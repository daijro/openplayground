+    /// Another person's app on a page of its own, its workbook not shared yet.
+    fn app() -> SheetApp {
+        let mut s = Session::new();
+        s.new_workbook();
+        SHARED.take();
+        SheetApp::new(s, Services::default())
+    }
+
+    /// Switches the test to another page: the session as this page knows it goes into `saved`, `saved`'s comes in.
+    fn swap(saved: &mut Shared) {
+        SHARED.with_borrow_mut(|sh| std::mem::swap(sh, saved));
+    }
+
+    /// The session's first workbook in a shared document.
+    fn first(doc: &Value) -> &Value {
+        &doc["documents"][0]
+    }
+
+    fn run(app: &mut SheetApp, id: &str, params: Value) {
+        app.session.execute(id, params).unwrap();
+    }
+
+    fn input(app: &SheetApp, a1: &str) -> String {
+        let d = app.session.active().unwrap();
+        d.wb.sheet(0).unwrap().cell(CellRef::parse(a1).unwrap()).map(|c| c.input_text()).unwrap_or_default()
+    }
