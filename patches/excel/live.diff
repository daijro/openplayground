+//! Live editing in a Playground session (web only): the shared document is the session's workbooks as JSON, keyed by a
+//! session id: the one active when the session started (or that a joiner's active window takes) and each one opened,
+//! created or imported since by anyone, which opens behind the others' own. Closing one is personal: the session goes on
+//! with it as it was, and File › Home lists the session's workbooks to go to or open again. Sheets are keyed by name,
+//! cells by address with their style inline (style ids are positions in a table each copy grows on its own), objects
+//! by id. Formula results are recalculated where the workbook is, not shared. This person's active sheet, zoom, sheet
+//! view mode, gridlines, headings and Show Formulas, scroll position and active cell, Watch Window, selection and the
+//! file data GridCraft does not model stay local. Presence: the workbook and sheet each person is on, their pointer,
+//! their selection and what they are doing before it reaches the workbook (a draft being typed, a range moved or filled,
+//! a row or column edge, an object moved or resized, an ink stroke), drawn over the others' grids in their color.
+//!
+//! The session and the presence look (pointers, name tags, colors, easing, ghosts) are the playground-live crate's
+//! (patches/live/kit); selections, drafts, strokes and edge lines are GridCraft's own, drawn here in the kit's colors.
+
+// The playground-live crate, under the module name web/live.rs and the tests reach it by.
+pub use ::playground_live;
+
+// DocState::new for a made-here workbook, which differs by channel (livedoc.diff, livedoc.head.diff).
+#[path = "live_compat.rs"]
+mod compat;
+#[path = "live_doc.rs"]
+mod live_doc;
+
+use std::cell::{Cell as Flag, RefCell};
+use std::sync::Arc;
+
+use egui::epaint::PathShape;
+use egui::text::LayoutJob;
+use egui::{Color32, FontId, Painter, Pos2, Rect, Stroke, StrokeKind, Vec2, pos2, vec2};
+use gridcraft_engine::core::{CellRef, MAX_COLS, MAX_ROWS, RangeRef, Value as CellValue};
+use gridcraft_engine::model::{
+    Anchor, Cell, CellStore, Formula, PatternType, Sheet, Style, StyleId, StyleTable, Workbook,
+};
+use gridcraft_engine::{DocState, Mode, Selection, Session};
+use serde::{Deserialize, Serialize};
+use serde_json::{Map, Value, json};
+
+use crate::grid::{Drag, Geo};
+use crate::{SheetApp, theme};
+use playground_live::{Live, Presence, presence};
+
+/// The four sides of a `width` wide outline centred on `rect`, cut to `clip` (the grid's own helper moved
+/// between modules across versions, so the adapter keeps a copy).
+fn outline_bands(rect: Rect, width: f32, clip: Rect) -> Vec<Rect> {
+    if !rect.is_finite() || !clip.is_finite() {
+        return Vec::new();
+    }
+    let h = width / 2.0;
+    let clip = clip.expand(width * 2.0);
+    let sides = [
+        Rect::from_min_max(pos2(rect.left() - h, rect.top() - h), pos2(rect.left() + h, rect.bottom() + h)),
+        Rect::from_min_max(pos2(rect.right() - h, rect.top() - h), pos2(rect.right() + h, rect.bottom() + h)),
+        Rect::from_min_max(pos2(rect.left() - h, rect.top() - h), pos2(rect.right() + h, rect.top() + h)),
+        Rect::from_min_max(pos2(rect.left() - h, rect.bottom() - h), pos2(rect.right() + h, rect.bottom() + h)),
+    ];
+    sides.into_iter().map(|s| s.intersect(clip)).filter(|s| s.is_finite() && s.width() > 0.0 && s.height() > 0.0).collect()
+}
+
+/// Sheet fields that are this person's view.
+const VIEW: [&str; 7] = ["zoom", "view", "view_active", "view_top_left", "show_gridlines", "show_headings", "show_formulas"];
+/// The defined name holding the Watch Window's list, which the app keeps through Undo as view state.
+const WATCH: &str = "_sc_watch";
+
+thread_local! {
+    /// The session's workbooks as this page knows them.
+    static SHARED: RefCell<Shared> = RefCell::new(Shared::default());
+    /// Where the pointer is on screen (as of the last frame).
+    static POINTER: Flag<Option<Pos2>> = const { Flag::new(None) };
+}
+
+/// The end of each frame (web), after the grid drew: the presence look's (name tags in GridCraft's bold), then
+/// [`playground_live::frame`].
+pub fn frame(app: &mut SheetApp, ctx: &egui::Context) {
+    presence::set_font(theme::ui_bold(12.0));
+    presence::end_frame(ctx);
+    POINTER.set(ctx.input(|i| i.pointer.hover_pos()));
+    playground_live::frame(app);
+}
+
+/// The first step of [`SheetApp::run`] (web): in the workbook a session shares, Undo and Redo undo or redo this
+/// person's last operations through the session (`Some`, the command's result).
+pub(crate) fn undo(app: &mut SheetApp, id: &str, params: &Value) -> Option<Result<Value, String>> {
+    let redo = match id {
+        "edit.undo" => false,
+        "edit.redo" => true,
+        _ => return None,
+    };
+    if !shared_active(&app.session) {
+        return None;
+    }
+    if let Err(e) = app.commit_text_box_edit() {
+        return Some(Err(e));
+    }
+    let steps = params.get("steps").and_then(Value::as_u64).unwrap_or(1).max(1);
+    (0..steps).all(|_| playground_live::undo(redo)).then_some(Ok(Value::Null))
+}
+
+/// Where this person's pointer is on the grid: the cell under it, or over the headings the column's or the row's
+/// heading (a whole column or row; every cell for the corner), and where in it (fractions of its width and height; in a
+/// heading strip, of the strip's height or width).
+fn pointer(app: &SheetApp, sh: &Sheet) -> Option<(RangeRef, f32, f32)> {
+    let geo = app.grid.geo.as_ref().filter(|_| app.backstage.is_none())?;
+    let p = geo.mirror_pos(POINTER.get()?);
+    let cells = geo.cells;
+    if !Rect::from_min_max(pos2(geo.head_left(), geo.head_top()), cells.max).contains(p) || (cells.contains(p) && !geo.in_cells(p)) {
+        return None;
+    }
+    let at = geo.cell_at(sh, p);
+    let r = geo.cell_rect(sh, at);
+    let f = |v: f32, size: f32| v / size.max(1.0);
+    let (col, x) = if p.x < cells.left() { (None, f(p.x - geo.head_left(), geo.header_w)) } else { (Some(at.col), f(p.x - r.left(), r.width())) };
+    let (row, y) = if p.y < cells.top() { (None, f(p.y - geo.head_top(), geo.header_h)) } else { (Some(at.row), f(p.y - r.top(), r.height())) };
+    let range = RangeRef::new(
+        CellRef::new(row.unwrap_or(0), col.unwrap_or(0)),
+        CellRef::new(row.unwrap_or(MAX_ROWS - 1), col.unwrap_or(MAX_COLS - 1)),
+    );
+    Some((range, x, y))
+}
+
+/// The most ranges, stroke points and typed characters a presence carries.
+const MAX_SHOWN: usize = 50;
+const MAX_STROKE: usize = 200;
+const MAX_TEXT: usize = 300;
+/// The shell sends no presence over 4 KiB.
+const MAX_PRESENCE: usize = 4000;
+/// The kit's pointer arrow, tip first, for right-to-left sheets (its cursor doesn't mirror): egui fills a closed path as
+/// a fan from its first point, which this shape allows.
+const ARROW: [[f32; 2]; 7] = [[0.0, 0.0], [0.0, 16.0], [4.5, 12.2], [7.6, 18.6], [10.4, 17.3], [7.3, 11.0], [12.5, 11.0]];
+
+/// The gesture under way in this person's grid, where it has its items so far, for the others' ghosts: the range a
+/// border drag moves (`move`: where it goes) or the fill handle fills (`fill`), a column's or a row's edge (`col` and
+/// `width`, `row` and `height`, in sheet points), the column whole columns move before (`before`), or a floating object
+/// moved or resized (`object`: [kind, id], `rect`: [x, y, width, height] in sheet points).
+fn drag(drag: &Drag, sh: &Sheet, sel: &Selection) -> Option<Value> {
+    let round = |f: f64| (f * 10.0).round() / 10.0;
+    Some(match *drag {
+        Drag::Move { to: Some(to), .. } => {
+            let r = sel.current();
+            json!({"move": RangeRef::new(to, to.offset_clamped(i64::from(r.height()) - 1, i64::from(r.width()) - 1)).a1()})
+        }
+        Drag::Fill { target: Some(t), .. } => json!({"fill": t.a1()}),
+        Drag::ResizeCol { col, .. } => json!({"col": col, "width": round(sh.col_width(col).into())}),
+        Drag::ResizeRow { row, .. } => json!({"row": row, "height": round(sh.row_height(row).into())}),
+        Drag::MoveCols { before: Some(before), .. } => json!({"before": before}),
+        Drag::Object { .. } => {
+            let (kind, id) = compat::drag_object(drag)?;
+            let a = object(sh, Some(kind), id)?;
+            let (x, y) = (sh.col_left(a.cell.col) + f64::from(a.dx), sh.row_top(a.cell.row) + f64::from(a.dy));
+            json!({"object": [kind, id], "rect": [round(x), round(y), round(a.width.into()), round(a.height.into())]})
+        }
+        _ => return None,
+    })
+}
+
+/// What this person is typing on the active sheet `si`: a cell's draft (`cell`) or a text box's (`shape`: its id), up to
+/// its first [`MAX_TEXT`] characters.
+fn typing(app: &SheetApp, si: usize, sh: &Sheet) -> Option<Value> {
+    let text = |t: &str| t.chars().take(MAX_TEXT).collect::<String>();
+    if let Some(ed) = app.editor.as_ref().filter(|ed| ed.sheet == si) {
+        return Some(json!({"cell": ed.cell.a1(), "text": text(&ed.text)}));
+    }
+    let ed = app.text_box_editor.as_ref().filter(|ed| sh.shapes.iter().any(|s| s.id == ed.id))?;
+    Some(json!({"shape": ed.id, "text": text(&ed.text)}))
+}
+
+/// The ink stroke being drawn (sheet points), its points at least a pixel apart at this person's zoom `z`: the newest
+/// [`MAX_STROKE`], in whole points, as one flat list.
+fn stroke(ink: &[[f32; 2]], z: f32) -> Option<Value> {
+    let mut kept: Vec<[f32; 2]> = Vec::new();
+    for &p in ink {
+        if kept.last().is_none_or(|q| (p[0] - q[0]).hypot(p[1] - q[1]) * z >= 1.0) {
+            kept.push(p);
+        }
+    }
+    let kept = &kept[kept.len().saturating_sub(MAX_STROKE)..];
+    (kept.len() >= 2).then(|| kept.iter().flatten().map(|v| v.round() as i64).collect())
+}
+
+/// A floating object on `sh` by its kind (any when `None`) and id: its anchor.
+fn object(sh: &Sheet, kind: Option<&str>, id: u32) -> Option<Anchor> {
+    let is = |k: &str| kind.is_none_or(|kind| kind == k);
+    (sh.shapes.iter().find(|s| is("shape") && s.id == id).map(|s| s.anchor))
+        .or_else(|| sh.charts.iter().find(|c| is("chart") && c.id == id).map(|c| c.anchor))
+        .or_else(|| sh.images.iter().find(|c| is("image") && c.id == id).map(|c| c.anchor))
+        .or_else(|| sh.slicers.iter().find(|c| is("slicer") && c.id == id).map(|c| c.anchor))
+}
+
+/// The ghost of a drag in sheet points: an area ([left, top, right, bottom] of cells or an object) or the line a column's
+/// (x) or a row's (y) edge goes to.
+#[derive(Clone, Copy, Debug, PartialEq)]
+enum Ghost {
+    Area([f64; 4]),
+    Col(f64),
+    Row(f64),
+}
+
+/// Person `o`'s drag on `sh` (see [`ghost`]), eased toward where it is ([`presence::ease`]; `z`: screen points per sheet
+/// point, `far`: the jump in screen points that goes at once). Another kind of ghost shows at once.
+fn eased_ghost(ctx: &egui::Context, o: &Presence, sh: &Sheet, z: f64, far: f64) -> Option<Ghost> {
+    match ghost(sh, &o.state["drag"])? {
+        Ghost::Area(t) => presence::ease(ctx, &o.id, "area", t, [z; 4], [far; 4]).map(Ghost::Area),
+        Ghost::Col(t) => presence::ease(ctx, &o.id, "col", [t], [z], [far]).map(|[x]| Ghost::Col(x)),
+        Ghost::Row(t) => presence::ease(ctx, &o.id, "row", [t], [z], [far]).map(|[y]| Ghost::Row(y)),
+    }
+}
+
+fn cell(v: &Value) -> Option<CellRef> {
+    v.as_str().and_then(CellRef::parse).filter(CellRef::is_valid)
+}
+
+/// The sheet point of a pointer `[range, x, y]` (see [`pointer`]) on `sh`. Over a heading it is in that heading strip, at
+/// negative points (`head`: the strips' width and height here, in sheet points; none when this grid hides them). While
+/// the person drags a column's or row's edge (`drag`, see [`drag`]), that line has its new size, as on their screen.
+fn pointer_at(sh: &Sheet, at: &Value, drag: &Value, head: [f64; 2]) -> Option<[f64; 2]> {
+    let r = at[0].as_str().and_then(RangeRef::parse).filter(|r| r.start.is_valid() && r.end.is_valid())?;
+    let f = |i: usize| at[i].as_f64().filter(|f| f.is_finite()).map(|f| f.clamp(0.0, 1.0));
+    let resized = |line: &str, size: &str, max: u32| {
+        let i = drag[line].as_u64().filter(|&i| i < u64::from(max))?;
+        Some((i as u32, drag[size].as_f64().filter(|f| (0.0..=1e4).contains(f))?))
+    };
+    // One axis: the heading strip when the range spans every line, else its one line at its start and size.
+    let along = |every: bool, (a, b): (u32, u32), f: f64, strip: f64, line: &dyn Fn(u32) -> (f64, f64), resized: Option<(u32, f64)>| {
+        if every {
+            return (strip > 0.0).then(|| (f.min(0.99) - 1.0) * strip);
+        }
+        let (mut start, mut size) = line(a);
+        match resized {
+            Some((i, new)) if i == a => size = new,
+            Some((i, new)) if i < a => start += new - line(i).1,
+            _ => {}
+        }
+        (a == b).then_some(start + f * size)
+    };
+    let col = |c: u32| (sh.col_left(c), f64::from(sh.col_width(c)));
+    let row = |r: u32| (sh.row_top(r), f64::from(sh.row_height(r)));
+    Some([
+        along(r.is_full_rows(), (r.start.col, r.end.col), f(1)?, head[0], &col, resized("col", "width", MAX_COLS))?,
+        along(r.is_full_cols(), (r.start.row, r.end.row), f(2)?, head[1], &row, resized("row", "height", MAX_ROWS))?,
+    ])
+}
+
+/// Where a drag (see [`drag`]) has its items on `sh`. What does not resolve or fit is left out.
+fn ghost(sh: &Sheet, d: &Value) -> Option<Ghost> {
+    let range = |k: &str| d[k].as_str().and_then(RangeRef::parse).filter(|r| r.start.is_valid() && r.end.is_valid());
+    let number = |v: &Value, max: f64| v.as_f64().filter(|f| (0.0..=max).contains(f));
+    let index = |k: &str, max: u32| d[k].as_u64().filter(|&i| i < u64::from(max)).map(|i| i as u32);
+    if let Some(r) = range("move").or_else(|| range("fill")) {
+        let (right, bottom) = (sh.col_left(r.end.col) + f64::from(sh.col_width(r.end.col)), sh.row_top(r.end.row) + f64::from(sh.row_height(r.end.row)));
+        return Some(Ghost::Area([sh.col_left(r.start.col), sh.row_top(r.start.row), right, bottom]));
+    }
+    if let (Some(c), Some(w)) = (index("col", MAX_COLS), number(&d["width"], 1e4)) {
+        return Some(Ghost::Col(sh.col_left(c) + w));
+    }
+    if let (Some(r), Some(h)) = (index("row", MAX_ROWS), number(&d["height"], 1e4)) {
+        return Some(Ghost::Row(sh.row_top(r) + h));
+    }
+    if let Some(before) = index("before", MAX_COLS) {
+        return Some(Ghost::Col(sh.col_left(before)));
+    }
+    let id = u32::try_from(d["object"][1].as_u64()?).ok()?;
+    object(sh, Some(d["object"][0].as_str()?), id)?;
+    let [x, y, w, h] = [0, 1, 2, 3].map(|i| number(&d["rect"][i], 1e9));
+    Some(Ghost::Area([x?, y?, x? + w?, y? + h?]))
+}
+
+/// A stroke's points (sheet points) from its flat list; none unless every number is a sheet point.
+fn stroke_at(v: &Value) -> Vec<[f64; 2]> {
+    let numbers = v.as_array().into_iter().flatten().take(2 * MAX_STROKE).map(|v| v.as_f64().filter(|f| (0.0..=1e9).contains(f)));
+    numbers.collect::<Option<Vec<f64>>>().unwrap_or_default().chunks_exact(2).map(|p| [p[0], p[1]]).collect()
+}
+
+fn length(stroke: &[[f64; 2]]) -> f64 {
+    stroke.windows(2).map(|w| (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1])).sum()
+}
+
+/// Sheet point `at` on this person's grid (through its panes, zoom and scroll); negative points are in the heading
+/// strips, left of and above the cells.
+fn screen(geo: &Geo, sh: &Sheet, at: &[f64]) -> Pos2 {
+    let (c, r) = (sh.col_at(at[0].max(0.0)), sh.row_at(at[1].max(0.0)));
+    let along = |v: f64, strip_end: f32, line: f32, start: f64| if v < 0.0 { strip_end + v as f32 * geo.z } else { line + (v - start) as f32 * geo.z };
+    pos2(along(at[0], geo.cells.left(), geo.x(sh, c), sh.col_left(c)), along(at[1], geo.cells.top(), geo.y(sh, r), sh.row_top(r)))
+}
+
+/// The ghost of a drag in `color`: the area the kit's way, or the edge's line across the grid.
+fn paint_ghost(p: &Painter, geo: &Geo, sh: &Sheet, ghost: Ghost, color: Color32) {
+    let edge = color.gamma_multiply(0.85);
+    let cells = geo.cells;
+    match ghost {
+        Ghost::Area(a) => {
+            let rect = Rect::from_min_max(screen(geo, sh, &a[..2]), screen(geo, sh, &a[2..]));
+            let last = |v: f64, start: f64| (v - 0.01).max(start);
+            let covered = RangeRef::new(
+                CellRef::new(sh.row_at(a[1]), sh.col_at(a[0])),
+                CellRef::new(sh.row_at(last(a[3], a[1])), sh.col_at(last(a[2], a[0]))),
+            );
+            for pane in geo.range_panes(covered) {
+                let clip = pane.intersect(p.clip_rect());
+                // Cut to what shows (a whole column is millions of points tall), keeping its edges out of sight.
+                let shown = rect.intersect(clip.expand(4.0));
+                if shown.is_positive() {
+                    presence::ghost(&p.with_clip_rect(clip), shown, color);
+                }
+            }
+        }
+        Ghost::Col(x) => {
+            let x = screen(geo, sh, &[x, 0.0]).x;
+            p.line_segment([pos2(x, cells.top()), pos2(x, cells.bottom())], Stroke::new(2.0, edge));
+        }
+        Ghost::Row(y) => {
+            let y = screen(geo, sh, &[0.0, y]).y;
+            p.line_segment([pos2(cells.left(), y), pos2(cells.right(), y)], Stroke::new(2.0, edge));
+        }
+    }
+}
+
+/// A stroke being drawn, its first `shown` sheet points: translucent, as wide as the pen.
+fn paint_stroke(p: &Painter, geo: &Geo, sh: &Sheet, stroke: &[[f64; 2]], shown: f64, color: Color32) {
+    let Some(&first) = stroke.first() else { return };
+    let mut left = shown;
+    let mut line = vec![screen(geo, sh, &first)];
+    for w in stroke.windows(2) {
+        let d = (w[1][0] - w[0][0]).hypot(w[1][1] - w[0][1]);
+        if d >= left {
+            let f = if d > 0.0 { (left / d).max(0.0) } else { 0.0 };
+            line.push(screen(geo, sh, &[w[0][0] + (w[1][0] - w[0][0]) * f, w[0][1] + (w[1][1] - w[0][1]) * f]));
+            break;
+        }
+        left -= d;
+        line.push(screen(geo, sh, &w[1]));
+    }
+    // ponytail: butt caps; round ones would show only past ~6 px wide (the pen is 2 sheet points).
+    p.add(PathShape::line(line, Stroke::new((2.0 * geo.z).max(2.0), color.gamma_multiply(0.7))));
+}
+
+/// What a person is typing, where it goes: over the cell as GridCraft's cell editor shows a draft (in the cell's font,
+/// growing to the right) or over the text box, outlined in their color, with their caret at its end. Where it is drawn.
+fn paint_typing(p: &Painter, geo: &Geo, wb: &Workbook, sh: &Sheet, typing: &Value, color: Color32) -> Option<Rect> {
+    let text = typing["text"].as_str()?;
+    let text: String = text.chars().take(MAX_TEXT).collect();
+    let (p, rect, galley, at, fill) = if let Some(c) = cell(&typing["cell"]) {
+        let range = sh.merge_at(c).unwrap_or(RangeRef::cell(c));
+        let pane = geo.range_panes(range).first().copied().filter(|_| !geo.hidden_under_frozen(sh, c))?;
+        let cell = geo.range_rect(sh, range);
+        let st = wb.styles.get(sh.style_id(c));
+        let font = FontId::new(st.font.size * 96.0 / 72.0 * geo.z, theme::cell_family(&st.font.name, st.font.bold, st.font.italic));
+        let g = p.layout_no_wrap(text, font, Color32::BLACK);
+        let w = (g.size().x + 14.0).max(cell.width()).min((geo.cells.right() - cell.left()).max(cell.width()));
+        let rect = Rect::from_min_size(cell.min, vec2(w, (g.size().y + 4.0).max(cell.height())));
+        let fill = (st.fill.pattern == PatternType::Solid).then(|| st.fill.fg.resolve(&wb.theme).map(theme::color32)).flatten();
+        let at = rect.min + vec2(3.0, ((cell.height() - g.size().y) / 2.0).max(2.0));
+        (p.with_clip_rect(pane.intersect(p.clip_rect())), rect, g, at, fill)
+    } else if let Some(sp) = typing["shape"].as_u64().and_then(|id| sh.shapes.iter().find(|s| u64::from(s.id) == id)) {
+        let rect = crate::chartview::anchor_rect(geo, sh, &sp.anchor);
+        let f = &sp.format;
+        let size = f.font_size.map_or(14.0, |pt| pt * 96.0 / 72.0).clamp(1.0, 2000.0) * geo.z;
+        let font = FontId::new(size, theme::cell_family(f.font.as_deref().unwrap_or(""), f.bold, f.italic));
+        let ink = f.text_color.and_then(|c| c.resolve(&wb.theme)).map(theme::color32).unwrap_or(Color32::BLACK);
+        let g = p.layout_job(LayoutJob::simple(text, font, ink, (rect.width() - 8.0).max(1.0)));
+        (p.clone(), rect, g, rect.min + vec2(4.0, 4.0), sp.fill.resolve(&wb.theme).map(theme::color32))
+    } else {
+        return None;
+    };
+    p.rect_filled(rect, 0.0, fill.unwrap_or(Color32::WHITE));
+    let caret = galley.pos_from_cursor(galley.end()).translate(at.to_vec2());
+    p.galley(at, galley, Color32::BLACK);
+    p.line_segment([caret.left_top(), caret.left_bottom()], Stroke::new(1.5, color));
+    p.rect_stroke(rect.expand(1.0), 0.0, Stroke::new(2.0, color), StrokeKind::Middle);
+    Some(rect)
+}
+
+/// A person's selection in `color`: each range outlined (2 points) and faintly filled but for the active cell, as
+/// GridCraft shades its own, in each pane that shows it; and their selected object outlined.
+fn paint_selection(p: &Painter, geo: &Geo, sh: &Sheet, state: &Value, color: Color32) {
+    let ranges = state["selection"].as_array().into_iter().flatten().take(MAX_SHOWN).filter_map(Value::as_str);
+    let mut ranges: Vec<RangeRef> = ranges.filter_map(RangeRef::parse).filter(|r| r.start.is_valid() && r.end.is_valid()).collect();
+    if let Some(active) = cell(&state["active"]) {
+        if !ranges.iter().any(|r| r.contains(active)) {
+            ranges.push(sh.merge_at(active).unwrap_or(RangeRef::cell(active)));
+        }
+        for range in ranges {
+            let rect = geo.range_rect(sh, range);
+            let one = Selection { active, anchor: active, ranges: vec![range] };
+            for pane in geo.range_panes(range) {
+                let clip = pane.intersect(p.clip_rect());
+                let p = p.with_clip_rect(clip);
+                for piece in crate::grid::selection_fill(geo, sh, &one, rect) {
+                    p.rect_filled(piece.intersect(clip.expand(4.0)), 0.0, color.gamma_multiply(0.1));
+                }
+                for side in outline_bands(rect, 2.0, clip) {
+                    p.rect_filled(side, 0.0, color);
+                }
+            }
+        }
+    }
+    if let Some(a) = state["object"].as_u64().and_then(|id| object(sh, None, u32::try_from(id).ok()?)) {
+        // Just outside it.
+        presence::outline(p, crate::chartview::anchor_rect(geo, sh, &a).expand(2.0), color);
+    }
+}
+
+/// A pointer on `p`, which paints on screen, on a right-to-left sheet: the kit's arrow mirrored, its tip at `tip`
+/// (logical), in `color` with a white edge and a soft shadow.
+fn paint_mirrored_arrow(p: &Painter, geo: &Geo, tip: Pos2, color: Color32) {
+    let points: Vec<Pos2> = ARROW.iter().map(|&[x, y]| geo.mirror_pos(tip + vec2(x, y))).collect();
+    let shadow = Color32::from_black_alpha(64);
+    p.add(PathShape::convex_polygon(points.iter().map(|q| *q + vec2(0.0, 1.0)).collect(), shadow, Stroke::new(1.5, shadow)));
+    p.add(PathShape::convex_polygon(points, color, Stroke::new(1.5, Color32::WHITE)));
+}
+
+/// The kit's name tag in `color` where `place` puts a tag of the size it is given.
+fn paint_tag(p: &Painter, name: &str, color: Color32, place: impl FnOnce(Vec2) -> Rect) {
+    presence::tag(p, place(presence::tag_size(p, name)).min, color, name);
+}
+
+/// Where a name of `size` goes without a pointer to go by: in the row of `at` (the active cell, or the draft over it),
+/// beside it where it covers no other cell's text, else inside it along its far edge; never over the cells above.
+fn parked(geo: &Geo, sh: &Sheet, at: Rect, size: Vec2) -> Rect {
+    let beside = Rect::from_min_size(pos2(at.right() + 2.0, at.top() + ((at.height() - size.y) / 2.0).max(0.0)), size);
+    let lines = |a: u32, b: u32| (a..=b).take(8);
+    let text = |r: u32| lines(geo.col_at(sh, beside.left()), geo.col_at(sh, beside.right())).any(|c| sh.cell(CellRef::new(r, c)).is_some_and(|c| !c.value.is_empty()));
+    if beside.right() > geo.cells.right() || lines(geo.row_at(sh, beside.top()), geo.row_at(sh, beside.bottom())).any(text) {
+        beside.translate(vec2(-4.0 - size.x, 0.0))
+    } else {
+        beside
+    }
+}
+
+/// The others on this person's workbook and sheet, in their colors: first what they are dragging, then their
+/// selections and drafts, then their pointers with their names, over the cells and the headings (a name by the active
+/// cell or draft for whoever's pointer is off the grid). The grid's overlays call it first: `p` paints over the cells of
+/// `sh`, the active sheet, laid out by `geo`, left to right. Marks ease toward where they were last shown
+/// ([`presence::ease`], which repaints until they get there).
+pub(crate) fn draw_presence(app: &SheetApp, p: &Painter, geo: &Geo, sh: &Sheet) {
+    let others = presence::others();
+    let (Some(doc), Some(d)) = (active_id(&app.session).filter(|_| !others.is_empty()), app.session.active()) else { return };
+    let here = |s: &Value| s["doc"].as_u64() == Some(doc) && s["sheet"].as_str() == Some(sh.name.as_str());
+    let here: Vec<&Presence> = others.iter().filter(|o| here(&o.state)).collect();
+    let (ctx, z) = (p.ctx(), f64::from(geo.z));
+    let far = 0.25 * f64::from(geo.cells.width().max(geo.cells.height()));
+    for o in &here {
+        if let Some(ghost) = eased_ghost(ctx, o, sh, z, far) {
+            paint_ghost(p, geo, sh, ghost, presence::color(o));
+        }
+        // How much of the stroke shows: its length, eased toward its newest point; held at none between strokes so the
+        // next one is drawn out from its start (one under way when its person is first seen shows whole).
+        let stroke = stroke_at(&o.state["stroke"]);
+        let far = if stroke.is_empty() { 0.0 } else { far };
+        if let Some([shown]) = presence::ease(ctx, &o.id, "stroke", [length(&stroke)], [z], [far]) {
+            paint_stroke(p, geo, sh, &stroke, shown, presence::color(o));
+        }
+    }
+    let drafts: Vec<Option<Rect>> = here.iter().map(|o| {
+        paint_selection(p, geo, sh, &o.state, presence::color(o));
+        paint_typing(p, geo, &d.wb, sh, &o.state["typing"], presence::color(o))
+    }).collect();
+    // Pointers on a layer of their own just above the grid's, so they show over the headings too (menus, popups and
+    // dialogs stay above), painted on screen.
+    let layer = egui::LayerId::new(p.layer_id().order, egui::Id::new("live_presence"));
+    ctx.set_sublayer(p.layer_id(), layer);
+    let top = Painter::new(ctx.clone(), layer, geo.rect);
+    let heads = Rect::from_min_max(pos2(geo.head_left(), geo.head_top()), geo.cells.max);
+    let head = [geo.header_w, geo.header_h].map(|size| f64::from(size / geo.z));
+    // A pointer shows where it lands as what it is (a cell scrolled away is not over the headings), unless frozen
+    // panes cover it.
+    let shown = |at: [f64; 2]| {
+        let tip = screen(geo, sh, &at);
+        let agrees = (at[0] < 0.0) == (tip.x < geo.cells.left()) && (at[1] < 0.0) == (tip.y < geo.cells.top());
+        let frozen = geo.hidden_under_frozen(sh, CellRef::new(sh.row_at(at[1].max(0.0)), sh.col_at(at[0].max(0.0))));
+        (heads.contains(tip) && agrees && !frozen).then_some(tip)
+    };
+    for (o, draft) in here.iter().zip(drafts) {
+        let color = presence::color(o);
+        // Between a heading strip and the cells it goes at once (a mark of its own): sheet points do not run on across
+        // that edge.
+        let pointer = pointer_at(sh, &o.state["pointer"], &o.state["drag"], head)
+            .and_then(|t| presence::ease(ctx, &o.id, &format!("pointer {:?}", t.map(|v| v < 0.0)), t, [z; 2], [far; 2]));
+        if let Some(tip) = pointer.and_then(shown) {
+            if geo.rtl {
+                paint_mirrored_arrow(&top, geo, tip, color);
+                paint_tag(&top, &o.name, color, |size| geo.mirror_rect(Rect::from_min_size(tip + vec2(12.0, 15.0), size)));
+            } else {
+                presence::cursor(&top, tip, color, &o.name);
+            }
+        } else if let Some(active) = cell(&o.state["active"]).filter(|&c| !geo.hidden_under_frozen(sh, c)) {
+            let at = draft.unwrap_or_else(|| geo.range_rect(sh, sh.merge_at(active).unwrap_or(RangeRef::cell(active))));
+            paint_tag(p, &o.name, color, |size| parked(geo, sh, at, size));
+        }
+    }
+}
+
+/// The session's workbooks on this page: the one active when it started (or that it joined into), and every one opened,
+/// created or imported here or by the others since.
+#[derive(Default)]
+struct Shared {
+    docs: Vec<Doc>,
+    /// Workbooks whose `DocState::uid` is at least this were opened since the session started (uids only grow).
+    since: u64,
+    /// For [`playground_live::fresh_id`].
+    next: u64,
+}
+
+/// A workbook of the session.
+struct Doc {
+    /// Its id in the session.
+    id: u64,
+    /// Its window here; none once this person closed it (closing is personal, the workbook stays in the session).
+    uid: Option<u64>,
+    /// As last seen: what the session goes on with while it is closed here.
+    wb: Arc<Workbook>,
+    title: String,
+}
+
+/// The session id of the active workbook when it is one of the session's (its Undo and Redo go to the session).
+fn active_id(s: &Session) -> Option<u64> {
+    let uid = s.active()?.uid;
+    SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.uid == Some(uid)).map(|d| d.id))
+}
+
+/// Whether the active workbook is one the session shares.
+pub fn shared_active(s: &Session) -> bool {
+    active_id(s).is_some()
+}
+
+/// Brings the session's workbooks up to date with this page's windows: the active one when nothing is shared yet, each
+/// one opened since (as a new workbook of the session), the latest of each that is open, and which ones were closed.
+fn sync(s: &Session) {
+    SHARED.with_borrow_mut(|sh| {
+        if sh.docs.is_empty() {
+            let Some(d) = s.active() else { return };
+            sh.since = s.documents().iter().map(|d| d.uid).max().unwrap_or(0) + 1;
+            let id = playground_live::fresh_id(&mut sh.next);
+            sh.docs.push(Doc { id, uid: Some(d.uid), wb: d.wb.clone(), title: d.title.clone() });
+        }
+        for doc in &mut sh.docs {
+            match s.documents().iter().find(|d| Some(d.uid) == doc.uid) {
+                Some(d) => (doc.wb, doc.title) = (d.wb.clone(), d.title.clone()),
+                None => doc.uid = None,
+            }
+        }
+        for d in s.documents().iter().filter(|d| d.uid >= sh.since) {
+            if !sh.docs.iter().any(|doc| doc.uid == Some(d.uid)) {
+                let id = playground_live::fresh_id(&mut sh.next);
+                sh.docs.push(Doc { id, uid: Some(d.uid), wb: d.wb.clone(), title: d.title.clone() });
+            }
+        }
+    });
+}
+
+/// File › Home in a session: the session's workbooks, a row each with dots in the colors of the others on it; a click
+/// goes to one, opening it again if this person closed it. Whether it did (Backstage then closes).
+pub(crate) fn session_list(app: &mut SheetApp, ui: &mut egui::Ui) -> bool {
+    if !playground_live::connected() {
+        return false;
+    }
+    sync(&app.session);
+    let rows: Vec<(u64, String, Option<u64>)> = SHARED.with_borrow(|sh| sh.docs.iter().map(|d| (d.id, d.title.clone(), d.uid)).collect());
+    let (t, here) = (theme::Tokens::get(ui.ctx()), active_id(&app.session));
+    ui.add_space(6.0);
+    ui.label(egui::RichText::new("In this session").font(theme::ui_bold(15.0)).color(t.text));
+    ui.add_space(8.0);
+    let mut chosen = None;
+    for (id, title, uid) in rows {
+        let (rect, resp) = ui.allocate_exact_size(vec2(ui.available_width(), 44.0), egui::Sense::click());
+        let p = ui.painter();
+        if resp.hovered() || here == Some(id) {
+            p.rect_filled(rect, 4.0, t.hover);
+        }
+        let icon = Rect::from_center_size(pos2(rect.left() + 20.0, rect.center().y), vec2(20.0, 20.0));
+        crate::icons::paint(p, icon, crate::icons::Icon::Book, t.text);
+        let note = match (here == Some(id), uid) {
+            (true, _) => "You are here",
+            (false, Some(_)) => "Open",
+            (false, None) => "Closed here: click to open it again",
+        };
+        p.text(pos2(rect.left() + 42.0, rect.center().y - 8.0), egui::Align2::LEFT_CENTER, &title, theme::ui_font(13.5), t.text);
+        p.text(pos2(rect.left() + 42.0, rect.center().y + 9.0), egui::Align2::LEFT_CENTER, note, theme::ui_font(11.5), t.text_dim);
+        let on = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(id));
+        let names = on
+            .enumerate()
+            .map(|(k, o)| {
+                let at = pos2(rect.right() - 16.0 - 16.0 * k as f32, rect.center().y);
+                p.circle(at, 5.0, presence::color(&o), Stroke::new(1.5, Color32::WHITE));
+                o.name
+            })
+            .collect::<Vec<_>>();
+        let resp = if names.is_empty() { resp } else { resp.on_hover_text(names.join(", ")) };
+        if resp.clicked() {
+            chosen = Some((id, uid));
+        }
+    }
+    ui.add_space(22.0);
+    let Some((id, uid)) = chosen else { return false };
+    let s = &mut app.session;
+    let i = match uid.and_then(|uid| s.documents().iter().position(|d| d.uid == uid)) {
+        Some(i) => i,
+        None => {
+            // Open again: a window of its own with the session's copy.
+            let found = SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.id == id).map(|d| ((*d.wb).clone(), d.title.clone())));
+            let Some((wb, title)) = found else { return false };
+            let active = s.active_index();
+            let i = s.add_document(live_doc::new_doc(wb, title));
+            let uid = s.documents()[i].uid;
+            SHARED.with_borrow_mut(|sh| sh.docs.iter_mut().filter(|d| d.id == id).for_each(|d| d.uid = Some(uid)));
+            s.set_active(active);
+            i
+        }
+    };
+    app.run_or_alert("window.activate", json!({"index": i}));
+    true
+}
+
+/// Runs `f` on document `i` (the session lends out only the active one).
+fn with_doc<R>(s: &mut Session, i: usize, f: impl FnOnce(&mut DocState) -> R) -> Option<R> {
+    let active = s.active_index();
+    s.set_active(i);
+    let r = s.active_mut().map(f);
+    s.set_active(active);
+    r
+}
+
+/// A cell as shared: its formula or value, and its style unless that is Normal.
+#[derive(Serialize, Deserialize)]
+struct SharedCell {
+    #[serde(default, skip_serializing_if = "CellValue::is_empty")]
+    value: CellValue,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    formula: Option<Arc<Formula>>,
+    #[serde(default, skip_serializing_if = "Option::is_none")]
+    style: Option<Style>,
+}
+
+fn document(wb: &Workbook) -> serde_json::Result<Value> {
+    let normal = wb.styles.get(StyleId::DEFAULT);
+    let mut sheets = Vec::new();
+    for sh in &wb.sheets {
+        let mut v = serde_json::to_value(Sheet { cells: CellStore::new(), ..(**sh).clone() })?;
+        if let Some(m) = v.as_object_mut() {
+            for k in VIEW {
+                m.remove(k);
+            }
+        }
+        v["id"] = sh.name.clone().into();
+        let mut cells = Map::new();
+        for (at, cell) in sh.cells.iter() {
+            let style = wb.styles.get(cell.style);
+            let shared = SharedCell {
+                // A formula's result is recalculated where the workbook is.
+                value: if cell.formula.is_some() { CellValue::Empty } else { cell.value.clone() },
+                formula: cell.formula.clone(),
+                style: (style != normal).then(|| style.clone()),
+            };
+            if !shared.value.is_empty() || shared.formula.is_some() || shared.style.is_some() {
+                cells.insert(at.a1(), serde_json::to_value(shared)?);
+            }
+        }
+        v["cells"] = Value::Object(cells);
+        for (key, lines) in [("rows", &sh.rows), ("cols", &sh.cols)] {
+            for (i, line) in lines {
+                if let Some(id) = line.style {
+                    v[key][i.to_string()]["style"] = serde_json::to_value(wb.styles.get(id))?;
+                }
+            }
+        }
+        sheets.push(v);
+    }
+    let mut v = serde_json::to_value(Workbook { sheets: vec![], ..wb.clone() })?;
+    if let Some(m) = v.as_object_mut() {
+        m.remove("active_sheet");
+        m.insert("styles".into(), serde_json::to_value(normal)?);
+        m.insert("sheets".into(), Value::Array(sheets));
+    }
+    if let Some(names) = v["names"].as_array_mut() {
+        names.retain(|n| n["name"] != WATCH);
+    }
+    Ok(v)
+}
+
+/// The shared `document` as a workbook, with this person's views, Watch Window and unmodelled file data from `local`.
+fn install(local: &Workbook, document: Value) -> Result<Workbook, String> {
+    let json = |e: serde_json::Error| e.to_string();
+    let mut m: Map<String, Value> = serde_json::from_value(document).map_err(json)?;
+    let normal: Style = serde_json::from_value(m.remove("styles").unwrap_or_default()).map_err(json)?;
+    let incoming: Vec<Map<String, Value>> = serde_json::from_value(m.remove("sheets").unwrap_or_default()).map_err(json)?;
+    m.extend([("active_sheet".into(), json!(0)), ("styles".into(), json!({"styles": []})), ("sheets".into(), json!([]))]);
+    let mut wb: Workbook = serde_json::from_value(Value::Object(m)).map_err(json)?;
+    // Styles this copy has keep their ids.
+    wb.styles = if *local.styles.get(StyleId::DEFAULT) == normal { local.styles.clone() } else { StyleTable::with_default(normal) };
+    let blank = serde_json::to_value(Sheet::new("")).map_err(json)?;
+    for mut s in incoming {
+        let cells = s.insert("cells".into(), blank["cells"].clone()).unwrap_or_else(|| json!({}));
+        for k in VIEW {
+            s.insert(k.into(), blank[k].clone());
+        }
+        for key in ["rows", "cols"] {
+            for line in s.get_mut(key).and_then(Value::as_object_mut).into_iter().flat_map(|m| m.values_mut()) {
+                if let Some(style) = line.get_mut("style").filter(|v| v.is_object()) {
+                    *style = wb.styles.intern(serde_json::from_value(style.take()).map_err(json)?).0.into();
+                }
+            }
+        }
+        let mut sh: Sheet = serde_json::from_value(Value::Object(s)).map_err(json)?;
+        for (a1, cell) in serde_json::from_value::<Map<String, Value>>(cells).map_err(json)? {
+            let at = CellRef::parse(&a1).ok_or_else(|| format!("invalid cell `{a1}`"))?;
+            let c: SharedCell = serde_json::from_value(cell).map_err(json)?;
+            // A merge can combine fields into a cell GridCraft would store differently, which would change it again.
+            let empty = c.value.is_empty() && c.formula.is_none() && c.style.is_none();
+            if empty || (c.formula.is_some() && !c.value.is_empty()) || c.style.as_ref() == Some(wb.styles.get(StyleId::DEFAULT)) {
+                return Err(format!("cell {a1} of {} is not one GridCraft stores", sh.name));
+            }
+            let style = c.style.map_or(StyleId::DEFAULT, |s| wb.styles.intern(s));
+            sh.cells.set(at, Cell { value: c.value, formula: c.formula, style });
+        }
+        if let Some(old) = local.sheets.iter().find(|old| old.name == sh.name) {
+            (sh.zoom, sh.view, sh.view_active, sh.view_top_left) = (old.zoom, old.view, old.view_active, old.view_top_left);
+            (sh.show_gridlines, sh.show_headings, sh.show_formulas) = (old.show_gridlines, old.show_headings, old.show_formulas);
+            sh.preserved = old.preserved.clone();
+        }
+        wb.sheets.push(Arc::new(sh));
+    }
+    if wb.sheets.is_empty() {
+        return Err("a workbook without sheets".into());
+    }
+    let active = local.active().map(|sh| &sh.name);
+    wb.active_sheet = wb.sheets.iter().position(|sh| Some(&sh.name) == active).unwrap_or(usize::from(local.active_sheet.clone()).min(wb.sheets.len() - 1)).into();
+    wb.names.extend(local.names.iter().filter(|n| n.name == WATCH).cloned());
+    (wb.preserved, wb.source_dir) = (local.preserved.clone(), local.source_dir.clone());
+    Ok(wb)
+}
+
+/// The session's workbooks in a shared document: (id, name, workbook).
+fn entries(document: &Value) -> Result<Vec<(u64, String, Value)>, String> {
+    let list = document["documents"].as_array().ok_or("no list of workbooks")?;
+    let entry = |v: &Value| {
+        let id = v["id"].as_u64().ok_or("a workbook without an id")?;
+        let name = v["name"].as_str().ok_or("a workbook without a name")?.to_owned();
+        let mut wb = v.clone();
+        if let Some(m) = wb.as_object_mut() {
+            (m.remove("id"), m.remove("name"));
+        }
+        Ok((id, name, wb))
+    };
+    list.iter().map(entry).collect()
+}
+
+/// What adopting the session's workbooks does to each, worked out before anything changes: (id, name, this page's copy
+/// as (window, workbook) if it has one, the workbook to install if it changed).
+type Plan = Vec<(u64, String, Option<(Option<u64>, Arc<Workbook>)>, Option<Workbook>)>;
+
+fn plan(docs: &[Doc], incoming: Vec<(u64, String, Value)>) -> Result<Plan, String> {
+    // Joining: the session's first workbook goes into the window this page offered (its active one).
+    let joining = !incoming.iter().any(|(id, ..)| docs.iter().any(|d| d.id == *id));
+    let mut plan = Vec::new();
+    for (i, (id, title, json)) in incoming.into_iter().enumerate() {
+        let old = if joining && i == 0 { docs.first() } else { docs.iter().find(|d| d.id == id) };
+        let wb = match old.is_some_and(|d| document(&d.wb).ok().as_ref() == Some(&json)) {
+            true => None,
+            false => Some(install(&old.map(|d| d.wb.clone()).unwrap_or_default(), json).map_err(|e| format!("Invalid shared workbook: {e}"))?),
+        };
+        plan.push((id, title, old.map(|d| (d.uid, d.wb.clone())), wb));
+    }
+    Ok(plan)
+}
+
+impl Live for SheetApp {
+    /// `{ documents: [{ id, name, ...workbook }] }`: every workbook of the session, open here or not.
+    fn live_document(&self) -> Value {
+        sync(&self.session);
+        SHARED.with_borrow(|sh| {
+            let docs = sh.docs.iter().map(|d| {
+                // Serializing the model cannot fail (every map key is text); a null would fail every peer's check.
+                let mut v = document(&d.wb).unwrap_or_default();
+                (v["id"], v["name"]) = (d.id.into(), d.title.clone().into());
+                v
+            });
+            json!({"documents": docs.collect::<Vec<_>>()})
+        })
+    }
+
+    /// Each workbook goes into its window here; one new to the session opens in a window behind this person's, one they
+    /// closed stays closed.
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let incoming = entries(&document)?;
+        let s = &mut self.session;
+        if SHARED.with_borrow(|sh| sh.docs.is_empty()) && s.active().is_none() {
+            // Joining with no workbook open: a window for the session's first one.
+            s.new_workbook();
+        }
+        sync(s);
+        let plan = SHARED.with_borrow(|sh| plan(&sh.docs, incoming))?;
+        let active = s.active_index();
+        let mut docs = Vec::new();
+        for (id, title, old, wb) in plan {
+            let at = old.as_ref().and_then(|o| o.0).and_then(|uid| s.documents().iter().position(|d| d.uid == uid));
+            docs.extend(match (at, old) {
+                (Some(i), _) => with_doc(s, i, |d| {
+                    if let Some(mut wb) = wb {
+                        d.calc.recalc_all(&mut wb);
+                        d.wb = Arc::new(wb);
+                        d.revision += 1;
+                    }
+                    d.title.clone_from(&title);
+                    Doc { id, uid: Some(d.uid), wb: d.wb.clone(), title }
+                }),
+                (None, Some((_, last))) => Some(Doc { id, uid: None, wb: wb.map_or(last, Arc::new), title }),
+                (None, None) => {
+                    let i = s.add_document(live_doc::new_doc(wb.unwrap_or_default(), title.clone()));
+                    s.set_active(active);
+                    let d = &s.documents()[i];
+                    Some(Doc { id, uid: Some(d.uid), wb: d.wb.clone(), title })
+                }
+            });
+        }
+        SHARED.with_borrow_mut(|sh| sh.docs = docs);
+        Ok(())
+    }
+
+    /// Whether every peer can install `document` (two people deleting a sheet each can leave none).
+    fn live_check(document: &Value) -> Result<(), String> {
+        let docs = entries(document).map_err(|e| format!("Conflict: {e}"))?;
+        for (i, (id, _, wb)) in docs.iter().enumerate() {
+            if docs[..i].iter().any(|d| d.0 == *id) {
+                return Err("Conflict: two workbooks with one id".into());
+            }
+            // ponytail: decodes every workbook per merge (O(cells)); a lighter schema check if big sessions lag.
+            install(&Workbook::default(), wb.clone()).map_err(|e| format!("Conflict: {e}"))?;
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let g = &self.grid;
+        presence::quiet()
+            && self.editor.is_none()
+            && self.text_box_editor.is_none()
+            && self.session.mode == Mode::Ready
+            && g.drag == Drag::None
+            && !g.drag_select
+            && g.ink.is_empty()
+            && g.hf_edit.is_none()
+            && g.ruler_drag.is_none()
+            && g.renaming_tab.is_none()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::hash::DefaultHasher::new();
+        for d in self.session.documents() {
+            (d.uid, d.revision, Arc::as_ptr(&d.wb) as usize, &d.title).hash(&mut h);
+        }
+        SHARED.with_borrow(|sh| sh.docs.iter().for_each(|d| (d.id, d.uid, Arc::as_ptr(&d.wb) as usize).hash(&mut h)));
+        Some(h.finish())
+    }
+
+    /// `{ doc: session id, sheet, active, selection: [ranges], pointer?: [cell or heading's column or row, x, y] (see
+    /// [`pointer`]), object?: selected id, drag?, stroke?, typing? }` (see [`drag`], [`stroke`], [`typing`]), on the
+    /// session's workbooks only.
+    fn live_presence(&self) -> Value {
+        let (Some(doc), Some(d)) = (active_id(&self.session), self.session.active()) else { return Value::Null };
+        let Some(sh) = d.wb.active() else { return Value::Null };
+        let (sel, grid) = (&d.selection, &self.grid);
+        let mut state = json!({
+            "doc": doc,
+            "sheet": sh.name,
+            "active": sel.active.a1(),
+            "selection": sel.ranges.iter().take(MAX_SHOWN).map(RangeRef::a1).collect::<Vec<_>>(),
+        });
+        if let Some((at, x, y)) = pointer(self, sh) {
+            let round = |f: f32| (f64::from(f) * 100.0).round() / 100.0;
+            state["pointer"] = json!([at.a1(), round(x), round(y)]);
+        }
+        if let Some(id) = compat::selected_chart(self).filter(|&id| object(sh, None, id).is_some()) {
+            state["object"] = id.into();
+        }
+        let z = grid.geo.as_ref().map_or(1.0, |g| g.z);
+        let marks = [("drag", drag(&grid.drag, sh, sel)), ("stroke", stroke(&grid.ink, z)), ("typing", typing(self, usize::from(d.wb.active_sheet.clone()), sh))];
+        for (key, mark) in marks {
+            if let Some(mark) = mark {
+                state[key] = mark;
+            }
+        }
+        // The shell sends nothing bigger: the stroke's oldest points go first.
+        while state.to_string().len() > MAX_PRESENCE
+            && let Some(s) = state.get_mut("stroke").and_then(Value::as_array_mut).filter(|s| s.len() > 4)
+        {
+            s.drain(..s.len() / 4 * 2);
+        }
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+
+    fn live_disconnected(&mut self) {
+        let s = &mut self.session;
+        let shared = SHARED.take();
+        for i in 0..s.documents().len() {
+            if shared.docs.iter().any(|d| d.uid == Some(s.documents()[i].uid)) {
+                // Their steps hold other people's edits.
+                with_doc(s, i, |d| {
+                    d.undo.clear();
+                    d.redo.clear();
+                });
+            }
+        }
+    }
+}
