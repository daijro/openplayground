+        let sh = wb.active().unwrap();
+        let geo = Geo::new(sh, Rect::from_min_size(Pos2::ZERO, vec2(800.0, 600.0)), egui::Vec2::ZERO);
+        let c3 = geo.cell_rect(sh, CellRef::parse("C3").unwrap());
