+    fn a_pointer_over_the_headings_comes_back_where_it_was_and_follows_a_column_edge_being_dragged() {
+        let mut a = app();
+        a.live_document();
+        let wb = a.session.active().unwrap().wb.clone();
+        let sh = wb.active().unwrap();
+        let geo = Geo::new(sh, Rect::from_min_size(Pos2::ZERO, vec2(800.0, 600.0)), egui::Vec2::ZERO);
+        let head = [geo.header_w, geo.header_h].map(|size| f64::from(size / geo.z));
+        let c3 = geo.cell_rect(sh, CellRef::parse("C3").unwrap());
+        a.grid.geo = Some(geo.clone());
+        let strips = [
+            (pos2(c3.center().x, geo.head_top() + 5.0), "C:C"),
+            (pos2(geo.head_left() + 6.0, c3.center().y), "3:3"),
+            (pos2(geo.head_left() + 3.0, geo.head_top() + 3.0), "A1:XFD1048576"),
+        ];
+        for (at, heading) in strips {
+            POINTER.set(Some(at));
+            let pointer = a.live_presence()["pointer"].clone();
+            assert_eq!(pointer[0], heading);
+            let back = screen(&geo, sh, &pointer_at(sh, &pointer, &Value::Null, head).unwrap());
+            assert!((back - at).length() < 0.5, "{heading}: {at:?} came back at {back:?}");
+        }
+        // Column B dragged 30 points wider: C's heading goes 30 points on, as on the dragger's screen.
+        let pointer = json!(["C:C", 0.5, 0.5]);
+        let wider = json!({"col": 1, "width": f64::from(sh.col_width(1)) + 30.0});
+        let [x, _] = pointer_at(sh, &pointer, &Value::Null, head).unwrap();
+        assert_eq!(pointer_at(sh, &pointer, &wider, head).unwrap()[0], x + 30.0);
