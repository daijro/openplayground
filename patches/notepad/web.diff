+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+  <title>NoteCraft Text</title>
+  <!-- NoteCraft Text in the browser, for Playground (patches/notepad.yaml in github.com/daijro/openplayground). -->
+  <link data-trunk rel="rust" href="crates/app/Cargo.toml" data-bin="notepad" data-wasm-opt="0" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #202020; }
+    #notecraft_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+    #notecraft_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #f0f0f0; font: 14px system-ui, sans-serif; pointer-events: none; }
+  </style>
+</head>
+<body>
+  <canvas id="notecraft_canvas"></canvas>
+  <div id="notecraft_loading">Loading NoteCraft Text&hellip;</div>
+</body>
+</html>
