+// SPDX-License-Identifier: MIT
+//! NoteCraft Text in the browser, for Playground (patches/notepad.yaml in github.com/daijro/openplayground): the
+//! desktop window on the page's canvas, and its files in Playground's Files.
+//!
+//! `ui::run` starts as on the desktop; mod.rs takes [`eframe`] from here on the web, whose `run_native` starts the
+//! app on the page. Files live in memory (notepad-playground's `fs`): a file from Files comes in at its path
+//! (`browser:/Notes/a.txt` is `/Notes/a.txt` here), and what the editor writes goes back to Files. Open and Save As
+//! are Playground's dialogs instead of the egui file dialog; "Open in NoteCraft Text" and a file dropped on the page
+//! open as File > Open does. A file from the computer or a drop lives under `/tmp`, and saving it downloads it.
+use super::{actions, state::{FileDialog, Shell, Tab}};
+use notepad_playground::{call, fs};
+use std::cell::{Cell, OnceCell, RefCell};
+use std::path::{Path, PathBuf};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+/// The file types Open offers and a Save As names (the dialogs add the first when a name has none).
+const TYPES: [&str; 18] = [
+    "txt", "md", "markdown", "log", "ini", "cfg", "conf", "json", "xml", "yaml", "yml", "toml", "csv", "tsv", "html",
+    "htm", "css", "js",
+];
+
+enum Event {
+    /// A file is in memory at this path: open it.
+    Open(PathBuf),
+    /// Save As answered: write this tab to this path.
+    SaveAs(usize, PathBuf),
+}
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    static EVENTS: RefCell<Vec<Event>> = const { RefCell::new(Vec::new()) };
+    static UNSAVED: Cell<bool> = const { Cell::new(false) };
+}
+
+fn push(event: Event) {
+    EVENTS.with_borrow_mut(|e| e.push(event));
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+/// The desktop's eframe, with `run_native` starting the app on the page instead.
+pub(crate) mod eframe {
+    pub use ::eframe::*;
+
+    /// The desktop window's options, which a page has no use for.
+    #[derive(Default)]
+    #[allow(dead_code)]
+    pub struct NativeOptions {
+        pub viewport: egui::ViewportBuilder,
+    }
+
+    /// Starts the app on the page's canvas, made by `creator` once the page's context exists; returns at once.
+    pub fn run_native(_name: &str, _options: NativeOptions, creator: ::eframe::AppCreator<'static>) -> ::eframe::Result {
+        super::start(creator);
+        Ok(())
+    }
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+/// `{ name, types }` for the dialogs (`name` only when given).
+fn options(name: Option<&str>) -> JsValue {
+    let o = js_sys::Object::new();
+    let types: js_sys::Array = TYPES.iter().map(|t| JsValue::from(*t)).collect();
+    let _ = js_sys::Reflect::set(&o, &"types".into(), &types);
+    if let Some(name) = name {
+        let _ = js_sys::Reflect::set(&o, &"name".into(), &name.into());
+    }
+    o.into()
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory at its path (one from the computer, under `/tmp`), then open.
+fn file_in(file: JsValue) {
+    let Some(name) = get(&file, "name").as_string() else { return };
+    let path = match get(&file, "path").as_string() {
+        Some(p) => PathBuf::from(p.strip_prefix("browser:").unwrap_or(&p)),
+        None => Path::new("/tmp").join(name),
+    };
+    fs::put(&path, js_sys::Uint8Array::new(&get(&file, "bytes")).to_vec());
+    push(Event::Open(path));
+}
+
+/// File > Open: Playground's Open, over all of Files.
+pub(super) fn open_dialog() {
+    let asked = call("open", &[options(None)]);
+    wasm_bindgen_futures::spawn_local(async move {
+        if let Some(files) = wait(asked).await {
+            js_sys::Array::from(&files).iter().for_each(file_in);
+        }
+    });
+}
+
+/// File > Save as: Playground's Save As. Its answer is a path in Files, or, for "Download to device", one under `/tmp`.
+pub(super) fn save_as_dialog(tab: usize, name: String) {
+    let name = if name.is_empty() { "Untitled.txt".to_owned() } else { name };
+    let asked = call("saveAs", &[options(Some(&name))]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let Some(answer) = wait(asked).await else { return };
+        let path = match get(&answer, "path").as_string() {
+            Some(p) => PathBuf::from(p.strip_prefix("browser:").unwrap_or(&p)),
+            None => Path::new("/tmp").join(&name),
+        };
+        push(Event::SaveAs(tab, path));
+    });
+}
+
+/// After the frame's drawing: what came in (Files, dialogs, drops), and the unsaved state for the leave warning.
+pub(super) fn frame(shell: &mut Shell, ctx: &egui::Context) {
+    // A dropped file is only a name on the web: its bytes are read, then it opens like a file from the computer.
+    for f in ctx.input(|i| i.raw.dropped_files.clone()) {
+        wasm_bindgen_futures::spawn_local(async move {
+            if let (Ok(bytes), Some(name)) = (f.bytes_async().await, f.path().file_name()) {
+                let path = Path::new("/tmp").join(name);
+                fs::put(&path, bytes);
+                push(Event::Open(path));
+            }
+        });
+    }
+    for event in EVENTS.take() {
+        match event {
+            Event::Open(path) => actions::open_path(shell, &path, None),
+            Event::SaveAs(tab, path) => {
+                let Some(document) = shell.tabs.get(tab) else { continue };
+                let (encoding, bom) = (document.file.encoding(), document.file.has_bom());
+                // As the egui dialog's Save would: the write, and whatever the save was for (closing the tab).
+                shell.file_dialog = Some(FileDialog::save_as(tab, path.to_string_lossy().into_owned(), encoding, bom));
+                actions::confirm_file_dialog(shell);
+            }
+        }
+    }
+    let unsaved = shell.tabs.iter().any(Tab::is_dirty);
+    if UNSAVED.replace(unsaved) != unsaved {
+        call("setUnsaved", &[unsaved.into()]);
+    }
+}
+
+/// [`eframe::run_native`] on the web.
+fn start(creator: ::eframe::AppCreator<'static>) {
+    std::panic::set_hook(Box::new(|info| web_sys::console::error_1(&format!("NoteCraft Text: {info}").into())));
+    call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(file_in).into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("notecraft_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #notecraft_canvas");
+        let creator = move |cc: &::eframe::CreationContext<'_>| {
+            CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+            creator(cc)
+        };
+        let runner = ::eframe::WebRunner::new();
+        let started = runner.start(canvas, ::eframe::WebOptions::default(), Box::new(creator)).await;
+        // The runner lives as long as the page.
+        std::mem::forget(runner);
+        if let Some(loading) = document.get_element_by_id("notecraft_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("NoteCraft Text could not start: {e:?}"))),
+            }
+        }
+    });
+}
