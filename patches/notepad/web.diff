@@ -0,0 +1,13 @@
+# Playground's browser build of NoteCraft Text (patches/notepad.yaml in github.com/daijro/openplayground): the files
+# wasm32-unknown-unknown lacks, in memory and mirrored to Files. Native builds compile it empty.
+[package]
+name = "notepad-playground"
+version = "0.1.0"
+edition = "2024"
+description = "NoteCraft Text in the browser: files in memory, mirrored to Playground's Files"
+license = "MIT"
+publish = false
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+wasm-bindgen = "0.2"
+js-sys = "0.3"
diff --git a/notepad-playground/src/lib.rs b/notepad-playground/src/lib.rs
