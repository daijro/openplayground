--- /dev/null
+++ b/notepad-playground/src/lib.rs
@@ -0,0 +1,51 @@
+// SPDX-License-Identifier: MIT
+//! NoteCraft Text in the browser, for Playground (patches/notepad.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no files: every `std::fs` call fails. `nc-textproc` takes `fs` from here instead.
+//! Files are kept in memory; a file from Files or a drop is [`fs::put`] in, and what the editor writes goes to
+//! Playground's Files (`playgroundFiles.write`), or, under `/tmp` (a file from the computer, or a Save As to
+//! download), to the browser's downloads.
+#![cfg(target_arch = "wasm32")]
+
+use js_sys::{Function, Reflect, Uint8Array};
+use wasm_bindgen::{JsCast as _, JsValue};
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+pub fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Reflect::get(&js_sys::global(), &"playgroundFiles".into()).ok().filter(JsValue::is_object)?;
+    let f = Reflect::get(&api, &method.into()).ok()?.dyn_into::<Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+pub mod fs {
+    // What isn't here (OpenOptions, rename, ...) is std's, which fails on a page.
+    pub use ::std::fs::*;
+    use ::std::cell::RefCell;
+    use ::std::collections::BTreeMap;
+    use ::std::io;
+    use ::std::path::{Path, PathBuf};
+
+    thread_local! {
+        static FILES: RefCell<BTreeMap<PathBuf, Vec<u8>>> = const { RefCell::new(BTreeMap::new()) };
+    }
+
+    /// Stores a file that came in from Files or a drop.
+    pub fn put(path: &Path, bytes: Vec<u8>) {
+        FILES.with_borrow_mut(|f| f.insert(path.to_path_buf(), bytes));
+    }
+
+    pub fn read<P: AsRef<Path>>(path: P) -> io::Result<Vec<u8>> {
+        FILES.with_borrow(|f| f.get(path.as_ref()).cloned()).ok_or_else(|| io::ErrorKind::NotFound.into())
+    }
+
+    pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(path: P, bytes: C) -> io::Result<()> {
+        let (path, bytes) = (path.as_ref(), bytes.as_ref());
+        put(path, bytes.to_vec());
+        let data = super::Uint8Array::from(bytes);
+        match path.strip_prefix("/tmp") {
+            Ok(name) => super::call("download", &[name.to_string_lossy().as_ref().into(), data.into()]),
+            Err(_) => super::call("write", &[format!("browser:{}", path.display()).into(), data.into()]),
+        };
+        Ok(())
+    }
+}
