+++ b/apps/altered-web/Cargo.toml
@@ -0,0 +1,38 @@
+# Playground's browser build of Altered Audio Editor (patches/audition.yaml in github.com/daijro/openplayground): the
+# back end in src-tauri as a WASI module the page runs (apps/altered-web/js), with Tauri replaced by stand-ins/.
+# scripts/build-web.sh builds it for wasm32-wasip1 and the interface around it with Vite.
+[package]
+name = "altered-web"
+version = "0.1.0"
+edition = "2021"
+license = "GPL-3.0-or-later"
+publish = false
+
+[lib]
+crate-type = ["cdylib"]
+
+[dependencies]
+altered-audio-editor = { path = "../../src-tauri" }
+altered-playground = { path = "playground" }
+tauri = { path = "stand-ins/tauri" }
+tauri-plugin-dialog = { path = "stand-ins/tauri-plugin-dialog" }
+serde_json = "1"
+
+[workspace]
+
+[patch.crates-io]
+tauri = { path = "stand-ins/tauri" }
+tauri-build = { path = "stand-ins/tauri-build" }
+tauri-plugin-dialog = { path = "stand-ins/tauri-plugin-dialog" }
+tauri-plugin-opener = { path = "stand-ins/tauri-plugin-opener" }
+tauri-plugin-updater = { path = "stand-ins/tauri-plugin-updater" }
+libloading = { path = "stand-ins/libloading" }
+# src-tauri's own patch, which only its workspace sees.
+opus-decoder = { path = "../../src-tauri/vendor/opus-decoder" }
+
+[profile.release]
+opt-level = 3
+debug = false
+panic = "abort"
+codegen-units = 1
+lto = true
diff --git a/apps/altered-web/js/audio-worklet.js b/apps/altered-web/js/audio-worklet.js
new file mode 100644
index 0000000..361a2fe
--- /dev/null
+++ b/apps/altered-web/js/audio-worklet.js
@@ -0,0 +1,77 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Altered Audio Editor in Playground (patches/audition.yaml in github.com/daijro/openplayground): the speakers and the
+// microphone, on the audio thread. Blocks come from the back end's worker (worker.js) through the port the page hands
+// over, about a tenth of a second ahead; the microphone's go back to it in blocks of 2048 frames. The page wakes it
+// ({ wake }) when something starts playing or recording.
+const AHEAD = 4096
+const MIC = 2048
+
+class Altered extends AudioWorkletProcessor {
+  constructor() {
+    super()
+    this.worker = null
+    this.queue = []
+    this.at = 0
+    this.buffered = 0
+    this.asked = false
+    this.idle = true
+    this.mic = new Float32Array(MIC * 2)
+    this.micAt = 0
+    this.port.onmessage = ({ data }) => {
+      if (data.worker) {
+        this.worker = data.worker
+        this.worker.onmessage = ({ data }) => this.fromWorker(data)
+      }
+      if (data.wake) this.idle = false
+    }
+  }
+  fromWorker(data) {
+    this.asked = false
+    if (data.block) {
+      this.queue.push(data.block)
+      this.buffered += data.block.length / 2
+    }
+    if (data.idle) this.idle = true
+  }
+  process(inputs, outputs) {
+    const out = outputs[0]
+    const frames = out[0].length
+    // The microphone, when it is connected.
+    const input = inputs[0]
+    if (input?.length && this.worker) {
+      const l = input[0]
+      const r = input[1] ?? l
+      for (let i = 0; i < l.length; i++) {
+        this.mic[this.micAt++] = l[i]
+        this.mic[this.micAt++] = r[i]
+        if (this.micAt === this.mic.length) {
+          this.worker.postMessage({ mic: this.mic }, [this.mic.buffer])
+          this.mic = new Float32Array(MIC * 2)
+          this.micAt = 0
+        }
+      }
+    }
+    for (let i = 0; i < frames; i++) {
+      const block = this.queue[0]
+      if (!block) {
+        out[0][i] = 0
+        out[1][i] = 0
+        continue
+      }
+      out[0][i] = block[this.at++]
+      out[1][i] = block[this.at++]
+      this.buffered--
+      if (this.at === block.length) {
+        this.queue.shift()
+        this.at = 0
+      }
+    }
+    if (!this.idle && !this.asked && this.worker && this.buffered < AHEAD) {
+      this.asked = true
+      this.worker.postMessage({ need: AHEAD - this.buffered })
+    }
+    return true
+  }
+}
+
+registerProcessor('altered', Altered)
diff --git a/apps/altered-web/js/backend.js b/apps/altered-web/js/backend.js
new file mode 100644
index 0000000..55416c6
--- /dev/null
+++ b/apps/altered-web/js/backend.js
@@ -0,0 +1,97 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Altered Audio Editor in Playground (patches/audition.yaml in github.com/daijro/openplayground): the back end, a
+// WASI module (apps/altered-web/src/lib.rs), started on the page's files (wasi.js). `call` runs one command at once.
+import { Files, WasiExit, wasi } from './wasi.js'
+
+export const files = new Files()
+
+/** Starts the back end from the module (compiled, its bytes or a fetch Response); `host(what, payload)` gets its events. */
+export async function start(source, host) {
+  const { imports, setMemory } = wasi(files)
+  const decoder = new TextDecoder()
+  let exports
+  const text = (ptr, len) => decoder.decode(new Uint8Array(exports.memory.buffer, ptr, len).slice())
+  const env = {
+    wasi_snapshot_preview1: imports,
+    playground: {
+      host: (w, wl, j, jl) => host(text(w, wl), JSON.parse(text(j, jl) || 'null')),
+    },
+  }
+  source = await source
+  const instance =
+    source instanceof WebAssembly.Module
+      ? await WebAssembly.instantiate(source, env)
+      : (source instanceof Response ? await WebAssembly.instantiateStreaming(source, env) : await WebAssembly.instantiate(source, env)).instance
+  exports = instance.exports
+  setMemory(exports.memory)
+  exports._initialize?.()
+  exports.pg_start()
+  return new Backend(exports)
+}
+
+class Backend {
+  constructor(exports) {
+    this.x = exports
+    this.encoder = new TextEncoder()
+    this.decoder = new TextDecoder()
+  }
+  /** `bytes` in the module's memory for `f(ptr, len)`. */
+  with(bytes, f) {
+    const ptr = this.x.pg_alloc(bytes.length)
+    new Uint8Array(this.x.memory.buffer, ptr, bytes.length).set(bytes)
+    try {
+      return f(ptr, bytes.length)
+    } finally {
+      this.x.pg_free(ptr, bytes.length)
+    }
+  }
+  reply() {
+    return new Uint8Array(this.x.memory.buffer, this.x.pg_reply_ptr(), this.x.pg_reply_len()).slice()
+  }
+  /** One command (its arguments as an object or JSON): { ok, value } (JSON, or an ArrayBuffer for bytes) or
+   * { ok: false, error }; null if unknown. */
+  call(cmd, args) {
+    const c = this.encoder.encode(cmd)
+    const a = this.encoder.encode(typeof args === 'string' ? args : JSON.stringify(args ?? {}))
+    let tag
+    try {
+      tag = this.with(c, (cp, cl) => this.with(a, (ap, al) => this.x.pg_invoke(cp, cl, ap, al)))
+    } catch (e) {
+      if (e instanceof WasiExit) throw e
+      // A panic (or any trap) leaves the module unusable: say so rather than carry on with half-done state.
+      throw new Error(`${cmd} crashed: ${e.message}`, { cause: e })
+    }
+    const bytes = this.reply()
+    if (tag === 3) return null
+    if (tag === 1) return { ok: true, value: bytes.buffer }
+    const value = bytes.length ? JSON.parse(this.decoder.decode(bytes)) : null
+    return tag === 0 ? { ok: true, value } : { ok: false, error: value }
+  }
+  /** The file dialog the last call asked for, or null. */
+  question() {
+    return this.x.pg_question() ? JSON.parse(this.decoder.decode(this.reply())) : null
+  }
+  answer(paths) {
+    this.with(this.encoder.encode(JSON.stringify(paths)), (p, l) => this.x.pg_answer(p, l))
+  }
+  forgetAnswers() {
+    this.x.pg_forget_answers()
+  }
+  playing() {
+    return !!this.x.pg_playing()
+  }
+  recording() {
+    return !!this.x.pg_recording()
+  }
+  /** Hands the back end a block of the microphone: `fill(view)` writes `frames` interleaved stereo frames. */
+  capture(frames, fill) {
+    const ptr = this.x.pg_capture(frames)
+    fill(new Float32Array(this.x.memory.buffer, ptr, frames * 2))
+    this.x.pg_captured()
+  }
+  /** The next `frames` of audio, interleaved stereo (a view into the module's memory: copy it out at once). */
+  render(frames) {
+    const ptr = this.x.pg_render(frames)
+    return new Float32Array(this.x.memory.buffer, ptr, frames * 2)
+  }
+}
diff --git a/apps/altered-web/js/playground.js b/apps/altered-web/js/playground.js
new file mode 100644
index 0000000..49cca43
--- /dev/null
+++ b/apps/altered-web/js/playground.js
@@ -0,0 +1,300 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+// Altered Audio Editor in Playground (patches/audition.yaml in github.com/daijro/openplayground): the page's side of
+// the back end, which runs in a worker (worker.js). The tauri-*.js modules stand in for @tauri-apps/api and come here.
+//
+//   Files      `/` in the back end is Playground's Files (globalThis.playgroundFiles): listed at start, a file's bytes
+//              loaded when a command reaches for them (the command then runs again), and what a command writes,
+//              creates or removes there mirrored back. Files is one flat list, and the app keeps sessions in folders
+//              (their media, recordings and exports beside them), so a path's folders go in the name: /Show/Audio/a.wav
+//              is "Show › Audio › a.wav" in Files. /.app is the app's own: its settings (/.app/config) are kept in
+//              this browser's localStorage, its cache and autosaves only while the page is open. What is saved in
+//              /Download to device (Save As > Download to device) is downloaded instead, and never kept in Files.
+//   Dialogs    a command's file dialog is Playground's Open or Save As; the command then runs again with the answer
+//              (stand-ins/tauri-plugin-dialog). Files from the computer, opened or dropped, are kept in Files, so a
+//              session that uses them still finds them next time.
+//   Audio      one AudioContext at the back end's rate, whose AudioWorklet (audio-worklet.js) gets its blocks from the
+//              worker and gives it the microphone's while something records or meters an armed track (the browser
+//              asks for the microphone the first time).
+
+const CONFIG = '/.app/config'
+const DOWNLOADS = '/Download to device'
+const CONFIG_KEY = 'altered-audio-editor:config'
+const RATE = 48000
+
+const pg = () => globalThis.playgroundFiles
+const normalize = (p) => '/' + String(p).split('/').filter((s) => s && s !== '.').join('/')
+const FOLDER = ' › '
+/** A Files path (browser:/Show › a.wav) as the back end's (/Show/a.wav), or null for anything else. */
+const fromApp = (p) =>
+  typeof p === 'string' && p.startsWith('browser:') ? normalize(p.slice('browser:'.length).split(/\/|\s›\s/).join('/')) : null
+const toApp = (p) => `browser:/${p.slice(1).split('/').join(FOLDER)}`
+const baseName = (p) => p.split('/').pop()
+const parentOf = (p) => p.slice(0, p.lastIndexOf('/')) || '/'
+
+// Playground's prelude cancels the browser's own Ctrl+key actions (page-prelude.js) and leaves the key to the app, but
+// this app's keymap passes over keys something else cancelled (src/keymap/dispatch.ts). Right after the prelude, the
+// event says it isn't cancelled until the app cancels it itself; the browser's action stays cancelled.
+addEventListener(
+  'keydown',
+  (e) => {
+    if (!e.defaultPrevented) return
+    let cancelled = false
+    Object.defineProperty(e, 'defaultPrevented', { get: () => cancelled })
+    Object.defineProperty(e, 'preventDefault', { value: () => ((cancelled = true), Event.prototype.preventDefault.call(e)) })
+  },
+  true,
+)
+
+// Below Playground's bar (shell.css sets --pg-bar), as the shell places canvas apps.
+document.head.append(Object.assign(document.createElement('style'), { textContent: '#app { position: fixed; inset: var(--pg-bar, 0px) 0 0 0; height: auto !important; }' }))
+
+const listeners = new Map()
+/** Events from the back end and the page, as Tauri's `listen` gets them. */
+export function on(event, handler) {
+  if (!listeners.has(event)) listeners.set(event, new Set())
+  listeners.get(event).add(handler)
+  return () => listeners.get(event)?.delete(handler)
+}
+let eventId = 0
+export function dispatch(event, payload) {
+  for (const h of listeners.get(event) ?? []) {
+    try {
+      h({ event, id: ++eventId, payload })
+    } catch (e) {
+      console.error(e)
+    }
+  }
+}
+
+function host(what, payload) {
+  if (what.startsWith('event:')) return dispatch(what.slice(6), payload)
+  if (what === 'set-title') {
+    document.title = String(payload)
+    // "<name> * - <app>" while the session has unsaved changes: Playground's leave warning follows it.
+    pg()?.setUnsaved(/ \* - /.test(String(payload)))
+  } else if (what === 'open-url') window.open(String(payload), '_blank', 'noopener')
+  else if (what === 'exit') location.href = '/'
+  else if (what === 'restart') location.reload()
+}
+
+// Paths the back end has (stubs and files), to name new ones without clashes.
+const known = new Set()
+
+const worker = new Worker(new URL('./worker.js', import.meta.url), { type: 'module' })
+const pending = new Map()
+let nextId = 0
+let started
+const ready = new Promise((resolve, reject) => (started = { resolve, reject }))
+worker.onmessage = ({ data }) => {
+  if (data.id !== undefined) {
+    pending.get(data.id)?.(data)
+    pending.delete(data.id)
+  } else if (data.host) host(data.host, data.payload)
+  else if (data.started) started.resolve()
+  else if (data.failed) started.reject(new Error(data.failed))
+  else if (data.recording === false) microphone(false)
+}
+worker.onerror = (e) => started.reject(new Error(`the back end's worker failed: ${e.message}`))
+worker.onerror = (e) => started.reject(new Error(`the back end's worker failed: ${e.message}`))
+const put = (path, bytes, note = false) => {
+  known.add(path)
+  worker.postMessage({ put: true, path, bytes, note })
+}
+
+;(async () => {
+  const config = []
+  try {
+    for (const [path, text] of Object.entries(JSON.parse(localStorage.getItem(CONFIG_KEY) ?? '{}'))) config.push([path, new TextEncoder().encode(text)])
+  } catch (e) {
+    console.warn('settings could not be restored', e)
+  }
+  const stubs = []
+  for (const p of (await pg()?.files('browser:/')) ?? []) {
+    const path = fromApp(p)
+    if (path && !path.startsWith('/.app/')) stubs.push(path)
+  }
+  stubs.forEach((p) => known.add(p))
+  // Compiled here, where Playground's loader unpacks the .wasm (page-prelude.js), and run in the worker.
+  const module = await WebAssembly.compileStreaming(fetch(new URL('altered.wasm', document.baseURI)))
+  worker.postMessage({ start: true, module, stubs, puts: config })
+  await ready
+  pg()?.onOpen((file) => openFile(file))
+})().catch((e) => {
+  console.error('the back end did not start', e)
+  started.reject(e)
+})
+
+/** Mirrors what a command changed: Files, the app's settings and its downloads. */
+function mirror(changes) {
+  let config = null
+  for (const { path, dir, bytes } of changes) {
+    if (bytes || dir) known.add(path)
+    else known.delete(path)
+    if (path === CONFIG || path.startsWith(CONFIG + '/')) {
+      config ??= JSON.parse(localStorage.getItem(CONFIG_KEY) ?? '{}')
+      if (bytes) config[path] = new TextDecoder().decode(bytes)
+      else if (!dir) delete config[path]
+    } else if (path === DOWNLOADS || path.startsWith(DOWNLOADS + '/')) {
+      if (!bytes) continue
+      pg()?.download(baseName(path), bytes)
+      worker.postMessage({ remove: path })
+    } else if (path === '/.app' || path.startsWith('/.app/') || dir) continue
+    else if (bytes) pg()?.write(toApp(path), bytes)
+    else pg()?.remove(toApp(path))
+  }
+  if (config) {
+    try {
+      localStorage.setItem(CONFIG_KEY, JSON.stringify(config))
+    } catch (e) {
+      console.warn('settings could not be saved', e)
+    }
+  }
+}
+
+/** A free path for `name` in `dir`: "name", else "name (2)"... */
+function freePath(dir, name) {
+  const dot = name.lastIndexOf('.')
+  const [stem, ext] = dot > 0 ? [name.slice(0, dot), name.slice(dot)] : [name, '']
+  for (let i = 1; ; i++) {
+    const p = normalize(`${dir}/${i === 1 ? name : `${stem} (${i})${ext}`}`)
+    if (!known.has(p)) return p
+  }
+}
+
+/** Keeps a file from the computer in Files; its path there. */
+function keepImported(name, bytes) {
+  const path = freePath('/', name)
+  put(path, bytes)
+  pg()?.write(toApp(path), bytes)
+  return path
+}
+
+const typesOf = (q) => [...new Set(q.filters.flatMap(([, exts]) => exts).filter((e) => e !== '*').map((e) => e.toLowerCase()))]
+
+/** Shows Playground's dialog for a command's question: the paths it answers, or null when cancelled. */
+async function ask(q) {
+  const types = typesOf(q)
+  if (q.kind === 'open' || q.kind === 'openMany') {
+    const picked = await pg()?.open({ types })
+    if (!picked?.length) return null
+    return picked.map((f) => {
+      const path = fromApp(f.path)
+      if (!path) return keepImported(f.name, f.bytes)
+      put(path, f.bytes)
+      return path
+    })
+  }
+  // A folder is named like a file saved where it goes.
+  const name = q.fileName ?? (q.kind === 'folder' ? q.title?.replace(/\s+to$/i, '') || 'Folder' : 'Untitled')
+  const saved = await pg()?.saveAs({ name, types: q.kind === 'folder' ? [] : types })
+  if (!saved) return null
+  const path = saved.download ? `${DOWNLOADS}/${name}` : fromApp(saved.path)
+  // Its folder may be new (made in the dialog, or the downloads).
+  worker.postMessage({ put: true, path: q.kind === 'folder' ? path : parentOf(path), dir: true })
+  return [path]
+}
+
+const send = (msg) =>
+  new Promise((resolve) => {
+    const id = nextId++
+    pending.set(id, resolve)
+    // As JSON, as Tauri sends them: arguments may be the interface's state proxies, which can't be posted as they are.
+    worker.postMessage({ call: true, id, ...msg, args: JSON.stringify(msg.args ?? {}) })
+  })
+
+/** Runs a command as Tauri's `invoke` does: its result, or a rejection with its error. */
+export async function invoke(cmd, args) {
+  await ready
+  let answer
+  for (let round = 0; ; round++) {
+    // The speakers start in the click or key that plays (browsers allow it only then), not when the reply is in.
+    if (/^(transport_play|preview_play|wave_play|record_start|record_monitor|midi_audition)$/.test(cmd)) audio(false)
+    const out = await send({ cmd, args, answer })
+    answer = undefined
+    mirror(out.changes)
+    if (out.playing) audio(true)
+    if (out.recording) microphone(true)
+    if (out.question) {
+      answer = await ask(out.question)
+      if (answer) continue
+    } else if (out.needed.length && round < 4) {
+      // Files it reached for that weren't loaded yet: load them and run it again.
+      await Promise.all(out.needed.map(async (p) => put(p, await pg().read(toApp(p)))))
+      continue
+    }
+    const r = out.reply
+    if (r === null) throw `Command ${cmd} not found`
+    if (r.crashed) console.error(`${cmd} crashed: ${r.error}`)
+    if (!r.ok) throw r.error
+    return r.value
+  }
+}
+
+let opened = []
+let onOpened = null
+/** A file for the app from Playground (Open in, ?open=): handed to the app as a drop (tauri-webview.js), once it
+ * listens for drops. */
+function openFile({ path, name, bytes }) {
+  const at = fromApp(path)
+  if (at) put(at, bytes)
+  opened.push(at ?? keepImported(name, bytes))
+  if (onOpened) onOpened(opened.splice(0))
+}
+export function whenOpened(f) {
+  onOpened = f
+  if (f && opened.length) f(opened.splice(0))
+}
+
+/** Files dropped from the computer: kept in Files, then their paths go to the app. */
+export async function dropped(list) {
+  const paths = []
+  for (const f of list) paths.push(keepImported(f.name, new Uint8Array(await f.arrayBuffer())))
+  return paths
+}
+
+let ctx = null
+let node = null
+let audioReady = null
+/** The speakers (and the worklet the microphone goes through); `play` wakes the worklet. */
+function audio(play) {
+  if (!ctx) {
+    ctx = new AudioContext({ sampleRate: RATE, latencyHint: 'interactive' })
+    audioReady = ctx.audioWorklet.addModule(new URL('./audio-worklet.js', import.meta.url)).then(() => {
+      node = new AudioWorkletNode(ctx, 'altered', { numberOfInputs: 1, numberOfOutputs: 1, outputChannelCount: [2] })
+      node.connect(ctx.destination)
+      const channel = new MessageChannel()
+      worker.postMessage({ audio: channel.port1 }, [channel.port1])
+      node.port.postMessage({ worker: channel.port2 }, [channel.port2])
+    })
+  }
+  if (ctx.state !== 'running') ctx.resume()
+  if (play) audioReady.then(() => node.port.postMessage({ wake: true }))
+}
+
+let mic = null
+/** The microphone into the worklet while the back end records or meters (stereo; a mono microphone on both sides). */
+async function microphone(on) {
+  if (!on) {
+    mic?.source?.disconnect()
+    for (const t of mic?.stream?.getTracks() ?? []) t.stop()
+    mic = null
+    return
+  }
+  if (mic) return
+  mic = {}
+  try {
+    const stream = await navigator.mediaDevices.getUserMedia({
+      audio: { echoCancellation: false, noiseSuppression: false, autoGainControl: false, channelCount: { ideal: 2 } },
+    })
+    audio(false)
+    await audioReady
+    if (!mic) return stream.getTracks().forEach((t) => t.stop())
+    const source = ctx.createMediaStreamSource(stream)
+    source.connect(node)
+    mic = { stream, source }
+  } catch (e) {
+    mic = null
+    console.warn('no microphone', e)
+    alert(`Recording needs the microphone: ${e.message}`)
+  }
+}
