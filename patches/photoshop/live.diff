+        // A brush stroke under way: the others are shown it so far, at the brush's size.
+        use photocraft_ui_egui::canvas::{ToolEvent, tool_event};
+        app.ui.tool = photocraft_ui_egui::state::Tool::Brush;
+        tool_event(&mut app, ToolEvent::Down { x: 20.0, y: 20.0, pressure: 1.0 }, egui::Modifiers::NONE);
+        tool_event(&mut app, ToolEvent::Move { x: 40.5, y: 30.0, pressure: 1.0 }, egui::Modifiers::NONE);
+        frame(&mut app, &ctx);
