+++ b/crates/engine/src/live.rs
@@ -0,0 +1,49 @@
+//! Live editing in a Playground session (web; patches/photoshop/live.diff): a shared document installed as a change
+//! made elsewhere. A child of the crate root so it reaches the open documents (it repeats session's private `fix_active`).
+
+use super::{Document, Session, channel_cmds, fix_selection, layer_multi_cmds};
+use std::sync::Arc;
+
+impl Session {
+    /// Makes `doc` the content of the open document `id` as a change made elsewhere (a live editing session), keeping
+    /// this person's [`Self::keep_views`] and the targeted layers that still exist. It is no history step: the native
+    /// steps and History snapshots, which hold none of it, go (restoring one would revert it). False when no open
+    /// document has that id.
+    pub fn install_remote(&mut self, id: photocraft_doc::DocId, mut doc: Document) -> bool {
+        let Some(st) = self.docs.iter_mut().find(|st| st.doc.id == id) else { return false };
+        Self::keep_views(&mut doc, &st.doc);
+        let damage = layer_multi_cmds::step_damage(&st.doc, &doc);
+        st.doc = Arc::new(doc);
+        st.history.clear();
+        st.snapshots.clear();
+        st.coalesce = None;
+        if st.active_layer.is_none_or(|id| st.doc.layer(id).is_none()) {
+            st.active_layer = st.doc.top_layer();
+        }
+        fix_selection(st);
+        channel_cmds::fix_view(st);
+        st.revision += 1;
+        st.last_damage = damage;
+        true
+    }
+
+    /// Copies `local`'s personal views into `doc`, the parts of a document a live editing session doesn't share: the
+    /// selection, Quick Mask, work path, groups' disclosure, Ruler tool line and active count group, the id and file
+    /// settings.
+    pub fn keep_views(doc: &mut Document, local: &Document) {
+        use photocraft_doc::{Layer, LayerContent::Group};
+        doc.id = local.id;
+        doc.file_encoding.clone_from(&local.file_encoding);
+        doc.selection.clone_from(&local.selection);
+        doc.quick_mask.clone_from(&local.quick_mask);
+        doc.quick_mask_unselected = local.quick_mask_unselected;
+        doc.work_path.clone_from(&local.work_path);
+        doc.measurement.ruler = local.measurement.ruler;
+        doc.measurement.active_count_group = local.measurement.active_count_group.min(doc.measurement.count_groups.len().saturating_sub(1));
+        for (_, _, l) in local.walk() {
+            if let (Group(g), Some(Layer { content: Group(mine), .. })) = (&l.content, doc.layer_mut(l.id)) {
+                mine.expanded = g.expanded;
+            }
+        }
+    }
+}
