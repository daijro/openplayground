+        assert_eq!((stroke["size"].as_f64(), &stroke["points"]), (Some(f64::from(app.session.tools.brush.size)), &json!([20, 20, 40.5, 30])));
+        tool_event(&mut app, ToolEvent::Up { x: 40.5, y: 30.0 }, egui::Modifiers::NONE);
+        app.session.add_document(Document::new("Untitled-2", Size::new(64, 64), ColorMode::Rgb, SampleType::U8), None);
+        frame(&mut app, &ctx);
+        let other = LIVE.with_borrow(|live| live.docs[1].uid);
+        assert_eq!(LIVE.with_borrow(|live| live.presence["doc"].clone()), json!(other), "another document shown");
