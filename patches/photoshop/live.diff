+        assert_eq!((out.layers[2].opacity, out.layers[2].content.clone()), (0.5, typed.layers[2].content.clone()));
+    }
+
+    #[test]
+    fn concurrent_layer_additions_reach_the_same_bytes_on_the_coordinator_and_every_peer() {
+        let base = doc();
+        let add = |name: &str| {
+            let mut d = base.clone();
+            d.layers.push(Layer::raster(name, d.pixel_format()));
+            bytes(&d)
+        };
