+//! Live editing in a Playground session (web only). Playground's `shell/live.js` drives it through [`web::attach`];
+//! nothing here runs until it connects. The shared document is the set of documents open in the session (the tabs), as
+//! a checkpoint ([`shared`]): each one's `.pcraft` manifest as canonical JSON without personal views ([`entry`]), then
+//! every surface's tiles in a fixed order, so a brush stroke changes only the bytes of the tiles it touched. A document
+//! opened here while connected joins the set; one someone else opened arrives as a tab in the background; closing a
+//! tab only hides that document here. A remote change merges into the open documents at the end of a quiet frame
+//! ([`frame`]), keeping this person's views, and is no step of the native history. While connected, Undo and Redo of
+//! those documents go to the session ([`undo`]), which reverts only this person's edits. Each person's document,
+//! pointer, active layers, selection bounds and the gesture under way go to the others ([`presence`]), who see them on
+//! the canvas and as dots on its tab (`peers`). The JSON merge and the presence look are the playground-live crate's
+//! (patches/live/kit); its JSON adapter isn't used: this checkpoint is binary.
+//!
+//! Checkpoint layout (integers little-endian):
+//! - `photocraft-live 3\n`;
+//! - `{"documents": [...]}`, keys sorted, each document the manifest's `document` without [`VIEWS`], with `id`: its id
+//!   in the set (in increasing order), each surface's `tiles` empty; cut after each surface ([`pieces`]) into u32 n, n
+//!   bytes pieces, each followed by that surface's tiles (a type layer's text and its rendered tiles change together):
+//!   u32 count, then per tile in row order: i32 tx, i32 ty, the BLAKE3 hash of its pixels (32 bytes), u32 n, n bytes
+//!   of its `.pcraft` zstd frame (0: that tile came earlier); the last piece by u32::MAX instead;
+//! - u32 count, then per blob the JSON names (ICC profile, EXIF, smart object source, …) in hash order: the hash,
+//!   u32 n, n bytes of its zstd frame.
+
+use photocraft_doc::{DocId, Document, LayerId};
+use photocraft_format::{ByteSource, FormatError, LoadOptions, PcraftWriter, SaveOptions};
+use photocraft_ui_egui::PhotocraftApp;
+use serde_json::{Map, Value, json};
+use std::collections::{BTreeMap, HashMap, HashSet, VecDeque};
+use std::rc::Rc;
+use std::sync::Arc;
+
+/// The shell's document limit (`shell/document-delta.js`).
+pub const MAX_BYTES: usize = 128 << 20;
+const MAGIC: &[u8] = b"photocraft-live 3\n";
+/// The manifest document's personal views; `Session::install_remote` keeps the local ones (and groups' `expanded`
+/// and the measurement's `ruler` and `active_count_group`). Its `id` is replaced by the one in the set.
+const VIEWS: &[&str] = &["id", "file_encoding", "selection", "quick_mask", "quick_mask_unselected", "work_path"];
+
+fn invalid(e: impl std::fmt::Display) -> String {
+    format!("Invalid shared document: {e}")
+}
+
+fn too_large(bytes: usize) -> String {
+    format!(
+        "This document is {} MiB to share live, over the 128 MiB limit. Make it smaller (fewer layers, a smaller canvas or 8 bits per channel) to edit it live.",
+        bytes >> 20
+    )
+}
+
+/// A checkpoint taken apart: the shared document with each surface's tiles as `{"tx,ty": hash}`, and the compressed
+/// tiles and blobs by hash.
+#[derive(Default)]
+struct Parts {
+    doc: Value,
+    tiles: HashMap<String, Rc<[u8]>>,
+    blobs: HashMap<String, Rc<[u8]>>,
+}
+
+/// Calls `f` with the `tiles` of each surface in `v` (an object of exactly `default`, `format` and `tiles`), keys
+/// sorted.
+fn surfaces(v: &mut Value, f: &mut dyn FnMut(&mut Value) -> Result<(), String>) -> Result<(), String> {
+    match v {
+        Value::Object(m) if m.len() == 3 && ["default", "format", "tiles"].iter().all(|k| m.contains_key(*k)) => m.get_mut("tiles").map_or(Ok(()), f),
+        Value::Object(m) => {
+            let mut items: Vec<_> = m.iter_mut().collect();
+            items.sort_by(|a, b| a.0.cmp(b.0));
+            items.into_iter().try_for_each(|(_, v)| surfaces(v, f))
+        }
+        Value::Array(items) => items.iter_mut().try_for_each(|v| surfaces(v, f)),
+        _ => Ok(()),
+    }
+}
+
+/// Groups' `expanded` (a view) out of the document, or back with a placeholder.
+fn groups(v: &mut Value, restore: bool) {
+    match v {
+        Value::Object(m) => {
+            if m.get("kind").and_then(Value::as_str) == Some("group") && m.contains_key("children") {
+                if restore {
+                    m.insert("expanded".into(), true.into());
+                } else {
+                    m.remove("expanded");
+                }
+            }
+            m.values_mut().for_each(|v| groups(v, restore));
+        }
+        Value::Array(items) => items.iter_mut().for_each(|v| groups(v, restore)),
+        _ => {}
+    }
+}
+
+fn is_hash(s: &str) -> bool {
+    s.len() == 64 && s.bytes().all(|b| b.is_ascii_digit() || (b'a'..=b'f').contains(&b))
+}
+
+/// The hashes `v` names: its blobs, and its tiles while they are maps of hashes.
+fn hashes(v: &Value, out: &mut HashSet<String>) {
+    match v {
+        Value::String(s) if is_hash(s) => {
+            out.insert(s.clone());
+        }
+        Value::Object(m) => m.values().for_each(|v| hashes(v, out)),
+        Value::Array(items) => items.iter().for_each(|v| hashes(v, out)),
+        _ => {}
+    }
+}
+
+fn coord(key: &str) -> Result<(i32, i32), String> {
+    key.split_once(',').and_then(|(x, y)| Some((x.parse().ok()?, y.parse().ok()?))).ok_or_else(|| invalid(format!("tile `{key}`")))
+}
+
+fn hash_bytes(hash: &str) -> Result<Vec<u8>, String> {
+    if !is_hash(hash) {
+        return Err(invalid(format!("hash `{hash}`")));
+    }
+    (0..32).map(|i| u8::from_str_radix(&hash[2 * i..2 * i + 2], 16).map_err(invalid)).collect()
+}
+
+/// The shared part of `doc` as the set's document `uid`. `writer` keeps the tiles it hashed and compressed before.
+fn entry(writer: &mut PcraftWriter, doc: &Document, uid: u64) -> Result<Parts, String> {
+    let (zip, _) = writer.save_zip(doc, &SaveOptions::default()).map_err(|e| e.to_string())?;
+    let zip = photocraft_format::zip::ZipReader::new(&zip).map_err(|e| e.to_string())?;
+    let mut objects = HashMap::new();
+    for entry in &zip.entries {
+        objects.insert(entry.name.as_str(), Rc::<[u8]>::from(zip.read(entry, usize::MAX).map_err(|e| e.to_string())?));
+    }
+    let mut manifest: Value = serde_json::from_slice(objects.get("manifest.json").ok_or("no manifest")?).map_err(|e| e.to_string())?;
+    let mut doc = manifest.get_mut("document").map(Value::take).unwrap_or_default();
+    if let Value::Object(m) = &mut doc {
+        for view in VIEWS {
+            m.remove(*view);
+        }
+        if let Some(Value::Object(m)) = m.get_mut("measurement") {
+            m.remove("ruler");
+            m.remove("active_count_group");
+        }
+        m.insert("id".into(), uid.into());
+    }
+    groups(&mut doc, false);
+    let mut parts = Parts::default();
+    surfaces(&mut doc, &mut |tiles| {
+        let mut map = Map::new();
+        for t in tiles.as_array().into_iter().flatten() {
+            let (tx, ty, hash) = (&t["tx"], &t["ty"], t["hash"].as_str().unwrap_or_default());
+            let bytes = objects.get(format!("tiles/{hash}.zst").as_str()).ok_or("missing tile")?;
+            parts.tiles.insert(hash.into(), bytes.clone());
+            map.insert(format!("{tx},{ty}"), hash.into());
+        }
+        *tiles = Value::Object(map);
+        Ok(())
+    })?;
+    parts.doc = doc;
+    for (name, bytes) in objects {
+        if let Some(hash) = name.strip_prefix("blobs/").and_then(|n| n.strip_suffix(".zst")) {
+            parts.blobs.insert(hash.into(), bytes);
+        }
+    }
+    let size = parts.tiles.values().chain(parts.blobs.values()).map(|b| b.len()).sum();
+    if size > MAX_BYTES { Err(too_large(size)) } else { Ok(parts) }
+}
+
+/// The set of `entries` as one: `{"documents": [...]}` in id order, with all their tiles and blobs.
+fn set<'a>(entries: impl Iterator<Item = &'a Parts>) -> Parts {
+    let mut set = Parts::default();
+    let mut docs = Vec::new();
+    for e in entries {
+        docs.push(e.doc.clone());
+        set.tiles.extend(e.tiles.iter().map(|(h, b)| (h.clone(), b.clone())));
+        set.blobs.extend(e.blobs.iter().map(|(h, b)| (h.clone(), b.clone())));
+    }
+    docs.sort_by_key(|d| d["id"].as_u64());
+    set.doc = json!({ "documents": docs });
+    set
+}
+
+/// The documents of a set, by id.
+fn documents(set: &Value) -> impl Iterator<Item = (u64, &Value)> {
+    set["documents"].as_array().into_iter().flatten().filter_map(|d| Some((d["id"].as_u64()?, d)))
+}
+
+/// `playground_live::canonical(header)` cut after each surface, in the order [`surfaces`] meets them.
+fn pieces(header: &Value) -> Vec<Vec<u8>> {
+    fn last(out: &mut [Vec<u8>]) -> &mut Vec<u8> {
+        out.last_mut().expect("a piece")
+    }
+    fn walk(v: &Value, out: &mut Vec<Vec<u8>>) {
+        match v {
+            Value::Object(m) if m.len() == 3 && ["default", "format", "tiles"].iter().all(|k| m.contains_key(*k)) => {
+                last(out).extend(playground_live::canonical(v));
+                out.push(Vec::new());
+            }
+            Value::Object(m) => {
+                last(out).push(b'{');
+                for (i, (key, v)) in m.iter().collect::<BTreeMap<_, _>>().into_iter().enumerate() {
+                    let piece = last(out);
+                    if i > 0 {
+                        piece.push(b',');
+                    }
+                    piece.extend(playground_live::canonical(&Value::String(key.clone())));
+                    piece.push(b':');
+                    walk(v, out);
+                }
+                last(out).push(b'}');
+            }
+            Value::Array(items) => {
+                last(out).push(b'[');
+                for (i, v) in items.iter().enumerate() {
+                    if i > 0 {
+                        last(out).push(b',');
+                    }
+                    walk(v, out);
+                }
+                last(out).push(b']');
+            }
+            scalar => last(out).extend(playground_live::canonical(scalar)),
+        }
+    }
+    let mut out = vec![Vec::new()];
+    walk(header, &mut out);
+    out
+}
+
+/// The canonical bytes of `parts` (see the module's layout).
+fn write(parts: &Parts) -> Result<Vec<u8>, String> {
+    let mut header = parts.doc.clone();
+    let mut sections = Vec::new();
+    surfaces(&mut header, &mut |tiles| {
+        let mut list = Vec::new();
+        for (key, hash) in tiles.as_object().ok_or_else(|| invalid("tiles"))? {
+            let (tx, ty) = coord(key)?;
+            list.push((ty, tx, hash.as_str().unwrap_or_default().to_owned()));
+        }
+        list.sort();
+        sections.push(list);
+        *tiles = Value::Array(Vec::new());
+        Ok(())
+    })?;
+    let json = pieces(&header);
+    let mut out = MAGIC.to_vec();
+    fn put(out: &mut Vec<u8>, bytes: &[u8]) {
+        out.extend((bytes.len() as u32).to_le_bytes());
+        out.extend(bytes);
+    }
+    let mut seen = HashSet::new();
+    for (piece, list) in json.iter().zip(sections) {
+        put(&mut out, piece);
+        out.extend((list.len() as u32).to_le_bytes());
+        for (ty, tx, hash) in list {
+            out.extend(tx.to_le_bytes());
+            out.extend(ty.to_le_bytes());
+            out.extend(hash_bytes(&hash)?);
+            let bytes = parts.tiles.get(&hash).ok_or_else(|| invalid(format!("tile {hash} missing")))?;
+            put(&mut out, if seen.insert(hash) { bytes } else { &[] });
+        }
+        if out.len() > MAX_BYTES {
+            return Err(too_large(out.len()));
+        }
+    }
+    put(&mut out, json.last().map_or(&[], Vec::as_slice));
+    out.extend(u32::MAX.to_le_bytes());
+    let mut named = HashSet::new();
+    hashes(&header, &mut named);
+    let blobs: BTreeMap<_, _> = parts.blobs.iter().filter(|(hash, _)| named.contains(*hash)).collect();
+    out.extend((blobs.len() as u32).to_le_bytes());
+    for (hash, bytes) in blobs {
+        out.extend(hash_bytes(hash)?);
+        put(&mut out, bytes);
+    }
+    if out.len() > MAX_BYTES { Err(too_large(out.len())) } else { Ok(out) }
+}
+
+struct Reader<'a> {
+    bytes: &'a [u8],
+    at: usize,
+}
+
+impl<'a> Reader<'a> {
+    fn take(&mut self, n: usize) -> Result<&'a [u8], String> {
+        let end = self.at.checked_add(n).filter(|end| *end <= self.bytes.len()).ok_or_else(|| invalid("truncated"))?;
+        let taken = &self.bytes[self.at..end];
+        self.at = end;
+        Ok(taken)
+    }
+    fn u32(&mut self) -> Result<u32, String> {
+        Ok(u32::from_le_bytes(self.take(4)?.try_into().map_err(invalid)?))
+    }
+    fn hash(&mut self) -> Result<String, String> {
+        Ok(self.take(32)?.iter().map(|b| format!("{b:02x}")).collect())
+    }
+}
+
+/// A canonical checkpoint taken apart; anything else is refused.
+fn decode(bytes: &[u8]) -> Result<Parts, String> {
+    if bytes.len() > MAX_BYTES {
+        return Err(too_large(bytes.len()));
+    }
+    let mut r = Reader { bytes, at: 0 };
+    if r.take(MAGIC.len())? != MAGIC {
+        return Err(invalid("not a PhotoCraft live document"));
+    }
+    let mut parts = Parts::default();
+    let (mut json, mut sections, mut seen) = (Vec::new(), Vec::new(), HashSet::new());
+    loop {
+        let n = r.u32()? as usize;
+        json.push(r.take(n)?);
+        let count = r.u32()?;
+        if count == u32::MAX {
+            break;
+        }
+        let mut map = Map::new();
+        let mut last = None;
+        for _ in 0..count {
+            let (tx, ty) = (r.u32()? as i32, r.u32()? as i32);
+            if last.is_some_and(|last| last >= (ty, tx)) {
+                return Err(invalid("tiles out of order"));
+            }
+            last = Some((ty, tx));
+            let hash = r.hash()?;
+            let n = r.u32()? as usize;
+            // A tile's bytes come with its first use only.
+            if (n > 0) != seen.insert(hash.clone()) {
+                return Err(invalid("tile bytes missing or repeated"));
+            }
+            if n > 0 {
+                parts.tiles.insert(hash.clone(), r.take(n)?.into());
+            }
+            map.insert(format!("{tx},{ty}"), hash.into());
+        }
+        sections.push(map);
+    }
+    let mut doc = playground_live::parse(&json.concat())?;
+    if pieces(&doc).iter().map(Vec::as_slice).ne(json.iter().copied()) {
+        return Err(invalid("noncanonical document"));
+    }
+    let ids: Option<Vec<u64>> =
+        doc.as_object().filter(|m| m.len() == 1).and_then(|m| m["documents"].as_array()).and_then(|d| d.iter().map(|d| d["id"].as_u64()).collect());
+    if !ids.is_some_and(|ids| ids.windows(2).all(|w| w[0] < w[1])) {
+        return Err(invalid("not a set of documents in id order"));
+    }
+    let mut named = HashSet::new();
+    hashes(&doc, &mut named);
+    let mut sections = sections.into_iter();
+    surfaces(&mut doc, &mut |tiles| {
+        if !tiles.as_array().is_some_and(Vec::is_empty) {
+            return Err(invalid("tiles inline"));
+        }
+        *tiles = Value::Object(sections.next().ok_or_else(|| invalid("tiles missing"))?);
+        Ok(())
+    })?;
+    let mut last = None;
+    for _ in 0..r.u32()? {
+        let hash = r.hash()?;
+        if last.as_ref().is_some_and(|last| *last >= hash) || !named.contains(&hash) {
+            return Err(invalid("blobs out of order or unused"));
+        }
+        let n = r.u32()? as usize;
+        parts.blobs.insert(hash.clone(), r.take(n)?.into());
+        last = Some(hash);
+    }
+    if r.at != bytes.len() {
+        return Err(invalid("trailing bytes"));
+    }
+    parts.doc = doc;
+    Ok(parts)
+}
+
+/// The largest layer, contents or document id `v` names.
+fn max_id(v: &Value) -> u64 {
+    match v {
+        Value::Object(m) => {
+            m.iter().map(|(k, v)| if matches!(k.as_str(), "id" | "contents_id") { v.as_u64().unwrap_or(0) } else { max_id(v) }).max().unwrap_or(0)
+        }
+        Value::Array(items) => items.iter().map(max_id).max().unwrap_or(0),
+        _ => 0,
+    }
+}
+
+/// A random 32-bit gap.
+fn gap() -> u64 {
+    #[cfg(target_arch = "wasm32")]
+    return (js_sys::Math::random() * (1u64 << 32) as f64) as u64;
+    #[cfg(not(target_arch = "wasm32"))]
+    {
+        use std::hash::BuildHasher as _;
+        std::collections::hash_map::RandomState::new().hash_one(0) >> 32
+    }
+}
+
+/// Ids stay unique across peers while connected: the process-wide id counter jumps a random gap past the ids of a
+/// document taken in (and at connect), so two people adding layers at once practically never pick the same id. The
+/// file loader then keeps every id.
+fn raise_ids(max: u64) {
+    if max >= LayerId::fresh().0 {
+        photocraft_doc::ensure_ids_above(max.saturating_add(gap()));
+    }
+}
+
+/// New pixels a document taken in may decode to, beyond the tiles decoded before: a small, highly compressible
+/// checkpoint must not take all the memory.
+const MAX_DECODED: u64 = 1 << 30;
+
+thread_local! {
+    /// The tiles of the document last loaded, decoded, and the compressed bytes they were checked from.
+    static DECODED: std::cell::RefCell<(photocraft_format::Tiles, HashMap<String, Rc<[u8]>>)> = Default::default();
+}
+
+/// The set's document `entry` (with its tiles and blobs in `parts`), through the `.pcraft` loader (which checks every
+/// tile against its hash). Tiles a load decoded before from the same bytes are reused, not decoded again. Views get
+/// placeholders: `Session::install_remote` puts the local ones back.
+fn document(entry: &Value, parts: &Parts) -> Result<Document, String> {
+    let mut doc = entry.clone();
+    surfaces(&mut doc, &mut |tiles| {
+        let mut list = Vec::new();
+        for (key, hash) in tiles.as_object().ok_or_else(|| invalid("tiles"))? {
+            let (tx, ty) = coord(key)?;
+            list.push(json!({"tx": tx, "ty": ty, "hash": hash}));
+        }
+        *tiles = Value::Array(list);
+        Ok(())
+    })?;
+    let Value::Object(m) = &mut doc else { return Err(invalid("not a document")) };
+    m.insert("id".into(), 0.into());
+    m.insert("selection".into(), Value::Null);
+    groups(&mut doc, true);
+    raise_ids(max_id(&doc));
+    let manifest = json!({"format_version": photocraft_format::FORMAT_VERSION, "generator": "", "document": doc});
+    struct Source<'a>(Vec<u8>, &'a Parts);
+    impl ByteSource for Source<'_> {
+        fn get(&self, path: &str, max: usize) -> photocraft_format::Result<Vec<u8>> {
+            let object = |prefix: &str, from: &HashMap<String, Rc<[u8]>>| path.strip_prefix(prefix)?.strip_suffix(".zst").and_then(|h| from.get(h).cloned());
+            let bytes = match path {
+                "manifest.json" => Some(self.0.as_slice().into()),
+                _ => object("tiles/", &self.1.tiles).or_else(|| object("blobs/", &self.1.blobs)),
+            };
+            let bytes = bytes.ok_or_else(|| FormatError::Corrupt(format!("missing `{path}`")))?;
+            if bytes.len() > max {
+                return Err(FormatError::LimitExceeded(format!("`{path}` exceeds {max} bytes")));
+            }
+            Ok(bytes.to_vec())
+        }
+    }
+    let manifest = serde_json::to_vec(&manifest).map_err(invalid)?;
+    let (mut tiles, checked) = DECODED.take();
+    tiles.values_mut().for_each(|tiles| tiles.retain(|hash, _| parts.tiles.get(hash).is_some_and(|bytes| checked.get(hash) == Some(bytes))));
+    let options = LoadOptions { max_total_bytes: MAX_DECODED, ..LoadOptions::default() };
+    let loaded = photocraft_format::load_reusing(&Source(manifest, parts), &options, &mut tiles).map_err(invalid)?;
+    DECODED.set((tiles, parts.tiles.clone()));
+    Ok(loaded)
+}
+
+/// Derived pixels (the renders of type, shapes and smart objects, a fill layer's cache) as one value each (`[cache]`),
+/// or back: the tiles of two renders must not mix.
+fn whole_caches(v: &mut Value, whole: bool) {
+    match v {
+        Value::Object(m) => m.iter_mut().for_each(|(key, v)| match (key.as_str(), &mut *v) {
+            ("cache" | "fill_cache", Value::Object(_)) if whole => *v = Value::Array(vec![v.take()]),
+            ("cache" | "fill_cache", Value::Array(cache)) if !whole => *v = cache.pop().unwrap_or_default(),
+            _ => whole_caches(v, whole),
+        }),
+        Value::Array(items) => items.iter_mut().for_each(|v| whole_caches(v, whole)),
+        _ => {}
+    }
+}
+
+/// The three-way merge of checkpoints: the set merges per document (by id: two opened at once are two), each document
+/// per field and per layer (by id), the pixels per surface tile (by hash), a derived cache as a whole; a value or tile
+/// both sides changed is a conflict, even to the same thing. `current` is the side not yet accepted, `edited` the
+/// accepted change. Each document that is neither side's is checked by loading it.
+fn merge(base: &[u8], current: &[u8], edited: &[u8]) -> Result<(Vec<u8>, Parts), String> {
+    let (mut base, mut current, mut edited) = (decode(base)?, decode(current)?, decode(edited)?);
+    [&mut base, &mut current, &mut edited].into_iter().for_each(|parts| whole_caches(&mut parts.doc, true));
+    let mut doc = playground_live::merge(&base.doc, &current.doc, &edited.doc, &[])?;
+    whole_caches(&mut doc, false);
+    [&mut current, &mut edited].into_iter().for_each(|parts| whole_caches(&mut parts.doc, false));
+    if let Some(docs) = doc["documents"].as_array_mut() {
+        docs.sort_by_key(|d| d["id"].as_u64());
+    }
+    let mut parts = Parts { doc, tiles: current.tiles, blobs: current.blobs };
+    parts.tiles.extend(edited.tiles);
+    parts.blobs.extend(edited.blobs);
+    let bytes = write(&parts)?;
+    let sides: HashSet<Vec<u8>> = [&current.doc, &edited.doc].into_iter().flat_map(|d| documents(d).map(|(_, d)| playground_live::canonical(d))).collect();
+    for (_, d) in documents(&parts.doc).filter(|(_, d)| !sides.contains(&playground_live::canonical(d))) {
+        document(d, &parts)?;
+    }
+    Ok((bytes, parts))
+}
+
+/// A remote change waiting for a quiet frame: `edited` relative to `base`, or with no base the whole document.
+struct Remote {
+    base: Option<Vec<u8>>,
+    edited: Vec<u8>,
+    done: Done,
+}
+
+/// Settles a remote change: a whole adopted document gives back the checkpoint it replaced, for the shell's draft.
+type Done = Box<dyn FnOnce(Result<Option<Vec<u8>>, String>)>;
+
+type Checkpoint = Result<Rc<Vec<u8>>, String>;
+
+/// A document of the session's set.
+struct Shared {
+    /// Its id in the set, the same for everyone.
+    uid: u64,
+    /// The open document showing it here; none once this person closed its tab (the others keep it).
+    local: Option<DocId>,
+    /// The document last encoded, and its part of the set ([`entry`]).
+    seen: Option<Arc<Document>>,
+    entry: Result<Rc<Parts>, String>,
+}
+
+/// A new document id for the set: random, so two people opening documents at once practically never pick the same one
+/// (52 bits, exact in JavaScript).
+fn uid() -> u64 {
+    ((gap() << 20) ^ gap()) & ((1 << 52) - 1)
+}
+
+#[derive(Default)]
+struct Live {
+    connected: bool,
+    /// The last frame was not quiet: a checkpoint now would catch a gesture half done.
+    busy: bool,
+    /// The session's documents.
+    docs: Vec<Shared>,
+    writer: PcraftWriter,
+    /// The set's checkpoint as last written.
+    encoded: Option<Checkpoint>,
+    /// The checkpoint last reported as changed.
+    reported: Option<Checkpoint>,
+    remote: VecDeque<Remote>,
+    #[cfg(test)]
+    changes: u64,
+    #[cfg(test)]
+    undos: Vec<bool>,
+    ctx: Option<egui::Context>,
+    #[cfg(target_arch = "wasm32")]
+    hooks: Option<web::Hooks>,
+    /// This person's presence as of the last frame, and the selection bounds it was computed from (by document).
+    presence: Value,
+    selection: Option<(std::sync::Weak<Document>, Value)>,
+}
+
+thread_local! {
+    static LIVE: std::cell::RefCell<Live> = std::cell::RefCell::default();
+}
+
+fn same(a: &Option<Checkpoint>, b: &Option<Checkpoint>) -> bool {
+    match (a, b) {
+        (Some(Ok(a)), Some(Ok(b))) => Rc::ptr_eq(a, b) || a == b,
+        _ => a == b,
+    }
+}
+
+/// The set's checkpoint: the documents open here (one opened since joins it), and those closed here as last known;
+/// `busy` until there is one. One that can't be shared (too large) makes it an error until it closes.
+fn shared(live: &mut Live, app: &PhotocraftApp) -> Checkpoint {
+    let open = app.session.documents();
+    let mut changed = live.encoded.is_none();
+    live.docs.retain_mut(|s| {
+        if s.local.is_some_and(|id| !open.iter().any(|st| st.doc.id == id)) {
+            s.local = None;
+            changed |= s.entry.is_err();
+        }
+        s.local.is_some() || s.entry.is_ok()
+    });
+    for st in open {
+        let i = match live.docs.iter().position(|s| s.local == Some(st.doc.id)) {
+            Some(i) => i,
+            None => {
+                live.docs.push(Shared { uid: uid(), local: Some(st.doc.id), seen: None, entry: Err(String::new()) });
+                live.docs.len() - 1
+            }
+        };
+        let s = &mut live.docs[i];
+        if s.seen.as_ref().is_some_and(|seen| Arc::ptr_eq(seen, &st.doc)) {
+            continue;
+        }
+        // A new selection or the like (personal views) shares nothing: no need to encode.
+        if s.seen.as_ref().is_none_or(|seen| !views_only(seen, &st.doc)) {
+            s.entry = entry(&mut live.writer, &st.doc, s.uid).map(Rc::new);
+            changed = true;
+        }
+        s.seen = Some(st.doc.clone());
+    }
+    if changed {
+        let entries: Result<Vec<_>, _> = live.docs.iter().map(|s| s.entry.clone()).collect();
+        live.encoded = Some(entries.and_then(|e| write(&set(e.iter().map(|e| &**e)))).map(Rc::new));
+    }
+    live.encoded.clone().filter(|_| !live.docs.is_empty()).unwrap_or_else(|| Err("busy".into()))
+}
+
+/// The set's documents closed here: their ids and names, for the Home screen's "In this session" (`peers`).
+#[cfg(target_arch = "wasm32")]
+fn closed(live: &Live) -> Vec<(u64, String)> {
+    let name = |s: &Shared| Some(s.entry.as_ref().ok()?.doc["name"].as_str()?.to_owned());
+    live.docs.iter().filter(|s| s.local.is_none()).filter_map(|s| Some((s.uid, name(s)?))).collect()
+}
+
+/// Opens the set's document `uid`, closed here, again as the document shown.
+#[cfg(target_arch = "wasm32")]
+fn reopen(app: &mut PhotocraftApp, uid: u64) {
+    let Some(entry) = LIVE.with_borrow(|live| live.docs.iter().find(|s| s.uid == uid && s.local.is_none())?.entry.clone().ok()) else { return };
+    let mut doc = match document(&entry.doc, &entry) {
+        Ok(doc) => doc,
+        Err(e) => return log::warn!("live editing: {e}"),
+    };
+    doc.id = DocId::fresh();
+    let i = app.session.add_document(doc, None);
+    let st = &app.session.documents()[i];
+    LIVE.with_borrow_mut(|live| {
+        if let Some(s) = live.docs.iter_mut().find(|s| s.uid == uid) {
+            (s.local, s.seen) = (Some(st.doc.id), Some(st.doc.clone()));
+        }
+    });
+}
+
+/// The set's id of open document `id`, while connected.
+fn uid_of(live: &Live, id: DocId) -> Option<u64> {
+    live.docs.iter().find(|s| s.local == Some(id)).map(|s| s.uid).filter(|_| live.connected)
+}
+
+/// Whether `a` and `b` differ in personal views only (tiles compare by pointer first).
+fn views_only(a: &Document, b: &Document) -> bool {
+    let mut b = b.clone();
+    photocraft_engine::Session::keep_views(&mut b, a);
+    *a == b
+}
+
+pub fn connect() {
+    LIVE.with_borrow_mut(|live| {
+        live.connected = true;
+        (live.docs, live.encoded, live.reported) = (Vec::new(), None, None);
+        if let Some(ctx) = &live.ctx {
+            ctx.request_repaint();
+        }
+    });
+    photocraft_doc::ensure_ids_above(LayerId::fresh().0.saturating_add(gap()));
+}
+
+/// Ends the session's hold on Undo; changes still waiting fail. Native Undo goes on from the current document: its
+/// steps since the last remote change hold no one else's edits.
+pub fn disconnect() {
+    let waiting = LIVE.with_borrow_mut(|live| {
+        live.connected = false;
+        (live.docs, live.encoded, live.reported) = (Vec::new(), None, None);
+        live.presence = Value::Null;
+        #[cfg(target_arch = "wasm32")]
+        {
+            live.hooks = None;
+        }
+        std::mem::take(&mut live.remote)
+    });
+    playground_live::presence::show(Vec::new());
+    for remote in waiting {
+        (remote.done)(Err("Live editing disconnected".into()));
+    }
+}
+
+fn queue(base: Option<Vec<u8>>, edited: Vec<u8>, done: Done) {
+    let refused = LIVE.with_borrow_mut(|live| {
+        if !live.connected {
+            return Some(done);
+        }
+        live.remote.push_back(Remote { base, edited, done });
+        if let Some(ctx) = &live.ctx {
+            ctx.request_repaint();
+        }
+        None
+    });
+    if let Some(done) = refused {
+        done(Err("Live editing is not connected".into()));
+    }
+}
+
+/// The canonical set of documents, unless the last frame was busy: then the next quiet frame reports it.
+fn checkpoint(app: &PhotocraftApp) -> Checkpoint {
+    LIVE.with_borrow_mut(|live| {
+        if live.busy {
+            live.reported = None;
+            return Err("busy".into());
+        }
+        shared(live, app)
+    })
+}
+
+/// The Undo hook (`photocraft_ui_egui::live`): while connected, Undo and Redo of the session's documents go to the
+/// session. Selection steps are personal, no session edits: Undo after one reverts this person's last shared edit and
+/// keeps the selection.
+pub fn undo(active: Option<DocId>, redo: Option<bool>) -> bool {
+    let taken = LIVE.with_borrow_mut(|live| {
+        let taken = active.and_then(|id| uid_of(live, id)).is_some();
+        #[cfg(test)]
+        if let (true, Some(redo)) = (taken, redo) {
+            live.undos.push(redo);
+        }
+        taken
+    });
+    #[cfg(target_arch = "wasm32")]
+    if let (true, Some(redo)) = (taken, redo) {
+        web::call(|hooks| &hooks.undo, &redo.into());
+    }
+    taken
+}
+
+/// Nothing under way that a remote change would cut short or a checkpoint would catch half done: no pointer down
+/// (strokes, drags), text field, live adjustment, IME composition or Type Mask, Free Transform, pen path, dialog or
+/// floating selection. Typing on the canvas is quiet between keystrokes: each one is an edit of the type layer, which
+/// the others then see as it is typed.
+fn quiet(app: &PhotocraftApp, ctx: &egui::Context) -> bool {
+    let ui = &app.ui;
+    !ctx.input(|i| i.pointer.any_down())
+        && !ctx.text_edit_focused()
+        && app.live_adjust.is_none()
+        && ui.text_edit.as_ref().is_none_or(|ed| !ed.mask && ed.preedit.is_none())
+        && (ui.type_transform.is_none() && ui.transform.is_none() && ui.cam_transform.is_none())
+        && (ui.pen.is_none() && ui.dialogs.is_empty())
+        && app.session.documents().iter().all(|st| st.floating.is_none())
+}
+
+/// The end of each frame: applies the remote changes waiting and reports a changed shared document, once quiet.
+pub fn frame(app: &mut PhotocraftApp, ctx: &egui::Context) {
+    let quiet = quiet(app, ctx);
+    let waiting = LIVE.with_borrow_mut(|live| {
+        live.ctx.get_or_insert_with(|| ctx.clone());
+        live.busy = !quiet;
+        if live.connected && quiet { std::mem::take(&mut live.remote) } else { VecDeque::new() }
+    });
+    for remote in waiting {
+        let result = apply(app, remote.base.as_deref(), &remote.edited);
+        (remote.done)(result);
+        ctx.request_repaint();
+    }
+    let changed = LIVE.with_borrow_mut(|live| {
+        if !live.connected {
+            return false;
+        }
+        // The set first, so a document opened this frame is in it for the presence.
+        let now = quiet.then(|| shared(live, app));
+        live.presence = presence(live, app, ctx);
+        if now.is_none() || same(&now, &live.reported) {
+            return false;
+        }
+        live.reported = now;
+        #[cfg(test)]
+        {
+            live.changes += 1;
+        }
+        true
+    });
+    #[cfg(target_arch = "wasm32")]
+    if changed {
+        web::call(|hooks| &hooks.changed, &wasm_bindgen::JsValue::NULL);
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    let _ = changed;
+}
+
+/// This person's presence: `{ "doc": <the document shown, by its id in the set>, "pointer": [x, y] }` in image pixels
+/// while it is over the canvas, `"layers"`: the targeted layers' ids (the active one first), `"selection": [x0, y0, x1,
+/// y1]`, the selection's bounds, when there is one, and the gesture under way ([`photocraft_ui_egui::live::gesture`]).
+/// Null while no document of the set is shown.
+fn presence(live: &mut Live, app: &PhotocraftApp, ctx: &egui::Context) -> Value {
+    let Some((st, uid)) = app.session.active().and_then(|st| Some((st, uid_of(live, st.doc.id)?))) else { return Value::Null };
+    let pointer = ctx.pointer_hover_pos().and_then(|p| photocraft_ui_egui::canvas::doc_point_at(app, p));
+    let mut state = photocraft_ui_egui::live::gesture(app, pointer);
+    state.insert("doc".into(), uid.into());
+    if let Some([x, y]) = pointer {
+        state.insert("pointer".into(), json!([(x * 10.0).round() / 10.0, (y * 10.0).round() / 10.0]));
+    }
+    let layers = st.active_layer.into_iter().chain(st.selected_layers.iter().copied().filter(|l| Some(*l) != st.active_layer));
+    state.insert("layers".into(), layers.take(50).map(|l| l.0).collect());
+    // The bounds scan the mask: once per selection.
+    let doc = Arc::downgrade(&st.doc);
+    if live.selection.as_ref().is_none_or(|(seen, _)| !seen.ptr_eq(&doc)) {
+        let b = st.doc.selection.as_ref().map(|s| s.content_bounds()).filter(|b| !b.is_empty());
+        live.selection = Some((doc, b.map_or(Value::Null, |b| json!([b.x0, b.y0, b.x1, b.y1]))));
+    }
+    if let Some((_, b)) = live.selection.as_ref().filter(|(_, b)| !b.is_null()) {
+        state.insert("selection".into(), b.clone());
+    }
+    Value::Object(state)
+}
+
+// The others on the shared document, drawn over its canvas.
+#[cfg(target_arch = "wasm32")]
+mod peers;
+#[cfg(target_arch = "wasm32")]
+pub use peers::draw as draw_presence;
+
+/// Merges `edited` (relative to `base`; without one, adopts it whole) into the session's documents, with no native undo
+/// step ([`install`]).
+fn apply(app: &mut PhotocraftApp, base: Option<&[u8]>, edited: &[u8]) -> Result<Option<Vec<u8>>, String> {
+    let current = LIVE.with_borrow_mut(|live| shared(live, app));
+    if current.as_ref().is_ok_and(|c| c.as_slice() == edited) {
+        return Ok(base.is_none().then(|| edited.to_vec()));
+    }
+    let (bytes, parts) = match base {
+        Some(base) => merge(base, current.as_ref()?, edited)?,
+        None => (edited.to_vec(), decode(edited)?),
+    };
+    install(app, &parts)?;
+    LIVE.with_borrow_mut(|live| {
+        live.encoded = Some(Ok(Rc::new(bytes)));
+        live.reported = live.encoded.clone();
+    });
+    // What a whole document replaces goes to the shell's drafts when it has a checkpoint (one too large has none).
+    Ok(if base.is_none() { current.ok().map(|c| c.to_vec()) } else { None })
+}
+
+/// Makes the session's documents those of `set`: each open one takes its new content (keeping this person's views), one
+/// someone else opened opens as a tab in the background, one closed here stays closed, and one no longer in the set
+/// (an open undone, another whole set adopted) closes. When the document shown closes, the set's first one shows.
+fn install(app: &mut PhotocraftApp, set: &Parts) -> Result<(), String> {
+    let shown = app.session.active().map(|st| st.doc.id);
+    // Every document that changed loads first: one that doesn't changes nothing.
+    let mut changed = Vec::new();
+    for (uid, doc) in documents(&set.doc) {
+        let known = LIVE.with_borrow(|live| live.docs.iter().find(|s| s.uid == uid).map(|s| (s.local, s.entry.as_ref().is_ok_and(|e| e.doc == *doc))));
+        let load = match known {
+            Some((_, true)) => continue,
+            Some((None, false)) => None,
+            Some((Some(id), false)) => Some((Some(id), document(doc, set)?)),
+            None => Some((None, document(doc, set)?)),
+        };
+        let mut named = HashSet::new();
+        hashes(doc, &mut named);
+        let only = |from: &HashMap<String, Rc<[u8]>>| from.iter().filter(|(h, _)| named.contains(*h)).map(|(h, b)| (h.clone(), b.clone())).collect();
+        changed.push((uid, Rc::new(Parts { doc: doc.clone(), tiles: only(&set.tiles), blobs: only(&set.blobs) }), load));
+    }
+    let gone: Vec<DocId> = LIVE.with_borrow_mut(|live| {
+        let kept = |s: &Shared| documents(&set.doc).any(|(uid, _)| uid == s.uid);
+        let gone = live.docs.iter().filter(|s| !kept(s)).filter_map(|s| s.local).collect();
+        live.docs.retain(kept);
+        gone
+    });
+    for (uid, entry, load) in changed {
+        let local = match load {
+            None => None,
+            Some((Some(id), doc)) => app.session.install_remote(id, doc).then_some(id),
+            Some((None, mut doc)) => {
+                doc.id = DocId::fresh();
+                let i = app.session.add_document(doc, None);
+                Some(app.session.documents()[i].doc.id)
+            }
+        };
+        let seen = local.and_then(|id| app.session.documents().iter().find(|st| st.doc.id == id)).map(|st| st.doc.clone());
+        LIVE.with_borrow_mut(|live| match live.docs.iter_mut().find(|s| s.uid == uid) {
+            Some(s) => (s.seen, s.entry) = (seen.or(s.seen.take()), Ok(entry)),
+            None => live.docs.push(Shared { uid, local, seen, entry: Ok(entry) }),
+        });
+    }
+    for id in gone {
+        if let Some(i) = app.session.documents().iter().position(|st| st.doc.id == id) {
+            app.session.close(i);
+        }
+    }
+    // No focus stolen: the document shown stays, unless it went.
+    let first = LIVE.with_borrow(|live| live.docs.iter().filter(|s| s.local.is_some()).min_by_key(|s| s.uid).and_then(|s| s.local));
+    let show = shown.filter(|id| app.session.documents().iter().any(|st| st.doc.id == *id)).or(first);
+    if let Some(i) = show.and_then(|id| app.session.documents().iter().position(|st| st.doc.id == id)) {
+        app.session.set_active(i);
+    }
+    Ok(())
+}
+
+/// The adapter object the Playground shell drives (`shell/live.js`): `format`, `checkpoint()` (throws `busy` while a
+/// gesture is under way), `merge(base, current, edited)`, `apply(base | null, edited)` (a promise settled at the next
+/// quiet frame; a whole adopted document resolves to the one it replaced), `connect({ changed, undo })`,
+/// `disconnect()`, `presence()` and `showPresence(others)`. The hooks are called from inside a frame: the shell defers
+/// its calls back.
+#[cfg(target_arch = "wasm32")]
+pub mod web {
+    use super::LIVE;
+    use js_sys::{Function, Object, Promise, Reflect, Uint8Array};
+    use photocraft_ui_egui::PhotocraftApp;
+    use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+    pub(super) struct Hooks {
+        pub(super) changed: Function,
+        pub(super) undo: Function,
+    }
+
+    pub(super) fn call(pick: impl FnOnce(&Hooks) -> &Function, arg: &JsValue) {
+        if let Some(hook) = LIVE.with_borrow(|live| live.hooks.as_ref().map(|hooks| pick(hooks).clone())) {
+            let _ = hook.call1(&JsValue::NULL, arg);
+        }
+    }
+
+    /// Offers the adapter as `globalThis.playgroundLiveAdapter`, and to `globalThis.playgroundLive.attach` when the
+    /// shell is there already. `with_app` runs a closure on the running app (false: it isn't running).
+    pub fn attach(with_app: impl Fn(&mut dyn FnMut(&PhotocraftApp)) -> bool + 'static) -> Result<(), JsValue> {
+        let adapter = Object::new();
+        let set = |name: &str, value: JsValue| Reflect::set(&adapter, &name.into(), &value).map(drop);
+        set("format", format!("photoshop:2:{}", env!("CARGO_PKG_VERSION")).into())?;
+        let checkpoint = move || -> Result<Uint8Array, JsValue> {
+            let mut bytes = None;
+            with_app(&mut |app| bytes = Some(super::checkpoint(app)));
+            // Not running yet, or inside a frame: the shell retries a busy checkpoint.
+            Ok(bytes.ok_or("busy")?.map_err(|e| JsValue::from_str(&e))?.as_slice().into())
+        };
+        set("checkpoint", Closure::<dyn Fn() -> _>::new(checkpoint).into_js_value())?;
+        let merge = |base: Uint8Array, current: Uint8Array, edited: Uint8Array| -> Result<Uint8Array, JsValue> {
+            let (merged, _) = super::merge(&base.to_vec(), &current.to_vec(), &edited.to_vec()).map_err(|e| JsValue::from_str(&e))?;
+            Ok(merged.as_slice().into())
+        };
+        set("merge", Closure::<dyn Fn(_, _, _) -> _>::new(merge).into_js_value())?;
+        let apply = |base: JsValue, edited: Uint8Array| -> Promise {
+            let mut job = Some((base.dyn_ref::<Uint8Array>().map(Uint8Array::to_vec), edited.to_vec()));
+            Promise::new(&mut |resolve, reject| {
+                let Some((base, edited)) = job.take() else { return };
+                super::queue(
+                    base,
+                    edited,
+                    Box::new(move |result| {
+                        let _ = match result {
+                            Ok(None) => resolve.call0(&JsValue::NULL),
+                            Ok(Some(replaced)) => resolve.call1(&JsValue::NULL, &Uint8Array::from(replaced.as_slice())),
+                            Err(e) => reject.call1(&JsValue::NULL, &JsValue::from_str(&e)),
+                        };
+                    }),
+                );
+            })
+        };
+        set("apply", Closure::<dyn Fn(_, _) -> _>::new(apply).into_js_value())?;
+        let connect = |hooks: JsValue| -> Result<(), JsValue> {
+            let get = |name: &str| Reflect::get(&hooks, &name.into())?.dyn_into::<Function>();
+            let hooks = Hooks { changed: get("changed")?, undo: get("undo")? };
+            LIVE.with_borrow_mut(|live| live.hooks = Some(hooks));
+            super::connect();
+            Ok(())
+        };
+        set("connect", Closure::<dyn Fn(_) -> _>::new(connect).into_js_value())?;
+        set("disconnect", Closure::<dyn Fn()>::new(super::disconnect).into_js_value())?;
+        let presence = || js_sys::JSON::parse(&LIVE.with_borrow(|live| live.presence.to_string()));
+        set("presence", Closure::<dyn Fn() -> _>::new(presence).into_js_value())?;
+        let show_presence = |others: JsValue| -> Result<(), JsValue> {
+            let others: String = js_sys::JSON::stringify(&others)?.into();
+            playground_live::presence::show(playground_live::Presence::list(&serde_json::from_str(&others).unwrap_or_default()));
+            LIVE.with_borrow(|live| live.ctx.as_ref().map(egui::Context::request_repaint));
+            Ok(())
+        };
+        set("showPresence", Closure::<dyn Fn(_) -> _>::new(show_presence).into_js_value())?;
+        photocraft_ui_egui::live::set_undo(super::undo);
+        let global = js_sys::global();
+        Reflect::set(&global, &"playgroundLiveAdapter".into(), &adapter)?;
+        let attach = Reflect::get(&global, &"playgroundLive".into())
+            .and_then(|live| Reflect::get(&live, &"attach".into()))
+            .ok()
+            .and_then(|attach| attach.dyn_into::<Function>().ok());
+        if let Some(attach) = attach {
+            attach.call1(&global, &adapter)?;
+        }
+        Ok(())
+    }
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    use photocraft_doc::{Color, ColorMode, Layer, PixelFormat, Rect, SampleType, Size, Surface};
+
+    /// A 1024×512 document: a white Background (8 tiles) and a layer painted over its left half.
+    fn doc() -> Document {
+        let mut d = Document::with_background("Untitled-1", Size::new(1024, 512), ColorMode::Rgb, SampleType::U8, Color::WHITE);
+        let mut layer = Layer::raster("Layer 1", d.pixel_format());
+        paint(&mut layer, Rect::from_xywh(0, 0, 512, 512), [0.2, 0.4, 0.6, 1.0]);
+        d.layers.push(layer);
+        d
+    }
+
+    fn paint(layer: &mut Layer, r: Rect, rgba: [f32; 4]) {
+        layer.surface_mut().unwrap().fill_rect(r, &rgba);
+    }
+
+    fn selection() -> Option<Surface> {
+        let mut selection = Surface::new(PixelFormat::GRAY8);
+        selection.fill_rect(Rect::from_xywh(10, 10, 50, 50), &[1.0]);
+        Some(selection)
+    }
+
+    /// The checkpoint of a set of `d` as document 1.
+    fn bytes(d: &Document) -> Vec<u8> {
+        set_of(&[(1, d)])
+    }
+
+    fn set_of(docs: &[(u64, &Document)]) -> Vec<u8> {
+        let entries: Vec<_> = docs.iter().map(|(uid, d)| entry(&mut PcraftWriter::new(), d, *uid).unwrap()).collect();
+        write(&set(entries.iter())).unwrap()
+    }
+
+    /// The first document of a set.
+    fn first_doc(set: &Parts) -> Document {
+        document(&set.doc["documents"][0], set).unwrap()
+    }
+
+    /// The bytes two checkpoints differ in, as the shell's delta sees them (between their common prefix and suffix).
+    fn delta(a: &[u8], b: &[u8]) -> usize {
+        let prefix = a.iter().zip(b).take_while(|(x, y)| x == y).count();
+        let suffix = a[prefix..].iter().rev().zip(b[prefix..].iter().rev()).take_while(|(x, y)| x == y).count();
+        b.len() - prefix - suffix
+    }
+
+    #[test]
+    fn checkpoints_are_canonical_local_and_leave_views_out() {
+        let d = doc();
+        let a = bytes(&d);
+        let mut viewed = d.clone();
+        viewed.id = DocId::fresh();
+        viewed.selection = selection();
+        viewed.measurement.ruler = Some(photocraft_doc::Ruler { start: [0.0, 0.0], end: [5.0, 5.0], protractor: None });
+        assert_eq!(bytes(&viewed), a, "views are not shared");
+        let loaded = first_doc(&decode(&a).unwrap());
+        assert_eq!(bytes(&loaded), a, "a loaded checkpoint encodes to the same bytes");
+        assert_eq!(loaded.layers[1].surface().unwrap().pixel(5, 5), d.layers[1].surface().unwrap().pixel(5, 5));
+        // A stroke within one tile of the top layer changes about that tile's bytes only.
+        let mut stroked = d.clone();
+        paint(&mut stroked.layers[1], Rect::from_xywh(300, 300, 40, 8), [1.0, 0.0, 0.0, 1.0]);
+        let b = bytes(&stroked);
+        let changed = delta(&a, &b);
+        eprintln!("checkpoint {} bytes, one-tile stroke changes {changed}", a.len());
+        assert!(changed < 2048, "{changed} of {} bytes", b.len());
+        // Typing on a type layer changes its text and its rendered cache: bytes close together, not a span over the
+        // pixels of every layer in between (here a tile of noise).
+        let mut noisy = d.clone();
+        let noise: Vec<u8> = (0u32..256 * 256 * 4).map(|i| (i.wrapping_mul(2_654_435_761) >> 24) as u8).collect();
+        noisy.layers[1].surface_mut().unwrap().write_interleaved(Rect::from_xywh(512, 0, 256, 256), &noise);
+        let typed = |text: &str| {
+            let mut cache = Surface::new(noisy.pixel_format());
+            cache.fill_rect(Rect::from_xywh(0, 300, 20 * text.len() as u32, 40), &[0.0, 0.0, 0.0, 1.0]);
+            let mut d = noisy.clone();
+            let text = photocraft_doc::TextLayer { text: text.into(), cache: Some(cache), ..Default::default() };
+            d.layers.push(Layer::new("Title", photocraft_doc::LayerContent::Text(text)));
+            bytes(&d)
+        };
+        let changed = delta(&typed("Sun"), &typed("Sunr"));
+        assert!(changed < 2048, "a keystroke changes {changed} bytes");
+        let changed = delta(&bytes(&noisy), &typed("S"));
+        assert!(changed < 4096, "a new type layer changes {changed} bytes");
+        assert!(decode(&b[..b.len() - 1]).is_err() && decode(&[b.as_slice(), &[0]].concat()).is_err());
+        assert!(decode(&vec![0; MAX_BYTES + 1]).is_err_and(|e| e.contains("over the 128 MiB limit")));
+    }
+
+    #[test]
+    fn merges_layers_fields_and_tiles_and_conflicts_on_a_tile_both_changed() {
+        let base = doc();
+        let (mut left, mut right) = (base.clone(), base.clone());
+        paint(&mut left.layers[1], Rect::from_xywh(10, 10, 20, 20), [1.0, 0.0, 0.0, 1.0]);
+        paint(&mut right.layers[0], Rect::from_xywh(900, 300, 20, 20), [0.0, 0.0, 1.0, 1.0]);
+        right.layers[1].opacity = 0.5;
+        let (merged, out) = merge(&bytes(&base), &bytes(&left), &bytes(&right)).unwrap();
+        let out = first_doc(&out);
+        assert_eq!(out.layers[1].surface().unwrap().pixel(15, 15), vec![1.0, 0.0, 0.0, 1.0]);
+        assert_eq!(out.layers[0].surface().unwrap().pixel(905, 305), vec![0.0, 0.0, 1.0, 1.0]);
+        assert_eq!(out.layers[1].opacity, 0.5);
+        assert_eq!(bytes(&out), merged);
+        let again = first_doc(&merge(&bytes(&base), &bytes(&left), &bytes(&right)).unwrap().1);
+        let tile = |d: &Document| d.layers[0].surface().unwrap().tiles().next().unwrap().1.clone();
+        assert!(Arc::ptr_eq(&tile(&out), &tile(&again)), "tiles decoded before are reused");
+        // The same tile changed on both sides is a conflict, even to the same pixels.
+        assert!(merge(&bytes(&base), &bytes(&left), &bytes(&left)).err().unwrap().contains("Conflict"));
+    }
+
+    #[test]
+    fn a_derived_cache_merges_as_a_whole() {
+        let mut base = doc();
+        let mut cache = Surface::new(base.pixel_format());
+        cache.fill_rect(Rect::from_xywh(0, 0, 100, 40), &[0.0, 0.0, 0.0, 1.0]);
+        let text = photocraft_doc::TextLayer { text: "a".into(), cache: Some(cache), ..Default::default() };
+        base.layers.push(Layer::new("a", photocraft_doc::LayerContent::Text(text)));
