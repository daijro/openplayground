@@ -0,0 +1,336 @@
+//! The others in a live session, drawn over the canvas of the document they are on in their colour after the app's own
+//! frame (`web/live_shell.rs`), so menus, dialogs and popups stay above them, and as dots on that document's tab. First
+//! the gestures they have under way ([`photocraft_ui_egui::live::gesture`]: a stroke at its brush width, a marquee's or
+//! lasso's rubber band, a ghost of what a Move drag or Free Transform has so far), then their selection bounds, then
+//! their pointers with a name tag. Presence arrives about ten times a second: each mark eases toward its person's latest
+//! state in document pixels, so this person's own scrolling and zooming never lags them. Their states come from other
+//! people: what doesn't read as numbers in range is skipped. The pointers, colours, easing, ghosts and selection bounds
+//! (turned with the view: [`presence::ghost_shape`], [`presence::outline_shape`]) are the playground-live crate's
+//! presence look (patches/live/kit); strokes and rubber bands are drawn here in its colours.
+
+use super::LIVE;
+use egui::{Color32, FontFamily, FontId, Pos2, Shape, Stroke, Vec2, pos2, vec2};
+use photocraft_ui_egui::canvas::ViewXform;
+use playground_live::{Presence, presence};
+use serde_json::Value;
+use std::cell::RefCell;
+use std::collections::HashMap;
+
+/// A point in document pixels.
+type P = [f32; 2];
+
+/// The most points of a remote path (twice what a presence carries).
+const MAX_POINTS: usize = 400;
+
+/// How far (along the path) the drawn end of a person's stroke or lasso trails its newest point: what came since the
+/// newest point drawn is drawn as it comes.
+#[derive(Default)]
+struct Trail {
+    tip: Option<P>,
+    behind: f32,
+}
+
+thread_local! {
+    static TRAILS: RefCell<HashMap<String, Trail>> = RefCell::default();
+}
+
+fn numbers<const N: usize>(v: &Value) -> Option<[f32; N]> {
+    points(v, N)?.as_flattened().try_into().ok()
+}
+
+/// `[x, y, …]` with at most `max` points, all in range.
+fn points(v: &Value, max: usize) -> Option<Vec<P>> {
+    let v = v.as_array().filter(|v| v.len() % 2 == 0 && v.len() <= 2 * max)?;
+    let n: Vec<f32> = v.iter().map(|n| n.as_f64().filter(|n| n.abs() < 1e7).map(|n| n as f32)).collect::<Option<_>>()?;
+    Some(n.chunks_exact(2).map(|p| [p[0], p[1]]).collect())
+}
+
+/// The four corners of the rectangle between `a` and `b`, clockwise from `a`.
+fn rect(a: P, b: P) -> [P; 4] {
+    [a, [b[0], a[1]], b, [a[0], b[1]]]
+}
+
+/// What a person's state shows, in document pixels: the ghost's four corners, a rubber band's two corners (and whether
+/// it is an ellipse), a path (a stroke's with its width, or a lasso's) and the pointer.
+struct Targets {
+    ghost: Option<[f32; 8]>,
+    band: Option<[f32; 4]>,
+    ellipse: bool,
+    path: Vec<P>,
+    width: Option<f32>,
+    pointer: Option<[f32; 2]>,
+}
+
+fn targets(state: &Value) -> Targets {
+    let stroke = &state["stroke"];
+    let width = stroke["size"].as_f64().filter(|s| (0.0..1e5).contains(s)).map(|s| s as f32);
+    let path = match width {
+        Some(_) => points(&stroke["points"], MAX_POINTS),
+        None => points(&state["lasso"], MAX_POINTS),
+    };
+    Targets {
+        ghost: numbers(&state["ghost"]),
+        band: numbers(&state["band"]),
+        ellipse: state["ellipse"] == true,
+        path: path.unwrap_or_default(),
+        width,
+        pointer: numbers(&state["pointer"]),
+    }
+}
+
+/// Person `who`'s mark `key` eased toward `to` (`[x, y, …]` in document pixels; [`presence::ease`]); a jump of more than
+/// `far` screen points goes at once.
+fn ease<const N: usize>(ctx: &egui::Context, xf: &ViewXform, who: &str, key: &str, to: Option<[f32; N]>, far: f32) -> Option<[f32; N]> {
+    let px = std::array::from_fn(|i| f64::from(if i % 2 == 0 { xf.zoom_x() } else { xf.zoom }));
+    Some(presence::ease(ctx, who, key, to?.map(f64::from), px, [f64::from(far); N])?.map(|v| v as f32))
+}
+
+impl Trail {
+    /// `k` of the way on toward `path`'s newest point; a trail of more than `far` screen points (`zoom` a pixel) goes at
+    /// once. Whether it still trails.
+    fn step(&mut self, path: &[P], k: f32, far: f32, zoom: f32) -> bool {
+        let tip = path.last().copied();
+        if tip != self.tip {
+            let since = self.tip.zip(tip).and_then(|(old, _)| from_end(path, old, 4.0 / zoom.max(1e-3)));
+            self.behind = since.map_or(0.0, |d| self.behind + d);
+            self.tip = tip;
+        }
+        self.behind *= 1.0 - k;
+        if self.behind * zoom < 0.5 || self.behind * zoom > far {
+            self.behind = 0.0;
+        }
+        self.behind > 0.0
+    }
+}
+
+fn dist(a: P, b: P) -> f32 {
+    (a[0] - b[0]).hypot(a[1] - b[1])
+}
+
+/// How far along `path` from `q` (within `tol` of it) to its newest end, searched from that end.
+fn from_end(path: &[P], q: P, tol: f32) -> Option<f32> {
+    let mut d = 0.0;
+    for w in path.windows(2).rev() {
+        let (a, b) = (w[0], w[1]);
+        let len = dist(a, b);
+        let t = if len > 0.0 { (((q[0] - a[0]) * (b[0] - a[0]) + (q[1] - a[1]) * (b[1] - a[1])) / (len * len)).clamp(0.0, 1.0) } else { 0.0 };
+        let on = [a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t];
+        if dist(on, q) <= tol {
+            return Some(d + len * (1.0 - t));
+        }
+        d += len;
+    }
+    None
+}
+
+/// `path` without its last `behind` pixels.
+fn cut(path: &[P], mut behind: f32) -> Vec<P> {
+    let mut end = path.len();
+    while behind > 0.0 && end > 1 {
+        let (a, b) = (path[end - 2], path[end - 1]);
+        let len = dist(a, b);
+        if behind < len {
+            let t = behind / len;
+            let mut kept = path[..end - 1].to_vec();
+            kept.push([b[0] + (a[0] - b[0]) * t, b[1] + (a[1] - b[1]) * t]);
+            return kept;
+        }
+        behind -= len;
+        end -= 1;
+    }
+    path[..end].to_vec()
+}
+
+/// A translucent stroke `w` wide along `path` (screen points), as one mesh so that no part of it covers another: round
+/// caps, mitred joins (at most twice as long), its edges feathered over `aa` points as egui feathers its own shapes.
+fn stroke(path: &[Pos2], w: f32, ink: Color32, aa: f32) -> Shape {
+    let mut pts: Vec<Pos2> = Vec::with_capacity(path.len());
+    for &p in path {
+        if pts.last().is_none_or(|q| q.distance(p) > 0.01) {
+            pts.push(p);
+        }
+    }
+    let n = pts.len();
+    let (inner, outer) = ((w - aa).max(0.0) / 2.0, (w + aa) / 2.0);
+    let clear = Color32::TRANSPARENT;
+    let dir = |i: usize| (pts[i + 1] - pts[i]).normalized();
+    let mut mesh = egui::Mesh::default();
+    // Per point, along its normal: the left edge's feather and inside, the right edge's inside and feather.
+    let normals: Vec<Vec2> = (0..n)
+        .map(|i| match i {
+            _ if n == 1 => Vec2::Y,
+            0 => dir(0).rot90(),
+            _ if i == n - 1 => dir(n - 2).rot90(),
+            _ => {
+                let (a, b) = (dir(i - 1).rot90(), dir(i).rot90());
+                let m = (a + b).normalized();
+                m / m.dot(a).max(0.5)
+            }
+        })
+        .collect();
+    for (p, normal) in pts.iter().zip(&normals) {
+        for (off, c) in [(outer, clear), (inner, ink), (-inner, ink), (-outer, clear)] {
+            mesh.colored_vertex(*p + *normal * off, c);
+        }
+    }
+    for a in (0..n.saturating_sub(1) as u32).map(|i| 4 * i) {
+        for k in 0..3 {
+            mesh.add_triangle(a + k, a + k + 1, a + 4 + k);
+            mesh.add_triangle(a + k + 1, a + 5 + k, a + 4 + k);
+        }
+    }
+    // Half a disc out of each end (a whole one around a single point), from the end's left edge to its right.
+    let mut cap = |i: usize, out: Vec2| {
+        let (p, left) = (pts[i], normals[i]);
+        let at = 4 * i as u32;
+        let centre = mesh.vertices.len() as u32;
+        mesh.colored_vertex(p, ink);
+        let (mut last_in, mut last_out) = (at + 1, at);
+        for k in 1..=12 {
+            let (sin, cos) = (std::f32::consts::PI * k as f32 / 12.0).sin_cos();
+            let (inside, edge) = match k {
+                12 => (at + 2, at + 3),
+                _ => {
+                    let u = left * cos + out * sin;
+                    let v = mesh.vertices.len() as u32;
+                    mesh.colored_vertex(p + u * inner, ink);
+                    mesh.colored_vertex(p + u * outer, clear);
+                    (v, v + 1)
+                }
+            };
+            mesh.add_triangle(centre, last_in, inside);
+            mesh.add_triangle(last_in, last_out, inside);
+            mesh.add_triangle(last_out, edge, inside);
+            (last_in, last_out) = (inside, edge);
+        }
+    };
+    match n {
+        0 => {}
+        1 => {
+            cap(0, Vec2::X);
+            cap(0, -Vec2::X);
+        }
+        _ => {
+            cap(0, -dir(0));
+            cap(n - 1, dir(n - 2));
+        }
+    }
+    Shape::mesh(mesh)
+}
+
+/// The others on each document tab: a dot each in their colour, stacked in the padding before its title (three at
+/// most).
+fn dots(app: &photocraft_ui_egui::PhotocraftApp, ui: &egui::Ui, live: &super::Live, others: &[Presence]) {
+    let edge = Stroke::new(1.0, Color32::from_black_alpha(90));
+    for (id, tab) in photocraft_ui_egui::live::tabs(app) {
+        let Some(uid) = super::uid_of(live, id) else { continue };
+        let on: Vec<_> = others.iter().filter(|p| p.state["doc"].as_u64() == Some(uid)).take(3).collect();
+        let painter = ui.painter().with_clip_rect(tab);
+        for (i, p) in on.iter().enumerate() {
+            let y = (i as f32 - (on.len() - 1) as f32 / 2.0) * 7.0;
+            painter.circle(pos2(tab.left() + 8.0, tab.center().y + y), 2.5, presence::color(p), edge);
+        }
+    }
+}
+
+/// The Home screen lists the session's documents closed here ("In this session"), one row each; a click opens it again.
+fn home(app: &mut photocraft_ui_egui::PhotocraftApp, ui: &egui::Ui) {
+    let n = app.session.documents().len();
+    let home = (n == 0 && app.session.prefs().general.auto_show_home_screen) || app.ui.chrome.home == Some(n);
+    let closed = LIVE.with_borrow(super::closed);
+    if !home || closed.is_empty() {
+        return;
+    }
+    let mut open = None;
+    // Under the Home screen's card, which is centred where the canvas was.
+    let at = app.last_canvas_rect.center() + vec2(0.0, 165.0);
+    egui::Area::new(egui::Id::new("live-session-documents")).fixed_pos(at).pivot(egui::Align2::CENTER_TOP).show(ui.ctx(), |ui| {
+        egui::Frame::popup(ui.style()).show(ui, |ui| {
+            ui.set_min_width(300.0);
+            ui.label(egui::RichText::new("In this session").strong());
+            for (uid, name) in &closed {
+                if ui.selectable_label(false, name).clicked() {
+                    open = Some(*uid);
+                }
+            }
+        });
+    });
+    if let Some(uid) = open {
+        super::reopen(app, uid);
+    }
+}
+
+/// Draws the others on the canvas of the document shown (those on it) and on the tabs, lists the session's documents
+/// closed here on the Home screen, and ends the presence look's frame ([`presence::end_frame`]: another frame while a
+/// mark is still on its way).
+pub fn draw(app: &mut photocraft_ui_egui::PhotocraftApp, ui: &egui::Ui) {
+    // Name tags in PhotoCraft's semibold, where its fonts have it.
+    let semibold = FontFamily::Name("semibold".into());
+    let semibold = ui.painter().fonts(|f| f.families().contains(&semibold)).then(|| FontId::new(12.0, semibold));
+    presence::set_font(semibold.unwrap_or_else(|| FontId::proportional(12.0)));
+    home(app, ui);
+    let app = &*app;
+    let others = presence::others();
+    LIVE.with_borrow(|live| {
+        dots(app, ui, live, &others);
+        TRAILS.with_borrow_mut(|trails| {
+            let here = app.session.active().and_then(|st| super::uid_of(live, st.doc.id));
+            let others: Vec<_> = others.iter().filter(|p| here.is_some() && p.state["doc"].as_u64() == here).collect();
+            trails.retain(|id, _| others.iter().any(|p| p.id == *id));
+            let Some(xf) = ViewXform::active(app).filter(|_| !others.is_empty()) else { return };
+            let ctx = ui.ctx();
+            let painter = ui.painter().with_clip_rect(xf.rect);
+            let k = 1.0 - (-ui.input(|i| i.stable_dt).clamp(0.0, 0.1) / presence::EASE as f32).exp();
+            let far = xf.rect.width().max(xf.rect.height()) / 4.0;
+            let screen = |p: &P| xf.to_screen(p[0], p[1]);
+            let (mut trailing, mut bounds, mut pointers) = (false, Vec::new(), Vec::new());
+            for p in &others {
+                let (t, color) = (targets(&p.state), presence::color(p));
+                let trail = trails.entry(p.id.clone()).or_default();
+                trailing |= trail.step(&t.path, k, far, xf.zoom);
+                if let Some(g) = ease(ctx, &xf, &p.id, "ghost", t.ghost, far) {
+                    let corners: Vec<Pos2> = g.chunks_exact(2).map(|c| xf.to_screen(c[0], c[1])).collect();
+                    presence::ghost_shape(&painter, &corners, color);
+                }
+                let band = match ease(ctx, &xf, &p.id, "band", t.band, far) {
+                    Some([x0, y0, x1, y1]) if t.ellipse => (0..=64)
+                        .map(|i| {
+                            let r = std::f32::consts::TAU * i as f32 / 64.0;
+                            let c = [(x0 + x1) / 2.0, (y0 + y1) / 2.0];
+                            screen(&[c[0] + (x1 - x0) / 2.0 * r.cos(), c[1] + (y1 - y0) / 2.0 * r.sin()])
+                        })
+                        .collect(),
+                    Some([x0, y0, x1, y1]) => rect([x0, y0], [x1, y1]).iter().chain([&[x0, y0]]).map(screen).collect(),
+                    None => Vec::new(),
+                };
+                let path: Vec<Pos2> = cut(&t.path, trail.behind).iter().map(screen).collect();
+                match t.width {
+                    Some(w) if !path.is_empty() => {
+                        let aa = 1.0 / painter.pixels_per_point();
+                        painter.add(stroke(&path, (w * xf.zoom).max(2.0), color.gamma_multiply(0.7), aa));
+                    }
+                    _ => painter.extend(Shape::dashed_line(&path, Stroke::new(1.5, color), 4.0, 3.0)),
+                }
+                painter.extend(Shape::dashed_line(&band, Stroke::new(1.5, color), 4.0, 3.0));
+                if let Some([x0, y0, x1, y1]) = numbers::<4>(&p.state["selection"]) {
+                    // On pixel edges: a 2-point line there stays crisp.
+                    let ppp = painter.pixels_per_point();
+                    let corners: Vec<Pos2> = rect([x0, y0], [x1, y1]).iter().map(|p| (screen(p).to_vec2() * ppp).round().to_pos2() / ppp).collect();
+                    bounds.push((corners, color));
+                }
+                pointers.extend(ease(ctx, &xf, &p.id, "pointer", t.pointer, far).map(|[x, y]| (screen(&[x, y]), *p)));
+            }
+            // Selection bounds over everyone's gestures, pointers over everything.
+            for (corners, color) in bounds {
+                presence::outline_shape(&painter, &corners, color);
+            }
+            for (at, p) in pointers.into_iter().filter(|(at, _)| xf.rect.contains(*at)) {
+                presence::cursor(&painter, at, presence::color(p), &p.name);
+            }
+            if trailing {
+                presence::keep_moving();
+            }
+        });
+    });
+    presence::end_frame(ui.ctx());
+}
