+//! Live editing in a Playground session (web; patches/photoshop/live.diff): loads that reuse the tiles an earlier load
+//! decoded, so taking in a shared document decodes only the tiles that changed. A child of `store` so it reaches the
+//! loader's byte source.
+
+use super::{ByteSource, LoadFetch, Loader, admit_canvas, read_manifest};
+use crate::manifest::Hash;
+use crate::{LoadOptions, Result};
+use photocraft_color::SampleType;
+use photocraft_doc::Document;
+use photocraft_raster::Tile;
+use std::collections::HashMap;
+use std::sync::Arc;
+
+/// Decoded tiles by sample type and content hash.
+pub type Tiles = HashMap<SampleType, HashMap<Hash, Arc<Tile>>>;
+
+/// Loads from any byte source like [`crate::load_bytes_source`], reusing `tiles` decoded before: those are not
+/// fetched or charged again (their sizes are still checked), and the tiles this load decodes are added.
+pub fn load_reusing(src: &dyn ByteSource, opts: &LoadOptions, tiles: &mut Tiles) -> Result<Document> {
+    let m = read_manifest(src, opts)?;
+    admit_canvas(m.document.size, opts)?;
+    let mut fetch = LoadFetch { src, opts: *opts, total: 0, blobs: HashMap::new() };
+    let mut loader = Loader {
+        fetch: &mut fetch,
+        preserve_ids: opts.preserve_ids,
+        id_map: HashMap::new(),
+        contents_id_map: HashMap::new(),
+        legacy_linked_contents: HashMap::new(),
+        tiles: std::mem::take(tiles),
+    };
+    let doc = loader.document(&m.document);
+    *tiles = loader.tiles;
+    doc
+}
diff --git a/crates/ui-egui/src/live.rs b/crates/ui-egui/src/live.rs
new file mode 100644
index 0000000..0d0a866
--- /dev/null
+++ b/crates/ui-egui/src/live.rs
@@ -0,0 +1,171 @@
+//! Live editing in a Playground session (web; patches/photoshop/live.diff): while the web crate's adapter
+//! (apps/photocraft-web/src/live.rs) is connected, Undo and Redo of the shared document go to the session, which
+//! reverts only this person's edits. Nothing here does anything until the adapter installs its hook. [`gesture`] reads
+//! the gesture under way for the adapter to show the others.
+
+use crate::PhotocraftApp;
+use crate::state::Tool;
+use photocraft_doc::{DocId, Document, LayerId, Rect};
+use serde_json::{Map, Value, json};
+use std::cell::{Cell, RefCell};
+use std::sync::{Arc, Weak};
+
+/// Whether the session takes Undo or Redo of the active document `active`; with `Some(redo)` it takes one.
+pub type UndoHook = fn(active: Option<DocId>, take: Option<bool>) -> bool;
+
+thread_local! {
+    static UNDO: Cell<Option<UndoHook>> = const { Cell::new(None) };
+}
+
+/// Installs the session's Undo hook.
+pub fn set_undo(hook: UndoHook) {
+    UNDO.set(Some(hook));
+}
+
+/// First in [`PhotocraftApp::run`] (with `take`) and `menus::is_enabled`: whether the session takes this Undo or Redo.
+/// Free Transform and a crop box keep their own steps.
+pub(crate) fn undo(app: &PhotocraftApp, id: &str, take: bool) -> bool {
+    let redo = match id {
+        "edit.undo" | "history.undo" => false,
+        "edit.redo" | "history.redo" => true,
+        _ => return false,
+    };
+    if crate::transform_tool::is_enabled(app, id).is_some() || crate::crop_ui::is_enabled(app, id).is_some() {
+        return false;
+    }
+    UNDO.get().is_some_and(|hook| hook(app.session.active().map(|st| st.doc.id), take.then_some(redo)))
+}
+
+/// The document tabs shown this frame: each one's document and rectangle.
+pub fn tabs(app: &PhotocraftApp) -> Vec<(DocId, egui::Rect)> {
+    let docs = app.session.documents();
+    let strip = app.tab_strip.as_ref().map(|s| s.tabs.as_slice()).unwrap_or_default();
+    strip.iter().filter_map(|&(i, r)| Some((docs.get(i)?.doc.id, r))).collect()
+}
+
+/// About this many characters of numbers at most in a stroke's or lasso's path, so a presence stays well under the
+/// shell's 4 KiB.
+const PATH_CHARS: usize = 2800;
+/// The most points of a path.
+const MAX_POINTS: usize = 200;
+
+/// `x` in tenths, short in JSON.
+fn num(x: f64) -> Value {
+    let x = (x.clamp(-1e7, 1e7) * 10.0).round() / 10.0;
+    if x.fract() == 0.0 { json!(x as i64) } else { json!(x) }
+}
+
+fn flat(points: &[[f64; 2]]) -> Value {
+    points.iter().flat_map(|p| [num(p[0]), num(p[1])]).collect()
+}
+
+/// `points` as `[x, y, …]`: none closer than `min` to the one kept before it (the last always kept), at most the newest
+/// [`MAX_POINTS`] and [`PATH_CHARS`].
+fn path(points: impl Iterator<Item = [f64; 2]>, min: f64) -> Value {
+    let mut kept: Vec<[f64; 2]> = Vec::new();
+    let mut last = None;
+    for p in points.filter(|p| p[0].is_finite() && p[1].is_finite()) {
+        if kept.last().is_none_or(|q| (p[0] - q[0]).hypot(p[1] - q[1]) >= min) {
+            kept.push(p);
+        }
+        last = Some(p);
+    }
+    if let Some(p) = last.filter(|p| kept.last() != Some(p)) {
+        kept.push(p);
+    }
+    let mut chars = 0;
+    let newest = kept.iter().rev().take(MAX_POINTS).take_while(|p| {
+        chars += num(p[0]).to_string().len() + num(p[1]).to_string().len() + 2;
+        chars <= PATH_CHARS
+    });
+    let from = kept.len() - newest.count();
+    flat(&kept[from..])
+}
+
+/// The four corners of `r` moved by `by`, clockwise from the top left.
+fn corners(r: Rect, by: (i32, i32)) -> Option<[[f64; 2]; 4]> {
+    let r = r.translate(by.0, by.1);
+    let [x0, y0, x1, y1] = [r.x0, r.y0, r.x1, r.y1].map(f64::from);
+    (!r.is_empty()).then_some([[x0, y0], [x1, y0], [x1, y1], [x0, y1]])
+}
+
+thread_local! {
+    /// The bounds a ghost last measured: in which document, of what (the moved layers; none: the selection).
+    static BOUNDS: RefCell<Option<(Weak<Document>, Vec<LayerId>, Option<Rect>)>> = const { RefCell::new(None) };
+}
+
+/// The bounds of `layers` in `doc` (none: of its selection), measured once per document and layers.
+fn bounds(doc: &Arc<Document>, layers: Vec<LayerId>) -> Option<Rect> {
+    BOUNDS.with_borrow_mut(|memo| {
+        if let Some((seen, of, b)) = memo.as_ref()
+            && seen.ptr_eq(&Arc::downgrade(doc))
+            && *of == layers
+        {
+            return *b;
+        }
+        let b = match layers.is_empty() {
+            true => doc.selection.as_ref().map(|s| s.content_bounds()),
+            false => (layers.iter().filter_map(|id| doc.layer(*id)))
+                .map(|l| photocraft_engine::transform_cmds::transform_bounds(doc, l))
+                .filter(|b| !b.is_empty())
+                .reduce(|a, b| a.union(&b)),
+        };
+        *memo = Some((Arc::downgrade(doc), layers, b));
+        b
+    })
+}
+
+/// The gesture under way on the active document, in its pixels, for the others to see as it happens:
+/// - `"stroke": {"size": diameter, "points": [x, y, …]}`: a painting stroke so far ([`path`]);
+/// - `"lasso": [x, y, …]`: a Lasso's or Polygonal Lasso's path, to the pointer (`pointer`);
+/// - `"band": [x0, y0, x1, y1]`, with `"ellipse": true` for the Elliptical Marquee: a marquee as it would select;
+/// - `"ghost": [x, y, …]`: where a Move drag (or a floating selection) has the layers or the selection so far, or the
+///   Free Transform box: four corners clockwise from the top left.
+///
+/// Read from the app's own gesture state; empty while nothing is under way.
+pub fn gesture(app: &PhotocraftApp, pointer: Option<[f64; 2]>) -> Map<String, Value> {
+    let mut out = Map::new();
+    let Some(st) = app.session.active() else { return out };
+    // The drawer's screen point, in document pixels: finer than that shows nothing.
+    let min = 1.0 / f64::from(app.point_zoom()).max(1e-3);
+    let selection = || crate::move_ui::floating_offset(app).or_else(|| crate::canvas::selection_drag_delta(app));
+    if let Some(t) = &app.ui.transform {
+        out.insert("ghost".into(), flat(&t.quad));
+    } else if !app.ui.polygon.is_empty() {
+        out.insert("lasso".into(), path(app.ui.polygon.iter().copied().chain(pointer), min));
+    } else if let Some(by) = selection() {
+        if let Some(c) = bounds(&st.doc, Vec::new()).and_then(|b| corners(b, by)) {
+            out.insert("ghost".into(), flat(&c));
+        }
+    } else if let Some(d) = &app.drag {
+        let end = d.points.last().map_or(d.start, |p| [p[0], p[1]]);
+        match d.tool {
+            t if t.is_brushlike() || crate::canvas::strokes_live(t) => {
+                let points = path(d.points.iter().map(|p| [p[0], p[1]]), min);
+                out.insert("stroke".into(), json!({"size": num(f64::from(app.session.tools.brush.size)), "points": points}));
+            }
+            Tool::Lasso => {
+                let to = d.lasso.as_ref().map(|l| l.cursor);
+                out.insert("lasso".into(), path(d.points.iter().map(|p| [p[0], p[1]]).chain(to), min));
+            }
+            Tool::RectMarquee | Tool::EllipseMarquee => {
+                if let Some(r) = crate::canvas::marquee_preview_px(&app.ui.tool_options, d, app.point_zoom()) {
+                    out.insert("band".into(), r.iter().map(|x| num(*x)).collect());
+                    if d.tool == Tool::EllipseMarquee {
+                        out.insert("ellipse".into(), true.into());
+                    }
+                }
+            }
+            Tool::Move => {
+                // Whole pixels, as the layers move (`move_ui`).
+                let by = ((end[0] - d.start[0]).round().clamp(-1e7, 1e7) as i32, (end[1] - d.start[1]).round().clamp(-1e7, 1e7) as i32);
+                let moved = photocraft_engine::layer_multi_cmds::move_targets(&st.doc, &st.selected_layers());
+                if let Some(c) = (!moved.is_empty()).then(|| bounds(&st.doc, moved)).flatten().and_then(|b| corners(b, by)) {
+                    out.insert("ghost".into(), flat(&c));
+                }
+            }
+            _ => {}
+        }
+    }
+    out
+}
