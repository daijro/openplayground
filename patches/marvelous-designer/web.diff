diff --git a/src/atelier/web.rs b/src/atelier/web.rs
new file mode 100644
index 0000000..206b383
--- /dev/null
+++ b/src/atelier/web.rs
@@ -0,0 +1,435 @@
+// SPDX-License-Identifier: MIT
+//! ClothCraft in the browser, for Playground (patches/marvelous-designer.yaml in github.com/daijro/openplayground): the
+//! desktop window on the page's canvas, and its files in Playground's Files.
+//!
+//! `cloth-fit` starts as on the desktop with the T-shirt and the mannequin ([`main`]); atelier.rs takes [`eframe`]
+//! from here on the web, whose `run_native` starts the app on the page. Files live in memory
+//! (clothcraft-playground's `std::fs`): a file from Files comes in at its path (`browser:/Garments/shirt.json` is
+//! `/Garments/shirt.json` here), and whatever ClothCraft writes outside `/tmp` (a saved garment and its `.assets`
+//! folder, an export) goes to Files after the frame. Open, Save and Save As, and the importers' Choose buttons, are
+//! Playground's dialogs ([`rfd`]); "Open in ClothCraft" and a file dropped on the page do what the matching menu item
+//! does with that file.
+use super::*;
+use clothcraft_playground::std::{self, fs};
+use std::cell::{OnceCell, RefCell};
+use std::path::Path;
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+/// The mannequin the desktop starts with (`--avatar`), in memory at the path the project names.
+const AVATAR: &str = "/assets/makehuman/mannequin.obj";
+/// Where the Export menu writes (and, with them, the project's files): this folder goes to Files, but the settings,
+/// workspace profiles and recovery snapshots ClothCraft keeps beside the export do not ([`mirrored`]).
+const OUTPUT: &str = "/ClothCraft/Export";
+/// Memory only: files from the computer or a drop, an imported avatar's staging folder, a save to download.
+const TMP: &str = "/tmp";
+const DOWNLOADS: &str = "/tmp/ClothCraft downloads";
+
+/// What a file is for.
+#[derive(Clone, Copy, PartialEq, Debug)]
+enum Kind {
+    Project,
+    Avatar,
+    Dxf,
+    Svg,
+}
+
+impl Kind {
+    fn of(extension: &str) -> Option<Self> {
+        Some(match extension {
+            "json" => Kind::Project,
+            "obj" | "gltf" | "glb" => Kind::Avatar,
+            "dxf" => Kind::Dxf,
+            "svg" => Kind::Svg,
+            _ => return None,
+        })
+    }
+    fn types(self) -> JsValue {
+        let types: &[&str] = match self {
+            Kind::Project => &["json"],
+            Kind::Avatar => &["obj", "gltf", "glb"],
+            Kind::Dxf => &["dxf"],
+            Kind::Svg => &["svg"],
+        };
+        types.iter().map(|t| JsValue::from(*t)).collect::<js_sys::Array>().into()
+    }
+}
+
+/// A dialog the app asked for this frame.
+enum Ask {
+    Open(Kind),
+    Save(String),
+}
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    static ASKED: RefCell<Option<Ask>> = const { RefCell::new(None) };
+    /// Files that came in (an answer to Open, "Open in ClothCraft", a drop), with what they were picked for.
+    static OPENED: RefCell<Vec<(PathBuf, Option<Kind>)>> = const { RefCell::new(Vec::new()) };
+    /// Where Save As… put the garment (and whether it is a download), for the next frame.
+    static SAVED: RefCell<Vec<(PathBuf, bool)>> = const { RefCell::new(Vec::new()) };
+}
+
+fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+/// The desktop's eframe, with `run_native` starting the app on the page instead.
+pub(crate) mod eframe {
+    pub use ::eframe::*;
+
+    /// The desktop window's options, which a page has no use for.
+    #[derive(Default)]
+    #[allow(dead_code)]
+    pub struct NativeOptions {
+        pub viewport: egui::ViewportBuilder,
+        pub wgpu_options: egui_wgpu::WgpuConfiguration,
+        pub renderer: Renderer,
+    }
+
+    /// Starts the app on the page's canvas, made by `creator` once the page's context exists; returns at once.
+    pub fn run_native(_name: &str, _options: NativeOptions, creator: super::Creator) -> ::eframe::Result {
+        super::start(creator)
+    }
+}
+
+/// The desktop's file dialogs: on the web they ask Playground's after the frame ([`Web::after`]) and give nothing now.
+pub(crate) mod rfd {
+    use std::path::{Path, PathBuf};
+
+    #[derive(Default)]
+    pub struct FileDialog {
+        extensions: Vec<String>,
+        title: String,
+        name: Option<String>,
+    }
+
+    impl FileDialog {
+        pub fn new() -> Self {
+            Self::default()
+        }
+        pub fn add_filter(mut self, _name: impl Into<String>, extensions: &[impl ToString]) -> Self {
+            self.extensions.extend(extensions.iter().map(ToString::to_string));
+            self
+        }
+        pub fn set_title(mut self, title: impl Into<String>) -> Self {
+            self.title = title.into();
+            self
+        }
+        pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+            self.name = Some(name.into());
+            self
+        }
+        pub fn set_directory(self, _dir: impl AsRef<Path>) -> Self {
+            self
+        }
+        pub fn pick_file(self) -> Option<PathBuf> {
+            // Not here: the recovery snapshots (there are none on a page), native garment templates and the relink of a
+            // missing avatar.
+            let skipped = ["recovery", "template", "Locate"].iter().any(|s| self.title.contains(s));
+            let kind = self.extensions.first().and_then(|e| super::Kind::of(e));
+            if let (false, Some(kind)) = (skipped, kind) {
+                super::ASKED.set(Some(super::Ask::Open(kind)));
+            }
+            None
+        }
+        pub fn save_file(self) -> Option<PathBuf> {
+            super::ASKED.set(Some(super::Ask::Save(self.name.unwrap_or_else(|| "garment.clothcraft.json".into()))));
+            None
+        }
+    }
+
+    #[derive(Clone, Copy, PartialEq)]
+    pub enum MessageButtons {
+        YesNo,
+        YesNoCancel,
+    }
+
+    #[derive(Clone, Copy, PartialEq, Debug)]
+    pub enum MessageDialogResult {
+        Yes,
+        No,
+        Cancel,
+    }
+
+    pub struct MessageDialog {
+        title: String,
+    }
+
+    impl MessageDialog {
+        pub fn new() -> Self {
+            Self { title: String::new() }
+        }
+        pub fn set_title(mut self, title: impl Into<String>) -> Self {
+            self.title = title.into();
+            self
+        }
+        pub fn set_description(self, _text: impl Into<String>) -> Self {
+            self
+        }
+        pub fn set_buttons(self, _buttons: MessageButtons) -> Self {
+            self
+        }
+        /// The unsaved-changes question, as the browser's own: OK throws the changes away and goes on, Cancel stays (Save
+        /// is in the menu; a page can't wait for a three-way answer).
+        pub fn show(self) -> MessageDialogResult {
+            let text = format!("{}\n\nOK discards the changes and continues. Cancel stays here, to Save first.", self.title);
+            match web_sys::window().and_then(|w| w.confirm_with_message(&text).ok()) {
+                Some(true) => MessageDialogResult::No,
+                _ => MessageDialogResult::Cancel,
+            }
+        }
+    }
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(pairs: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in pairs {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn extension(path: &Path) -> String {
+    path.extension().and_then(|e| e.to_str()).unwrap_or_default().to_ascii_lowercase()
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory at its path (one from the computer goes to `/tmp`), and for
+/// a garment its avatar, from the `.assets` folder beside it.
+async fn bring_in(file: JsValue) -> Option<PathBuf> {
+    let name = get(&file, "name").as_string()?;
+    let from = get(&file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from));
+    let file_name = Path::new(&name).file_name()?;
+    let path = from.clone().unwrap_or_else(|| Path::new(TMP).join(file_name));
+    let bytes = js_sys::Uint8Array::new(&get(&file, "bytes")).to_vec();
+    if let (Some(from), "json") = (&from, extension(&path).as_str()) {
+        let avatar = serde_json::from_slice::<serde_json::Value>(&bytes).ok().and_then(|j| j["avatar_path"].as_str().map(PathBuf::from));
+        if let (Some(avatar), Some(dir)) = (avatar.filter(|a| a.is_relative()), from.parent()) {
+            let target = dir.join(&avatar);
+            let read = call("read", &[format!("browser:{}", target.display()).into()]);
+            if let Some(avatar) = wait(read).await {
+                fs::put(&target, js_sys::Uint8Array::new(&avatar).to_vec());
+            }
+        }
+    }
+    fs::put(&path, bytes);
+    Some(path)
+}
+
+fn opened(file: JsValue, kind: Option<Kind>) {
+    wasm_bindgen_futures::spawn_local(async move {
+        if let Some(path) = bring_in(file).await {
+            OPENED.with_borrow_mut(|o| o.push((path, kind)));
+            repaint();
+        }
+    });
+}
+
+/// Whether a changed file belongs in Files: the export and the garments, not the settings ClothCraft keeps beside the
+/// export.
+fn mirrored(p: &Path) -> bool {
+    let name = p.file_name().and_then(|n| n.to_str()).unwrap_or_default();
+    !p.starts_with(TMP) && !name.starts_with("recovery-") && !["preferences.json", "presentation.json", "workspace-profiles.json"].contains(&name)
+}
+
+/// The page's app: the window, then what it asked of the page.
+pub(crate) struct Web {
+    app: Atelier,
+    unsaved: bool,
+}
+
+impl Web {
+    /// After the window's frame: files that came in, the dialogs it asked for, and what it wrote.
+    fn after(&mut self, ctx: &egui::Context) {
+        for (path, kind) in OPENED.take() {
+            // A dialog's answer comes after the importer or the unsaved-changes question the menu item began with;
+            // a file from Files' "Open in" or a drop begins it here.
+            let asked = kind.is_some();
+            let Some(kind) = kind.or_else(|| Kind::of(&extension(&path))) else {
+                self.app.status = format!("{} is not a garment, an avatar or a pattern outline", path.display());
+                continue;
+            };
+            let app = &mut self.app;
+            match kind {
+                Kind::Project => {
+                    if !asked && !app.can_replace_document(ctx) {
+                        continue;
+                    }
+                    app.open_document_path(path.clone(), false);
+                    // A file from the computer has no place in Files: Save asks where.
+                    if path.starts_with(TMP) {
+                        app.document.path = None;
+                    }
+                }
+                Kind::Avatar => {
+                    if !asked {
+                        app.open_avatar_import(ctx);
+                    }
+                    app.document.avatar_import.choose(&path);
+                }
+                Kind::Dxf => {
+                    if !asked {
+                        app.open_pattern_import();
+                    }
+                    app.document.pattern_import.choose(&path);
+                }
+                Kind::Svg => {
+                    if !asked {
+                        app.open_svg_import();
+                    }
+                    app.document.svg_import.choose(&path);
+                }
+            }
+        }
+        for (path, download) in SAVED.take() {
+            self.app.document.path = Some(path);
+            // "Download to device": written in memory first, then handed to the browser (below); the next Save asks again.
+            if self.app.save_document(ctx, false) && download {
+                self.app.document.path = None;
+            }
+        }
+        match ASKED.take() {
+            Some(Ask::Open(kind)) => {
+                let asked = call("open", &[options(&[("types", kind.types())])]);
+                wasm_bindgen_futures::spawn_local(async move {
+                    if let Some(file) = wait(asked).await.and_then(|p| js_sys::Array::from(&p).iter().next()) {
+                        opened(file, Some(kind));
+                    }
+                });
+            }
+            Some(Ask::Save(name)) => {
+                let asked = call("saveAs", &[options(&[("name", name.as_str().into()), ("types", Kind::Project.types())])]);
+                wasm_bindgen_futures::spawn_local(async move {
+                    let Some(answer) = wait(asked).await else { return };
+                    let (path, download) = match get(&answer, "path").as_string() {
+                        Some(p) => (p.strip_prefix("browser:").map(PathBuf::from), false),
+                        None => (Some(Path::new(DOWNLOADS).join(&name)), true),
+                    };
+                    if let Some(mut path) = path {
+                        if path.extension().is_none() {
+                            path.set_extension("json");
+                        }
+                        SAVED.with_borrow_mut(|s| s.push((path, download)));
+                        repaint();
+                    }
+                });
+            }
+            None => {}
+        }
+        for p in fs::changes() {
+            if p.starts_with(DOWNLOADS) {
+                if let (Ok(bytes), Some(name)) = (fs::read(&p), p.file_name()) {
+                    call("download", &[name.to_string_lossy().as_ref().into(), js_sys::Uint8Array::from(bytes.as_slice()).into()]);
+                    let _ = fs::remove_file(&p);
+                    fs::changes();
+                }
+            } else if mirrored(&p) {
+                let target = JsValue::from(format!("browser:{}", p.display()));
+                if fs::is_file(&p) {
+                    call("write", &[target, js_sys::Uint8Array::from(fs::read(&p).unwrap_or_default().as_slice()).into()]);
+                } else if !fs::exists(&p) {
+                    call("remove", &[target]);
+                }
+            }
+        }
+        if self.unsaved != self.app.document.dirty {
+            self.unsaved = self.app.document.dirty;
+            call("setUnsaved", &[self.unsaved.into()]);
+        }
+    }
+}
+
+impl ::eframe::App for Web {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        ::eframe::App::raw_input_hook(&mut self.app, ctx, raw_input);
+        // A dropped file is only a name on the web: its bytes are read, then it is handled as "Open in ClothCraft" is.
+        for f in std::mem::take(&mut raw_input.dropped_files) {
+            wasm_bindgen_futures::spawn_local(async move {
+                if let (Ok(bytes), Some(name)) = (f.bytes_async().await, f.path().file_name()) {
+                    let path = Path::new(TMP).join("ClothCraft dropped").join(name);
+                    fs::put(&path, bytes);
+                    OPENED.with_borrow_mut(|o| o.push((path, None)));
+                    repaint();
+                }
+            });
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut ::eframe::Frame) {
+        // The simulation's turn on the page's one thread (see worker_web.rs), before the frame reads its result.
+        super::super::worker::pump();
+        ::eframe::App::ui(&mut self.app, ui, frame);
+        self.after(ui.ctx());
+        // A link opens in a new tab, as the desktop opens the browser, rather than replacing the app.
+        ui.ctx().output_mut(|o| {
+            for command in &mut o.commands {
+                if let egui::OutputCommand::OpenUrl(url) = command {
+                    url.new_tab = true;
+                }
+            }
+        });
+    }
+}
+
+/// The desktop's app creator, as atelier.rs's `run` hands it over (a `Box<Atelier>`, not eframe's `dyn App`).
+pub(crate) type Creator = Box<dyn FnOnce(&::eframe::CreationContext<'_>) -> Result<Box<Atelier>, DynError>>;
+type DynError = Box<dyn std::error::Error + Send + Sync>;
+
+/// [`eframe::run_native`] on the web: the app is made by the desktop's creator against the page's context, so the
+/// services it starts wake the page.
+fn start(creator: Creator) -> ::eframe::Result {
+    call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(|file| opened(file, None)).into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("clothcraft_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #clothcraft_canvas");
+        let creator = move |cc: &::eframe::CreationContext<'_>| -> Result<Box<dyn ::eframe::App>, DynError> {
+            CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+            let mut app = *creator(cc)?;
+            // The T-shirt it starts with is nobody's work yet (the desktop has it unsaved, which would ask before an
+            // "Open in ClothCraft" replaced it, and before the page was left).
+            app.document.dirty = false;
+            Ok(Box::new(Web { app, unsaved: false }))
+        };
+        let runner = ::eframe::WebRunner::new();
+        let started = runner.start(canvas, ::eframe::WebOptions::default(), Box::new(creator)).await;
+        // The runner lives as long as the page.
+        std::mem::forget(runner);
+        if let Some(loading) = document.get_element_by_id("clothcraft_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("ClothCraft could not start: {e:?}"))),
+            }
+        }
+    });
+    Ok(())
+}
+
+/// `cloth-fit --steps 0 --view` on the page: the T-shirt on the mannequin, in the editor.
+pub fn main() {
+    std::panic::set_hook(Box::new(|info| web_sys::console::error_1(&format!("ClothCraft: {info}").into())));
+    fs::put(Path::new(AVATAR), include_bytes!("../../assets/makehuman/mannequin.obj").to_vec());
+    let project = FittingProject::basic(GarmentKind::Tshirt, 2, PathBuf::from(AVATAR));
+    let scene = project.compile().expect("the T-shirt does not compile");
+    let files = super::super::DocumentFiles { output: PathBuf::from(OUTPUT), source: None, modified: false };
+    if let Err(e) = super::super::run(project, scene, files, false, false, false, false) {
+        web_sys::console::error_1(&format!("ClothCraft: {e}").into());
+    }
+}
