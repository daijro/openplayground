+// SPDX-License-Identifier: MIT
+//! The simulation worker in Playground's browser build (patches/marvelous-designer.yaml in github.com/daijro/openplayground),
+//! without its thread: a page has one. `start` makes the same channel and result slot, and [`pump`] (the page calls it
+//! before every frame) is one turn of the thread's loop, run in place: the work sent since the last frame is taken, and
+//! if a step is due it is solved on the page's one thread (Rayon runs there too) and published for the frame. Steps
+//! use the CPU solver: the GPU one reads its results back with a blocking `device.poll`, which a page can't do, and
+//! WebGL2 has no compute shaders at all.
+use super::*;
+use clothcraft_playground::std::{self, cell::RefCell};
+
+struct Pump {
+    rx: mpsc::Receiver<Work>,
+    output: Latest,
+    cache: Option<(u64, VbdSolver)>,
+    active: Option<Work>,
+    deadline: Instant,
+}
+
+thread_local! {
+    static PUMP: RefCell<Option<Pump>> = const { RefCell::new(None) };
+}
+
+pub(crate) fn start(
+    _device: wgpu::Device,
+    _queue: wgpu::Queue,
+) -> Result<(mpsc::Sender<Work>, Latest), std::io::Error> {
+    let (tx, rx) = mpsc::channel::<Work>();
+    let latest: Latest = Arc::new(Mutex::new(None));
+    PUMP.set(Some(Pump {
+        rx,
+        output: latest.clone(),
+        cache: None,
+        active: None,
+        deadline: Instant::now(),
+    }));
+    Ok((tx, latest))
+}
+
+/// One turn of the worker's loop: take the work sent, and solve a step if one is due.
+pub(crate) fn pump() {
+    PUMP.with_borrow_mut(|pump| {
+        if let Some(pump) = pump {
+            pump.turn();
+        }
+    });
+}
+
+impl Pump {
+    fn turn(&mut self) {
+        while let Ok(w) = self.rx.try_recv() {
+            accept(&mut self.active, w, &mut self.deadline);
+        }
+        let Some(w) = &mut self.active else { return };
+        if !w.once && (!w.playing || Instant::now() < self.deadline) {
+            return;
+        }
+        let request = take_final_diagnostics_request(w.generation);
+        if request.is_some() {
+            clear_final_diagnostics();
+        }
+        let previous = request.map(|_| w.scene.state.clone());
+        w.once = false;
+        let cache = &mut self.cache;
+        let result: Result<(State, VbdMetrics), String> = (|| {
+            if cache.as_ref().is_none_or(|(g, _)| *g != w.generation) {
+                *cache = Some((
+                    w.generation,
+                    VbdSolver::new(
+                        w.scene.garment.clone(),
+                        Some(&w.scene.collider.surface),
+                        &w.scene.state,
+                    )?,
+                ));
+                clear_final_diagnostics();
+            }
+            let solver = &mut cache.as_mut().unwrap().1;
+            let metrics = solver.step(&mut w.scene.state, &w.settings, w.grab.as_ref())?;
+            if let (Some(request), Some(previous)) = (request, previous) {
+                match solver.sample_final_diagnostics(
+                    &previous,
+                    &w.scene.state,
+                    &w.settings,
+                    w.grab.as_ref(),
+                    FinalDiagnosticsBackend::Cpu,
+                ) {
+                    Ok(sample) => {
+                        *FINAL_DIAGNOSTICS.lock().unwrap() = Some(FinalDiagnosticsResult { request, sample });
+                        *FINAL_DIAGNOSTICS_ERROR.lock().unwrap() = None;
+                    }
+                    Err(message) => {
+                        *FINAL_DIAGNOSTICS.lock().unwrap() = None;
+                        *FINAL_DIAGNOSTICS_ERROR.lock().unwrap() = Some(FinalDiagnosticsFailure { request, message });
+                    }
+                }
+            }
+            Ok((w.scene.state.clone(), metrics))
+        })();
+        if let Err(error) = &result {
+            if let Some(request) = request {
+                *FINAL_DIAGNOSTICS.lock().unwrap() = None;
+                *FINAL_DIAGNOSTICS_ERROR.lock().unwrap() =
+                    Some(FinalDiagnosticsFailure { request, message: error.clone() });
+            }
+            w.playing = false;
+        }
+        let mut slot = self.output.lock().unwrap();
+        let had_grab = w.grab.is_some()
+            || slot.as_ref().is_some_and(|d| d.generation == w.generation && d.had_grab);
+        *slot = Some(Done { generation: w.generation, had_grab, result });
+        drop(slot);
+        w.ctx.request_repaint();
+        let dt = Duration::from_secs_f64(w.settings.dt);
+        self.deadline = (self.deadline + dt).max(Instant::now() - dt * 4);
+    }
+}
