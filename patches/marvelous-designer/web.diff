+# Playground's browser build of ClothCraft (patches/marvelous-designer.yaml in github.com/daijro/openplayground): std's
+# clock, files and process id as wasm32-unknown-unknown can have them, and a temporary folder. Native builds compile it
+# empty.
+[package]
+name = "clothcraft-playground"
+version = "0.1.0"
+edition = "2024"
+description = "ClothCraft in the browser: the clock, files and temporary folders std lacks on wasm32-unknown-unknown"
+license = "MIT"
+publish = false
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+web-time = "1"
diff --git a/clothcraft-playground/src/lib.rs b/clothcraft-playground/src/lib.rs
