index 0000000..049b307
--- /dev/null
+++ b/clothcraft-playground/src/lib.rs
@@ -0,0 +1,263 @@
+// SPDX-License-Identifier: MIT
+//! ClothCraft in the browser, for Playground (patches/marvelous-designer.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock, no files and no process: `Instant::now` and `SystemTime::now` panic there,
+//! every file call fails and `process::id` panics. The modules that use them take `std` from here instead, through one
+//! `#[cfg(target_arch = "wasm32")] use clothcraft_playground::std;` line at each one's end (a local `std` shadows the
+//! standard library's name in that module; everything else in it still comes from the real std):
+//!   time     web-time's Instant and SystemTime;
+//!   fs       an in-memory file system (garments, avatars, exports, settings), each change noted for the page to mirror
+//!            to Playground's Files;
+//!   process  `id` is 1.
+//! And [`tempfile`]: the temporary folder an imported avatar is staged in, in memory.
+#![cfg(target_arch = "wasm32")]
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+    }
+
+    pub mod process {
+        pub use ::std::process::*;
+
+        /// The page is one process (std's panics on wasm).
+        pub fn id() -> u32 {
+            1
+        }
+    }
+
+    pub mod fs {
+        // What isn't here (OpenOptions, metadata, ...) is std's, which fails on a page.
+        pub use ::std::fs::*;
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io::{self, Cursor, Read, Write};
+        use ::std::path::{Component, Path, PathBuf};
+
+        enum Entry {
+            Dir,
+            File(Vec<u8>),
+        }
+
+        #[derive(Default)]
+        struct Tree {
+            entries: BTreeMap<PathBuf, Entry>,
+            /// Paths written, created or removed since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+        }
+
+        thread_local! {
+            static TREE: RefCell<Tree> = RefCell::default();
+        }
+
+        fn with<T>(f: impl FnOnce(&mut Tree) -> T) -> T {
+            TREE.with(|t| f(&mut t.borrow_mut()))
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        pub fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} does not exist", p.display()))
+        }
+
+        impl Tree {
+            fn parents(&mut self, p: &Path) {
+                for dir in p.ancestors().skip(1) {
+                    self.entries.entry(dir.to_path_buf()).or_insert(Entry::Dir);
+                }
+            }
+            fn put(&mut self, p: PathBuf, bytes: Vec<u8>) {
+                self.parents(&p);
+                self.entries.insert(p, Entry::File(bytes));
+            }
+            /// `p` and everything below it.
+            fn below(&self, p: &Path) -> Vec<PathBuf> {
+                self.entries.range(p.to_path_buf()..).map(|(k, _)| k).take_while(|k| k.starts_with(p)).cloned().collect()
+            }
+        }
+
+        /// Stores a file without noting a change (files the page brings in from Files or a drop).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            with(|t| t.put(key(p), bytes));
+        }
+
+        /// The paths changed since the last call: each now holds what the page's storage should hold, or is gone.
+        pub fn changes() -> Vec<PathBuf> {
+            with(|t| ::std::mem::take(&mut t.changed).into_iter().collect())
+        }
+
+        pub fn exists<P: AsRef<Path>>(p: P) -> bool {
+            TREE.with(|t| t.borrow().entries.contains_key(&key(p.as_ref())))
+        }
+
+        pub fn is_file<P: AsRef<Path>>(p: P) -> bool {
+            TREE.with(|t| matches!(t.borrow().entries.get(&key(p.as_ref())), Some(Entry::File(_))))
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.put(p.clone(), bytes.as_ref().to_vec());
+                t.changed.insert(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes)) => Ok(bytes.clone()),
+                _ => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.parents(&p);
+                t.entries.entry(p).or_insert(Entry::Dir);
+            });
+            Ok(())
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| match t.entries.remove(&p) {
+                Some(Entry::File(_)) => {
+                    t.changed.insert(p);
+                    Ok(())
+                }
+                _ => Err(missing(&p)),
+            })
+        }
+
+        pub fn remove_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                for gone in t.below(&p) {
+                    t.entries.remove(&gone);
+                    t.changed.insert(gone);
+                }
+            });
+            Ok(())
+        }
+
+        pub struct DirEntry(PathBuf);
+        impl DirEntry {
+            pub fn path(&self) -> PathBuf {
+                self.0.clone()
+            }
+        }
+
+        pub fn read_dir<P: AsRef<Path>>(p: P) -> io::Result<::std::vec::IntoIter<io::Result<DirEntry>>> {
+            let dir = key(p.as_ref());
+            if TREE.with(|t| !matches!(t.borrow().entries.get(&dir), Some(Entry::Dir))) {
+                return Err(missing(&dir));
+            }
+            let entries = TREE.with(|t| {
+                t.borrow().below(&dir).into_iter().filter(|k| k.parent() == Some(&dir)).map(|k| Ok(DirEntry(k))).collect::<Vec<_>>()
+            });
+            Ok(entries.into_iter())
+        }
+
+        /// A file's bytes, read whole when it opens; one made by `create` is stored back when flushed or dropped.
+        pub struct File {
+            data: Cursor<Vec<u8>>,
+            /// Where written bytes go, for a file made by `create`.
+            to: Option<PathBuf>,
+            dirty: bool,
+        }
+
+        impl File {
+            pub fn open<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                Ok(File { data: Cursor::new(read(p)?), to: None, dirty: false })
+            }
+            pub fn create<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                write(p.as_ref(), [])?;
+                Ok(File { data: Cursor::new(Vec::new()), to: Some(key(p.as_ref())), dirty: false })
+            }
+            fn store(&mut self) {
+                if let (true, Some(to)) = (self.dirty, &self.to) {
+                    let _ = write(to, self.data.get_ref());
+                    self.dirty = false;
+                }
+            }
+        }
+
+        impl Read for File {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                self.data.read(buf)
+            }
+        }
+
+        impl Write for File {
+            fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+                if self.to.is_none() {
+                    return Err(io::Error::new(io::ErrorKind::PermissionDenied, "the file is open to read"));
+                }
+                self.dirty = true;
+                self.data.write(buf)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                self.store();
+                Ok(())
+            }
+        }
+
+        impl Drop for File {
+            fn drop(&mut self) {
+                self.store();
+            }
+        }
+    }
+}
+
+/// The temporary folder an imported avatar is staged in (the real crate's `tempdir`, in memory).
+pub mod tempfile {
+    use ::std::cell::Cell;
+    use ::std::path::{Path, PathBuf};
+
+    #[derive(Debug)]
+    pub struct TempDir(PathBuf);
+
+    impl TempDir {
+        pub fn path(&self) -> &Path {
+            &self.0
+        }
+    }
+
+    impl Drop for TempDir {
+        fn drop(&mut self) {
+            let _ = super::std::fs::remove_dir_all(&self.0);
+        }
+    }
+
+    thread_local! {
+        static NEXT: Cell<u32> = const { Cell::new(0) };
+    }
+
+    pub fn tempdir() -> ::std::io::Result<TempDir> {
+        let n = NEXT.replace(NEXT.get() + 1);
+        let dir = PathBuf::from(format!("/tmp/.tmp{n}"));
+        super::std::fs::create_dir_all(&dir)?;
+        Ok(TempDir(dir))
+    }
+}
