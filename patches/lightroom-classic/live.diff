+//! Playground live editing (`playground_live`): the shared document is the library's catalog as JSON (every photo's
+//! develop settings, History, Versions, rating, flag, label and metadata; collections including saved Book, Print,
+//! Slideshow and Web creations, stacks, the keyword list, folder labels, the Map's saved locations), without what only
+//! this browser has (its preview index, sidecar stamps, links to its remote accounts, when it browsed Local folders and
+//! the photos seen there) and without views (selection, filter, sort, module, panels live outside the catalog). The
+//! originals of imported photos travel as session files named by their content hash, and land in this browser's
+//! storage as if imported here. Native undo history stays local; while connected Undo and Redo go to the session.
+//! Each person sees the others' selections outlined on grid and filmstrip cells and their pointer over a photo both
+//! have open, in their color with their name; and their gestures as they happen (a slider's value, the crop box, brush
+//! and spot strokes, a straighten line, photos dragged to a collection, text typed into a metadata field), until the
+//! change itself arrives on release. Pointers, name and value tags, outlines, ghosts (the crop box's too), colors and
+//! easing are the presence look of the playground-live crate (patches/live/kit); strokes, straighten lines and a
+//! slider's ghost thumb are drawn here in its colors.
+//!
+//! Everything lives in new files: this one, `live_web.rs` (the host's side, a child of `web`) and a `live` module in
+//! the catalog, engine and UI crates. Playground's patches/lightroom-classic.yaml adds the one-line calls into them.
+
+#![cfg_attr(test, allow(dead_code))]
+
+use crate::store::{self, Originals};
+use lcc_engine::catalog::{Catalog, PhotoId, Source};
+use lcc_engine::develop::controls;
+use lcc_engine::pipeline::geometry::Frame;
+use lcc_ui_egui::module::ModuleId;
+use lcc_ui_egui::panels::detail::Gesture;
+use lcc_ui_egui::state::ViewMode;
+use lcc_ui_egui::{CommandError, LccApp};
+use playground_live::{Live, Presence, presence};
+use serde::Deserialize as _;
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, BTreeSet, HashMap, HashSet};
+
+/// What holds the app: the web app (live_web.rs) and, in the native tests, the app itself.
+pub trait Host {
+    fn app(&self) -> &LccApp;
+    fn app_mut(&mut self) -> &mut LccApp;
+}
+
+/// The app as the session sees it: [`Live`] is the playground-live crate's and LccApp the UI crate's, so the trait goes
+/// on this, around what holds the app, which it reaches through.
+pub struct Peer<H>(pub H);
+
+impl<H: Host> std::ops::Deref for Peer<H> {
+    type Target = LccApp;
+    fn deref(&self) -> &LccApp {
+        self.0.app()
+    }
+}
+
+impl<H: Host> std::ops::DerefMut for Peer<H> {
+    fn deref_mut(&mut self) -> &mut LccApp {
+        self.0.app_mut()
+    }
+}
+
+#[cfg_attr(test, allow(dead_code))]
+pub const FORMAT: &str = concat!("lightroom-classic:1:", env!("CARGO_PKG_VERSION"));
+
+/// The catalog's own records of this browser: its previews index, its remote account links, its Local browsing.
+const OWN: [&str; 3] = ["browsed", "previews", "remote"];
+
+/// This browser's originals: the ones in memory, and the hashes known to be in its storage (`None`: no storage).
+#[derive(Default)]
+struct Media {
+    originals: Originals,
+    stored: Option<HashSet<String>>,
+}
+
+thread_local! {
+    static MEDIA: RefCell<Media> = RefCell::default();
+    /// An original arrived from the session since the last frame.
+    static ARRIVED: Cell<bool> = const { Cell::new(false) };
+    /// Saved creations someone else saved since this person last opened them (album ids).
+    static STALE: RefCell<BTreeSet<u64>> = const { RefCell::new(BTreeSet::new()) };
+    /// An open command is running under [`command`]'s watch.
+    static OPENING: Cell<bool> = const { Cell::new(false) };
+    /// Where this person points over the photo open in the loupe, in its normalized coordinates ([`Loupe`]).
+    static POINTER: Cell<Option<[f64; 2]>> = const { Cell::new(None) };
+    /// The collection row under the pointer while this person drags photos.
+    static DROP: Cell<Option<u64>> = const { Cell::new(None) };
+    /// The metadata field this person is typing into (the Metadata panel's), and its text so far.
+    static TYPED: RefCell<Option<(&'static str, String)>> = const { RefCell::new(None) };
+    /// The others' strokes as this person last drew them, by person.
+    static TRAILS: RefCell<HashMap<String, Trail>> = RefCell::default();
+    /// Others' changes are being merged into this person's work (the end of a frame), and one of them conflicted.
+    static MERGING: Cell<bool> = const { Cell::new(false) };
+    static CONFLICTED: Cell<bool> = const { Cell::new(false) };
+}
+
+/// Photos sent as a selection or a drag, and points as a stroke, at most; the most bytes a presence takes (the shell
+/// sends none past 4096).
+const MAX_SELECTION: usize = 50;
+const MAX_STROKE: usize = 200;
+const MAX_PRESENCE: usize = 4000;
+
+/// The Metadata panel's text fields (panels/metadata.rs `text_field`: each keeps its text while edited, by this key,
+/// and saves it on Return or leaving).
+const META_FIELDS: [&str; 12] =
+    ["title", "caption", "altText", "extendedDescription", "copyright", "usageTerms", "copyrightUrl", "creator", "location", "city", "state", "country"];
+
+/// The shared photo this person has open (the loupe, in Library or Develop).
+fn open_photo(app: &LccApp) -> Option<PhotoId> {
+    let loupe = matches!(app.ui.module, ModuleId::Library | ModuleId::Develop) && matches!(app.ui.view, ViewMode::Detail);
+    let active = app.session.selection.active.filter(|id| app.session.catalog.photo(*id).is_some_and(|p| !p.local));
+    loupe.then_some(active).flatten()
+}
+
+/// Ten-thousandths are plenty on a photo.
+fn round(v: f64) -> f64 {
+    (v * 1e4).round() / 1e4
+}
+
+/// This person's loupe as last drawn: the photo open in it, and where that photo's normalized coordinates (its oriented,
+/// uncropped frame, 0..1: the same for everyone whatever their zoom, crop tool or panels) are on screen
+/// (`lcc_ui_egui::live::loupe`, the loupe's own mapping), as affine coefficients.
+#[derive(Clone, Copy)]
+struct Loupe {
+    photo: PhotoId,
+    to_norm: [f64; 6],
+    from_norm: [f64; 6],
+}
+
+impl Loupe {
+    fn of(app: &LccApp) -> Option<Loupe> {
+        let photo = open_photo(app)?;
+        let (to_norm, from_norm) = lcc_ui_egui::live::loupe(app)?;
+        Some(Loupe { photo, to_norm, from_norm })
+    }
+
+    /// A screen point, normalized.
+    fn norm(&self, x: f32, y: f32) -> [f64; 2] {
+        affine(self.to_norm, [x.into(), y.into()])
+    }
+
+    /// A normalized point on screen.
+    fn screen(&self, n: [f64; 2]) -> [f32; 2] {
+        affine(self.from_norm, n).map(|v| v as f32)
+    }
+}
+
+fn affine([a, b, c, d, e, f]: [f64; 6], [x, y]: [f64; 2]) -> [f64; 2] {
+    [x * a + y * c + e, x * b + y * d + f]
+}
+
+/// A gesture under way, as the others are shown it until its change arrives on release, in the open photo's normalized
+/// coordinates: a develop adjustment (`adjust`: the photo, its History label, and a slider's control and value so far),
+/// the crop box it makes (`crop`: four corners), a brush or spot stroke (`stroke`: the newest points, and the brush's
+/// radius as a fraction of the photo's long edge), a straighten line (`line`: where it starts; it ends at the pointer),
+/// photos dragged toward a collection (`drag`: the photos, and the collection under the pointer), text typed into a
+/// metadata field (`typing`: the active photo, the field, the newest 200 characters; it is saved on Return or leaving).
+fn in_progress(app: &LccApp, state: &mut Value) {
+    let s = &app.session;
+    if let Some(i) = &s.interaction
+        && let Some(p) = s.catalog.photo(i.photo)
+    {
+        let d = &p.develop;
+        state["adjust"] = json!({"photo": i.photo.0, "label": i.label});
+        if let Some(id) = app.ui.dragging_control.as_deref()
+            && let Some(v) = control_value(d, id)
+        {
+            (state["adjust"]["control"], state["adjust"]["value"]) = (id.into(), v.into());
+        }
+        if d.crop.geometry != i.original.crop.geometry {
+            let f = Frame::with_lens(p.width.max(1) as usize, p.height.max(1) as usize, d, false, p.embedded_lens.as_deref());
+            let f = Frame { crop: d.crop.geometry, ..f };
+            state["crop"] = json!(f.crop_quad_norm().map(|q| [round(q.x), round(q.y)]));
+        }
+    }
+    let loupe = Loupe::of(app);
+    let stroke = match &app.gesture {
+        Some(Gesture::Brush { points, .. }) => Some((points, app.ui.brush_size)),
+        Some(Gesture::Spot { points }) => Some((points, app.ui.remove_size)),
+        Some(Gesture::StraightenLine { a }) => {
+            if let Some(l) = loupe {
+                state["line"] = json!(l.norm(a.x, a.y).map(round));
+            }
+            None
+        }
+        _ => None,
+    };
+    if let Some((points, size)) = stroke {
+        // a point at least a pixel from the last, where this person draws them
+        let apart = |a: [f64; 2], b: [f64; 2]| {
+            loupe.is_none_or(|l| {
+                let (a, b) = (l.screen(a), l.screen(b));
+                (a[0] - b[0]).hypot(a[1] - b[1]) >= 1.0
+            })
+        };
+        let mut line: Vec<[f64; 2]> = Vec::new();
+        for q in points {
+            if line.last().is_none_or(|last| apart(*last, [q.x, q.y])) {
+                line.push([q.x, q.y]);
+            }
+        }
+        let newest: Vec<_> = line[line.len().saturating_sub(MAX_STROKE)..].iter().map(|n| n.map(round)).collect();
+        state["stroke"] = json!({"points": newest, "size": round(size.into())});
+    }
+    if let Some((field, text)) = TYPED.with_borrow(Clone::clone)
+        && let Some(photo) = s.selection.active
+    {
+        let n = text.chars().count();
+        state["typing"] = json!({"photo": photo.0, "field": field, "text": text.chars().skip(n.saturating_sub(200)).collect::<String>()});
+    }
+    if let Some(ids) = &app.ui.dragging_photos {
+        let shared: Vec<u64> = ids.iter().copied().filter(|id| s.catalog.photo(PhotoId(*id)).is_some_and(|p| !p.local)).take(MAX_SELECTION).collect();
+        if !shared.is_empty() {
+            state["drag"] = json!({"photos": shared});
+            if let Some(album) = DROP.get() {
+                state["drag"]["album"] = album.into();
+            }
+        }
+    }
+    // a long stroke keeps its newest points
+    while state.to_string().len() > MAX_PRESENCE
+        && let Some(points) = state.pointer_mut("/stroke/points").and_then(Value::as_array_mut).filter(|p| p.len() > 1)
+    {
+        points.drain(..points.len() / 2);
+    }
+}
+
+/// Points of someone's stroke kept at most (a longer one starts again from its newest).
+const MAX_SHOWN_STROKE: usize = 10_000;
+
+/// Another person's stroke as this person last drew it, in the photo's normalized coordinates (so this person's own
+/// zooming and panning never lag it): its points show one after the other as they come, eased like the others' marks.
+#[derive(Default)]
+struct Trail {
+    /// The stroke's points so far, and how many of them show (a fraction is that far toward the next).
+    stroke: Vec<[f64; 2]>,
+    reveal: f64,
+    /// What the stroke's coverage was painted from: the view (the loupe's mapping), its points on screen so far, how
+    /// many of `stroke` they hold whole; and the coverage.
+    view: [f64; 6],
+    fed: Vec<[f32; 2]>,
+    fed_whole: usize,
+    #[cfg(target_arch = "wasm32")]
+    painted: Option<Painted>,
+}
+
+impl Trail {
+    /// `dt` seconds on toward the end of `stroke` (its newest points; a stroke first seen shows whole). Whether it is
+    /// still on its way.
+    fn step(&mut self, stroke: &[[f64; 2]], dt: f32) -> bool {
+        let k = 1.0 - (-f64::from(dt.clamp(0.0, 0.1)) / presence::EASE).exp();
+        // the points after the last one this person has (the same numbers come again until they drop off the front)
+        match self.stroke.last().and_then(|last| stroke.iter().rposition(|p| p == last)) {
+            Some(i) if self.stroke.len() < MAX_SHOWN_STROKE => self.stroke.extend_from_slice(&stroke[i + 1..]),
+            _ => {
+                (self.stroke, self.reveal) = (stroke.to_vec(), stroke.len() as f64);
+                (self.fed, self.fed_whole) = (Vec::new(), 0);
+            }
+        }
+        let n = self.stroke.len() as f64;
+        self.reveal += (n - self.reveal) * k;
+        if n - self.reveal < 0.05 {
+            self.reveal = n;
+        }
+        self.reveal < n
+    }
+}
+
+/// A normalized point from someone else's presence: two finite numbers near the photo, else nothing.
+fn point(v: &Value) -> Option<[f64; 2]> {
+    let p = [v.get(0)?.as_f64()?, v.get(1)?.as_f64()?];
+    p.iter().all(|c| (-2.0..=3.0).contains(c)).then_some(p)
+}
+
+/// A crop box from someone else's presence: four [`point`]s.
+fn quad(v: &Value) -> Option<[f64; 8]> {
+    let c: Vec<[f64; 2]> = v.as_array()?.iter().map(point).collect::<Option<_>>()?;
+    let &[a, b, c, d] = c.as_slice() else { return None };
+    Some([a[0], a[1], b[0], b[1], c[0], c[1], d[0], d[1]])
+}
+
+/// The end of a frame in the browser: notes where this person points on the open photo (and the collection row under
+/// photos being dragged, and the metadata field being typed into), draws the others over the app (name tags in the
+/// app's 12 px semibold), ends the presence look's frame, then [`frame`].
+#[cfg(target_arch = "wasm32")]
+pub fn end_frame(app: &mut Peer<impl Host>, ctx: &egui::Context) {
+    let at = ctx.input(|i| i.pointer.hover_pos());
+    let over_canvas = at.filter(|p| app.canvas_rect.is_some_and(|c| c.contains(*p)));
+    POINTER.set(Loupe::of(app).zip(over_canvas).map(|(l, p)| l.norm(p.x, p.y).map(round)));
+    let album = |p: egui::Pos2| app.widgets.iter().filter(|(_, r)| r.contains(p)).find_map(|(k, _)| k.strip_prefix("source:album:")?.parse().ok());
+    DROP.set(app.ui.dragging_photos.as_ref().and(at).and_then(album));
+    let draft = |key: &'static str| ctx.data(|d| d.get_temp::<String>(egui::Id::new(("info-field", key)))).map(|text| (key, text));
+    TYPED.set(META_FIELDS.into_iter().find_map(draft));
+    presence::set_font(lcc_ui_egui::theme::Tokens::get(ctx).semibold(12.0));
+    show_others(app, ctx);
+    presence::end_frame(ctx);
+    frame(app);
+    if CONFLICTED.take() {
+        app.toast_error(ctx, "Someone else changed the same setting at the same time: your edit is kept as a draft (Share)");
+    }
+}
+
+/// The others over this person's app, in their colors (the look every Playground app shares), what does not resolve
+/// skipped: first the ghosts of their gestures (the crop box, a stroke, a straighten line on the photo this person has
+/// open too; photos being dragged, in the grid and filmstrip), then their selections outlined, then their pointers and
+/// tags (a slider's value beside this person's own slider, the collection photos are dragged to).
+#[cfg(target_arch = "wasm32")]
+fn show_others(app: &LccApp, ctx: &egui::Context) {
+    use egui::{Pos2, Shape, Stroke, vec2};
+    // over the panels, under menus and windows
+    let painter = ctx.layer_painter(egui::LayerId::background());
+    let ids = |v: &Value| v.as_array().into_iter().flatten().take(MAX_SELECTION).filter_map(Value::as_u64).collect::<HashSet<u64>>();
+    let (loupe, canvas, image) = (Loupe::of(app), app.canvas_rect, app.image_rect);
+    let on = |l: Loupe, n: [f64; 2]| Pos2::from(l.screen(n));
+    let dt = ctx.input(|i| i.stable_dt);
+    let others = presence::others();
+    // each one's pointer on the photo this person has open, eased once a frame (the straighten line ends at it)
+    let mut pointers = Vec::new();
+    TRAILS.with_borrow_mut(|trails| {
+        trails.retain(|id, _| others.iter().any(|o| o.id == *id));
+        for o in &others {
+            let (c, s) = (presence::color(o), &o.state);
+            for id in ids(&s["drag"]["photos"]) {
+                for (r, visible) in cells(app, id) {
+                    presence::ghost(&painter.with_clip_rect(visible), r, c);
+                }
+            }
+            let (Some(l), Some(canvas)) = (loupe.filter(|l| s["page"].as_u64() == Some(l.photo.0)), canvas) else {
+                trails.remove(&o.id);
+                pointers.push(None);
+                continue;
+            };
+            // points a normalized unit across and down; a quarter of the canvas, past which a mark goes at once
+            let (o0, o1, o2) = (on(l, [0.0, 0.0]), on(l, [1.0, 0.0]), on(l, [0.0, 1.0]));
+            let px: [f64; 2] = [o0.distance(o1).into(), o0.distance(o2).into()];
+            let far = [f64::from(canvas.width() / 4.0), f64::from(canvas.height() / 4.0)];
+            let pointer = point(&s["pointer"]).and_then(|t| presence::ease(ctx, &o.id, "pointer", t, px, far));
+            pointers.push(pointer.map(|n| on(l, n)));
+            let p = painter.with_clip_rect(canvas);
+            let xy = |v: [f64; 2]| std::array::from_fn(|i| v[i % 2]);
+            if let Some(q) = quad(&s["crop"]).and_then(|t| presence::ease(ctx, &o.id, "crop", t, xy(px), xy(far))) {
+                let corners: Vec<Pos2> = q.chunks_exact(2).map(|n| on(l, [n[0], n[1]])).collect();
+                presence::ghost_shape(&p, &corners, c);
+            }
+            let stroke: Vec<[f64; 2]> = s["stroke"]["points"].as_array().into_iter().flatten().take(MAX_STROKE).filter_map(point).collect();
+            let trail = trails.entry(o.id.clone()).or_default();
+            if trail.step(&stroke, dt) {
+                presence::keep_moving();
+            }
+            if !trail.stroke.is_empty() {
+                // the brush's radius on this person's photo, a fraction of its long edge as for the drawer
+                let long = image.map_or(0.0, |r| r.width().max(r.height()));
+                let r = (s["stroke"]["size"].as_f64().filter(|v| v.is_finite()).unwrap_or(0.0).clamp(0.0, 1.0) as f32 * long).max(1.0);
+                live_stroke(ctx, &p, trail, l, canvas, r, o.color);
+            }
+            if let (Some(a), Some(b)) = (point(&s["line"]), pointer) {
+                p.extend(Shape::dashed_line(&[on(l, a), on(l, b)], Stroke::new(1.5, c), 4.0, 3.0));
+            }
+        }
+    });
+    for (i, o) in others.iter().enumerate() {
+        let (c, s) = (presence::color(o), &o.state);
+        for id in ids(&s["selection"]) {
+            for (r, visible) in cells(app, id) {
+                // one inside the other when several people select the same photo
+                let inner = r.shrink(1.0 + 3.0 * i.min(8) as f32);
+                let p = painter.with_clip_rect(visible);
+                presence::outline(&p, inner, c);
+                presence::tag(&p, inner.min + vec2(3.0, 3.0), c, &o.name);
+            }
+        }
+        if let Some((row, panel)) = drop_row(app, ctx, s) {
+            presence::outline(&painter.with_clip_rect(panel), row.shrink2(vec2(8.0, 1.0)), c);
+        }
+    }
+    for (o, tip) in others.iter().zip(pointers) {
+        let (c, s) = (presence::color(o), &o.state);
+        if let (Some(canvas), Some(tip)) = (canvas, tip)
+            && canvas.contains(tip)
+        {
+            presence::cursor(&painter.with_clip_rect(canvas), tip, c, &o.name);
+        }
+        if let Some((row, panel)) = drop_row(app, ctx, s) {
+            let n = ids(&s["drag"]["photos"]).len();
+            beside(&painter, row, panel, canvas, &format!("{n} photo{}", if n == 1 { "" } else { "s" }), c);
+        }
+        let here = loupe.filter(|l| s["page"].as_u64() == Some(l.photo.0));
+        editing(app, &painter, s, c, here.and(image));
+    }
+}
+
+/// The registered rect of widget `key` this frame.
+#[cfg(target_arch = "wasm32")]
+fn area(app: &LccApp, key: &str) -> Option<egui::Rect> {
+    app.widgets.iter().find(|(k, _)| k == key).map(|(_, r)| *r)
+}
+
+/// Photo `id`'s grid and filmstrip cells this frame, each with the part of it that shows.
+#[cfg(target_arch = "wasm32")]
+fn cells(app: &LccApp, id: u64) -> impl Iterator<Item = (egui::Rect, egui::Rect)> + '_ {
+    let (grid, strip) = (area(app, "grid:scroll"), area(app, "filmstrip"));
+    app.widgets.iter().filter_map(move |(k, r)| {
+        let (kind, of) = k.split_once(':')?;
+        let shown = match kind {
+            "thumb" => grid?,
+            "film" => strip?,
+            _ => return None,
+        };
+        (of.parse() == Ok(id)).then(|| (*r, shown.intersect(*r)))
+    })
+}
+
+/// The collection row someone drags photos to, when this person's left panel shows it, and the part of the panel the
+/// rows scroll in (panels/classic_left.rs: under the pinned Navigator, above the Import… / Export… bar).
+#[cfg(target_arch = "wasm32")]
+fn drop_row(app: &LccApp, ctx: &egui::Context, state: &Value) -> Option<(egui::Rect, egui::Rect)> {
+    let row = area(app, &format!("source:album:{}", state["drag"]["album"].as_u64()?))?;
+    let mut panel = area(app, "panel:left_panel")?;
+    if let Some(top) = ctx.data(|d| d.get_temp::<f32>(egui::Id::new("left-view-top"))) {
+        panel.min.y = panel.min.y.max(top);
+    }
+    if let Some(bar) = app.widgets.iter().filter(|(k, r)| k.starts_with("button:leftBar-") && panel.contains_rect(*r)).map(|(_, r)| r.top()).reduce(f32::min) {
+        panel.max.y = panel.max.y.min(bar);
+    }
+    panel.contains_rect(row).then_some((row, panel))
+}
+
+/// Someone's edit under way (`state`) shown as a tag, beside the control this person has for it when it shows the same
+/// photo, else on the photo (`image`: open in the loupe on the same photo, or its cell): a develop adjustment named with
+/// its value (and a ghost of the slider's thumb where theirs is; a crop shows as its box instead), or the text being
+/// typed into a metadata field.
+#[cfg(target_arch = "wasm32")]
+fn editing(app: &LccApp, painter: &egui::Painter, state: &Value, c: egui::Color32, image: Option<egui::Rect>) {
+    use lcc_ui_egui::i18n::tr;
+    let a = &state["adjust"];
+    if let Some(photo) = a["photo"].as_u64() {
+        let spec = a["control"].as_str().and_then(control_spec);
+        let value = a["value"].as_f64().filter(|v| v.is_finite()).zip(spec).map(|(v, spec)| spec.clamp(v));
+        let text = match (spec, value) {
+            (Some(spec), Some(v)) => format!("{} {}", tr(spec.label), spec.format(v)),
+            _ => tr(&a["label"].as_str().unwrap_or_default().chars().take(40).collect::<String>()).to_owned(),
+        };
+        let slider = spec.zip(value).map(|(spec, _)| format!("slider:{}", spec.id));
+        if let Some(track) = photo_tag(app, painter, photo, slider.as_deref(), state["crop"].is_null(), &text, c, image)
+            && let (Some(spec), Some(v)) = (spec, value)
+        {
+            let at = egui::pos2(track.left() + spec.position(v) as f32 * track.width(), track.center().y);
+            painter.circle(at, 7.0, c.gamma_multiply(0.28), egui::Stroke::new(1.5, c.gamma_multiply(0.85)));
+        }
+    }
+    let t = &state["typing"];
+    if let (Some(photo), Some(field), Some(text)) = (t["photo"].as_u64(), t["field"].as_str().filter(|f| META_FIELDS.contains(f)), t["text"].as_str()) {
+        // the end of it, on one line
+        let n = text.chars().count();
+        let end: String = text.chars().skip(n.saturating_sub(40)).map(|c| if c.is_control() { ' ' } else { c }).collect();
+        let text = if n > 40 { format!("…{end}") } else { end };
+        photo_tag(app, painter, photo, Some(&format!("field:{field}")), true, &text, c, image);
+    }
+}
+
+/// A tag about an edit of `photo`: beside this person's own `widget` for it in the right panel when that shows the same
+/// photo (which it returns), else, when `elsewhere`, on the photo (`image`, or its cell).
+#[cfg(target_arch = "wasm32")]
+#[allow(clippy::too_many_arguments)]
+fn photo_tag(
+    app: &LccApp,
+    painter: &egui::Painter,
+    photo: u64,
+    widget: Option<&str>,
+    elsewhere: bool,
+    text: &str,
+    c: egui::Color32,
+    image: Option<egui::Rect>,
+) -> Option<egui::Rect> {
+    let mine = app.session.selection.active.is_some_and(|p| p.0 == photo);
+    let beside_widget = widget.filter(|_| mine).and_then(|w| Some((area(app, w)?, area(app, "panel:right_panel")?)));
+    if let Some((anchor, panel)) = beside_widget.filter(|(anchor, panel)| panel.contains_rect(*anchor)) {
+        beside(painter, anchor, panel, app.canvas_rect, text, c);
+        return Some(anchor);
+    }
+    if elsewhere && let Some((r, visible)) = image.map(|r| (r, r)).or_else(|| cells(app, photo).next()) {
+        presence::label(&painter.with_clip_rect(visible), egui::pos2(r.left() + 8.0, r.bottom() - 8.0 - presence::label_size(painter, text).y), c, text);
+    }
+    None
+}
+
+/// A tag beside `anchor` (vertically centred on it), just outside `panel` on the side toward the canvas.
+#[cfg(target_arch = "wasm32")]
+fn beside(painter: &egui::Painter, anchor: egui::Rect, panel: egui::Rect, canvas: Option<egui::Rect>, text: &str, color: egui::Color32) {
+    let size = presence::label_size(painter, text);
+    let left = canvas.is_none_or(|c| panel.center().x > c.center().x);
+    let x = if left { panel.left() - 8.0 - size.x } else { panel.right() + 8.0 };
+    presence::label(painter, egui::pos2(x, anchor.center().y - size.y / 2.0), color, text);
+}
+
+/// Someone's stroke as far as it shows (`shown`), on photo `l` in this person's `canvas`, as a disc of radius `r`
+/// (points) all along it in their `color`. Only what is new is painted each frame; a new view paints it again.
+#[cfg(target_arch = "wasm32")]
+fn live_stroke(ctx: &egui::Context, painter: &egui::Painter, shown: &mut Trail, l: Loupe, canvas: egui::Rect, r: f32, color: [u8; 3]) {
+    if shown.view != l.to_norm {
+        (shown.view, shown.fed, shown.fed_whole) = (l.to_norm, Vec::new(), 0);
+    }
+    let whole = (shown.reveal as usize).min(shown.stroke.len());
+    for n in &shown.stroke[shown.fed_whole.min(whole)..whole] {
+        shown.fed.push(l.screen(*n));
+    }
+    shown.fed_whole = whole;
+    // part of the way to the next point: on the segment, so the coverage follows the stroke
+    if let (Some(a), Some(b)) = (whole.checked_sub(1).and_then(|i| shown.stroke.get(i)), shown.stroke.get(whole)) {
+        let f = shown.reveal - whole as f64;
+        shown.fed.push(l.screen([a[0] + (b[0] - a[0]) * f, a[1] + (b[1] - a[1]) * f]));
+    }
+    // the points it has were placed in another view (or the stroke is another): start again
+    let params = (canvas, ctx.pixels_per_point().min(4096.0 / canvas.width().max(canvas.height()).max(1.0)), r, color);
+    if shown.painted.as_ref().is_none_or(|p| p.params != params || shown.fed.len() < p.stamped) {
+        let side = |v: f32| ((v * params.1).ceil().max(1.0) as usize).min(4096);
+        let (w, h) = (side(canvas.width()), side(canvas.height()));
+        shown.painted = Some(Painted { params, w, h, cover: vec![0; w * h], stamped: 0, dirty: None, texture: None });
+    }
+    let Some(p) = shown.painted.as_mut() else { return };
+    if p.stamp(&shown.fed) {
+        presence::keep_moving();
+    }
+    p.show(ctx, painter);
+}
+
+/// A stroke at screen resolution: each pixel's coverage (0..=255) by a disc stamped all along it, the most any disc gives
+/// it (round at the ends and turns, never darker where the stroke crosses itself); and the texture showing it at 70%.
+#[cfg(target_arch = "wasm32")]
+struct Painted {
+    /// Where (the canvas), at how many pixels a point, the disc's radius (points), the color.
+    params: (egui::Rect, f32, f32, [u8; 3]),
+    w: usize,
+    h: usize,
+    cover: Vec<u8>,
+    /// Points stamped so far, and the pixels changed since the last upload (x0, y0, x1, y1).
+    stamped: usize,
+    dirty: Option<[usize; 4]>,
+    texture: Option<egui::TextureHandle>,
+}
+
+#[cfg(target_arch = "wasm32")]
+impl Painted {
+    /// Each new point of `points` (screen), joined to the one before it; at most a few million pixels a frame (someone
+    /// else's points: a long scribble finishes over the next frames). Whether some are left.
+    fn stamp(&mut self, points: &[[f32; 2]]) -> bool {
+        let (clip, scale, r, _) = self.params;
+        let px = |q: [f32; 2]| [(q[0] - clip.min.x) * scale, (q[1] - clip.min.y) * scale];
+        let r = r * scale;
+        let mut budget = 4_000_000usize;
+        for i in self.stamped..points.len() {
+            let (a, b) = (px(points[i.saturating_sub(1)]), px(points[i]));
+            if !a.iter().chain(&b).all(|v| v.is_finite()) {
+                continue;
+            }
+            // the capsule's box, in the buffer
+            let span = |u: f32, v: f32, n: usize| (((u.min(v) - r - 1.0).floor().max(0.0) as usize).min(n), ((u.max(v) + r + 1.0).ceil().max(0.0) as usize).min(n));
+            let ((x0, x1), (y0, y1)) = (span(a[0], b[0], self.w), span(a[1], b[1], self.h));
+            let area = (x1 - x0) * (y1 - y0);
+            if area > budget && i > self.stamped {
+                self.stamped = i;
+                return true;
+            }
+            budget = budget.saturating_sub(area);
+            let (dx, dy) = (b[0] - a[0], b[1] - a[1]);
+            let len2 = dx * dx + dy * dy;
+            for y in y0..y1 {
+                for x in x0..x1 {
+                    let (qx, qy) = (x as f32 + 0.5 - a[0], y as f32 + 0.5 - a[1]);
+                    let t = if len2 > 0.0 { ((qx * dx + qy * dy) / len2).clamp(0.0, 1.0) } else { 0.0 };
+                    let cover = ((r + 0.5 - (qx - t * dx).hypot(qy - t * dy)).clamp(0.0, 1.0) * 255.0) as u8;
+                    let at = &mut self.cover[y * self.w + x];
+                    *at = (*at).max(cover);
+                }
+            }
+            if x0 < x1 && y0 < y1 {
+                let d = self.dirty.get_or_insert([x0, y0, x1, y1]);
+                *d = [d[0].min(x0), d[1].min(y0), d[2].max(x1), d[3].max(y1)];
+            }
+        }
+        self.stamped = points.len();
+        false
+    }
+
+    /// Uploads what changed and draws it.
+    fn show(&mut self, ctx: &egui::Context, painter: &egui::Painter) {
+        let (clip, scale, _, [r, g, b]) = self.params;
+        let image = |[x0, y0, x1, y1]: [usize; 4]| {
+            let pixels = (y0..y1).flat_map(|y| (x0..x1).map(move |x| (y, x)));
+            let pixels = pixels.map(|(y, x)| egui::Color32::from_rgba_unmultiplied(r, g, b, (f32::from(self.cover[y * self.w + x]) * 0.7) as u8));
+            egui::ColorImage::new([x1 - x0, y1 - y0], pixels.collect())
+        };
+        match (&mut self.texture, self.dirty.take()) {
+            (None, _) => self.texture = Some(ctx.load_texture("live-stroke", image([0, 0, self.w, self.h]), egui::TextureOptions::LINEAR)),
+            (Some(t), Some(d)) => t.set_partial([d[0], d[1]], image(d), egui::TextureOptions::LINEAR),
+            (Some(_), None) => {}
+        }
+        if let Some(t) = &self.texture {
+            let at = egui::Rect::from_min_size(clip.min, egui::vec2(self.w as f32 / scale, self.h as f32 / scale));
+            painter.image(t.id(), at, egui::Rect::from_min_max(egui::pos2(0.0, 0.0), egui::pos2(1.0, 1.0)), egui::Color32::WHITE);
+        }
+    }
+}
+
+/// The end of a frame.
+pub fn frame(app: &mut Peer<impl Host>) {
+    if ARRIVED.take() {
+        // failed renders are retried once the catalog changes (as after a relink); the document itself stays as it is
+        app.session.catalog.revision = app.session.catalog.revision.wrapping_add(1);
+    }
+    // while live, automatic versions are for the photos this person edited (others' are theirs to keep)
+    lcc_engine::live::set_live(playground_live::connected());
+    MERGING.set(true);
+    playground_live::frame(app);
+    MERGING.set(false);
+}
+
+/// The slider a develop control's id names: a registered control, or the relative Temp and Tint that rendered files
+/// (JPEG, PNG…) show instead of Kelvin (panels/edit.rs `REL_TEMP`, `REL_TINT`).
+fn control_spec(id: &str) -> Option<controls::ControlSpec> {
+    let (of, id) = match id {
+        "wb.tempRel" => ("wb.temp", "wb.tempRel"),
+        "wb.tintRel" => ("wb.tint", "wb.tintRel"),
+        _ => return controls::find(id).copied(),
+    };
+    Some(controls::ControlSpec { id, min: -100.0, max: 100.0, default: 0.0, step: 1.0, decimals: 0, ..*controls::find(of)? })
+}
+
+/// The value of [`control_spec`]'s slider in `d` (panels/edit.rs `k_to_rel` for the relative Temp).
+fn control_value(d: &lcc_engine::develop::DevelopSettings, id: &str) -> Option<f64> {
+    match id {
+        "wb.tempRel" => Some(((1e6 / 6500.0 - 1e6 / d.wb.temp) / 0.8).clamp(-100.0, 100.0)),
+        "wb.tintRel" => Some(d.wb.tint.clamp(-100.0, 100.0)),
+        _ => controls::get(d, id),
+    }
+}
+
+/// Before the strict merge, a photo both sides changed keeps both changes wherever they are to different values: its
+/// edit time is the later one, its History `edited`'s steps (more of them, or fewer after an Undo) then the ones
+/// `current` added, re-based onto `edited`'s settings so the newest step is still the photo's settings; the rest as
+/// [`settle`] leaves it. What is settled goes into `current`, and into `base` as `edited` has it, so the merge takes
+/// it from `current`.
+fn settle_photos(base: &mut Value, current: &mut Value, edited: &Value) {
+    let (Some(b), Some(c), Some(e)) = (
+        base.get_mut("photos").and_then(Value::as_object_mut),
+        current.get_mut("photos").and_then(Value::as_object_mut),
+        edited.get("photos").and_then(Value::as_object),
+    ) else {
+        return;
+    };
+    for (id, e) in e {
+        let (Some(b), Some(c)) = (b.get_mut(id), c.get_mut(id)) else { continue };
+        if b == c || b == e || !b.is_object() || !c.is_object() {
+            continue;
+        }
+        let history = match (b["history"].as_array(), c["history"].as_array(), e["history"].as_array()) {
+            (Some(bh), Some(ch), Some(eh)) if eh != bh => appended(bh, ch, true).map(|n| {
+                let rebase = |step: &Value| {
+                    let mut step = step.clone();
+                    if let Ok(settings) = merged(&b["develop"], &step["settings"], &e["develop"]) {
+                        step["settings"] = settings;
+                    }
+                    step
+                };
+                let mut h = eh.clone();
+                h.extend(ch[ch.len() - n..].iter().map(rebase));
+                h.drain(..h.len().saturating_sub(lcc_engine::catalog::HISTORY_LIMIT));
+                h
+            }),
+            _ => None,
+        };
+        if let Some(h) = history {
+            (b["history"], c["history"]) = (e["history"].clone(), h.into());
+        }
+        if c.get("edited") != b.get("edited") && e.get("edited") != b.get("edited") && e.get("edited").is_some() {
+            let later = c["edited"].as_str().max(e["edited"].as_str()).map_or(Value::Null, Value::from);
+            (b["edited"], c["edited"]) = (e["edited"].clone(), later);
+        }
+        settle(b, c, e);
+    }
+}
+
+/// The parts of a value both sides changed that keep both changes: a list both only added to is `edited`'s additions
+/// then `current`'s (a word or number already there not twice); items with an `id`, list items in the same place when
+/// the list kept its length (a mask's components, whose strokes are added to) and objects settle deeper, key by key.
+/// Everything else is left to the strict merge (both changing one value is a conflict).
+fn settle(b: &mut Value, c: &mut Value, e: &Value) {
+    if b == c || b == e {
+        return;
+    }
+    match (b, c, e) {
+        (Value::Object(b), Value::Object(c), Value::Object(e)) => {
+            for (k, e) in e {
+                if let (Some(b), Some(c)) = (b.get_mut(k), c.get_mut(k)) {
+                    settle(b, c, e);
+                }
+            }
+        }
+        (Value::Array(b), Value::Array(c), Value::Array(e)) => {
+            let id = |v: &Value| v.get("id").filter(|id| id.is_number() || id.is_string()).cloned();
+            if [&*b, &*c, e].iter().all(|l| l.iter().all(|v| id(v).is_some())) {
+                for e in e {
+                    let at = |l: &[Value]| l.iter().position(|v| id(v) == id(e));
+                    if let (Some(i), Some(j)) = (at(b), at(c)) {
+                        settle(&mut b[i], &mut c[j], e);
+                    }
+                }
+            } else if let (Some(n), Some(_)) = (appended(b, c, false), appended(b, e, false)) {
+                let added: Vec<Value> = c[c.len() - n..].iter().filter(|v| v.is_object() || v.is_array() || !e.contains(v)).cloned().collect();
+                *b = e.clone();
+                *c = e.clone();
+                c.extend(added);
+            } else if b.len() == c.len() && b.len() == e.len() {
+                for ((b, c), e) in b.iter_mut().zip(c.iter_mut()).zip(e) {
+                    settle(b, c, e);
+                }
+            }
+        }
+        _ => {}
+    }
+}
+
+/// How many items `x` adds after the end of `b` (`None`: it changed more than that); `capped`: also when it dropped
+/// some from the front, as History does past its limit.
+fn appended(b: &[Value], x: &[Value], capped: bool) -> Option<usize> {
+    let most = if capped { b.len().saturating_sub(1) } else { 0 };
+    (0..=most).find_map(|dropped| {
+        let kept = b.len() - dropped;
+        (x.len() > kept && x.starts_with(&b[dropped..])).then(|| x.len() - kept)
+    })
+}
+
+/// [`settle`], then the strict merge.
+fn merged(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+    let (mut b, mut c) = (base.clone(), current.clone());
+    settle(&mut b, &mut c, edited);
+    playground_live::merge(&b, &c, edited, &[])
+}
+
+/// Offers live editing to the Playground shell (nothing happens until it connects), once the stored originals are known.
+#[cfg(target_arch = "wasm32")]
+pub async fn attach<H: Host + 'static>(
+    with_app: impl Fn(&mut dyn FnMut(&mut Peer<H>)) -> bool + 'static,
+    repaint: impl Fn() + 'static,
+    (originals, backend): (Originals, Option<crate::backend::Backend>),
+) {
+    let stored = match &backend {
+        Some(b) => Some(b.list("originals").await.unwrap_or_else(|e| {
+            log::warn!("listing the stored originals: {e}");
+            Vec::new()
+        })),
+        None => None,
+    };
+    MEDIA.set(Media { originals: originals.clone(), stored: stored.map(|s| s.into_iter().collect()) });
+    let _ = lcc_engine::catalog::live::FRESH_ID.set(playground_live::fresh_id);
+    let _ = lcc_ui_egui::live::COMMAND.set(command);
+    if let Err(e) = playground_live::web::attach::<Peer<H>>(FORMAT, with_app, repaint).and_then(|()| media(originals, backend)) {
+        log::error!("live editing unavailable: {e:?}");
+    }
+}
+
+/// Originals live in asynchronous browser storage: the adapter's `readAsset` and `writeAsset` return promises. One that
+/// arrives is stored and kept in memory as the import does, without touching the catalog or the undo history.
+#[cfg(target_arch = "wasm32")]
+fn media(originals: Originals, backend: Option<crate::backend::Backend>) -> Result<(), wasm_bindgen::JsValue> {
+    use js_sys::{Promise, Reflect, Uint8Array};
+    use wasm_bindgen::prelude::*;
+    use wasm_bindgen_futures::future_to_promise;
+    let adapter = Reflect::get(&js_sys::global(), &"playgroundLiveAdapter".into())?;
+    let (o, b) = (originals.clone(), backend.clone());
+    let read = move |id: String| {
+        let (originals, backend) = (o.clone(), b.clone());
+        future_to_promise(async move {
+            let path = store::original_path(&id, "original");
+            if let Some(bytes) = originals.contains(&path).then(|| originals.get(&path)).flatten() {
+                return Ok(Uint8Array::from(&bytes[..]).into());
+            }
+            let bytes = match &backend {
+                Some(b) => b.read(&store::storage_key(&id)).await?,
+                None => None,
+            };
+            Ok(Uint8Array::from(&bytes.ok_or("Missing media")?[..]).into())
+        })
+    };
+    Reflect::set(&adapter, &"readAsset".into(), &Closure::<dyn Fn(String) -> Promise>::new(read).into_js_value())?;
+    let write = move |id: String, name: String, bytes: Uint8Array| {
+        let (originals, backend) = (originals.clone(), backend.clone());
+        future_to_promise(async move {
+            let bytes = bytes.to_vec();
+            // the storage is named by content: anything else under this name would be another photo
+            if store::content_hash(&bytes) != id {
+                return Err(format!("{name} is not the photo the library refers to").into());
+            }
+            if let Some(b) = &backend {
+                b.write(&store::storage_key(&id), &bytes).await?;
+            }
+            originals.insert(&id, bytes.into());
+            MEDIA.with_borrow_mut(|m| m.stored.as_mut().map(|s| s.insert(id)));
+            ARRIVED.set(true);
+            crate::web::request_repaint();
+            Ok(JsValue::UNDEFINED)
+        })
+    };
+    Reflect::set(&adapter, &"writeAsset".into(), &Closure::<dyn Fn(String, String, Uint8Array) -> Promise>::new(write).into_js_value())?;
+    Ok(())
+}
+
+/// The commands live editing takes over or watches: while connected, Undo and Redo go to the session (but the Presets
+/// panel's own), and a saved creation someone else saved since this person opened it is not saved over.
+fn command(app: &mut LccApp, id: &str, params: &Value) -> Option<Result<Value, CommandError>> {
+    match id {
+        "edit.undo" | "edit.redo" if !lcc_ui_egui::live::is_native() => playground_live::undo(id == "edit.redo").then_some(Ok(Value::Null)),
+        "creation.update" if playground_live::connected() => {
+            let id = params["id"].as_u64().filter(|id| STALE.with_borrow(|s| s.contains(id)))?;
+            let creation = app.session.catalog.album(lcc_engine::catalog::AlbumId(id)).and_then(|a| a.creation.as_ref());
+            let what = creation.and_then(|c| lcc_engine::creations::kind_of(&c.kind)).map_or("creation", |k| k.label());
+            let msg = format!("someone else saved this {what} since you opened it: open it again to see theirs, or save yours under another name");
+            Some(Err(lcc_engine::EngineError::BadParams { cmd: "creation.update".into(), msg }.into()))
+        }
+        "creation.get" | "creation.open" | "slideshow.openSaved" if !OPENING.get() => {
+            OPENING.set(true);
+            let r = app.run_typed(id, params.clone());
+            OPENING.set(false);
+            // what this person has open now is the creation as stored
+            if let Some(id) = r.as_ref().ok().and_then(|v| v.get("id").or_else(|| v.get("openId"))).and_then(Value::as_u64) {
+                STALE.with_borrow_mut(|s| s.remove(&id));
+            }
+            Some(r)
+        }
+        _ => None,
+    }
+}
+
+/// The library folder of a Playground session (`?pg-session=<room id>`, a lowercase UUID): its own, so joining a session
+/// never touches this browser's library. `None` for anything else.
+pub fn session_library_dir(room: &str) -> Option<String> {
+    let uuid = room.len() == 36
+        && room.char_indices().all(|(i, c)| if matches!(i, 8 | 13 | 18 | 23) { c == '-' } else { matches!(c, '0'..='9' | 'a'..='f') });
+    uuid.then(|| format!("library-session-{room}"))
+}
+
+/// The content hash naming the original a photo's source refers to (demo scenes have none).
+fn original(path: &str) -> Option<&str> {
+    store::hash_of_path(path).filter(|h| crate::backup::valid_hash(h))
+}
