+    fn a_crop_held_while_someone_brushes_the_same_photo_lands_with_their_stroke() -> Result<(), String> {
+        let _ = lcc_engine::catalog::live::FRESH_ID.set(playground_live::fresh_id);
+        let (mut a, mut b) = (demo(), demo());
+        playground_live::connect();
