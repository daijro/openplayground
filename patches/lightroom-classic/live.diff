+        b.live_adopt(playground_live::parse(&start)?)?;
+        let photo = a.session.active().ok_or("no active photo")?;
+        // A holds a crop drag; B, on the same photo, brushes a new mask, which reaches A mid-drag and waits.
+        a.run("develop.beginInteraction", json!({"label": "Crop"}))?;
+        a.run("crop.set", json!({"rect": [0.1, 0.2, 0.9, 0.8]}))?;
+        b.run("mask.brushStroke", json!({"points": [[0.3, 0.4], [0.6, 0.5]]}))?;
+        let done = std::rc::Rc::new(Cell::new(false));
+        let to = done.clone();
+        playground_live::queue(Some(start.clone()), canonical(&b.live_document()), Box::new(move |r| to.set(r.is_ok())));
+        playground_live::frame(&mut a);
+        assert!(!done.get());
+        // A lets go: the crop lands on top of the stroke; History is B's step then A's, whose settings are the photo's.
+        a.run("develop.endInteraction", json!({}))?;
+        playground_live::frame(&mut a);
+        assert!(done.get(), "the two edits merge");
+        let p = a.session.catalog.photo(photo).ok_or("no photo")?;
+        let r = p.develop.crop.geometry.rect;
+        assert_eq!(([r.x0, r.y0, r.x1, r.y1], p.develop.masks.len()), ([0.1, 0.2, 0.9, 0.8], 1));
+        assert_eq!(p.history.iter().map(|h| h.label.as_str()).collect::<Vec<_>>(), ["Brush", "Crop"]);
+        assert_eq!(p.history.last().map(|h| &*h.settings), Some(&*p.develop));
+        // B's Undo of the stroke (the journal's merge(after, now, before)) keeps A's crop, History its step alone.
+        let (brushed, both) = (b.live_document(), a.live_document());
+        let undone = App::live_merge(&brushed, &both, &playground_live::parse(&start)?)?;
+        let p = &undone["photos"][photo.0.to_string()];
+        assert_eq!((&p["develop"]["crop"], p["develop"]["masks"].as_array().map(Vec::len)), (&both["photos"][photo.0.to_string()]["develop"]["crop"], Some(0)));
+        assert_eq!((p["history"].as_array().map(Vec::len), &p["history"][0]["settings"]), (Some(1), &p["develop"]));
+        // Both changing one control is a conflict (the shell keeps the losing edit as a draft).
+        let exposure = |v: f64| -> Result<Value, String> {
+            let mut d = playground_live::parse(&start)?;
+            *d.pointer_mut(&format!("/photos/{}/develop/light/exposure", photo.0)).ok_or("no exposure")? = v.into();
+            Ok(d)
+        };
+        assert!(App::live_merge(&playground_live::parse(&start)?, &exposure(0.5)?, &exposure(1.0)?).is_err());
+        playground_live::disconnect();
+        Ok(())
+    }
