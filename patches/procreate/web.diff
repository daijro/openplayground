+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! rfd's blocking dialogs as a page has them (Playground's browser build of ProCraft, patches/procreate.yaml). A page can't
+//! wait for a file dialog, so the open dialogs answer nothing now and note what they asked (`asked`): the page shows
+//! Playground's Open, and what it picks comes in as files dropped on the window. A save dialog answers at once with a
+//! path in memory under `/downloads`; what the app writes there goes to Playground's Save As after the frame.
+
+use std::cell::RefCell;
+use std::path::PathBuf;
+
+/// What an open dialog asked for: its title and the extensions of its filters.
+pub struct Asked {
+    pub title: String,
+    pub extensions: Vec<String>,
+}
+
+thread_local! {
+    static ASKED: RefCell<Vec<Asked>> = const { RefCell::new(Vec::new()) };
+}
+
+/// The open dialogs asked since the last call.
+pub fn asked() -> Vec<Asked> {
+    ASKED.with(|a| std::mem::take(&mut *a.borrow_mut()))
+}
+
+/// Where the save dialogs say a file goes.
+pub const DOWNLOADS: &str = "/downloads";
+
+#[derive(Default)]
+pub struct FileDialog {
+    title: String,
+    extensions: Vec<String>,
+    name: String,
+}
+
+impl FileDialog {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn set_title(mut self, title: impl Into<String>) -> Self {
+        self.title = title.into();
+        self
+    }
+    pub fn add_filter(mut self, _name: impl Into<String>, extensions: &[impl ToString]) -> Self {
+        self.extensions.extend(extensions.iter().map(ToString::to_string));
+        self
+    }
+    pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+        self.name = name.into();
+        self
+    }
+    fn ask(self) {
+        ASKED.with(|a| a.borrow_mut().push(Asked { title: self.title, extensions: self.extensions }));
+    }
+    pub fn pick_file(self) -> Option<PathBuf> {
+        self.ask();
+        None
+    }
+    pub fn pick_files(self) -> Option<Vec<PathBuf>> {
+        self.ask();
+        None
+    }
+    /// A folder to write into can't be picked on a page.
+    pub fn pick_folder(self) -> Option<PathBuf> {
+        None
+    }
+    pub fn save_file(self) -> Option<PathBuf> {
+        let name = if self.name.is_empty() { "Untitled".to_owned() } else { self.name };
+        Some(PathBuf::from(DOWNLOADS).join(name))
+    }
+}
+
+#[derive(Clone, Copy)]
+pub enum MessageLevel {
+    Info,
+    Warning,
+    Error,
+}
+
+#[derive(Clone, Copy, PartialEq, Eq)]
+pub enum MessageDialogResult {
+    Ok,
+}
+
+#[derive(Default)]
+pub struct MessageDialog {
+    title: String,
+    text: String,
+}
+
+impl MessageDialog {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn set_level(self, _: MessageLevel) -> Self {
+        self
+    }
+    pub fn set_title(mut self, title: impl Into<String>) -> Self {
+        self.title = title.into();
+        self
+    }
+    pub fn set_description(mut self, text: impl Into<String>) -> Self {
+        self.text = text.into();
+        self
+    }
+    /// The browser's own alert (it does wait).
+    pub fn show(self) -> MessageDialogResult {
+        if let Some(window) = web_sys::window() {
+            let _ = window.alert_with_message(&format!("{}\n\n{}", self.title, self.text));
+        }
+        MessageDialogResult::Ok
+    }
+}
