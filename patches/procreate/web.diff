index 0000000..1111111
--- /dev/null
+++ b/crates/engine/src/playground.rs
@@ -0,0 +1,584 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock, no files, no threads and nothing to wait with: `Instant::now` panics there,
+//! every file call fails and `thread::spawn` panics. The modules that use them take `std` (and `pollster`) from
+//! here instead, through one `#[cfg(target_arch = "wasm32")] use …::playground::…;` line at each one's end (a local name
+//! shadows the crate's in that module; everything else in it still comes from the real one):
+//!   std::time    web-time's clock;
+//!   std::fs      an in-memory file system (the gallery's artworks, packages, exports, brushes, settings), each write
+//!                noted for the page to mirror into Files (desktop/src/web.rs);
+//!   std::env     `HOME` is `/home` (settings live in memory, so every page starts afresh); nothing else is set;
+//!   std::thread  the page has one: a spawned thread's work runs where it is spawned, at once (a thread that would
+//!                loop or wait for work does not start); scopes likewise; `sleep` does not wait;
+//!   pollster     `block_on` polls once: what the page cannot wait for (a GPU error scope's answer, the adapters' list)
+//!                gives nothing.
+
+// Not every part of std's API that is here gets used.
+#![allow(dead_code)]
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+    }
+
+    pub mod env {
+        pub use ::std::env::*;
+        use ::std::ffi::{OsStr, OsString};
+
+        /// `HOME` is `/home`: settings go to the in-memory files. Nothing else is set.
+        pub fn var_os<K: AsRef<OsStr>>(key: K) -> Option<OsString> {
+            (key.as_ref() == "HOME").then(|| OsString::from("/home"))
+        }
+
+        pub fn var<K: AsRef<OsStr>>(key: K) -> Result<String, VarError> {
+            var_os(key).and_then(|v| v.into_string().ok()).ok_or(VarError::NotPresent)
+        }
+
+        /// std's panics where there is no file system: here it is in memory.
+        pub fn temp_dir() -> ::std::path::PathBuf {
+            "/tmp".into()
+        }
+
+        pub fn current_dir() -> ::std::io::Result<::std::path::PathBuf> {
+            Ok("/".into())
+        }
+    }
+
+    pub mod process {
+        pub use ::std::process::*;
+
+        pub fn id() -> u32 {
+            1
+        }
+    }
+
+    pub mod thread {
+        pub use ::std::thread::*;
+        use ::std::io;
+        use ::std::marker::PhantomData;
+
+        /// What a thread started would have given: its work ran when it was started.
+        pub struct JoinHandle<T>(T);
+
+        impl<T> JoinHandle<T> {
+            pub fn join(self) -> Result<T> {
+                Ok(self.0)
+            }
+            pub fn is_finished(&self) -> bool {
+                true
+            }
+        }
+
+        pub fn spawn<F: FnOnce() -> T, T>(f: F) -> JoinHandle<T> {
+            JoinHandle(f())
+        }
+
+        /// The work of these runs at once; the others loop or wait for work, which a page can't (they don't start).
+        const RUNS: &[&str] = &["procraft-pipelines", "brush previews", "selection reach", "flood reach", "fill", "plugin filter"];
+
+        #[derive(Default)]
+        pub struct Builder(Option<String>);
+
+        impl Builder {
+            pub fn new() -> Self {
+                Self(None)
+            }
+            pub fn name(mut self, name: String) -> Self {
+                self.0 = Some(name);
+                self
+            }
+            pub fn stack_size(self, _size: usize) -> Self {
+                self
+            }
+            pub fn spawn<F: FnOnce() -> T, T>(self, f: F) -> io::Result<JoinHandle<T>> {
+                if self.0.as_deref().is_some_and(|n| RUNS.contains(&n)) {
+                    Ok(JoinHandle(f()))
+                } else {
+                    Err(io::Error::new(io::ErrorKind::Unsupported, "a page has one thread"))
+                }
+            }
+        }
+
+        pub struct Scope<'scope, 'env: 'scope>(PhantomData<&'scope mut &'scope ()>, PhantomData<&'env mut &'env ()>);
+
+        pub struct ScopedJoinHandle<'scope, T>(T, PhantomData<&'scope ()>);
+
+        impl<T> ScopedJoinHandle<'_, T> {
+            pub fn join(self) -> Result<T> {
+                Ok(self.0)
+            }
+            pub fn is_finished(&self) -> bool {
+                true
+            }
+        }
+
+        impl<'scope> Scope<'scope, '_> {
+            pub fn spawn<F: FnOnce() -> T + 'scope, T: 'scope>(&'scope self, f: F) -> ScopedJoinHandle<'scope, T> {
+                ScopedJoinHandle(f(), PhantomData)
+            }
+        }
+
+        pub fn scope<'env, F, T>(f: F) -> T
+        where
+            F: for<'scope> FnOnce(&'scope Scope<'scope, 'env>) -> T,
+        {
+            f(&Scope(PhantomData, PhantomData))
+        }
+
+        pub fn sleep(_: ::std::time::Duration) {}
+
+        pub fn available_parallelism() -> io::Result<::std::num::NonZeroUsize> {
+            Ok(::std::num::NonZeroUsize::MIN)
+        }
+    }
+
+    pub mod fs {
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
+        use ::std::path::{Component, Path, PathBuf};
+
+        enum Entry {
+            Dir,
+            File(Vec<u8>, web_time::SystemTime),
+        }
+
+        #[derive(Default)]
+        struct Tree {
+            entries: BTreeMap<PathBuf, Entry>,
+            /// Paths written, created or removed since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+        }
+
+        thread_local! {
+            static TREE: RefCell<Tree> = RefCell::default();
+        }
+
+        fn with<T>(f: impl FnOnce(&mut Tree) -> T) -> T {
+            TREE.with(|t| f(&mut t.borrow_mut()))
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        pub fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} does not exist", p.display()))
+        }
+
+        impl Tree {
+            fn mark(&mut self, p: PathBuf) {
+                self.changed.insert(p);
+            }
+            fn parents(&mut self, p: &Path) {
+                for dir in p.ancestors().skip(1) {
+                    self.entries.entry(dir.to_path_buf()).or_insert(Entry::Dir);
+                }
+            }
+            fn put(&mut self, p: PathBuf, bytes: Vec<u8>) {
+                self.parents(&p);
+                self.entries.insert(p, Entry::File(bytes, web_time::SystemTime::now()));
+            }
+        }
+
+        /// Stores a file without noting a change (files the page brings in from Files or a drop).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            with(|t| t.put(key(p), bytes));
+        }
+
+        /// Removes a file without noting a change, giving back what it held (an export on its way to Save As).
+        pub fn take(p: &Path) -> Option<Vec<u8>> {
+            with(|t| match t.entries.remove(&key(p)) {
+                Some(Entry::File(bytes, _)) => Some(bytes),
+                _ => None,
+            })
+        }
+
+        /// The paths changed since the last call: each now holds what Files should hold, or is gone.
+        pub fn changes() -> Vec<PathBuf> {
+            with(|t| ::std::mem::take(&mut t.changed).into_iter().collect())
+        }
+
+        pub fn exists<P: AsRef<Path>>(p: P) -> io::Result<bool> {
+            Ok(metadata(p).is_ok())
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.put(p.clone(), bytes.as_ref().to_vec());
+                t.mark(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, _)) => Ok(bytes.clone()),
+                _ => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                if !t.entries.contains_key(&p) {
+                    t.parents(&p);
+                    t.entries.insert(p.clone(), Entry::Dir);
+                    t.mark(p);
+                }
+            });
+            Ok(())
+        }
+
+        pub fn create_dir<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            create_dir_all(p)
+        }
+
+        pub fn canonicalize<P: AsRef<Path>>(p: P) -> io::Result<PathBuf> {
+            Ok(key(p.as_ref()))
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| match t.entries.get(&p) {
+                Some(Entry::File(..)) => {
+                    t.entries.remove(&p);
+                    t.mark(p);
+                    Ok(())
+                }
+                _ => Err(missing(&p)),
+            })
+        }
+
+        pub fn remove_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                let gone: Vec<PathBuf> = t.entries.keys().filter(|k| k.starts_with(&p)).cloned().collect();
+                if gone.is_empty() {
+                    return Err(missing(&p));
+                }
+                for k in gone {
+                    t.entries.remove(&k);
+                    t.mark(k);
+                }
+                Ok(())
+            })
+        }
+
+        pub fn remove_dir<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            remove_dir_all(p)
+        }
+
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+            let (from, to) = (key(from.as_ref()), key(to.as_ref()));
+            with(|t| {
+                let moved: Vec<PathBuf> = t.entries.keys().filter(|k| k.starts_with(&from)).cloned().collect();
+                if moved.is_empty() {
+                    return Err(missing(&from));
+                }
+                for k in moved {
+                    if let Some(entry) = t.entries.remove(&k) {
+                        let at = to.join(k.strip_prefix(&from).unwrap_or(Path::new("")));
+                        t.parents(&at);
+                        t.entries.insert(at.clone(), entry);
+                        t.mark(at);
+                    }
+                    t.mark(k);
+                }
+                Ok(())
+            })
+        }
+
+        pub fn copy<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<u64> {
+            let bytes = read(from)?;
+            let n = bytes.len() as u64;
+            write(to, bytes)?;
+            Ok(n)
+        }
+
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub struct FileType(bool);
+        impl FileType {
+            pub fn is_file(&self) -> bool {
+                self.0
+            }
+            pub fn is_dir(&self) -> bool {
+                !self.0
+            }
+            pub fn is_symlink(&self) -> bool {
+                false
+            }
+        }
+
+        #[derive(Clone, Debug)]
+        pub struct Metadata(Option<(u64, web_time::SystemTime)>);
+        impl Metadata {
+            pub fn len(&self) -> u64 {
+                self.0.map_or(0, |(n, _)| n)
+            }
+            pub fn is_file(&self) -> bool {
+                self.0.is_some()
+            }
+            pub fn is_dir(&self) -> bool {
+                self.0.is_none()
+            }
+            pub fn file_type(&self) -> FileType {
+                FileType(self.is_file())
+            }
+            pub fn modified(&self) -> io::Result<web_time::SystemTime> {
+                Ok(self.0.map_or(web_time::SystemTime::UNIX_EPOCH, |(_, t)| t))
+            }
+        }
+
+        pub fn metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, at)) => Ok(Metadata(Some((bytes.len() as u64, *at)))),
+                Some(Entry::Dir) => Ok(Metadata(None)),
+                None => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn symlink_metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            metadata(p)
+        }
+
+        pub struct DirEntry(PathBuf, bool, u64, web_time::SystemTime);
+        impl DirEntry {
+            pub fn path(&self) -> PathBuf {
+                self.0.clone()
+            }
+            pub fn file_name(&self) -> ::std::ffi::OsString {
+                self.0.file_name().unwrap_or_default().to_owned()
+            }
+            pub fn file_type(&self) -> io::Result<FileType> {
+                Ok(FileType(self.1))
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                Ok(Metadata(self.1.then_some((self.2, self.3))))
+            }
+        }
+
+        pub struct ReadDir(::std::vec::IntoIter<DirEntry>);
+        impl Iterator for ReadDir {
+            type Item = io::Result<DirEntry>;
+            fn next(&mut self) -> Option<Self::Item> {
+                self.0.next().map(Ok)
+            }
+        }
+
+        pub fn read_dir<P: AsRef<Path>>(p: P) -> io::Result<ReadDir> {
+            let dir = key(p.as_ref());
+            TREE.with(|t| {
+                let t = t.borrow();
+                if !matches!(t.entries.get(&dir), Some(Entry::Dir)) {
+                    return Err(missing(p.as_ref()));
+                }
+                let kids: Vec<DirEntry> = t
+                    .entries
+                    .iter()
+                    .filter(|(k, _)| k.parent() == Some(dir.as_path()) && **k != dir)
+                    .map(|(k, e)| match e {
+                        Entry::File(bytes, at) => DirEntry(k.clone(), true, bytes.len() as u64, *at),
+                        Entry::Dir => DirEntry(k.clone(), false, 0, web_time::SystemTime::UNIX_EPOCH),
+                    })
+                    .collect();
+                Ok(ReadDir(kids.into_iter()))
+            })
+        }
+
+        /// What `OpenOptions` asked for.
+        #[derive(Clone, Default)]
+        pub struct OpenOptions {
+            read: bool,
+            write: bool,
+            append: bool,
+            truncate: bool,
+            create: bool,
+            create_new: bool,
+        }
+
+        impl OpenOptions {
+            pub fn new() -> Self {
+                Self::default()
+            }
+            pub fn read(&mut self, on: bool) -> &mut Self {
+                self.read = on;
+                self
+            }
+            pub fn write(&mut self, on: bool) -> &mut Self {
+                self.write = on;
+                self
+            }
+            pub fn append(&mut self, on: bool) -> &mut Self {
+                self.append = on;
+                self
+            }
+            pub fn truncate(&mut self, on: bool) -> &mut Self {
+                self.truncate = on;
+                self
+            }
+            pub fn create(&mut self, on: bool) -> &mut Self {
+                self.create = on;
+                self
+            }
+            pub fn create_new(&mut self, on: bool) -> &mut Self {
+                self.create_new = on;
+                self
+            }
+            pub fn open<P: AsRef<Path>>(&self, p: P) -> io::Result<File> {
+                let there = metadata(p.as_ref()).is_ok_and(|m| m.is_file());
+                if self.create_new && there {
+                    return Err(io::Error::new(io::ErrorKind::AlreadyExists, "the file exists"));
+                }
+                if !there && !(self.create || self.create_new) {
+                    return Err(missing(p.as_ref()));
+                }
+                let kept = if there && !self.truncate { read(p.as_ref())? } else { Vec::new() };
+                let mut data = Cursor::new(kept);
+                if self.append {
+                    data.seek(SeekFrom::End(0))?;
+                }
+                let to = (self.write || self.append).then(|| key(p.as_ref()));
+                if to.is_some() && (!there || self.truncate) {
+                    write(p.as_ref(), [])?;
+                }
+                Ok(File { data, to, dirty: false })
+            }
+        }
+
+        /// A file's bytes, read whole when it opens; one opened to write is stored when flushed or dropped.
+        pub struct File {
+            data: Cursor<Vec<u8>>,
+            /// Where written bytes go, for a file opened to write.
+            to: Option<PathBuf>,
+            dirty: bool,
+        }
+
+        impl File {
+            pub fn open<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                Ok(File { data: Cursor::new(read(p)?), to: None, dirty: false })
+            }
+            pub fn create<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                OpenOptions::new().write(true).create(true).truncate(true).open(p)
+            }
+            pub fn options() -> OpenOptions {
+                OpenOptions::new()
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                Ok(Metadata(Some((self.data.get_ref().len() as u64, web_time::SystemTime::now()))))
+            }
+            /// The bytes are stored when the file is flushed or dropped.
+            pub fn sync_all(&self) -> io::Result<()> {
+                Ok(())
+            }
+            pub fn set_len(&self, _: u64) -> io::Result<()> {
+                Ok(())
+            }
+            pub fn set_modified(&self, at: web_time::SystemTime) -> io::Result<()> {
+                if let Some(to) = &self.to {
+                    with(|t| {
+                        if let Some(Entry::File(_, when)) = t.entries.get_mut(to) {
+                            *when = at;
+                        }
+                    });
+                }
+                Ok(())
+            }
+            fn store(&mut self) {
+                if let (true, Some(to)) = (self.dirty, &self.to) {
+                    let _ = write(to, self.data.get_ref());
+                    self.dirty = false;
+                }
+            }
+        }
+
+        impl Read for File {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                self.data.read(buf)
+            }
+        }
+
+        impl Seek for File {
+            fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+                self.data.seek(pos)
+            }
+        }
+
+        impl Write for File {
+            fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+                if self.to.is_none() {
+                    return Err(io::Error::new(io::ErrorKind::PermissionDenied, "the file is open to read"));
+                }
+                self.dirty = true;
+                self.data.write(buf)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                self.store();
+                Ok(())
+            }
+        }
+
+        impl Drop for File {
+            fn drop(&mut self) {
+                self.store();
+            }
+        }
+    }
+}
+
+/// `exists`, `is_file` and `is_dir` of a `PathBuf`, from the in-memory files: `Path`'s own ask the real file system (std's, not
+/// shadowed here), which has none. A trait's method is found before the `Path` a `PathBuf` derefs to, so this answers for a
+/// `PathBuf` (a `&Path` still asks std's): the modules whose paths come from `join` or a directory's entries take it in with `std`.
+pub trait PathExt {
+    fn exists(&self) -> bool;
+    fn is_file(&self) -> bool;
+    fn is_dir(&self) -> bool;
+}
+
+impl PathExt for ::std::path::PathBuf {
+    fn exists(&self) -> bool {
+        std::fs::metadata(self).is_ok()
+    }
+    fn is_file(&self) -> bool {
+        std::fs::metadata(self).is_ok_and(|m| m.is_file())
+    }
+    fn is_dir(&self) -> bool {
+        std::fs::metadata(self).is_ok_and(|m| m.is_dir())
+    }
+}
+
+/// `pollster`, polling once: what a page can't wait for gives its type's default (no GPU error, no adapters).
+pub mod pollster {
+    use ::std::future::Future;
+    use ::std::pin::pin;
+    use ::std::task::{Context, Poll, Waker};
+
+    pub fn block_on<F: Future>(f: F) -> F::Output
+    where
+        F::Output: Default,
+    {
+        match pin!(f).poll(&mut Context::from_waker(Waker::noop())) {
+            Poll::Ready(v) => v,
+            Poll::Pending => F::Output::default(),
+        }
+    }
+}
