+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! arboard's system clipboard as a page has it (Playground's browser build of ProCraft, patches/procreate.yaml): there is
+//! none to read, so no clipboard can be made and the pictures, files and text pasted from outside the app say so.
+
+use std::borrow::Cow;
+use std::path::PathBuf;
+
+#[derive(Debug)]
+pub struct Error;
+
+pub struct ImageData<'a> {
+    pub width: usize,
+    pub height: usize,
+    pub bytes: Cow<'a, [u8]>,
+}
+
+pub struct Clipboard;
+
+pub struct Get;
+
+impl Clipboard {
+    pub fn new() -> Result<Clipboard, Error> {
+        Err(Error)
+    }
+    pub fn get_text(&mut self) -> Result<String, Error> {
+        Err(Error)
+    }
+    pub fn get_image(&mut self) -> Result<ImageData<'static>, Error> {
+        Err(Error)
+    }
+    pub fn get(&mut self) -> Get {
+        Get
+    }
+}
+
+impl Get {
+    pub fn file_list(self) -> Result<Vec<PathBuf>, Error> {
+        Err(Error)
+    }
+}
