+# ProCraft in the browser, for Playground (patches/procreate.yaml in the openplayground repository).
+# Build with: trunk build --release   (from the repository's root)
+[build]
+target = "index.html"
+public_url = "./"
+filehash = true
+dist = "target/trunk-dist"
