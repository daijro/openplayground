+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+  <title>ProCraft</title>
+  <!-- ProCraft in the browser, for Playground (patches/procreate.yaml in the openplayground repository). -->
+  <link data-trunk rel="rust" href="desktop/Cargo.toml" data-bin="procraft" data-wasm-opt="0" />
+  <link data-trunk rel="icon" href="assets/app-icon/procraft-256.png" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #0b0b0c; }
+    #procraft_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; touch-action: none; }
+    #procraft_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #efe9dc; font: 14px system-ui, sans-serif; pointer-events: none; text-align: center; padding: 0 16px; }
+  </style>
+  <script>
+    // What winit leaves out of a pen: its pressure, eraser end and lean (PointerEvents, which winit's web backend gives as the
+    // mouse), kept for the brushes (desktop/src/web.rs: `procraftPen`, -1 while no pen is near). The Rust side asks for it
+    // before winit's own listener on the canvas has the event, as this one is on the window, in the capture phase.
+    for (const type of ['pointerdown', 'pointermove', 'pointerup', 'pointercancel', 'pointerleave']) {
+      addEventListener(type, (e) => {
+        const pen = e.pointerType === 'pen' && type !== 'pointerleave' && type !== 'pointercancel'
+        globalThis.procraftPen?.(pen ? (e.buttons ? e.pressure : 0) : -1, (e.buttons & 32) !== 0, e.tiltX, e.tiltY)
+      }, { capture: true, passive: true })
+    }
+    // Files dropped on the page (winit's web backend has no drops): to the app, as Files' "Open in ProCraft" are.
+    addEventListener('DOMContentLoaded', () => {
+      const canvas = document.getElementById('procraft_canvas')
+      canvas.addEventListener('dragover', (e) => e.preventDefault())
+      canvas.addEventListener('drop', async (e) => {
+        e.preventDefault()
+        for (const f of e.dataTransfer.files) globalThis.procraftOpened?.({ name: f.name, path: null, bytes: new Uint8Array(await f.arrayBuffer()) })
+      })
+    })
+  </script>
+</head>
+<body>
+  <canvas id="procraft_canvas"></canvas>
+  <div id="procraft_loading">Loading ProCraft&hellip;</div>
+</body>
+</html>
