+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground): what the GPU
+//! gives a page, which can't wait. The adapter and device can only be asked for without waiting, so the page's start asks
+//! for them ([`preload`]) before the app starts, and `Gpu::create` takes them where it would have blocked on
+//! `pollster::block_on`. And pixels can't be mapped and waited for either: see [`read`].
+
+use std::cell::RefCell;
+
+use procraft_engine::geom::IRect;
+use wasm_bindgen::JsCast;
+
+use crate::GpuError;
+use crate::canvas::Readback;
+
+thread_local! {
+    static PRELOADED: RefCell<Option<(wgpu::Instance, wgpu::Adapter, wgpu::Device, wgpu::Queue)>> = const { RefCell::new(None) };
+    static READER: RefCell<Option<Reader>> = const { RefCell::new(None) };
+}
+
+/// Asks the browser for the adapter and the device (the same the desktop asks for, `Gpu::create`'s).
+pub async fn preload() -> Result<(), GpuError> {
+    let mut desc = wgpu::InstanceDescriptor::new_without_display_handle();
+    desc.backends = wgpu::Backends::BROWSER_WEBGPU;
+    let instance = wgpu::Instance::new(desc);
+    let adapter = instance
+        .request_adapter(&wgpu::RequestAdapterOptions {
+            power_preference: wgpu::PowerPreference::HighPerformance,
+            force_fallback_adapter: false,
+            compatible_surface: None,
+            apply_limit_buckets: false,
+        })
+        .await
+        .map_err(|e| GpuError::NoAdapter(e.to_string()))?;
+    let (device, queue) = adapter
+        .request_device(&wgpu::DeviceDescriptor {
+            label: Some("procraft"),
+            required_features: adapter.features() & wgpu::Features::DUAL_SOURCE_BLENDING,
+            required_limits: adapter.limits(),
+            memory_hints: wgpu::MemoryHints::MemoryUsage,
+            ..Default::default()
+        })
+        .await
+        .map_err(|e| GpuError::Device(e.to_string()))?;
+    PRELOADED.with(|p| *p.borrow_mut() = Some((instance, adapter, device, queue)));
+    Ok(())
+}
+
+pub(crate) fn instance() -> wgpu::Instance {
+    PRELOADED.with(|p| p.borrow().as_ref().map(|(i, ..)| i.clone())).unwrap_or_else(|| {
+        let mut desc = wgpu::InstanceDescriptor::new_without_display_handle();
+        desc.backends = wgpu::Backends::BROWSER_WEBGPU;
+        wgpu::Instance::new(desc)
+    })
+}
+
+pub(crate) fn adapter() -> Result<wgpu::Adapter, GpuError> {
+    PRELOADED
+        .with(|p| p.borrow().as_ref().map(|(_, a, ..)| a.clone()))
+        .ok_or_else(|| GpuError::NoAdapter("WebGPU wasn't asked for".to_owned()))
+}
+
+pub(crate) fn device() -> Result<(wgpu::Device, wgpu::Queue), GpuError> {
+    PRELOADED
+        .with(|p| p.borrow().as_ref().map(|(_, _, d, q)| (d.clone(), q.clone())))
+        .ok_or_else(|| GpuError::Device("WebGPU wasn't asked for".to_owned()))
+}
+
+// ---- reading pixels back
+//
+// A page can't wait for the GPU: `map_async` answers in a later task, which a blocking readback never reaches. What it can
+// do at once is draw onto a canvas and read the canvas (`drawImage`, `getImageData`), which the browser answers by
+// waiting for the GPU itself. So a texture is read by drawing it onto a hidden canvas twice, its colour (alpha made 1) and
+// its alpha (as grey), and reading each: the pixels come back as they are, premultiplied, with nothing lost to the
+// canvas's own premultiplying. Everything that reads a texture goes through `start_reading_part`, which asks here instead.
+
+struct Reader {
+    /// The canvas the GPU draws on, and the one a 2D context copies it onto to read it.
+    canvas: web_sys::HtmlCanvasElement,
+    flat: web_sys::HtmlCanvasElement,
+    context: web_sys::CanvasRenderingContext2d,
+    surface: wgpu::Surface<'static>,
+    format: wgpu::TextureFormat,
+    pipeline: wgpu::RenderPipeline,
+    layout: wgpu::BindGroupLayout,
+    /// What each pass draws: 0 the colour, 1 the alpha.
+    modes: [wgpu::Buffer; 2],
+    size: (u32, u32),
+}
+
+const BLIT: &str = "
+@group(0) @binding(0) var source: texture_2d<f32>;
+@group(0) @binding(1) var<uniform> mode: vec4<u32>;
+@vertex fn vs(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    return vec4<f32>(p * 2.0 - 1.0, 0.0, 1.0);
+}
+@fragment fn fs(@builtin(position) at: vec4<f32>) -> @location(0) vec4<f32> {
+    let t = textureLoad(source, vec2<i32>(at.xy), 0);
+    if mode.x == 0u { return vec4<f32>(t.rgb, 1.0); }
+    return vec4<f32>(t.a, t.a, t.a, 1.0);
+}
+";
+
+fn reader(gpu: &crate::Gpu) -> Result<Reader, String> {
+    let document = web_sys::window().and_then(|w| w.document()).ok_or("no page")?;
+    let canvas: web_sys::HtmlCanvasElement = document.create_element("canvas").map_err(|_| "no canvas")?.unchecked_into();
+    // (a canvas has one kind of context: the 2D one that reads the picture is on a canvas of its own)
+    let flat: web_sys::HtmlCanvasElement = document.create_element("canvas").map_err(|_| "no canvas")?.unchecked_into();
+    let options = js_sys::Object::new();
+    js_sys::Reflect::set(&options, &"willReadFrequently".into(), &true.into()).map_err(|_| "no options")?;
+    let context: web_sys::CanvasRenderingContext2d = flat
+        .get_context_with_context_options("2d", &options)
+        .map_err(|_| "no 2d context")?
+        .ok_or("no 2d context")?
+        .unchecked_into();
+    let surface = gpu.instance.create_surface(wgpu::SurfaceTarget::Canvas(canvas.clone())).map_err(|e| e.to_string())?;
+    let formats = surface.get_capabilities(&gpu.adapter).formats;
+    let format = [wgpu::TextureFormat::Rgba8Unorm, wgpu::TextureFormat::Bgra8Unorm]
+        .into_iter()
+        .find(|f| formats.contains(f))
+        .ok_or("the canvas takes no 8-bit format")?;
+    let device = &gpu.device;
+    let entry = |binding, ty| wgpu::BindGroupLayoutEntry {
+        binding,
+        visibility: wgpu::ShaderStages::FRAGMENT,
+        ty,
+        count: None,
+    };
+    let layout = device.create_bind_group_layout(&wgpu::BindGroupLayoutDescriptor {
+        label: Some("read back"),
+        entries: &[
+            entry(
+                0,
+                wgpu::BindingType::Texture {
+                    sample_type: wgpu::TextureSampleType::Float { filterable: false },
+                    view_dimension: wgpu::TextureViewDimension::D2,
+                    multisampled: false,
+                },
+            ),
+            entry(
+                1,
+                wgpu::BindingType::Buffer {
+                    ty: wgpu::BufferBindingType::Uniform,
+                    has_dynamic_offset: false,
+                    min_binding_size: None,
+                },
+            ),
+        ],
+    });
+    let module = device.create_shader_module(wgpu::ShaderModuleDescriptor {
+        label: Some("read back"),
+        source: wgpu::ShaderSource::Wgsl(BLIT.into()),
+    });
+    let pipeline_layout = device.create_pipeline_layout(&wgpu::PipelineLayoutDescriptor {
+        label: Some("read back"),
+        bind_group_layouts: &[Some(&layout)],
+        immediate_size: 0,
+    });
+    let pipeline = device.create_render_pipeline(&wgpu::RenderPipelineDescriptor {
+        label: Some("read back"),
+        layout: Some(&pipeline_layout),
+        vertex: wgpu::VertexState {
+            module: &module,
+            entry_point: Some("vs"),
+            compilation_options: Default::default(),
+            buffers: &[],
+        },
+        fragment: Some(wgpu::FragmentState {
+            module: &module,
+            entry_point: Some("fs"),
+            compilation_options: Default::default(),
+            targets: &[Some(format.into())],
+        }),
+        primitive: wgpu::PrimitiveState::default(),
+        depth_stencil: None,
+        multisample: wgpu::MultisampleState::default(),
+        multiview_mask: None,
+        cache: None,
+    });
+    let mode = |m: u32| {
+        let buffer = device.create_buffer(&wgpu::BufferDescriptor {
+            label: Some("read back mode"),
+            size: 16,
+            usage: wgpu::BufferUsages::UNIFORM | wgpu::BufferUsages::COPY_DST,
+            mapped_at_creation: false,
+        });
+        gpu.queue.write_buffer(&buffer, 0, &[m.to_le_bytes(), [0; 4], [0; 4], [0; 4]].concat());
+        buffer
+    };
+    Ok(Reader { canvas, flat, context, surface, format, pipeline, layout, modes: [mode(0), mode(1)], size: (0, 0) })
+}
+
+impl Reader {
+    /// What the hidden canvas shows after `pass` (0 the colour, 1 the alpha) over `source`, as `getImageData` gives it.
+    fn draw(&mut self, gpu: &crate::Gpu, source: &wgpu::TextureView, size: (u32, u32), pass: usize) -> Result<Vec<u8>, String> {
+        if self.size != size {
+            self.surface.configure(
+                &gpu.device,
+                &wgpu::SurfaceConfiguration {
+                    usage: wgpu::TextureUsages::RENDER_ATTACHMENT,
+                    format: self.format,
+                    width: size.0,
+                    height: size.1,
+                    present_mode: wgpu::PresentMode::Fifo,
+                    desired_maximum_frame_latency: 2,
+                    alpha_mode: wgpu::CompositeAlphaMode::Opaque,
+                    color_space: wgpu::SurfaceColorSpace::default(),
+                    view_formats: Vec::new(),
+                },
+            );
+            self.flat.set_width(size.0);
+            self.flat.set_height(size.1);
+            self.size = size;
+        }
+        let (wgpu::CurrentSurfaceTexture::Success(frame) | wgpu::CurrentSurfaceTexture::Suboptimal(frame)) =
+            self.surface.get_current_texture()
+        else {
+            return Err("the canvas gave no picture to draw on".to_owned());
+        };
+        let target = frame.texture.create_view(&wgpu::TextureViewDescriptor::default());
+        let group = gpu.device.create_bind_group(&wgpu::BindGroupDescriptor {
+            label: Some("read back"),
+            layout: &self.layout,
+            entries: &[
+                wgpu::BindGroupEntry { binding: 0, resource: wgpu::BindingResource::TextureView(source) },
+                wgpu::BindGroupEntry { binding: 1, resource: self.modes[pass].as_entire_binding() },
+            ],
+        });
+        let mut encoder = gpu.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("read back") });
+        {
+            let mut drawing = encoder.begin_render_pass(&wgpu::RenderPassDescriptor {
+                label: Some("read back"),
+                color_attachments: &[Some(wgpu::RenderPassColorAttachment {
+                    view: &target,
+                    depth_slice: None,
+                    resolve_target: None,
+                    ops: wgpu::Operations { load: wgpu::LoadOp::Clear(wgpu::Color::BLACK), store: wgpu::StoreOp::Store },
+                })],
+                depth_stencil_attachment: None,
+                timestamp_writes: None,
+                occlusion_query_set: None,
+                multiview_mask: None,
+            });
+            drawing.set_pipeline(&self.pipeline);
+            drawing.set_bind_group(0, &group, &[]);
+            drawing.draw(0..3, 0..1);
+        }
+        gpu.queue.submit([encoder.finish()]);
+        self.context.draw_image_with_html_canvas_element(&self.canvas, 0.0, 0.0).map_err(|_| "drawImage failed")?;
+        let data = self
+            .context
+            .get_image_data(0.0, 0.0, f64::from(size.0), f64::from(size.1))
+            .map_err(|_| "getImageData failed")?;
+        drop(frame);
+        Ok(data.data().0)
+    }
+}
+
+/// `rect` of `texture`, read back at once (4 bytes a pixel, premultiplied, rows top to bottom without padding).
+pub(crate) fn read(gpu: &crate::Gpu, texture: &wgpu::Texture, rect: IRect) -> Readback {
+    let (width, height) = (rect.width(), rect.height());
+    let done = READER.with(|r| -> Result<Vec<u8>, String> {
+        let mut r = r.borrow_mut();
+        if r.is_none() {
+            *r = Some(reader(gpu)?);
+        }
+        let reader = r.as_mut().ok_or("no reader")?;
+        // a copy of the part wanted, which the shader can sample whatever the texture's own usage
+        let size = wgpu::Extent3d { width, height, depth_or_array_layers: 1 };
+        let copy = gpu.device.create_texture(&wgpu::TextureDescriptor {
+            label: Some("read back"),
+            size,
+            mip_level_count: 1,
+            sample_count: 1,
+            dimension: wgpu::TextureDimension::D2,
+            format: texture.format(),
+            usage: wgpu::TextureUsages::COPY_DST | wgpu::TextureUsages::TEXTURE_BINDING,
+            view_formats: &[],
+        });
+        let mut encoder = gpu.device.create_command_encoder(&wgpu::CommandEncoderDescriptor { label: Some("read back") });
+        encoder.copy_texture_to_texture(
+            wgpu::TexelCopyTextureInfo {
+                texture,
+                mip_level: 0,
+                origin: wgpu::Origin3d { x: rect.x0.max(0) as u32, y: rect.y0.max(0) as u32, z: 0 },
+                aspect: wgpu::TextureAspect::All,
+            },
+            copy.as_image_copy(),
+            size,
+        );
+        gpu.queue.submit([encoder.finish()]);
+        let view = copy.create_view(&wgpu::TextureViewDescriptor::default());
+        let mut pixels = reader.draw(gpu, &view, (width, height), 0)?;
+        let alpha = reader.draw(gpu, &view, (width, height), 1)?;
+        for (p, a) in pixels.chunks_exact_mut(4).zip(alpha.chunks_exact(4)) {
+            p[3] = a[0];
+        }
+        Ok(pixels)
+    });
+    match done {
+        Ok(pixels) => Readback::Ready(pixels),
+        Err(why) => Readback::Failed(why),
+    }
+}
