@@ -0,0 +1,298 @@
+// SPDX-License-Identifier: MIT OR Apache-2.0
+//! ProCraft in the browser, for Playground (patches/procreate.yaml in github.com/daijro/openplayground): the page's side.
+//!
+//! Files live in memory (procraft-engine's `playground::std::fs`): the gallery's artworks, settings and what comes in from
+//! Files or a drop (under `/files` and `/uploads`). The open dialogs (Open, Import, the pictures, brushes and palettes'
+//! pickers) ask Playground's Open and answer nothing at once (the `playground-rfd` stand-in notes what they asked):
+//! what it gives comes in as files dropped on the window, as "Open in ProCraft" and files dropped on the page do. The save
+//! dialogs answer at once with a path under `/downloads`; what the app writes there goes to Playground's Save As after
+//! the frame (a painting saved to Files is kept up to date there by the next Save). The artwork's unsaved state is
+//! reported with `setUnsaved`. A pen's pressure (PointerEvent.pressure, kept by index.html) reaches the brushes.
+
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+use std::path::{Path, PathBuf};
+
+use procraft_engine::playground::std::fs;
+use wasm_bindgen::closure::Closure;
+use wasm_bindgen::{JsCast, JsValue};
+use winit::event_loop::EventLoopProxy;
+
+use super::App;
+
+/// Where the save dialogs say a file goes (`playground-rfd`'s).
+const DOWNLOADS: &str = "/downloads";
+/// Where files from Files are kept: `browser:/Art/Sky.procraft` is `/files/Art/Sky.procraft`.
+const FILES: &str = "/files";
+/// Where a file from the computer (Open's "From computer…", a drop) is kept.
+const UPLOADS: &str = "/uploads";
+/// The pictures an artwork can be made of.
+const PICTURES: [&str; 8] = ["png", "jpg", "jpeg", "webp", "gif", "bmp", "tif", "tiff"];
+
+/// A file that came in: where it is, and whether it opens as an artwork of its own (Files' "Open in ProCraft", an answer
+/// to an artwork's Open) rather than as a drop on the window does (a picture dropped on a canvas is a layer).
+struct Incoming(PathBuf, bool);
+
+thread_local! {
+    static INCOMING: RefCell<Vec<Incoming>> = const { RefCell::new(Vec::new()) };
+    static PROXY: RefCell<Option<EventLoopProxy<()>>> = const { RefCell::new(None) };
+    /// Where each painting saved to Files goes on the next Save: `/downloads/Sky.procraft` is `browser:/Art/Sky.procraft`.
+    static KEPT: RefCell<HashMap<PathBuf, String>> = RefCell::new(HashMap::new());
+    /// Whether there is work Files (or the downloads) doesn't have, as last reported.
+    static UNSAVED: Cell<bool> = const { Cell::new(false) };
+    /// The artwork last looked at and its edits then, and whether it changed since a save.
+    static WATCHED: Cell<(usize, u64)> = const { Cell::new((0, 0)) };
+    static DIRTY: Cell<bool> = const { Cell::new(false) };
+}
+
+/// The console's log: warnings and errors where the browser shows them as such.
+struct Console;
+
+impl log::Log for Console {
+    fn enabled(&self, m: &log::Metadata) -> bool {
+        m.level() <= log::Level::Info && !m.target().starts_with("wgpu") && !m.target().starts_with("naga")
+    }
+    fn log(&self, r: &log::Record) {
+        if self.enabled(r.metadata()) {
+            let line = JsValue::from_str(&format!("[{}] {}", r.level(), r.args()));
+            match r.level() {
+                log::Level::Error => web_sys::console::error_1(&line),
+                log::Level::Warn => web_sys::console::warn_1(&line),
+                _ => web_sys::console::log_1(&line),
+            }
+        }
+    }
+    fn flush(&self) {}
+}
+
+/// The loading note (index.html's), if it is still there.
+fn note() -> Option<web_sys::Element> {
+    web_sys::window()?.document()?.get_element_by_id("procraft_loading")
+}
+
+/// Said on the page where the loading note is.
+fn say(text: &str) {
+    if let Some(note) = note() {
+        note.set_text_content(Some(text));
+    }
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(fields: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in fields {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn types(types: &[String]) -> JsValue {
+    types.iter().map(|t| JsValue::from(t.to_ascii_lowercase())).collect::<js_sys::Array>().into()
+}
+
+fn bytes(b: &[u8]) -> JsValue {
+    js_sys::Uint8Array::from(b).into()
+}
+
+/// Wakes the window's loop, which looks at what came in as it finishes whatever it wakes for.
+fn wake() {
+    PROXY.with(|p| {
+        if let Some(p) = p.borrow().as_ref() {
+            let _ = p.send_event(());
+        }
+    });
+}
+
+/// A file from Playground (`{ path, name, bytes }`) into memory: one in Files at its place there, one from the computer in
+/// /uploads.
+fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let path = match get(file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(str::to_owned)) {
+        Some(p) => Path::new(FILES).join(p.trim_start_matches('/')),
+        None => Path::new(UPLOADS).join(Path::new(&name).file_name()?),
+    };
+    fs::put(&path, js_sys::Uint8Array::new(&get(file, "bytes")).to_vec());
+    Some(path)
+}
+
+fn come_in(path: PathBuf, as_artwork: bool) {
+    INCOMING.with_borrow_mut(|i| i.push(Incoming(path, as_artwork)));
+    wake();
+}
+
+/// Playground's Open, for an open dialog of the app's: what it picks comes in as files dropped on the window (or, for the
+/// artworks' Open, as artworks).
+fn ask_open(extensions: Vec<String>) {
+    let as_artwork = extensions.iter().any(|e| e == "procraft");
+    let asked = call("open", &[options(&[("types", types(&extensions))])]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let Some(list) = wait(asked).await else { return };
+        for file in js_sys::Array::from(&list).iter() {
+            if let Some(path) = bring_in(&file) {
+                come_in(path, as_artwork);
+            }
+        }
+    });
+}
+
+/// What the app wrote under /downloads: Playground's Save As, then into Files where it was put (and kept up to date there
+/// by the next save of the same painting).
+fn save_as(written: PathBuf, data: Vec<u8>) {
+    let name = written.file_name().and_then(|n| n.to_str()).unwrap_or("Untitled").to_owned();
+    let ext = written.extension().and_then(|e| e.to_str()).map(str::to_owned);
+    let painting = ext.as_deref() == Some("procraft");
+    if let Some(to) = KEPT.with_borrow(|k| k.get(&written).cloned()).filter(|_| painting) {
+        call("write", &[to.as_str().into(), bytes(&data)]);
+        DIRTY.set(false);
+        wake();
+        return;
+    }
+    let asked = call("saveAs", &[options(&[("name", name.as_str().into()), ("types", types(ext.as_slice())), ("bytes", bytes(&data))])]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let answer = wait(asked).await;
+        match answer.as_ref().and_then(|a| get(a, "path").as_string()) {
+            Some(to) => {
+                call("write", &[to.as_str().into(), bytes(&data)]);
+                if painting {
+                    KEPT.with_borrow_mut(|k| k.insert(written, to));
+                    DIRTY.set(false);
+                }
+            }
+            // downloaded (the shell did it, from the bytes it was given): the next save asks again
+            None if answer.is_some() => {
+                KEPT.with_borrow_mut(|k| k.remove(&written));
+                DIRTY.set(false);
+            }
+            None => {}
+        }
+        wake();
+    });
+}
+
+impl App {
+    /// After each event the loop handles: what the open dialogs asked, what came in from Files or a drop, what the app wrote
+    /// for the downloads, and whether there is unsaved work.
+    pub(super) fn web_after(&mut self) {
+        for asked in playground_rfd::asked() {
+            ask_open(asked.extensions);
+        }
+        let incoming = INCOMING.take();
+        if !incoming.is_empty() {
+            let (artworks, others): (Vec<_>, Vec<_>) = incoming.into_iter().partition(|Incoming(path, as_artwork)| {
+                let ext = path.extension().and_then(|e| e.to_str()).unwrap_or_default().to_ascii_lowercase();
+                matches!(ext.as_str(), "procraft" | "procreate" | "psd") || (*as_artwork && PICTURES.contains(&ext.as_str()))
+            });
+            if !artworks.is_empty() {
+                let folder = if self.session.is_some() { self.artwork_folder() } else { self.gallery.folder() };
+                self.import(artworks.into_iter().map(|Incoming(p, _)| p).collect(), folder);
+            }
+            self.dropped.extend(others.into_iter().map(|Incoming(p, _)| p));
+            if let Some(screen) = &self.screen {
+                screen.window.request_redraw();
+            }
+        }
+        for path in fs::changes() {
+            let name = path.to_string_lossy();
+            if !path.starts_with(DOWNLOADS) || name.ends_with(".part") || name.ends_with(".tmp") {
+                continue;
+            }
+            if let Some(data) = fs::metadata(&path).ok().filter(|m| m.is_file()).and_then(|_| fs::take(&path)) {
+                save_as(path, data);
+            }
+        }
+        // work since the last save: an artwork whose edits changed (the gallery here lasts only as long as the page)
+        if let Some(session) = &self.session {
+            let now = (std::sync::Arc::as_ptr(session) as usize, session.edits());
+            let before = WATCHED.replace(now);
+            if before.0 == now.0 && before.1 != now.1 {
+                DIRTY.set(true);
+            }
+        }
+        if DIRTY.get() != UNSAVED.get() {
+            UNSAVED.set(DIRTY.get());
+            call("setUnsaved", &[DIRTY.get().into()]);
+        }
+    }
+}
+
+/// `main` on the page: asks for the GPU, then starts the app on the canvas (`run`, the desktop's `main`).
+pub fn start() {
+    std::panic::set_hook(Box::new(|info| {
+        web_sys::console::error_1(&JsValue::from_str(&format!("panicked: {info}")));
+        say(&format!("ProCraft stopped: {info}"));
+    }));
+    let _ = log::set_logger(&Console).map(|()| log::set_max_level(log::LevelFilter::Info));
+    let webgpu = web_sys::window()
+        .and_then(|w| js_sys::Reflect::get(&w.navigator(), &"gpu".into()).ok())
+        .is_some_and(|g| !g.is_undefined());
+    if !webgpu {
+        say("ProCraft needs WebGPU, which this browser doesn't have (Chrome, Edge or Safari 26 do).");
+        return;
+    }
+    // Files' "Open in ProCraft" and a file dropped on the page (index.html passes it on)
+    let opened = Closure::<dyn Fn(JsValue)>::new(|file: JsValue| {
+        if let Some(path) = bring_in(&file) {
+            come_in(path, get(&file, "path").is_string());
+        }
+    })
+    .into_js_value();
+    let _ = js_sys::Reflect::set(&js_sys::global(), &"procraftOpened".into(), &opened);
+    call("onOpen", &[opened]);
+    // a pen's pressure, eraser end and lean, from index.html: what moves the mouse pointer is then a pen (as a tablet's under X11)
+    let pen = Closure::<dyn Fn(f64, bool, f64, f64)>::new(|pressure: f64, eraser: bool, tilt_x: f64, tilt_y: f64| {
+        if pressure < 0.0 {
+            crate::pen::set_mouse_pen(None);
+            return;
+        }
+        let tilt = (tilt_x.to_radians().tan().powi(2) + tilt_y.to_radians().tan().powi(2)).sqrt().atan() as f32;
+        let towards = tilt_x.atan2(-tilt_y) as f32;
+        crate::pen::set_mouse_pen(Some((crate::pen::MousePen { pressure: pressure as f32, eraser }, (tilt, towards))));
+    })
+    .into_js_value();
+    let _ = js_sys::Reflect::set(&js_sys::global(), &"procraftPen".into(), &pen);
+    wasm_bindgen_futures::spawn_local(async {
+        match procraft_gpu::web::preload().await {
+            Ok(()) => {
+                if let Some(note) = note() {
+                    note.remove();
+                }
+                super::run();
+            }
+            Err(e) => say(&format!("ProCraft can't use the GPU: {e}")),
+        }
+    });
+}
+
+/// The window's loop, which `come_in` wakes.
+pub fn keep_proxy(proxy: EventLoopProxy<()>) {
+    PROXY.set(Some(proxy));
+}
+
+/// Lets the canvas follow the page: the window's first size is a fixed one, which the page's own style (100%) replaces.
+pub fn fit() {
+    if let Some(canvas) = canvas() {
+        let style = canvas.style();
+        let _ = style.remove_property("width");
+        let _ = style.remove_property("height");
+    }
+}
+
+/// The canvas the app draws on (index.html's).
+pub fn canvas() -> Option<web_sys::HtmlCanvasElement> {
+    web_sys::window()?.document()?.get_element_by_id("procraft_canvas")?.dyn_into().ok()
+}
