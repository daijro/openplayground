+<!DOCTYPE html>
+<html lang="en">
+<head>
+  <meta charset="utf-8">
+  <meta name="viewport" content="width=device-width, initial-scale=1, user-scalable=no">
+  <title>Pro Wave</title>
+  <!-- Pro Wave in the browser, for Playground (patches/logic-pro.yaml in github.com/daijro/openplayground). -->
+  <link data-trunk rel="rust" href="crates/prowave-app/Cargo.toml" data-bin="prowave" data-wasm-opt="0" />
+  <link data-trunk rel="icon" href="crates/prowave-app/assets/icon-256.png" />
+  <style>
+    html, body { margin: 0; padding: 0; width: 100%; height: 100%; overflow: hidden; background: #3a3a3c; }
+    #prowave_canvas { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }
+    #prowave_loading { position: absolute; inset: 0; display: flex; align-items: center; justify-content: center;
+      color: #dcdcdc; font: 14px system-ui, sans-serif; pointer-events: none; }
+  </style>
+  <script>
+    // Browsers keep a page's audio off until the person clicks or types: the engine's AudioContext starts then.
+    {
+      const contexts = []
+      if (window.AudioContext) window.AudioContext = class extends window.AudioContext {
+        constructor(...args) { super(...args); contexts.push(this) }
+      }
+      const resume = () => contexts.forEach((c) => c.state === 'suspended' && c.resume().catch(() => {}))
+      for (const type of ['pointerdown', 'keydown', 'touchend']) addEventListener(type, resume, { capture: true })
+    }
+  </script>
+</head>
+<body>
+  <canvas id="prowave_canvas"></canvas>
+  <div id="prowave_loading">Loading Pro Wave&hellip;</div>
