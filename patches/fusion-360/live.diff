+    /// An app with a sketch, as the session sees it.
+    fn app() -> App<SolveApp> {
+        let mut app = SolveApp::new(Session::default(), Services::default());
+        app.run("sketch.create", json!({"plane": "XY"})).unwrap();
+        app.run("sketch.line", json!({"points": [[0, 0], [10, 0]]})).unwrap();
+        app.finish_sketch();
+        App { shell: app, get: |a| a, get_mut: |a| a }
+    }
+
+    /// The app under test, its active design shared (as the owner's is), on a page of its own.
+    fn bound() -> App<SolveApp> {
+        SHARED.take();
+        let mut a = app();
+        let doc = a.live_document();
+        a.live_adopt(doc).unwrap();
+        a
+    }
+
+    /// Another peer: a design holding `design` (one of a shared document's), changed by `cmd`.
+    fn peer(design: &Value, cmd: &str, p: Value) -> Value {
+        let mut x = app();
+        install(&mut x.session, None,super::design(design.clone()).unwrap());
+        x.run(cmd, p).unwrap();
+        project(&x.session.doc)
+    }
+
+    /// `document` with its first design replaced by `design`.
+    fn with_first(document: &Value, design: Value) -> Value {
+        let mut d = document.clone();
+        let id = d["documents"][0]["id"].clone();
+        d["documents"][0] = design;
+        d["documents"][0]["id"] = id;
+        d
+    }
+
+    fn first(app: &App<SolveApp>) -> Value {
+        let mut d = app.live_document()["documents"][0].clone();
+        d.as_object_mut().unwrap().remove("id");
+        d
+    }
+
+    fn shared(app: &App<SolveApp>) -> Vec<u8> {
+        canonical(&app.live_document())
+    }
+
+    /// Switches the test to another page: this page's session goes into `saved`, `saved`'s comes in.
+    fn swap(saved: &mut Shared) {
+        SHARED.with_borrow_mut(|sh| std::mem::swap(sh, saved));
+    }
