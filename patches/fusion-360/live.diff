+        // A rectangle being drawn from (0, 0) to (10, 5): its rubber band, in the sketch's coordinates.
+        connect();
+        a.run("sketch.create", json!({"plane": "XY"})).unwrap();
+        let mut t = solidcraft_ui_egui::tools::Tool::for_command("sketch.rectangle.two_point").unwrap();
+        t.pts.push((Vec2::new(0.0, 0.0), None));
+        t.hover = Some((Vec2::new(10.0, 5.0), None));
+        a.tool = Some(t);
+        let ctx = egui::Context::default();
+        ctx.run_ui(egui::RawInput::default(), |ui| frame(&mut a, ui.ctx())).textures_delta.clear();
+        let band = a.live_presence()["band"].clone();
+        let xy: Vec<f64> = band.as_array().unwrap().iter().flat_map(|l| l.as_array().unwrap().iter().map(|x| x.as_f64().unwrap())).collect();
+        let corners: Vec<(f64, f64)> = xy.chunks(2).map(|p| (p[0], p[1])).collect();
+        for c in [(0.0, 0.0), (10.0, 0.0), (10.0, 5.0), (0.0, 5.0)] {
+            assert!(corners.iter().any(|q| (q.0 - c.0).abs() < 0.05 && (q.1 - c.1).abs() < 0.05), "{c:?} in {corners:?}");
+        }
+        // Off the model in a sketch, the pointer stays on the sketch's plane.
+        a.viewport.mouse = Some(egui::pos2(5.0, 5.0));
+        assert!(a.live_presence()["pointer"][2].as_f64().is_some_and(|z| z.abs() < 1e-3), "on XY");
+        disconnect();
+
+        // A 24 x 11 tab extruded 22 mm from the top of an 80 x 50 x 30 plate: the ghost is the tab's prism, not the plate.
+        let mut a = bound();
+        a.run(BOX.0, json!({"length": "80", "width": "50", "height": "30"})).unwrap();
+        a.run("sketch.create", json!({"plane": {"face": [40, 25, 30]}})).unwrap();
+        a.run("sketch.rectangle.two_point", json!({"p0": [6, 4], "p1": [30, 15]})).unwrap();
+        let sketch = a.session.active_sketch.unwrap();
+        a.finish_sketch();
+        // The tab's profile (the face's outline around it is another).
+        let st = world_state(&a.session);
+        let area = |p: &solidcraft_engine::sketch::Profile| {
+            let l = p.region.outer.polyline(1e-2);
+            l.iter().zip(l.iter().cycle().skip(1)).map(|(p, q)| p.x * q.y - q.x * p.y).sum::<f64>().abs()
+        };
+        let profiles = &st.sketch(sketch).unwrap().profiles;
+        let index = (0..profiles.len()).min_by(|i, j| area(&profiles[*i]).total_cmp(&area(&profiles[*j]))).unwrap();
+        connect();
+        a.start("solid.extrude");
+        let d = a.dialog.as_mut().unwrap();
+        d.inputs[0].items = vec![Sel::Profile { sketch, index }];
+        if let Kind::Extrude { distance, operation, .. } = &mut d.kind {
+            (*distance, *operation) = ("22 mm".into(), 1);
+        }
+        (a.viewport.rect, a.viewport.mouse) = (Some(rect), Some(egui::pos2(700.0, 500.0)));
+        for _ in 0..500 {
+            solidcraft_ui_egui::preview::update(&mut a, &ctx);
+            if a.preview.active && !a.preview.busy {
+                break;
+            }
+            std::thread::sleep(std::time::Duration::from_millis(10));
+        }
+        assert!(a.preview.active && a.preview.error.is_none(), "{:?}", a.preview.error);
+        let handle = egui::Rect::from_center_size(egui::pos2(400.0, 300.0), vec2(20.0, 20.0));
+        let input = |pressed: bool, at: egui::Pos2| egui::RawInput {
+            events: vec![
+                egui::Event::PointerMoved(at),
+                egui::Event::PointerButton { pos: at, button: egui::PointerButton::Primary, pressed, modifiers: Default::default() },
+            ],
+            ..Default::default()
+        };
+        let run = |input: egui::RawInput, a: &mut App<SolveApp>| {
+            let _ = ctx.run_ui(input, |ui| {
+                let _ = ui.interact(handle, egui::Id::new("sc_manipulator"), egui::Sense::drag());
+                frame(a, ui.ctx());
+            });
+        };
+        // egui hit-tests against the last pass's widgets: the handle is there before it is pressed.
+        run(egui::RawInput { events: vec![egui::Event::PointerMoved(handle.center())], ..Default::default() }, &mut a);
+        run(input(true, handle.center()), &mut a);
+        run(egui::RawInput { events: vec![egui::Event::PointerMoved(handle.center() - vec2(0.0, 30.0))], ..Default::default() }, &mut a);
+        let p = a.live_presence();
+        let mut prism = Aabb3::EMPTY;
+        for l in p["solid"].as_array().expect("a solid") {
+            let xyz: Vec<f64> = serde_json::from_value(l.clone()).unwrap();
+            xyz.chunks(3).for_each(|q| prism.add(Vec3::new(q[0], q[1], q[2])));
+        }
+        let mut size = [prism.size().x, prism.size().y, prism.size().z];
+        size.sort_by(f64::total_cmp);
+        assert!(size.iter().zip([11.0, 22.0, 24.0]).all(|(a, b)| (a - b).abs() < 0.01), "{prism:?}");
+        assert!((prism.min.z - 30.0).abs() < 0.01 && (prism.max.z - 52.0).abs() < 0.01, "{prism:?}");
+        assert!(p.get("box").is_none());
+        // The distance arrow dragged: the pointer is on it, where the value shows.
+        assert_eq!(p["pointer"], p["value"]["at"]);
+        run(input(false, handle.center()), &mut a);
+        assert_ne!(a.live_presence()["pointer"], p["value"]["at"], "let go, the pointer is the mouse's again");
+        disconnect();
+    }
+}
