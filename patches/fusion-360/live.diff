+//! Live editing in a Playground session (the web app's `live` module): every open design, and a design opened in a tab
+//! behind the others. Nothing here runs unless that module calls it.
+
+use solidcraft_engine::Session;
+
+use super::{DocSlot, MAX_OPEN};
+use crate::SolveApp;
+
+/// Each open design's session and Edit Sketch's saved timeline position, in tab order (the active one is the app's).
+pub fn designs(app: &SolveApp) -> Vec<(&Session, Option<Option<usize>>)> {
+    let active = (&app.session, app.session.sketch_restore_marker());
+    if app.docs.slots.is_empty() {
+        return vec![active];
+    }
+    app.docs.slots.iter().map(|s| s.as_ref().map_or(active, |d| (&d.session, d.session.sketch_restore_marker()))).collect()
+}
+
+/// [`designs`], to change.
+pub fn designs_mut(app: &mut SolveApp) -> Vec<(&mut Session, Option<Option<usize>>)> {
+    let SolveApp { session, docs, .. } = app;
+    let mut active = Some((session.sketch_restore_marker(), session));
+    if docs.slots.is_empty() {
+        return active.into_iter().map(|(m, s)| (s, m)).collect();
+    }
+    docs.slots.iter_mut().filter_map(|s| s.as_mut().map(|d| (d.session.sketch_restore_marker(), &mut d.session)).or_else(|| active.take())).map(|(m, s)| (s, m)).collect()
+}
+
+/// Opens `session` in a new last tab, leaving the active design as it is; its index.
+pub fn open_behind(app: &mut SolveApp, session: Session) -> Result<usize, String> {
+    if app.docs.slots.is_empty() {
+        app.docs.slots.push(None);
+        app.docs.active = 0;
+    }
+    if app.docs.slots.len() >= MAX_OPEN {
+        return Err(format!("at most {MAX_OPEN} designs can be open"));
+    }
+    app.docs.slots.push(Some(DocSlot::new(session)));
+    Ok(app.docs.slots.len() - 1)
+}
+
+/// The geometry types and the traits of their methods, as this checkout spells them (live-geom.diff).
+#[path = "documents_geom.rs"]
+pub mod geom;
