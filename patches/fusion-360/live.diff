+//! Live editing in a Playground session (the playground-live crate, patches/live/kit, drives it through [`App`]). The
+//! shared document is the set of designs open in the session, `{ documents: [{ id, ...design }] }`: the one shown when
+//! the session started and every design opened, created or imported here or by the others since (once it holds
+//! something), which reaches the others as a tab behind theirs. Each design is its parametric feature tree
+//! (`Session::doc`); every peer evaluates the bodies from it. A design's tab is found by a mark ([`mark`]) wherever it
+//! moves. Closing a tab is this person's own: the design stays in the session and up to date, and the start page lists
+//! it to open again. This person's own state stays out: the camera, selection and tools (outside the document anyway),
+//! what is hidden, each sketch's Sketch Palette options and the timeline position Edit Sketch rolled to. Each peer
+//! numbers new features, components and occurrences on from a point of its own ([`jump`]), and keeps its own `next_id`.
+//!
+//! Presence: the design and scope (component and sketch) each person is on, the pointer as a point in the model, the
+//! selection, and the gesture under way ([`gesture`]): a sketch shape's rubber band, sketch geometry being dragged, a
+//! feature dialog's value at its handle with the feature's own volume ([`volume`]), a component being moved. The others' show
+//! over the viewport in their colours, eased toward where they are; dots on the tabs show who is on which design.
+//! Pointers, name and value tags, selection outlines, colours and the easing are the kit's ([`presence`]); the ghosts of
+//! features (their edges, filled), sketch geometry being dragged and rubber bands are SolidCraft's own, in the kit's
+//! colours.
+
+use std::cell::{Cell, OnceCell, RefCell};
+use std::collections::{BTreeMap, BTreeSet};
+use std::hash::{Hash, Hasher};
+use std::sync::Arc;
+
+use egui::{Color32, Pos2, Rect, Shape, Stroke, pos2, vec2};
+use serde_json::{Map, Value, json};
+use solidcraft_engine::doc::{Document, FeatureKind};
+use solidcraft_engine::geom::Aabb3;
+#[allow(unused_imports)]
+use solidcraft_ui_egui::documents::live::geom::{Plane, Vec2, Vec3, traits::*, world_state};
+use solidcraft_engine::{Sel, Session};
+use solidcraft_ui_egui::dialogs::{self, Dialog, Kind};
+use solidcraft_ui_egui::documents::{self, live as tabs};
+use solidcraft_ui_egui::viewport::{self, Hit, Proj};
+use solidcraft_ui_egui::{SolveApp, canvas, scenario};
+
+use playground_live::{Live, Presence, canonical, presence};
+
+/// The app as the session sees it: the kit's [`Live`] can't go on SolveApp outside its crate, so it goes on this, around
+/// what holds the app (the web entry's shell, whose app `get` and `get_mut` give; in tests the app itself).
+pub struct App<T> {
+    shell: T,
+    get: fn(&T) -> &SolveApp,
+    get_mut: fn(&mut T) -> &mut SolveApp,
+}
+
+impl<T> std::ops::Deref for App<T> {
+    type Target = SolveApp;
+    fn deref(&self) -> &SolveApp {
+        (self.get)(&self.shell)
+    }
+}
+
+impl<T> std::ops::DerefMut for App<T> {
+    fn deref_mut(&mut self) -> &mut SolveApp {
+        (self.get_mut)(&mut self.shell)
+    }
+}
+
+/// A design of the session.
+struct Doc {
+    /// Its id in the session.
+    id: u64,
+    /// Its tab here ([`marker`]); `None` once this person closed it.
+    mark: Option<usize>,
+    /// Its tab's place as of the last frame.
+    at: usize,
+    /// As last seen (without the id): what the session goes on with while it is closed here.
+    last: Value,
+    /// What `last` was made from (the design, its revision and Edit Sketch's position), to skip unchanged ones.
+    seen: Option<(usize, u64, Option<Option<usize>>)>,
+}
+
+/// The session's designs as this page knows them, in the session's order.
+#[derive(Default)]
+struct Shared {
+    docs: Vec<Doc>,
+    /// Marks of the tabs open before the session started, which it does not share.
+    private: Vec<usize>,
+    /// The session started between frames: its first design is the active tab's, marked at the next frame.
+    claim: bool,
+    /// Tabs opened behind for the session and not shown yet: their view is fitted when they first are.
+    unfit: Vec<usize>,
+    /// For [`playground_live::fresh_id`].
+    next: u64,
+    /// Goes up whenever the list changes ([`Live::live_generation`]).
+    version: u64,
+}
+
+thread_local! {
+    static SHARED: RefCell<Shared> = RefCell::default();
+    /// The active design is the session's (or none is yet): Undo and Redo go to the session.
+    static ON_SHARED: Cell<bool> = const { Cell::new(true) };
+    /// The active design's mark and next id as this person last left it: another value means an id was taken since.
+    static NEXT: Cell<Option<(usize, u64)>> = const { Cell::new(None) };
+    /// This person's gesture under way, as of the last frame ([`gesture`]).
+    static GESTURE: RefCell<Map<String, Value>> = RefCell::default();
+    /// Where the pointer is on the page, as of the last frame: also over what the app draws inside the viewport (a value
+    /// box, a sketch's dimension inputs), which hides it from the viewport.
+    static OVER: Cell<Option<Pos2>> = const { Cell::new(None) };
+    /// The last feature volume worked out ([`volume`]) and what it was worked out from.
+    static VOLUME: RefCell<Option<(u64, Option<(&'static str, Value)>)>> = const { RefCell::new(None) };
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+}
+
+#[cfg(target_arch = "wasm32")]
+const FORMAT: &str = concat!("fusion-360:1:", env!("CARGO_PKG_VERSION"));
+/// The most bytes of a presence (the shell sends at most 4 KiB).
+const MAX_BYTES: usize = 3900;
+/// The most points of a gesture's lines, and the most lines; the most points of a feature's volume (3D, so fewer).
+const MAX_POINTS: usize = 150;
+const MAX_SOLID: usize = 90;
+const MAX_ITEMS: usize = 50;
+/// Numbers beyond this are not drawn (remote data).
+const FAR_OUT: f64 = 1e9;
+
+/// Marks a design's session: a do-nothing callback in `open_preview`, which only `doc.open` reads (and takes, as the
+/// design it was in is replaced). Its address names the design wherever its tab goes; closing or replacing the design
+/// drops it.
+fn mark(s: &mut Session) -> Option<usize> {
+    // A captured byte: the box is an allocation of its own, so each mark has its own address.
+    let token = 0u8;
+    s.open_preview = Some(Box::new(move |_| {
+        std::hint::black_box(token);
+    }));
+    marker(s)
+}
+
+fn marker(s: &Session) -> Option<usize> {
+    s.open_preview.as_deref().map(|f| f as *const _ as *const () as usize)
+}
+
+/// A design with nothing in it yet, which a session does not share until it has something (as the app's own test for
+/// a design it may replace).
+fn blank(s: &Session) -> bool {
+    s.path.is_none() && s.doc.features.is_empty() && s.doc.params.is_empty() && s.doc.components.is_empty() && !s.is_dirty()
+}
+
+/// A shared design as it was last seen with nothing in it.
+fn blank_value(v: &Value) -> bool {
+    ["features", "params", "components"].iter().all(|k| v[k].as_array().is_none_or(Vec::is_empty))
+}
+
+/// The session's id of the active design, when the session shares it.
+fn active_doc(app: &SolveApp) -> Option<u64> {
+    let m = marker(&app.session);
+    SHARED.with_borrow(|sh| match sh.docs.first() {
+        Some(first) if sh.claim => Some(first.id),
+        _ => sh.docs.iter().find(|d| d.mark.is_some() && d.mark == m).map(|d| d.id),
+    })
+}
+
+/// The end of each frame: the others drawn (name tags in SolidCraft's semibold), the presence look's frame ended (after
+/// the drawing, so moving marks keep easing), then the session's frame hook.
+pub fn frame<T>(app: &mut App<T>, ctx: &egui::Context) {
+    CTX.with(|c| {
+        c.get_or_init(|| ctx.clone());
+    });
+    OVER.set(ctx.input(|i| i.pointer.hover_pos()));
+    if playground_live::connected() {
+        settle(app);
+        ids_move_on(app);
+        let g = gesture(app, ctx);
+        GESTURE.set(g);
+    }
+    ON_SHARED.set(active_doc(app).is_some() || SHARED.with_borrow(|sh| sh.docs.is_empty()));
+    presence::set_font(solidcraft_ui_egui::fonts::semibold(12.0));
+    draw(app, ctx);
+    tab_dots(app, ctx);
+    presence::end_frame(ctx);
+    playground_live::frame(app);
+}
+
+/// Brings the session's designs up to date with this page's tabs (no projections; [`collect`] makes those): marks the
+/// tabs when the session starts, notes the designs closed here, and adds each tab opened since that holds something.
+/// A blank design that a file or sample replaced in its tab (the start page does that) stays the session's.
+fn settle(app: &mut SolveApp) {
+    let active = app.docs.active;
+    let mut list = tabs::designs_mut(app);
+    SHARED.with_borrow_mut(|sh| {
+        if sh.docs.is_empty() {
+            return;
+        }
+        if std::mem::take(&mut sh.claim) {
+            for (i, (s, _)) in list.iter_mut().enumerate() {
+                let m = mark(s);
+                match sh.docs.first_mut() {
+                    Some(first) if i == active => (first.mark, first.at) = (m, i),
+                    _ => sh.private.extend(m),
+                }
+            }
+        }
+        let known = |sh: &Shared, m: Option<usize>| m.is_some_and(|m| sh.private.contains(&m) || sh.docs.iter().any(|d| d.mark == Some(m)));
+        let marks: Vec<Option<usize>> = list.iter().map(|(s, _)| marker(s)).collect();
+        for k in 0..sh.docs.len() {
+            let Some(m) = sh.docs[k].mark else { continue };
+            match marks.iter().position(|x| *x == Some(m)) {
+                Some(i) => sh.docs[k].at = i,
+                None => {
+                    let at = sh.docs[k].at;
+                    let replaced = blank_value(&sh.docs[k].last) && marks.get(at).is_some_and(|x| !known(sh, *x));
+                    sh.docs[k].mark = match list.get_mut(at) {
+                        Some((s, _)) if replaced => mark(s),
+                        _ => None,
+                    };
+                    sh.docs[k].seen = None;
+                    sh.version += 1;
+                }
+            }
+        }
+        for (i, (s, pre)) in list.iter_mut().enumerate() {
+            if known(sh, marker(s)) || blank(s) {
+                continue;
+            }
+            let id = playground_live::fresh_id(&mut sh.next);
+            let m = mark(s);
+            sh.docs.push(Doc { id, mark: m, at: i, last: projection(s, *pre), seen: None });
+            sh.version += 1;
+        }
+    });
+    // A design opened behind for the session is fitted to the view the first time it shows.
+    let m = marker(&app.session);
+    if SHARED.with_borrow_mut(|sh| m.is_some_and(|m| sh.unfit.contains(&m)).then(|| sh.unfit.retain(|x| Some(*x) != m)).is_some()) {
+        app.fit_view();
+    }
+}
+
+/// The session's designs' latest projections, from their tabs (the active one when the session just started).
+fn collect(app: &SolveApp) {
+    let list = tabs::designs(app);
+    let active = app.docs.active.min(list.len().saturating_sub(1));
+    SHARED.with_borrow_mut(|sh| {
+        if sh.docs.is_empty() {
+            let id = playground_live::fresh_id(&mut sh.next);
+            sh.docs.push(Doc { id, mark: None, at: active, last: Value::Null, seen: None });
+            sh.claim = true;
+            sh.version += 1;
+        }
+        let claim = sh.claim;
+        for (k, d) in sh.docs.iter_mut().enumerate() {
+            let tab = match d.mark {
+                Some(m) => list.iter().find(|(s, _)| marker(s) == Some(m)),
+                None if claim && k == 0 => list.get(active),
+                None => None,
+            };
+            if let Some((s, pre)) = tab {
+                let key = (Arc::as_ptr(&s.doc) as usize, s.revision, *pre);
+                if d.seen != Some(key) {
+                    (d.last, d.seen) = (projection(s, *pre), Some(key));
+                }
+            }
+        }
+    });
+}
+
+/// While connected, the active design's next id moves on by a random step after each id taken and each remote change,
+/// so two people adding at once number from different points (one person's ids stay below their next id).
+fn ids_move_on(app: &mut SolveApp) {
+    let m = marker(&app.session).filter(|_| active_doc(app).is_some());
+    let next = app.session.doc.next_id;
+    match (m, NEXT.get()) {
+        (Some(m), Some((was, n))) if was == m && n != next => {
+            jump(&mut app.session.doc_mut().next_id);
+            NEXT.set(Some((m, app.session.doc.next_id)));
+        }
+        (Some(m), _) => NEXT.set(Some((m, next))),
+        (None, _) => NEXT.set(None),
+    }
+}
+
+// ponytail: up to 2^28 per step, 2^24 steps before ids pass MAX_FEATURE_ID (2^52); a per-peer id range if that matters.
+fn jump(next: &mut u64) {
+    *next = next.saturating_add(1 + (playground_live::fresh_id(&mut 0) & ((1 << 28) - 1)));
+}
+
+/// Undo and Redo of a shared design go to the session (`SolveApp::run`, before anything else).
+fn undo(id: &str) -> bool {
+    matches!(id, "edit.undo" | "edit.redo") && ON_SHARED.get() && playground_live::undo(id == "edit.redo")
+}
+
+#[cfg(target_arch = "wasm32")]
+thread_local! {
+    static RUNNER: OnceCell<eframe::WebRunner> = const { OnceCell::new() };
+}
+
+/// The page's web runner, kept so the session reaches the app between frames.
+#[cfg(target_arch = "wasm32")]
+pub fn runner() -> eframe::WebRunner {
+    RUNNER.with(|r| r.get_or_init(eframe::WebRunner::new).clone())
+}
+
+/// The app eframe runs: `shell`, whose design `get` and `get_mut` give, then the session's end-of-frame hook. Offers
+/// live editing to the Playground shell.
+#[cfg(target_arch = "wasm32")]
+pub fn wrap<S: eframe::App + 'static>(get: fn(&S) -> &SolveApp, get_mut: fn(&mut S) -> &mut SolveApp, shell: S) -> Box<dyn eframe::App> {
+    let _ = solidcraft_ui_egui::LIVE_UNDO.set(undo);
+    let _ = solidcraft_ui_egui::LIVE_HOME.set(session_list);
+    let with_app = |f: &mut dyn FnMut(&mut App<S>)| RUNNER.with(|r| r.get().and_then(|r| r.app_mut::<App<S>>()).map(|mut a| f(&mut a)).is_some());
+    let repaint = || CTX.with(|c| c.get().map_or((), egui::Context::request_repaint));
+    if let Err(e) = playground_live::web::attach::<App<S>>(FORMAT, with_app, repaint) {
+        log::warn!("live editing: {e:?}");
+    }
+    Box::new(App { shell, get, get_mut })
+}
+
+#[cfg(target_arch = "wasm32")]
+impl<S: eframe::App + 'static> eframe::App for App<S> {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut eframe::Frame) {
+        self.shell.logic(ctx, frame);
+    }
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        self.shell.ui(ui, frame);
+        let ctx = ui.ctx().clone();
+        crate::live::frame(self, &ctx);
+    }
+    /// Itself, which the session reaches through the runner.
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+    fn save(&mut self, storage: &mut dyn eframe::Storage) {
+        self.shell.save(storage);
+    }
+    fn auto_save_interval(&self) -> std::time::Duration {
+        self.shell.auto_save_interval()
+    }
+    fn clear_color(&self, visuals: &egui::Visuals) -> [f32; 4] {
+        self.shell.clear_color(visuals)
+    }
+    fn persist_egui_memory(&self) -> bool {
+        self.shell.persist_egui_memory()
+    }
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        self.shell.raw_input_hook(ctx, raw_input);
+    }
+}
+
+impl<T> Live for App<T> {
+    /// `{ documents: [{ id, ...design }] }`: every design of the session, open here or not.
+    fn live_document(&self) -> Value {
+        collect(self);
+        SHARED.with_borrow(|sh| {
+            let docs = sh.docs.iter().map(|d| {
+                let mut v = d.last.clone();
+                if let Some(o) = v.as_object_mut() {
+                    o.insert("id".into(), d.id.into());
+                }
+                v
+            });
+            json!({ "documents": docs.collect::<Vec<_>>() })
+        })
+    }
+
+    /// Each design goes into its tab here; one new to the session opens in a tab behind this person's, one they closed
+    /// stays closed. Joining, the session's first design goes into the tab this page shares when that is blank (or the
+    /// same), else into a tab of its own, which is shown; this person's own design stays theirs.
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let incoming = entries(&document)?;
+        let designs = incoming.iter().map(|(_, v)| design(v.clone())).collect::<Result<Vec<_>, _>>()?;
+        collect(self);
+        settle(self);
+        let mut sh = SHARED.take();
+        let joining = !incoming.iter().any(|(id, _)| sh.docs.iter().any(|d| d.id == *id));
+        let mut pool = std::mem::take(&mut sh.docs);
+        let mut docs = Vec::with_capacity(incoming.len());
+        for (k, ((id, value), doc)) in incoming.into_iter().zip(designs).enumerate() {
+            let old = if joining && k == 0 { (!pool.is_empty()).then(|| pool.remove(0)) } else { pool.iter().position(|d| d.id == id).map(|i| pool.remove(i)) };
+            let tab = old.as_ref().and_then(|d| d.mark).and_then(|m| tabs::designs(self).iter().position(|(s, _)| marker(s) == Some(m)));
+            // A tab opened here for it (its design arrives from the session: closing it unchanged asks nothing).
+            let mut opened = false;
+            let at = match (old.as_ref(), tab) {
+                (_, Some(i)) if !(joining && k == 0) => Some(i),
+                // Joining: into this page's tab if it is blank or the same design, else a tab of its own, shown.
+                (_, Some(i)) => {
+                    let (s, pre) = tabs::designs(self)[i];
+                    if blank(s) || canonical(&projection(s, pre)) == canonical(&value) {
+                        Some(i)
+                    } else {
+                        sh.private.extend(marker(s));
+                        opened = true;
+                        documents::open_tab(self, Session::default()).ok().map(|()| self.docs.active)
+                    }
+                }
+                // Closed here: it stays closed.
+                (Some(_), None) => None,
+                // New to this page: a tab behind this person's (none past the most designs open at once: as if closed).
+                (None, None) => {
+                    let i = tabs::open_behind(self, Session::default()).ok();
+                    opened = i.is_some();
+                    i
+                }
+            };
+            let mark = match at.and_then(|i| tabs::designs_mut(self).into_iter().nth(i)) {
+                Some((s, pre)) => {
+                    install(s, pre, doc);
+                    if opened {
+                        s.mark_saved();
+                    }
+                    marker(s).or_else(|| mark(s))
+                }
+                None => None,
+            };
+            if old.is_none() && tab.is_none() {
+                sh.unfit.extend(mark);
+            }
+            docs.push(Doc { id, mark, at: at.unwrap_or_default(), last: value, seen: None });
+        }
+        // Designs the session no longer has stay open here as this person's own.
+        sh.private.extend(pool.iter().filter_map(|d| d.mark));
+        sh.docs = docs;
+        sh.version += 1;
+        SHARED.set(sh);
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        presence::quiet()
+            && self.dialog.is_none()
+            && self.params.is_none()
+            && self.applying.is_none()
+            && self.tool.as_ref().is_none_or(|t| t.pts.is_empty() && t.picks.is_empty())
+            && self.viewport.point_drag.is_none()
+            && !self.file_load.busy()
+            && !self.file_picker_busy()
+            && !self.session.model.is_stale()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        use std::hash::{Hash, Hasher};
+        let mut h = std::hash::DefaultHasher::new();
+        for (s, pre) in tabs::designs(self) {
+            (marker(s), s.revision, Arc::as_ptr(&s.doc) as usize, pre).hash(&mut h);
+        }
+        SHARED.with_borrow(|sh| (sh.version, sh.claim, self.docs.active).hash(&mut h));
+        Some(h.finish())
+    }
+
+    /// The session's designs that are open here lose their Undo history (it holds others' edits) and their marks.
+    fn live_disconnected(&mut self) {
+        let sh = SHARED.take();
+        for (s, _) in tabs::designs_mut(self) {
+            let m = marker(s);
+            if m.is_some_and(|m| sh.docs.iter().any(|d| d.mark == Some(m))) {
+                s.undo.clear();
+                s.redo.clear();
+            }
+            if m.is_some_and(|m| sh.private.contains(&m) || sh.docs.iter().any(|d| d.mark == Some(m))) {
+                s.open_preview = None;
+            }
+        }
+        ON_SHARED.set(true);
+        NEXT.set(None);
+        GESTURE.take();
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        let (mut base, mut current, mut edited) = (base.clone(), current.clone(), edited.clone());
+        take_counters(&mut base);
+        // Sketch ids count up per prefix: the larger of each side's, so concurrent drawing and Undo reuse none.
+        let mut counters = take_counters(&mut current);
+        for (key, theirs) in take_counters(&mut edited) {
+            let mine = counters.entry(key).or_default();
+            for (prefix, n) in theirs {
+                if n.as_u64() > mine.get(&prefix).and_then(Value::as_u64) {
+                    mine.insert(prefix, n);
+                }
+            }
+        }
+        let mut merged = playground_live::merge(&base, &current, &edited, Self::COUNTERS)?;
+        for d in items(&mut merged, "documents") {
+            let doc = d.get("id").and_then(Value::as_u64).unwrap_or_default();
+            for f in items(d, "features") {
+                let id = f.get("id").and_then(Value::as_u64).unwrap_or_default();
+                if let Some(s) = f.get_mut("sketch").and_then(Value::as_object_mut) {
+                    s.insert("counters".into(), Value::Object(counters.remove(&(doc, id)).unwrap_or_default()));
+                }
+            }
+        }
+        // Both sides adding a Box (Box1, d1…) to one design merge as two features with one name.
+        let of = |all: &Value, id: &Value| all["documents"].as_array().and_then(|l| l.iter().find(|d| d["id"] == *id).cloned()).unwrap_or_default();
+        for d in merged["documents"].as_array().into_iter().flatten() {
+            let before: BTreeSet<_> = named_twice(&of(&current, &d["id"])).union(&named_twice(&of(&edited, &d["id"]))).cloned().collect();
+            if let Some(name) = named_twice(d).difference(&before).next() {
+                return Err(format!("Conflict: two {name}"));
+            }
+        }
+        Ok(merged)
+    }
+
+    /// Each design opens, and as it is: one that reading repairs (a component left without an occurrence gets one,
+    /// with a new id) would come out differently on every peer.
+    fn live_check(document: &Value) -> Result<(), String> {
+        for (_, d) in entries(document)? {
+            if canonical(&project(&design(d.clone())?)) != canonical(&d) {
+                return Err("Conflict: the merged design needs repairs".into());
+            }
+        }
+        Ok(())
+    }
+
+    /// `{ doc, component, sketch, pointer?, selection, band?, ghost?, value?, box? }` (see [`gesture`]): the design and
+    /// scope shown, the pointer as a point in the model while it is over the viewport, the gesture under way and the
+    /// selection (as much of it as fits). Nothing on the start page or a design the session does not share.
+    fn live_presence(&self) -> Value {
+        let Some(doc) = active_doc(self).filter(|_| !self.home.open) else { return Value::Null };
+        let s = &self.session;
+        let mut p = json!({ "doc": doc, "component": s.active_component, "sketch": s.active_sketch });
+        if let Some(at) = pointer(self) {
+            p["pointer"] = xyz(at);
+        }
+        GESTURE.with_borrow(|g| g.iter().for_each(|(k, v)| p[k] = v.clone()));
+        let mut room = MAX_BYTES.saturating_sub(p.to_string().len() + 16);
+        let selection: Vec<Value> = (s.selection.iter().filter_map(|x| serde_json::to_value(x).ok()))
+            .take_while(|v| {
+                let n = v.to_string().len() + 1;
+                room = room.checked_sub(n).unwrap_or(0);
+                room > 0
+            })
+            .take(MAX_ITEMS)
+            .collect();
+        p["selection"] = selection.into();
+        p
+    }
+
+    /// Kept for [`draw`], the tab dots and the start page's list.
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+}
+
+/// The session's designs in a shared document, `(id, design without the id)`, ids distinct.
+fn entries(document: &Value) -> Result<Vec<(u64, Value)>, String> {
+    let list = document["documents"].as_array().ok_or("Invalid shared designs: no list")?;
+    let mut out: Vec<(u64, Value)> = Vec::with_capacity(list.len());
+    for v in list {
+        let (Some(id), Some(mut d)) = (v["id"].as_u64(), v.as_object().cloned()) else { return Err("Invalid shared design: no id".into()) };
+        if out.iter().any(|(other, _)| *other == id) {
+            return Err("Conflict: two designs with one id".into());
+        }
+        d.remove("id");
+        out.push((id, Value::Object(d)));
+    }
+    Ok(out)
+}
+
+/// A tab's design as shared, with the timeline where it is for everyone (Edit Sketch rolls it for the person editing).
+fn projection(s: &Session, pre_sketch_marker: Option<Option<usize>>) -> Value {
+    let mut v = project(&s.doc);
+    if let (Some(marker), Some(o)) = (pre_sketch_marker, v.as_object_mut()) {
+        match marker {
+            Some(m) => drop(o.insert("marker".into(), m.into())),
+            None => drop(o.remove("marker")),
+        }
+    }
+    v
+}
+
+/// Installs a shared design in a tab, keeping this person's views; no undo step.
+fn install(s: &mut Session, pre_sketch_marker: Option<Option<usize>>, mut doc: Document) {
+    let local = &s.doc;
+    doc.next_id = doc.next_id.max(local.next_id);
+    for f in &mut doc.features {
+        if let FeatureKind::Sketch { sketch, .. } = &mut f.kind {
+            sketch.view = local.sketch(f.id).map(|s| s.view.clone()).unwrap_or_default();
+        }
+    }
+    if pre_sketch_marker.is_some() {
+        doc.marker = local.marker;
+    }
+    // The same design (the owner adopting its own): nothing to do.
+    if doc == **local {
+        return;
+    }
+    if playground_live::connected() {
+        jump(&mut doc.next_id);
+    }
+    s.doc = Arc::new(doc);
+    s.refresh();
+}
+
+/// A design as shared: without each peer's next id and what is hidden, sketches without their display options, and
+/// parameters keyed by name (so they merge one by one).
+fn project(doc: &Document) -> Value {
+    let mut v = serde_json::to_value(doc).unwrap_or_default();
+    if let Some(o) = v.as_object_mut() {
+        o.remove("next_id");
+        o.remove("visibility");
+    }
+    for p in items(&mut v, "params") {
+        if let Some(name) = p.get("name").cloned() {
+            p["id"] = name;
+        }
+    }
+    for f in items(&mut v, "features") {
+        if let Some(s) = f.get_mut("sketch").and_then(Value::as_object_mut) {
+            s.remove("view");
+        }
+    }
+    v
+}
+
+fn items<'a>(v: &'a mut Value, key: &'static str) -> impl Iterator<Item = &'a mut Value> {
+    v.get_mut(key).and_then(Value::as_array_mut).into_iter().flatten()
+}
+
+/// Each sketch's id counters, by design and feature id, taken out of the shared designs.
+fn take_counters(all: &mut Value) -> BTreeMap<(u64, u64), Map<String, Value>> {
+    let mut out = BTreeMap::new();
+    for d in items(all, "documents") {
+        let doc = d.get("id").and_then(Value::as_u64).unwrap_or_default();
+        for f in items(d, "features") {
+            let id = f.get("id").and_then(Value::as_u64).unwrap_or_default();
+            if let Some(Value::Object(n)) = f.get_mut("sketch").and_then(Value::as_object_mut).and_then(|s| s.remove("counters")) {
+                out.insert((doc, id), n);
+            }
+        }
+    }
+    out
+}
+
+/// Feature names and parameter names (user parameters and feature inputs) given twice in a design.
+fn named_twice(doc: &Value) -> BTreeSet<String> {
+    let list = |v: &Value, key: &str| v.get(key).and_then(Value::as_array).cloned().unwrap_or_default();
+    let features = list(doc, "features");
+    let names = features.iter().filter_map(|f| f.get("name")?.as_str()).map(|n| format!("features named {n}"));
+    let inputs = features.iter().flat_map(|f| list(f, "param_names"));
+    let params = list(doc, "params").into_iter().filter_map(|p| p.get("name").cloned()).chain(inputs);
+    let params: Vec<_> = params.filter_map(|n| n.as_str().filter(|n| !n.is_empty()).map(|n| format!("parameters named {n}"))).collect();
+    let mut seen = BTreeSet::new();
+    names.chain(params).filter(|n| !seen.insert(n.clone())).collect()
+}
+
+/// A shared design as a design, checked and upgraded as a design file is.
+fn design(mut document: Value) -> Result<Document, String> {
+    for p in items(&mut document, "params") {
+        if let Some(p) = p.as_object_mut() {
+            p.remove("id");
+        }
+    }
+    Document::from_json(&document.to_string()).map_err(|e| e.to_string())
+}
+
+/// A coordinate in presence: to a thousandth of a millimetre, which keeps it small.
+fn round(x: f64) -> f64 {
+    (x * 1e3).round() / 1e3
+}
+
+fn xyz(p: Vec3) -> Value {
+    json!([round(p.x), round(p.y), round(p.z)])
+}
+
+/// Millimetres per point at the view's target.
+fn mm_per_px(proj: &Proj) -> f64 {
+    proj.cam.half_height() * 2.0 / f64::from(proj.rect.height().max(1.0))
+}
+
+/// Where the view ray through `p` meets `plane`, in the plane's coordinates.
+fn on_plane(proj: &Proj, plane: &Plane, p: Pos2) -> Option<Vec2> {
+    let (o, d) = proj.ray(p);
+    let n = plane.normal();
+    let den = d.dot(n);
+    if den.abs() < 1e-12 {
+        return None;
+    }
+    let q = plane.to_local(o + d * ((plane.origin - o).dot(n) / den));
+    q.is_finite().then_some(q)
+}
+
+/// The point of the line `base + dir * t` nearest the view ray through `p`.
+fn on_line(proj: &Proj, p: Pos2, base: Vec3, dir: Vec3) -> Option<Vec3> {
+    let (o, r) = proj.ray(p);
+    let dir = dir.normalized()?;
+    let w = base - o;
+    let (b, d, e) = (dir.dot(r) / r.len(), dir.dot(w), r.dot(w) / r.len());
+    let den = 1.0 - b * b;
+    (den.abs() > 1e-6).then(|| base + dir * ((b * e - d) / den)).filter(|q| q.is_finite())
+}
+
+/// The lines the app paints with `paint` this frame, caught on a layer of their own that is emptied again (so never
+/// shown): paths and segments, one after another joined up.
+fn painted(ctx: &egui::Context, rect: Rect, paint: impl FnOnce(&egui::Painter)) -> Vec<Vec<Pos2>> {
+    fn walk(shape: &Shape, add: &mut dyn FnMut(&[Pos2])) {
+        match shape {
+            Shape::Path(p) => add(&p.points),
+            Shape::LineSegment { points, .. } => add(points),
+            Shape::Vec(v) => v.iter().for_each(|s| walk(s, add)),
+            _ => {}
+        }
+    }
+    let layer = egui::LayerId::new(egui::Order::Background, egui::Id::new("sc_live_caught"));
+    paint(&egui::Painter::new(ctx.clone(), layer, rect));
+    let list = ctx.graphics_mut(|g| std::mem::take(g.entry(layer)));
+    let mut lines: Vec<Vec<Pos2>> = Vec::new();
+    let mut add = |pts: &[Pos2]| match (lines.last_mut(), pts.split_first()) {
+        (Some(line), Some((first, rest))) if line.last().is_some_and(|q| q.distance(*first) < 0.5) => line.extend_from_slice(rest),
+        (_, Some(_)) => lines.push(pts.to_vec()),
+        _ => {}
+    };
+    list.all_entries().for_each(|c| walk(&c.shape, &mut add));
+    lines
+}
+
+/// Lines in presence: `[[x, y, x, y, …], …]` (or `x, y, z`), at most `max` points all told (every so many kept, and
+/// each line's ends) and [`MAX_ITEMS`] lines.
+fn lines_json<const N: usize>(lines: Vec<Vec<[f64; N]>>, max: usize) -> Option<Value> {
+    let lines: Vec<_> = lines.into_iter().filter(|l| l.len() >= 2).take(MAX_ITEMS).collect();
+    let total: usize = lines.iter().map(Vec::len).sum();
+    let step = total.div_ceil(max).max(1);
+    let out: Vec<Value> = (lines.iter())
+        .map(|l| {
+            let kept = l.iter().enumerate().filter(|(i, _)| i % step == 0 || *i + 1 == l.len());
+            Value::Array(kept.flat_map(|(_, p)| p.map(|x| Value::from(round(x)))).collect())
+        })
+        .collect();
+    (!out.is_empty()).then_some(Value::Array(out))
+}
+
+/// The gesture under way, read from the app's own state, as presence fields: `band`, the rubber band of a sketch shape
+/// being drawn (what the app paints for its tool, on the sketch's plane), and `ghost`, the sketch curves a drag is
+/// moving (where they are now), both as lines in the active sketch's coordinates; `value`, a feature dialog's main
+/// value at its handle (`{ text: "Extrude 12.5 mm", at: [x, y, z] }`), and while one of its handles is dragged the
+/// `pointer` on it; the feature's volume ([`volume`]: `solid` or `box`); `box`, also the bounds of a component being
+/// moved (`[x0, y0, z0, x1, y1, z1]`). Dimension and text-handle drags show no ghost.
+fn gesture(app: &mut SolveApp, ctx: &egui::Context) -> Map<String, Value> {
+    let mut out = Map::new();
+    let Some(rect) = app.viewport.rect.filter(|_| !app.home.open) else { return out };
+    let proj = viewport::projection(app, rect);
+    let st = world_state(&app.session);
+    if let Some(sid) = app.session.active_sketch
+        && let Some(plane) = st.sketch(sid).map(|ss| ss.plane)
+    {
+        if let Some(t) = app.tool.as_ref().filter(|t| !t.pts.is_empty()) {
+            let seen = painted(ctx, rect, |p| solidcraft_ui_egui::tools::preview(app, t, p, &proj));
+            // Points a couple of pixels apart are enough for the others.
+            let lines = seen.into_iter().map(|l| {
+                let mut kept: Vec<Pos2> = Vec::new();
+                for (i, q) in l.iter().enumerate() {
+                    if kept.last().is_none_or(|k| k.distance(*q) >= 2.0) || i + 1 == l.len() {
+                        kept.push(*q);
+                    }
+                }
+                kept.into_iter().filter_map(|q| on_plane(&proj, &plane, q)).map(|q| [q.x, q.y]).collect()
+            });
+            out.extend(lines_json(lines.collect(), MAX_POINTS).map(|v| ("band".to_string(), v)));
+        }
+        if let Some((_, depth, _)) = &app.viewport.point_drag
+            && let Some(before) = app.session.undo.get(*depth).and_then(|u| u.doc.sketch(sid).ok())
+            && let Ok(now) = app.session.doc.sketch(sid)
+        {
+            let moved = (0..now.curves.len()).map(|i| now.polyline(i)).enumerate().filter(|(i, l)| before.polyline(*i) != *l);
+            let moved = moved.map(|(_, l)| l.iter().map(|q| [q.x, q.y]).collect());
+            out.extend(lines_json(moved.collect(), MAX_POINTS).map(|v| ("ghost".to_string(), v)));
+        }
+    }
+    if let Some(mut d) = app.dialog.take() {
+        let triad = solidcraft_ui_egui::dialogs_move::triad(app, &d).map(|t| t.center);
+        let anchor = canvas::anchor(app, &d);
+        let name = format!("{:?}", d.kind).split(|c: char| !c.is_alphanumeric()).next().unwrap_or_default().to_owned();
+        let mut grow = None;
+        if let Some((label, kind, value)) = d.primary()
+            && let Some((base, dir)) = anchor
+        {
+            grow = app.session.doc.eval(value, kind).ok().filter(|v| v.is_finite());
+            let tip = |handle: &str| dir.zip(scenario::handle_at(handle)).and_then(|(dir, p)| on_line(&proj, p, base, dir));
+            let name = if name == "Fillet" && label == "Distance" { "Chamfer".into() } else { name };
+            let at = triad.or(tip("arrow")).unwrap_or(base);
+            let text: String = format!("{name} {}", value.trim()).chars().take(40).collect();
+            out.insert("value".into(), json!({ "text": text, "at": xyz(at) }));
+            // One of its handles dragged (a small widget over the viewport, not the viewport's own drag): the pointer
+            // is the handle, where the value shows, not whatever lies behind it.
+            if let Some(id) = ctx.dragged_id()
+                && ctx.read_response(id).is_some_and(|r| r.rect.size().max_elem() < 48.0 && rect.contains(r.rect.center()))
+            {
+                let grip = if id == egui::Id::new("sc_manipulator2") { tip("arrow2").unwrap_or(at) } else { at };
+                out.insert("pointer".into(), xyz(grip));
+            }
+        }
+        app.dialog = Some(d);
+        if let Some(d) = app.dialog.as_ref().filter(|d| app.preview.active && d.previews())
+            && let Some((key, v)) = volume(app, d, grow)
+        {
+            out.insert(key.into(), v);
+        }
+    }
+    if let Some(m) = &app.tree.occurrence_move {
+        let path = if m.path.is_empty() { vec![m.occurrence] } else { m.path.clone() };
+        let own = std::mem::replace(&mut app.session.selection, vec![Sel::Occurrence { path }]);
+        if let Some(b) = viewport::selection_bounds(app).filter(|b| !b.is_empty()) {
+            out.insert("box".into(), boxed(&b));
+        }
+        app.session.selection = own;
+    }
+    out
+}
+
+fn boxed(b: &Aabb3) -> Value {
+    json!([b.min.x, b.min.y, b.min.z, b.max.x, b.max.y, b.max.z].map(round))
+}
+
+/// The feature a dialog previews, as the others' ghost of it (`grow`: the dialog's value). One that makes a body, or
+/// joins, cuts or intersects with one, gives that body made on its own, as its edges (`solid`, lines in the model), as
+/// the app's preview builds such a feature's tool; one that changes bodies (a fillet, a shell, a move), the box around
+/// the bodies it changes (`box`), and for a fillet or chamfer only around its edges, grown by the value. The preview's
+/// commands are evaluated again, which the session's evaluation cache answers from the preview's own run, and only when
+/// they change.
+fn volume(app: &SolveApp, d: &Dialog, grow: Option<f64>) -> Option<(&'static str, Value)> {
+    let mut cmds = dialogs::preview_commands(app, d).ok().filter(|c| !c.is_empty())?;
+    let mut makes = false;
+    for (command, p) in &mut cmds {
+        let nested = p.get("command").and_then(Value::as_str).map(str::to_owned);
+        // A combine is between bodies already there.
+        if nested.as_deref().unwrap_or(command.as_str()) == "solid.combine" {
+            continue;
+        }
+        let p = if nested.is_some() { p.get_mut("params") } else { Some(p) };
+        if let Some(op) = p.and_then(|p| p.get_mut("operation")).filter(|op| op.is_string()) {
+            *op = "new".into();
+            makes = true;
+        }
+    }
+    let mut h = std::collections::hash_map::DefaultHasher::new();
+    (serde_json::to_string(&cmds).ok()?, app.session.revision).hash(&mut h);
+    let key = h.finish();
+    if let Some((k, v)) = VOLUME.with_borrow(Clone::clone)
+        && k == key
+    {
+        return v;
+    }
+    let found = (|| {
+        let p = app.session.preview_world(&cmds).ok()?;
+        let made = p.after.bodies.iter().filter(|b| p.before.body(&b.name).is_none());
+        if makes {
+            let edges = made.flat_map(|b| {
+                let m = b.mesh();
+                (0..m.edges.len()).filter(|i| m.shaded_edge_visible(*i)).map(|i| m.edges[i].iter().map(|q| [q.x, q.y, q.z]).collect()).collect::<Vec<_>>()
+            });
+            return lines_json(edges.collect(), MAX_SOLID).map(|v| ("solid", v));
+        }
+        let changed = p.after.bodies.iter().filter(|b| {
+            p.before.body(&b.name).is_none_or(|old| {
+                let (old, new) = (old.mesh(), b.mesh());
+                !(Arc::ptr_eq(&old, &new) || old.triangles == new.triangles && old.positions == new.positions)
+            })
+        });
+        let mut b = changed.fold(Aabb3::EMPTY, |b, x| b.union(&x.mesh().bounds()));
+        let mut edges = Aabb3::EMPTY;
+        if let Kind::Fillet { .. } = d.kind {
+            for sel in d.inputs.first().map_or(&[][..], |i| &i.items) {
+                if let Sel::Edge { body, index, .. } = sel {
+                    let m = p.before.body(body).map(|b| b.mesh());
+                    m.iter().flat_map(|m| m.edges.get(*index)).flatten().for_each(|q| edges.add(*q));
+                }
+            }
+        }
+        if !edges.is_empty() {
+            let r = grow.unwrap_or(0.0).abs();
+            let r = Vec3::new(r, r, r);
+            b = Aabb3 { min: b.min.max(edges.min - r), max: b.max.min(edges.max + r) };
+        }
+        (!b.is_empty()).then(|| ("box", boxed(&b)))
+    })();
+    VOLUME.set(Some((key, found.clone())));
+    found
+}
+
+/// The model point under the pointer: where the pointer's ray meets what it is over; over a sketch's geometry, or off
+/// the model in a sketch, where it meets the sketch's plane; near an edge, the ray's point beside it; or else the ray's
+/// point nearest the view's target. Also over what the app draws inside the viewport (a value box, dimension inputs).
+/// `None` while the pointer is not over the viewport.
+fn pointer(app: &SolveApp) -> Option<Vec3> {
+    let v = &app.viewport;
+    let rect = v.rect?;
+    let mouse = v.mouse.or_else(|| OVER.get().filter(|p| rect.contains(*p)))?;
+    let proj = viewport::projection(app, rect);
+    let (o, d) = proj.ray(mouse);
+    let near = |q: Vec3| o + d * ((q - o).dot(d) / d.len2());
+    let st = world_state(&app.session);
+    // Not far out on a plane seen edge-on.
+    let reach = proj.cam.half_height() * 20.0;
+    let sketch = |id: u64| {
+        let plane = st.sketch(id)?.plane;
+        on_plane(&proj, &plane, mouse).map(|q| plane.to_world(q)).filter(|q| (*q - proj.cam.target).len() < reach)
+    };
+    let at = match v.mouse.and(v.hover.as_ref()) {
+        Some(Hit::Face { point, .. } | Hit::Vertex { point, .. } | Hit::Plane { point, .. }) => *point,
+        Some(Hit::Edge { mid, .. }) => near(*mid),
+        Some(Hit::SketchPoint { sketch: id, .. } | Hit::SketchCurve { sketch: id, .. } | Hit::Profile { sketch: id, .. }) => {
+            sketch(*id).unwrap_or_else(|| near(proj.cam.target))
+        }
+        _ => app.session.active_sketch.and_then(sketch).unwrap_or_else(|| near(proj.cam.target)),
+    };
+    at.is_finite().then_some(at)
+}
+
+/// Person `o`'s mark `key` eased toward `at` (in the model's millimetres) by the kit: `px` points a millimetre, and a jump
+/// wider than `far` points goes at once. On another design or sketch it is another mark, so it shows there at once.
+fn eased<const N: usize>(ctx: &egui::Context, o: &Presence, key: &str, at: [f64; N], (px, far): (f64, f64)) -> Option<[f64; N]> {
+    let key = format!("{key} {} {}", o.state["doc"], o.state["sketch"]);
+    presence::ease(ctx, &o.id, &key, at, [px; N], [far; N])
+}
+
+/// `N` numbers in range, or none.
+fn numbers<const N: usize>(v: &Value) -> Option<[f64; N]> {
+    let items = v.as_array().filter(|a| a.len() == N)?;
+    let mut out = [0.0; N];
+    for (o, x) in out.iter_mut().zip(items) {
+        *o = x.as_f64().filter(|x| x.abs() < FAR_OUT)?;
+    }
+    Some(out)
+}
+
+/// Person `o`'s lines `key` (`[[x, y, …], …]`, `N` numbers a point) on the screen, each line eased as a mark of its
+/// own ([`presence::ease_list`], keyed as [`eased`]: another count of lines or points shows at once), placed by `at`.
+fn screen_lines<const N: usize>(
+    ctx: &egui::Context,
+    proj: &Proj,
+    o: &Presence,
+    key: &str,
+    (px, far): (f64, f64),
+    at: impl Fn([f64; N]) -> Vec3,
+) -> Vec<Vec<Pos2>> {
+    let lines = o.state[key].as_array().map_or(&[][..], Vec::as_slice);
+    let n = lines.len().min(MAX_ITEMS);
+    let line = |(i, l): (usize, &Value)| -> Option<Vec<Pos2>> {
+        let xs = l.as_array().filter(|xs| xs.len() <= 4 * MAX_POINTS)?;
+        let xs: Vec<f64> = xs.iter().map(|x| x.as_f64().filter(|x| x.abs() < FAR_OUT)).collect::<Option<_>>()?;
+        let xs = presence::ease_list(ctx, &o.id, &format!("{key} {i}/{n} {} {}", o.state["doc"], o.state["sketch"]), &xs, &[px], &[far])?;
+        xs.chunks_exact(N).map(|p| proj.to_screen(at(p.try_into().ok()?))).collect()
+    };
+    lines.iter().take(MAX_ITEMS).enumerate().filter_map(line).collect()
+}
+
+/// A ghost's fill and edge, in its person's colour at these opacities (the kit's).
+const GHOST: f32 = 0.28;
+const GHOST_EDGE: f32 = 0.85;
+
+/// The others on the active design (when the session shares it), over its viewport (the root layer, after everything
+/// the app drew there, under dialogs and menus), in the session's look and their colours, eased toward their latest
+/// presence: everyone's ghosts, rubber bands and values first, then their selections outlined (a box around each
+/// item's bounds, as the app bounds its own selection), then their pointers with their names. Their data come from
+/// other people: whatever does not resolve is skipped.
+fn draw(app: &mut SolveApp, ctx: &egui::Context) {
+    let (Some(rect), Some(doc)) = (app.viewport.rect.filter(|_| !app.home.open), active_doc(app)) else { return };
+    let here: Vec<Presence> = presence::others().into_iter().filter(|o| o.state["doc"].as_u64() == Some(doc)).collect();
+    if here.is_empty() {
+        return;
+    }
+    let proj = viewport::projection(app, rect);
+    // Points a millimetre at the view's target, and a quarter of the view: a jump wider than that goes at once.
+    let ease = (1.0 / mm_per_px(&proj), f64::from(rect.height()) / 4.0);
+    let painter = ctx.layer_painter(egui::LayerId::background()).with_clip_rect(rect);
+    let st = world_state(&app.session);
+    for o in &here {
+        let c = presence::color(o);
+        if let Some(b) = numbers::<6>(&o.state["box"]).and_then(|b| eased(ctx, o, "box", b, ease)) {
+            ghost_box(&painter, &proj, b, c);
+        }
+        ghost(&painter, screen_lines(ctx, &proj, o, "solid", ease, |[x, y, z]| Vec3::new(x, y, z)), c);
+        if let Some(plane) = o.state["sketch"].as_u64().and_then(|id| st.sketch(id)).map(|ss| ss.plane) {
+            let on_sketch = |[x, y]: [f64; 2]| plane.to_world(Vec2::new(x, y));
+            for line in screen_lines(ctx, &proj, o, "ghost", ease, on_sketch) {
+                painter.add(Shape::line(line, Stroke::new(2.0, c.gamma_multiply(GHOST_EDGE))));
+            }
+            for line in screen_lines(ctx, &proj, o, "band", ease, on_sketch) {
+                painter.extend(Shape::dashed_line(&line, Stroke::new(1.5, c), 4.0, 3.0));
+            }
+        }
+        if let (Some(at), Some(text)) = (numbers::<3>(&o.state["value"]["at"]), o.state["value"]["text"].as_str())
+            && let Some([x, y, z]) = eased(ctx, o, "at", at, ease)
+            && let Some(at) = proj.to_screen(Vec3::new(x, y, z))
+        {
+            painter.circle(at, 4.0, c, Stroke::new(1.5, Color32::WHITE));
+            presence::label(&painter, at + vec2(10.0, -30.0), c, text);
+        }
+    }
+    let own = std::mem::take(&mut app.session.selection);
+    for o in &here {
+        for sel in o.state["selection"].as_array().into_iter().flatten().take(MAX_ITEMS) {
+            let Ok(sel) = serde_json::from_value::<Sel>(sel.clone()) else { continue };
+            app.session.selection = vec![sel];
+            if let Some(r) = viewport::selection_bounds(app).and_then(|b| screen_rect(&proj, &b)) {
+                // 3 points out from the bounds (the kit's outline is drawn inside its box).
+                presence::outline(&painter, r.expand(5.0), presence::color(o));
+            }
+        }
+    }
+    app.session.selection = own;
+    for o in &here {
+        let at = numbers::<3>(&o.state["pointer"]).and_then(|p| eased(ctx, o, "pointer", p, ease));
+        if let Some(at) = at.and_then(|[x, y, z]| proj.to_screen(Vec3::new(x, y, z))).filter(|p| rect.expand(20.0).contains(*p)) {
+            presence::cursor(&painter, at, presence::color(o), &o.name);
+        }
+    }
+}
+
+/// A model box's outline on the screen (none behind the eye, or absurdly large).
+fn screen_rect(proj: &Proj, b: &Aabb3) -> Option<Rect> {
+    let mut r = Rect::NOTHING;
+    for p in corners(b) {
+        r.extend_with(proj.to_screen(p)?);
+    }
+    (r.is_finite() && r.width() < 1e5 && r.height() < 1e5).then_some(r)
+}
+
+fn corners(b: &Aabb3) -> [Vec3; 8] {
+    std::array::from_fn(|i| {
+        let pick = |bit: usize, lo: f64, hi: f64| if i & bit == 0 { lo } else { hi };
+        Vec3::new(pick(1, b.min.x, b.max.x), pick(2, b.min.y, b.max.y), pick(4, b.min.z, b.max.z))
+    })
+}
+
+/// A box in the model as a ghost: its twelve edges.
+fn ghost_box(p: &egui::Painter, proj: &Proj, [x0, y0, z0, x1, y1, z1]: [f64; 6], color: Color32) {
+    let b = Aabb3 { min: Vec3::new(x0, y0, z0), max: Vec3::new(x1, y1, z1) };
+    let Some(pts) = corners(&b).iter().map(|q| proj.to_screen(*q)).collect::<Option<Vec<Pos2>>>() else { return };
+    let edges = [(0, 1), (2, 3), (4, 5), (6, 7), (0, 2), (1, 3), (4, 6), (5, 7), (0, 4), (1, 5), (2, 6), (3, 7)];
+    ghost(p, edges.iter().map(|&(i, j)| vec![pts[i], pts[j]]).collect(), color);
+}
+
+/// A shape's edges on the screen as a ghost: what they span filled, the edges drawn.
+// ponytail: the fill is the edges' convex hull, exact for a box, a convex profile's prism or a cylinder, a little more
+// for an L-shaped one (a union of the faces' outlines would fix that).
+fn ghost(p: &egui::Painter, lines: Vec<Vec<Pos2>>, color: Color32) {
+    let pts: Vec<Pos2> = lines.iter().flatten().copied().collect();
+    if pts.len() < 2 || pts.iter().any(|q| !q.is_finite() || q.x.abs() > 1e5 || q.y.abs() > 1e5) {
+        return;
+    }
+    p.add(Shape::convex_polygon(hull(&pts), color.gamma_multiply(GHOST), Stroke::NONE));
+    let edge = Stroke::new(1.5, color.gamma_multiply(GHOST_EDGE));
+    for line in lines {
+        p.add(Shape::line(line, edge));
+    }
+}
+
+/// The convex hull of `pts`, in order (Andrew's monotone chain).
+fn hull(pts: &[Pos2]) -> Vec<Pos2> {
+    let mut v = pts.to_vec();
+    v.sort_by(|a, b| a.x.total_cmp(&b.x).then(a.y.total_cmp(&b.y)));
+    let turn = |o: Pos2, a: Pos2, b: Pos2| (a - o).x * (b - o).y - (a - o).y * (b - o).x;
+    let mut out: Vec<Pos2> = Vec::new();
+    for pass in [false, true] {
+        let start = out.len();
+        let points: Vec<Pos2> = if pass { v.iter().rev().copied().collect() } else { v.clone() };
+        for q in points {
+            while out.len() >= start + 2 && turn(out[out.len() - 2], out[out.len() - 1], q) <= 0.0 {
+                out.pop();
+            }
+            out.push(q);
+        }
+        out.pop();
+    }
+    out
+}
+
+/// The others on each tab's design, as dots in their colours at the tab's right end, left of its × (where the app bar
+/// put the tabs this frame).
+fn tab_dots(app: &SolveApp, ctx: &egui::Context) {
+    let on: Vec<(u64, Color32)> = presence::others().iter().filter_map(|o| Some((o.state["doc"].as_u64()?, presence::color(o)))).collect();
+    if on.is_empty() {
+        return;
+    }
+    let ids: Vec<Option<u64>> = SHARED.with_borrow(|sh| {
+        tabs::designs(app).iter().map(|(s, _)| marker(s).and_then(|m| sh.docs.iter().find(|d| d.mark == Some(m))).map(|d| d.id)).collect()
+    });
+    let centres: Vec<Option<Pos2>> = (0..ids.len()).map(|i| scenario::handle_at(&format!("tab:design:{i}"))).collect();
+    // The tabs are all one width: the step between two, or the widest a lone tab gets.
+    let w = centres.windows(2).find_map(|c| Some(c[1]?.x - c[0]?.x)).unwrap_or(220.0);
+    let painter = ctx.layer_painter(egui::LayerId::background());
+    for (id, centre) in ids.iter().zip(&centres) {
+        let (Some(id), Some(centre)) = (id, centre) else { continue };
+        for (k, (_, c)) in on.iter().filter(|(d, _)| d == id).take(4).enumerate() {
+            painter.circle(pos2(centre.x + w / 2.0 - 32.0 - 9.0 * k as f32, centre.y), 3.5, *c, Stroke::new(1.0, Color32::WHITE));
+        }
+    }
+}
+
+/// The start page's "In this session" (above Recent): a row for each design of the session, with dots in the colours
+/// of the others on it; a click goes to it, opening it again in a tab when this person closed it.
+#[cfg(target_arch = "wasm32")]
+fn session_list(app: &mut SolveApp, ui: &mut egui::Ui) {
+    use egui::FontId;
+    if !playground_live::connected() {
+        return;
+    }
+    let rows: Vec<(u64, String, bool)> =
+        SHARED.with_borrow(|sh| sh.docs.iter().map(|d| (d.id, d.last["name"].as_str().unwrap_or_default().to_owned(), d.mark.is_some())).collect());
+    if rows.is_empty() {
+        return;
+    }
+    let t = solidcraft_ui_egui::theme::Tokens::get();
+    ui.label(egui::RichText::new("In this session").size(15.0).strong().color(t.text));
+    ui.add_space(8.0);
+    let mut chosen = None;
+    let others = presence::others();
+    for (id, name, open) in rows {
+        let (r, resp) = ui.allocate_exact_size(vec2(320.0, 36.0), egui::Sense::click());
+        let hover = resp.hovered();
+        let p = ui.painter();
+        p.rect(r, 6.0, if hover { t.hover } else { t.field }, Stroke::new(1.0, if hover { t.accent } else { t.border }), egui::StrokeKind::Inside);
+        let name = if name.is_empty() || name == "Untitled" { "Untitled".to_owned() } else { name };
+        p.with_clip_rect(r.shrink2(vec2(12.0, 0.0)).with_max_x(r.right() - 110.0)).text(
+            r.left_center() + vec2(12.0, 0.0),
+            egui::Align2::LEFT_CENTER,
+            name,
+            FontId::proportional(14.0),
+            if open { t.text } else { t.text_dim },
+        );
+        p.text(r.right_center() - vec2(12.0, 0.0), egui::Align2::RIGHT_CENTER, if open { "Open" } else { "Closed here" }, FontId::proportional(11.5), t.text_dim);
+        let on = others.iter().filter(|o| o.state["doc"].as_u64() == Some(id));
+        for (k, o) in on.take(4).enumerate() {
+            p.circle(pos2(r.right() - 96.0 + 9.0 * k as f32, r.center().y), 3.5, presence::color(o), Stroke::new(1.0, Color32::WHITE));
+        }
+        if hover {
+            ui.ctx().set_cursor_icon(egui::CursorIcon::PointingHand);
+        }
+        if resp.clicked() {
+            chosen = Some(id);
+        }
+        ui.add_space(6.0);
+    }
+    ui.add_space(18.0);
+    if let Some(id) = chosen {
+        go_to(app, id);
+    }
+}
+
+/// Shows the session's design `id`, opening it again in a tab when this person closed it.
+#[cfg(target_arch = "wasm32")]
+fn go_to(app: &mut SolveApp, id: u64) {
+    let Some((was, last)) = SHARED.with_borrow(|sh| sh.docs.iter().find(|d| d.id == id).map(|d| (d.mark, d.last.clone()))) else { return };
+    let tab = was.and_then(|m| tabs::designs(app).iter().position(|(s, _)| marker(s) == Some(m)));
+    let i = match tab {
+        Some(i) => i,
+        None => {
+            let Ok(doc) = design(last) else { return };
+            let mut s = Session::default();
+            install(&mut s, None, doc);
+            s.mark_saved();
+            let m = mark(&mut s);
+            let Ok(i) = tabs::open_behind(app, s) else { return };
+            SHARED.with_borrow_mut(|sh| {
+                sh.unfit.extend(m);
+                sh.docs.iter_mut().filter(|d| d.id == id).for_each(|d| (d.mark, d.at, d.seen) = (m, i, None));
+                sh.version += 1;
+            });
+            i
+        }
+    };
+    documents::switch(app, i);
+    app.home.open = false;
+}
