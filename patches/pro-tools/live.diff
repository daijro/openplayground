+//! Live editing in a Playground session (web only). The shared document is the session without anyone's views: no
+//! Edit-window state (`edit`: selection, playhead, zoom, tools, modes, view flags), and per track no height, lane view,
+//! folder state, pin, record arm or input monitor. Audio reaches everyone as session files, one per source id (the
+//! built-in demo's synthesized audio excepted: every browser makes the same).
+//!
+//! Presence ([`Live::live_presence`]): each person's pointer and selection, and the gesture under way where it has
+//! things so far (the session changes only when it ends), all in the session's terms so each person draws them through
+//! their own zoom and scroll, eased toward where they last were. Over the Edit window's tracks: clips being moved or
+//! trimmed as ghosts, a fade being drawn or bent, a MIDI clip being drawn as a rubber band, a Pencil stroke on an
+//! automation lane, a time selection being dragged, the playhead while playing or scrubbing. In the MIDI Editor: the
+//! selected notes and those being dragged, and over its velocity lane the pointer and the stalks being dragged. Over the
+//! Mix window's strips and over plug-in windows: the pointer. A value being set (a fader, pan, trim, send, plug-in
+//! parameter, clip gain or velocity) is tagged under the person's name; a fader, pan knob or send level also shows as a
+//! ghost on this person's own, its value beside it. Tags go where they show whole.
+//! The look is the playground-live crate's ([`presence`]: pointers, tags, ghosts, outlines, playheads, easing); rubber
+//! bands, strokes, fades, control ghosts and where the tags go are SoundCraft's own, in its colors.
+//! A child of the Edit window's module, for its drag preview and lane geometry.
+
+// Where the Edit window's helpers live differs between versions: patches/pro-tools/live-compat*.diff.
+mod compat;
+use compat::{clip_name_height, clip_preview_fades, drag_plan, fade_curve_points, midi_clip_span, ops, plugin_range, rect, sample_at, x_of};
+use crate::widgets::{db_text, fader_slot, pan_text};
+use crate::{Gesture, MainWindow, SoundApp};
+use egui::{Color32, Context, Id, LayerId, Order, Painter, Pos2, Rect, Shape, Stroke, Ui, Vec2, pos2, vec2};
+use serde::Deserialize as _;
+use serde_json::{Value, json};
+use soundcraft_audio_io::{BitDepth, EncodeOptions, FileFormat, SampleFormat};
+use soundcraft_model::playground_live::{self, Live, Presence, presence};
+use soundcraft_model::{AutoParam, ClipContent, ClipId, EditState, Fade, Session, Source, SourceAudio, SourceId, Track, TrackId, fader_db_to_pos};
+use std::cell::{Cell, RefCell};
+use std::collections::{BTreeMap, HashMap};
+use std::sync::Arc;
+
+thread_local! {
+    /// The control each other person set last, by their id: `[command, params]`, its value's tag and when last seen.
+    static HELD: RefCell<HashMap<String, (Value, String, f64)>> = RefCell::default();
+    /// The Mix window's strips as the latest pass drew them (that pass's number first).
+    static STRIPS: RefCell<(u64, Vec<Strip>)> = const { RefCell::new((0, Vec::new())) };
+    /// The MIDI Editor's piano roll as last drawn.
+    static ROLL: Cell<Option<Roll>> = const { Cell::new(None) };
+    /// The command journal's length when no pointer button was last down: what follows is the gesture's.
+    static PRESSED_AT: Cell<usize> = const { Cell::new(usize::MAX) };
+}
+
+/// Selected or dragged things a presence carries, at most; the points of a stroke.
+const MAX_ITEMS: usize = 50;
+const MAX_STROKE: usize = 120;
+/// The kit's ghost fill and edge (the person's colour at these opacities), for the ghosts drawn here that aren't boxes (a
+/// fade, a pan knob, a stalk's dot); a stroke under way.
+const GHOST: f32 = 0.28;
+const GHOST_EDGE: f32 = 0.85;
+const STROKE: f32 = 0.7;
+/// How long a control's ghost stays after they let go (seconds): until the change itself has most likely arrived.
+const LINGER: f64 = 0.6;
+
+/// The value `p` is setting, when there is one.
+fn value(p: &Presence) -> Option<&str> {
+    p.state["value"].as_str().filter(|v| v.len() <= 64)
+}
+
+/// A Mix-window strip as drawn: its track, its rect, the area it shows in, its layer and its Ui's id (its widgets' ids
+/// derive from it).
+#[derive(Clone, Copy)]
+struct Strip {
+    track: u64,
+    rect: Rect,
+    clip: Rect,
+    layer: LayerId,
+    ui: Id,
+}
+
+/// The MIDI Editor's piano roll as drawn ([`midi`]): the pass, the clip, the roll, its velocity lane (as last laid out),
+/// the layer and area they show in, and where tick 0 and pitch 0 are with the points a tick and a pitch take (pitches
+/// go up, so `ky` is below zero: a row is `-ky` tall from `y(pitch)` down).
+#[derive(Clone, Copy)]
+struct Roll {
+    pass: u64,
+    clip: u64,
+    rect: Rect,
+    vel: Option<Rect>,
+    layer: LayerId,
+    area: Rect,
+    x0: f32,
+    kx: f32,
+    y0: f32,
+    ky: f32,
+}
+
+impl Roll {
+    fn at(&self, [tick, pitch]: [f64; 2]) -> Pos2 {
+        pos2(self.x0 + tick as f32 * self.kx, self.y0 + pitch as f32 * self.ky)
+    }
+
+    /// A note's box, as the MIDI Editor draws it.
+    fn note(&self, [tick, pitch, len]: [f64; 3]) -> Rect {
+        let (a, b) = (self.at([tick, pitch]), self.at([tick + len, pitch]));
+        Rect::from_min_max(a + vec2(0.0, 1.0), pos2(b.x.max(a.x + 3.0), a.y - self.ky - 1.0))
+    }
+
+    /// `[tick, velocity]` in velocity lane `vel`, where the editor puts the top of a stalk (a point right of it).
+    fn vel_pos(&self, vel: Rect, [tick, v]: [f64; 2]) -> Pos2 {
+        pos2(self.x0 + tick as f32 * self.kx, vel.max.y - 2.0 - (vel.height() - 4.0) * v as f32 / 127.0)
+    }
+
+    /// `p` in velocity lane `vel` as `[tick, velocity]` (see [`Self::vel_pos`]).
+    fn vel_at(&self, vel: Rect, p: Pos2) -> [f64; 2] {
+        [f64::from((p.x - self.x0) / self.kx).round(), f64::from((vel.max.y - 2.0 - p.y) / (vel.height() - 4.0) * 127.0)]
+    }
+}
+
+/// Whether `pass` is the latest one or the one before.
+fn fresh(ctx: &Context, pass: u64) -> bool {
+    pass + 1 >= ctx.cumulative_pass_nr()
+}
+
+/// A remote time (samples, ticks), unless it is no whole number or too far off to draw.
+fn time(v: &Value) -> Option<f64> {
+    v.as_i64().filter(|t| t.unsigned_abs() < 1 << 48).map(|t| t as f64)
+}
+
+/// A remote fraction (0 to 1).
+fn fraction(v: &Value) -> Option<f64> {
+    v.as_f64().filter(|f| (0.0..=1.0).contains(f))
+}
+
+/// The items of a remote list, at most [`MAX_ITEMS`].
+fn items(v: &Value) -> impl Iterator<Item = &Value> {
+    v.as_array().into_iter().flatten().take(MAX_ITEMS)
+}
+
+/// `f` in thousandths: finer than a point, and short in JSON.
+fn fine(f: f32) -> f64 {
+    (f64::from(f) * 1000.0).round() / 1000.0
+}
+
+/// The first of `spots` (top left corners) where a box of `size` shows whole in `area` without covering `avoid`, else
+/// the first where it shows whole, else the first moved as far inside as it goes.
+fn place(area: Rect, size: Vec2, spots: &[Pos2], avoid: Option<Rect>) -> Pos2 {
+    let fits = |p: &&Pos2| area.contains_rect(Rect::from_min_size(**p, size));
+    let clear = |p: &&Pos2| avoid.is_none_or(|a| !a.intersects(Rect::from_min_size(**p, size)));
+    let first = spots.first().copied().unwrap_or(area.min);
+    let inside = || pos2(first.x.min(area.max.x - size.x).max(area.min.x), first.y.min(area.max.y - size.y).max(area.min.y));
+    spots.iter().filter(fits).find(clear).or_else(|| spots.iter().find(fits)).copied().unwrap_or_else(inside)
+}
+
+/// A tag of `text` beside `anchor` (right of it, else left), vertically centred on it; its rect.
+fn tag_beside(painter: &Painter, anchor: Rect, text: &str, color: Color32) -> Option<Rect> {
+    let size = presence::label_size(painter, text);
+    let y = anchor.center().y - size.y / 2.0;
+    let at = place(painter.clip_rect(), size, &[pos2(anchor.max.x + 6.0, y), pos2(anchor.min.x - 6.0 - size.x, y)], None);
+    (!text.is_empty()).then(|| presence::label(painter, at, color, text))
+}
+
+/// A pointer at `tip` (the kit's arrow) with its name tag and, under it, a tag of a `value` being set. The tags go below
+/// and right of the tip, else (when they would not show whole in the painter's area, or would cover `avoid`) above it,
+/// left of it or both, else as far inside as they go.
+fn cursor(painter: &Painter, tip: Pos2, color: Color32, name: &str, value: Option<&str>, avoid: Option<Rect>) {
+    presence::cursor(painter, tip, color, "");
+    let value = value.unwrap_or_default();
+    let (name_size, value_size) = (presence::tag_size(painter, name), presence::label_size(painter, value));
+    let gap = if name_size.y > 0.0 && value_size.y > 0.0 { 2.0 } else { 0.0 };
+    let size = vec2(name_size.x.max(value_size.x), name_size.y + gap + value_size.y);
+    let (right, left, below, above) = (tip.x + 12.0, tip.x - 4.0 - size.x, tip.y + 15.0, tip.y - 4.0 - size.y);
+    let at = place(painter.clip_rect(), size, &[pos2(right, below), pos2(right, above), pos2(left, below), pos2(left, above)], avoid);
+    // Left of the tip, they line up at their right ends.
+    let x = |s: Vec2| if at.x < tip.x { at.x + size.x - s.x } else { at.x };
+    let name_tag = presence::tag(painter, pos2(x(name_size), at.y), color, name);
+    presence::label(painter, pos2(x(value_size), name_tag.max.y + gap), color, value);
+}
+
+/// Copies what each person keeps of a track for themselves.
+fn keep_views(t: &mut Track, from: &Track) {
+    t.height = from.height;
+    t.view.clone_from(&from.view);
+    t.folder_open = from.folder_open;
+    t.pinned = from.pinned;
+    t.mixer.record_arm = from.mixer.record_arm;
+    t.mixer.input_monitor = from.mixer.input_monitor;
+}
+
+/// A new track's views: what the shared document gives every track.
+fn fresh_track(t: &Track) -> Track {
+    Track::new(t.id, "", t.kind, t.format, t.color)
+}
+
+/// Every playlist's clips in a shared document.
+fn clip_lists(doc: &mut Value) -> impl Iterator<Item = &mut Vec<Value>> {
+    fn items(v: Option<&mut Value>) -> impl Iterator<Item = &mut Value> {
+        v.and_then(Value::as_array_mut).into_iter().flatten()
+    }
+    items(doc.get_mut("tracks")).flat_map(|t| items(t.get_mut("playlists"))).filter_map(|p| p.get_mut("clips").and_then(Value::as_array_mut))
+}
+
+/// Undo and Redo ([`SoundApp::run`]) go to the session while one is connected: true when it took them.
+pub(crate) fn undo(command: &str) -> bool {
+    matches!(command, "edit.undo" | "edit.redo") && playground_live::undo(command == "edit.redo")
+}
+
+/// A connected session shares the open session, which then stays open: nothing replaces it (see
+/// [`crate::bounce::refuses_session_switch`]). True when refused; the status line says why.
+pub(crate) fn refuses_session_switch(app: &mut SoundApp) -> bool {
+    let refused = playground_live::connected();
+    if refused {
+        app.ui.status = "Leave the live session first: it shares this session".into();
+    }
+    refused
+}
+
+/// Whether two records describe the same audio (saving changes only where it is kept).
+fn same_audio(a: &Source, b: &Source) -> bool {
+    (&a.name, a.channels, a.frames, a.sample_rate) == (&b.name, b.channels, b.frames, b.sample_rate)
+}
+
+/// The Edit window's track under `p`, the time there and how far down its row (0 to 1), as of the last frame.
+fn pointer_at(app: &SoundApp, p: Pos2) -> Option<Value> {
+    let tl = rect(app.edit_layout.timeline);
+    let (track, r) = app.edit_layout.rows.iter().find(|(_, r)| (r[1]..r[3]).contains(&p.y)).filter(|_| tl.contains(p))?;
+    let y = (f64::from((p.y - r[1]) / (r[3] - r[1])) * 100.0).round() / 100.0;
+    Some(json!({"track": track, "at": sample_at(app.engine.session(), tl, p.x), "y": y}))
+}
+
+/// Another person's Edit-window pointer ([`pointer_at`]) in this person's terms: the time, and the row (its index among
+/// this person's rows plus how far down it).
+fn pointer_target(app: &SoundApp, v: &Value) -> Option<[f64; 3]> {
+    let row = app.edit_layout.rows.iter().position(|(id, _)| Some(*id) == v["track"].as_u64())?;
+    Some([time(&v["at"])?, row as f64 + v["y"].as_f64()?.clamp(0.0, 1.0), 0.0])
+}
+
+/// A time and row ([`pointer_target`]) on this person's Edit window, when it shows there.
+fn edit_pos(app: &SoundApp, at: f64, row: f64) -> Option<Pos2> {
+    let rows = &app.edit_layout.rows;
+    let i = (row.max(0.0) as usize).min(rows.len().checked_sub(1)?);
+    let r = rect(rows[i].1);
+    let tl = rect(app.edit_layout.timeline);
+    let p = pos2(x_of(app.engine.session(), tl, at.round() as i64), r.min.y + (row - i as f64) as f32 * r.height());
+    tl.contains(p).then_some(p)
+}
+
+/// The name of the clip at time `at` on row `row` (as [`pointer_target`] has them), where the Edit window writes it.
+fn clip_name(app: &SoundApp, painter: &Painter, at: f64, row: f64) -> Option<Rect> {
+    let s = app.engine.session();
+    let (id, r) = app.edit_layout.rows.get(row.max(0.0) as usize)?;
+    let t = s.track(TrackId(*id))?;
+    let c = t.clips().iter().find(|c| c.range().contains(at.round() as i64))?;
+    let tl = rect(app.edit_layout.timeline);
+    let lane = Rect::from_min_size(pos2(tl.min.x, r[1]), vec2(tl.width(), t.height.points().min(r[3] - r[1])));
+    let h = clip_name_height(s, lane);
+    let w = painter.layout_no_wrap(c.name.clone(), crate::theme::bold(10.5), Color32::WHITE).size().x;
+    (h > 0.0).then(|| Rect::from_min_size(pos2(x_of(s, tl, c.start).max(tl.min.x) + 4.0, lane.min.y + 1.0), vec2(w, h)))
+}
+
+/// The value range an automation lane draws `p` over (as `draw_automation` does).
+fn value_range(track: &Track, p: &AutoParam) -> (f32, f32) {
+    match p {
+        AutoParam::Volume | AutoParam::SendLevel(_) => (-60.0, 12.0),
+        AutoParam::Plugin { .. } => plugin_range(track, p),
+        _ => {
+            let (lo, hi, _) = p.range();
+            (lo, hi)
+        }
+    }
+}
+
+/// The others over the Edit window's tracks (`overlay` calls it first, over the clips): their ghosts, rubber bands,
+/// strokes and playheads, then outlines around what they selected, then their pointers.
+pub(crate) fn draw_presence(app: &SoundApp, ui: &Ui) {
+    let (s, tl) = (app.engine.session(), rect(app.edit_layout.timeline));
+    let rows: Vec<(u64, Rect)> = app.edit_layout.rows.iter().map(|(id, r)| (*id, rect(*r))).collect();
+    let painter = ui.painter().with_clip_rect(tl);
+    let ctx = ui.ctx();
+    let row_of = |track: &Value| Some(rows.iter().position(|(id, _)| Some(*id) == track.as_u64())? as f64);
+    // The main lane of row `v` (its index plus a fraction), moved down by that fraction.
+    let lane = |v: f64| {
+        let i = (v.max(0.0) as usize).min(rows.len().checked_sub(1)?);
+        let (id, r) = rows[i];
+        let h = s.track(TrackId(id)).map_or(r.height(), |t| t.height.points().min(r.height()));
+        Some(Rect::from_min_size(pos2(tl.min.x, r.min.y + (v - i as f64) as f32 * r.height()), vec2(tl.width(), h)))
+    };
+    // Remote times: x clamped to just past the timeline.
+    let x = |at: f64| x_of(s, tl, at.round() as i64).clamp(tl.min.x - 8.0, tl.max.x + 8.0);
+    // A clip's body from time `a` to `b` on the main lane of row `v`.
+    let body = |a: f64, v: f64, b: f64| lane(v).map(|l| Rect::from_min_max(pos2(x(a), l.min.y + 1.0), pos2(x(b).max(x(a) + 1.0), l.max.y - 1.0)));
+    let spp = s.edit.zoom.samples_per_px.max(0.01);
+    let px = [1.0 / spp, rows.first().map_or(50.0, |r| f64::from(r.1.height())), 1.0 / spp];
+    let far = [f64::from(tl.width()) / 4.0, f64::from(tl.height()) / 4.0, f64::from(tl.width()) / 4.0];
+    let others = presence::others();
+    for o in &others {
+        let (st, color) = (&o.state, presence::color(o));
+        let span = |g: &Value| Some([time(&g[1])?, row_of(&g[0])?, time(&g[2])?]);
+        let ghosts: Vec<_> = items(&st["ghosts"]).filter_map(span).collect();
+        let rubber: Vec<_> = span(&st["band"]).into_iter().collect();
+        // A Pencil stroke on an automation lane: its points as values on this person's lane for that track.
+        let stroke = &st["stroke"];
+        let stroke = (s.track(TrackId(stroke["track"].as_u64().unwrap_or_default())))
+            .zip(stroke["view"].as_str().and_then(AutoParam::parse))
+            .zip(row_of(&stroke["track"]).and_then(lane))
+            .map(|((t, p), lane)| {
+                let (lo, hi) = value_range(t, &p);
+                let y = move |v: f64| lane.max.y - 4.0 - ((v as f32 - lo) / (hi - lo).max(1e-6)).clamp(0.0, 1.0) * (lane.height() - 8.0);
+                let points: Vec<[f64; 2]> = (stroke["points"].as_array().into_iter().flatten().take(MAX_STROKE))
+                    .filter_map(|p| Some([time(&p[0])?, p[1].as_f64().filter(|v| v.is_finite())?]))
+                    .collect();
+                (points, y, (hi - lo).max(1e-6), lane)
+            });
+        let fade = &st["fade"];
+        let fade =
+            s.find_clip(ClipId(fade["clip"].as_u64().unwrap_or_default())).zip(Fade::deserialize(&fade["fade"]).ok()).zip(fade["in"].as_bool());
+        // The playhead while it shows on the timeline.
+        if let Some([t]) = time(&st["playhead"]).and_then(|t| presence::ease(ctx, &o.id, "edit.playhead", [t], [px[0]], [far[0]]))
+            && (tl.min.x..=tl.max.x).contains(&x(t))
+        {
+            presence::playhead(&painter, x(t), [tl.min.y, tl.max.y], tl.max.x, color, &o.name);
+        }
+        for &[a, v, b] in presence::ease_list(ctx, &o.id, "edit.ghosts", ghosts.as_flattened(), &px, &far).unwrap_or_default().as_chunks().0 {
+            if let Some(r) = body(a, v, b) {
+                presence::ghost(&painter, r, color);
+            }
+        }
+        for &[a, v, b] in presence::ease_list(ctx, &o.id, "edit.band", rubber.as_flattened(), &px, &far).unwrap_or_default().as_chunks().0 {
+            if let Some(r) = body(a, v, b) {
+                presence::dashed(&painter, &[r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom()], true, color);
+            }
+        }
+        // A fade being drawn or bent: the area under its curve, as the clip draws its fades.
+        if let Some((((track, c), fade), fade_in)) = fade
+            && fade.len > 0
+            && fade.len <= c.length
+            && fade.curvature.is_finite()
+            && let Some(l) = row_of(&json!(track.0)).and_then(lane)
+        {
+            let r = Rect::from_min_max(pos2(x(c.start as f64), l.min.y + 1.0), pos2(x(c.end() as f64), l.max.y - 1.0));
+            let body = Rect::from_min_max(pos2(r.min.x, r.min.y + clip_name_height(s, l)), r.max);
+            let (a, b) = match fade_in {
+                true => (r.min.x, x((c.start + fade.len) as f64)),
+                false => (x((c.end() - fade.len) as f64), r.max.x),
+            };
+            let curve = fade_curve_points(fade, fade_in, a, b, body, ctx.pixels_per_point());
+            let mut mesh = egui::Mesh::default();
+            for (i, p) in curve.iter().enumerate() {
+                mesh.colored_vertex(*p, color.gamma_multiply(GHOST));
+                mesh.colored_vertex(pos2(p.x, body.max.y), color.gamma_multiply(GHOST));
+                if let Some(k) = (2 * i as u32).checked_sub(2) {
+                    mesh.add_triangle(k, k + 1, k + 2);
+                    mesh.add_triangle(k + 1, k + 2, k + 3);
+                }
+            }
+            painter.with_clip_rect(r.intersect(tl)).add(mesh);
+            painter.with_clip_rect(r.intersect(tl)).add(Shape::line(curve, Stroke::new(1.5, color.gamma_multiply(GHOST_EDGE))));
+        }
+        if let Some((mut points, y, span, lane)) = stroke {
+            // The newest point eases; the others are where the stroke has them.
+            let k = [px[0], f64::from(lane.height() / span)];
+            if let Some(tip) = points.pop().and_then(|tip| presence::ease(ctx, &o.id, "edit.stroke", tip, k, [far[0], far[1]])) {
+                points.push(tip);
+            }
+            let line: Vec<Pos2> = points.iter().map(|&[t, v]| pos2(x(t), y(v))).collect();
+            if let Some(&tip) = line.last() {
+                painter.circle_filled(tip, 2.0, color.gamma_multiply(STROKE));
+            }
+            painter.with_clip_rect(lane.intersect(tl)).add(Shape::line(line, Stroke::new(2.0, color.gamma_multiply(STROKE))));
+        }
+    }
+    for o in &others {
+        let (st, color) = (&o.state["selection"], presence::color(o));
+        let selecting = o.state["selecting"] == true;
+        let ids = |v: &Value| items(v).filter_map(Value::as_u64).collect::<Vec<_>>();
+        if let (Some(a), Some(b)) = (time(&st["range"][0]), time(&st["range"][1])) {
+            for v in ids(&st["tracks"]).into_iter().filter_map(|t| row_of(&json!(t))) {
+                // A time range (at least 2 points wide: an insertion point); filled while it is being dragged.
+                if let Some(l) = lane(v).filter(|_| x(b) >= tl.min.x && x(a) <= tl.max.x) {
+                    let r = Rect::from_min_max(pos2(x(a), l.min.y + 1.0), pos2(x(b).max(x(a) + 2.0), l.max.y - 1.0));
+                    if selecting { presence::ghost(&painter, r, color) } else { presence::outline(&painter, r, color) }
+                }
+            }
+        }
+        for clip in ids(&st["clips"]) {
+            if let Some((track, c)) = s.find_clip(ClipId(clip))
+                && let Some(r) = row_of(&json!(track.0)).and_then(|v| body(c.start as f64, v, c.end() as f64))
+            {
+                presence::outline(&painter, r, color);
+            }
+        }
+    }
+    for o in &others {
+        if let Some([at, v, _]) = pointer_target(app, &o.state["pointer"]).and_then(|t| presence::ease(ctx, &o.id, "edit.pointer", t, px, far))
+            && let Some(tip) = edit_pos(app, at, v)
+        {
+            cursor(&painter, tip, presence::color(o), &o.name, value(o), clip_name(app, &painter, at, v));
+        }
+    }
+}
+
+/// The others in the MIDI Editor when they edit `clip` there too: the notes they drag as ghosts, outlines around those
+/// they selected, and their pointers. The editor calls it after drawing its notes, with its roll and its own mapping
+/// of ticks and pitches to the roll (pixels per tick, scroll and row height); this records them for [`Live::live_presence`].
+pub(crate) fn midi(ui: &Ui, clip: ClipId, roll: Rect, px_per_tick: f32, scroll: f32, row_h: f32) {
+    let ctx = ui.ctx();
+    // The editor's mapping: x = roll.min.x + tick * px_per_tick; y = roll.min.y + (127 - pitch) * row_h - scroll.
+    let (x0, y0) = (roll.min.x, roll.min.y + 127.0 * row_h - scroll);
+    // The velocity lane comes after this (as the editor laid it out the pass before): end_frame draws over it.
+    let vel = ctx.read_response(ui.id().with(("vel", clip.0))).map(|r| r.rect).filter(|v| v.height() > 4.0 && v.width() > 0.0);
+    let (layer, area) = (ui.layer_id(), ui.clip_rect());
+    let r =
+        Roll { pass: ctx.cumulative_pass_nr(), clip: clip.0, rect: roll, vel, layer, area, x0, kx: px_per_tick, y0, ky: -row_h };
+    ROLL.set(Some(r));
+    if !(r.kx > 0.0 && r.ky < 0.0) {
+        return;
+    }
+    let painter = ui.painter().with_clip_rect(roll);
+    let note = |n: &Value| {
+        let len = time(&n[2]).filter(|l| *l > 0.0)?;
+        Some([time(&n[0])?, n[1].as_u64().filter(|p| *p <= 127)? as f64, len])
+    };
+    let px = [f64::from(r.kx), f64::from(-r.ky), f64::from(r.kx)];
+    let far = [f64::from(roll.width()) / 4.0, f64::from(roll.height()) / 4.0, f64::from(roll.width()) / 4.0];
+    let others = presence::others();
+    let here: Vec<_> = others.iter().filter(|o| o.state["midi"]["clip"].as_u64() == Some(clip.0)).collect();
+    for o in &here {
+        let ghosts: Vec<_> = items(&o.state["midi"]["ghosts"]).filter_map(note).collect();
+        for &g in presence::ease_list(ctx, &o.id, "midi.ghosts", ghosts.as_flattened(), &px, &far).unwrap_or_default().as_chunks().0 {
+            presence::ghost(&painter, r.note(g), presence::color(o));
+        }
+    }
+    for o in &here {
+        for n in items(&o.state["midi"]["notes"]).filter_map(note) {
+            presence::outline(&painter, r.note(n), presence::color(o));
+        }
+    }
+    for o in &here {
+        let p = &o.state["pointer"];
+        let to = (p["clip"].as_u64() == Some(clip.0))
+            .then(|| Some([time(&p["tick"])?, p["pitch"].as_f64().filter(|p| (-1.0..=129.0).contains(p))?]))
+            .flatten();
+        if let Some([tick, pitch]) = to.and_then(|t| presence::ease(ctx, &o.id, "midi.pointer", t, [px[0], px[1]], [far[0], far[1]])) {
+            cursor(&painter, r.at([tick, pitch]), presence::color(o), &o.name, value(o), None);
+        }
+    }
+}
+
+/// A Mix-window strip being drawn (`strip` calls it once it has its rect), for [`end_frame`] and the pointer.
+pub(crate) fn strip(ui: &Ui, track: TrackId, rect: Rect) {
+    let pass = ui.ctx().cumulative_pass_nr();
+    STRIPS.with_borrow_mut(|(at, strips)| {
+        if *at != pass {
+            (*at, *strips) = (pass, Vec::new());
+        }
+        strips.push(Strip { track: track.0, rect, clip: ui.clip_rect(), layer: ui.layer_id(), ui: ui.id() });
+    });
+}
+
+/// A control another person sets (`[command, params]`, see [`Live::live_presence`]) when it is on strip `s`: which (0 the
+/// fader, 1 + n pan knob n, 100 + n send n), its widget's rect as the strip laid it out (by the id the strip gives it)
+/// and how far along it the value is (0 to 1: the fader's taper, hard left to hard right).
+fn control(ctx: &Context, s: &Strip, c: &Value) -> Option<(f64, Rect, f64)> {
+    let p = &c[1];
+    let widget = |salt: (&str, u64, usize)| ctx.read_response(s.ui.with(salt)).map(|r| r.rect);
+    let num = |k: &str| p[k].as_f64().filter(|v| v.is_finite()).map(|v| v as f32);
+    let n = |k: &str, most: u64| p[k].as_u64().filter(|n| *n < most).map(|n| n as usize);
+    if p["track"].as_u64() != Some(s.track) {
+        return None;
+    }
+    match c[0].as_str()? {
+        "mix.volume" => Some((0.0, ctx.read_response(s.ui.with(("fader", s.track)))?.rect, f64::from(fader_db_to_pos(num("db")?)))),
+        "mix.pan" => {
+            let i = n("index", 2)?;
+            Some((1.0 + i as f64, widget(("pan-value", s.track, i))?, f64::from(num("pan")?.clamp(-1.0, 1.0) + 1.0) / 2.0))
+        }
+        "mix.send_level" => {
+            let slot = n("slot", 10)?;
+            Some((100.0 + slot as f64, widget(("send-value", s.track, slot))?, f64::from(fader_db_to_pos(num("db")?))))
+        }
+        _ => None,
+    }
+}
+
+/// The ghost of a control ([`control`]: `which`, its widget `w`, at `pos`) in `color`: a fader's cap, a pan knob with its
+/// pointer, a send's level mark; the rect to tag (none on a short track's send square, which shows no level).
+fn control_ghost(painter: &Painter, which: f64, w: Rect, pos: f64, color: Color32) -> Option<Rect> {
+    let pos = pos.clamp(0.0, 1.0) as f32;
+    if which == 0.0 {
+        // As widgets::fader draws its cap.
+        let slot = fader_slot(w);
+        let cap = Rect::from_center_size(
+            pos2(slot.center().x, slot.max.y - slot.height() * pos),
+            vec2((w.width() * 0.4).clamp(16.0, 18.0), w.height() - slot.height()),
+        );
+        presence::ghost(painter, cap, color);
+        Some(cap)
+    } else if which < 100.0 {
+        // `w` is the knob's readout; the knob (widgets::pan_knob) is centred 25 points above it, 8 narrower.
+        let (c, rad) = (w.center() - vec2(0.0, 25.0), (w.width() - 8.0) * 0.42);
+        let at = std::f32::consts::PI * (0.75 + 1.5 * pos);
+        let d = vec2(at.cos(), at.sin());
+        painter.circle(c, rad, color.gamma_multiply(GHOST), Stroke::new(1.5, color.gamma_multiply(GHOST_EDGE)));
+        painter.line_segment([c + d * rad * 0.15, c + d * (rad - 2.5)], Stroke::new(2.0, color.gamma_multiply(GHOST_EDGE)));
+        Some(Rect::from_center_size(c, Vec2::splat(2.0 * rad)))
+    } else {
+        // `w` is the level icon's hit area (mix_window::send_slot): 3 points either side of the icon, 1 above and below.
+        let well = w.shrink2(vec2(3.0, 1.0)).shrink(1.0);
+        let mark = Rect::from_center_size(pos2(well.center().x, well.max.y - well.height() * pos), vec2(well.width() + 6.0, 4.0));
+        (w.width() < 16.0).then(|| presence::ghost(painter, mark, color)).map(|()| well.union(mark))
+    }
+}
+
+/// The end of a frame (the web app's shell calls it): the others' pointers over the Mix window's strips and over the
+/// plug-in windows open here too, drawn over them, with ghosts of the faders, pan knobs and send levels they set; their
+/// pointers and the stalks they drag over the MIDI Editor's velocity lane; where the gesture under way starts in the
+/// command journal; then the kit's end of frame ([`presence::end_frame`]), after every view drew the others.
+pub fn end_frame(app: &SoundApp, ctx: &Context) {
+    presence::set_font(crate::theme::bold(12.0));
+    if !ctx.input(|i| i.pointer.any_down()) {
+        PRESSED_AT.set(app.engine.journal.len());
+    }
+    let strips = STRIPS.with_borrow(|(pass, strips)| if fresh(ctx, *pass) { strips.clone() } else { Vec::new() });
+    let roll = ROLL.get().filter(|r| fresh(ctx, r.pass) && r.kx > 0.0);
+    let now = ctx.input(|i| i.time);
+    HELD.with_borrow_mut(|held| {
+        for o in &presence::others() {
+            let (p, color) = (&o.state["pointer"], presence::color(o));
+            let (x, y) = (fraction(&p["x"]), fraction(&p["y"]));
+            // A fader, pan knob or send level they set (and for a moment after they let go: until the change arrives), as
+            // a ghost on this person's strip for it, its value beside it.
+            if o.state["control"].is_array() {
+                held.insert(o.id.clone(), (o.state["control"].clone(), value(o).unwrap_or_default().to_owned(), now));
+            }
+            let mut value_tag = None;
+            if let Some((c, text, seen)) = held.get(&o.id).filter(|h| now - h.2 < LINGER)
+                && let Some((s, (which, w, pos))) = strips.iter().find_map(|s| Some((s, control(ctx, s, c)?)))
+                && let Some([_, _, pos]) =
+                    presence::ease(ctx, &o.id, "mix.control", [s.track as f64, which, pos], [1.0, 1.0, 100.0], [0.0, 0.0, f64::INFINITY])
+            {
+                let painter = ctx.layer_painter(s.layer).with_clip_rect(s.clip);
+                value_tag = control_ghost(&painter, which, w, pos, color).and_then(|g| tag_beside(&painter, g, text, color));
+                if *seen < now {
+                    presence::keep_moving();
+                }
+            }
+            let shown = value(o).filter(|_| value_tag.is_none());
+            // Over a strip: its place among this person's strips, plus how far across and down it.
+            let on = p["strip"].as_u64().and_then(|t| strips.iter().position(|s| s.track == t));
+            if let Some(&first) = strips.first()
+                && let Some([v, y]) = on.zip(x).zip(y).and_then(|((i, x), y)| {
+                    let px = [f64::from(first.rect.width()), f64::from(first.clip.height())];
+                    let far = [f64::from(first.clip.width()) / 4.0, f64::from(first.clip.height()) / 4.0];
+                    presence::ease(ctx, &o.id, "mix.pointer", [i as f64 + x, y], px, far)
+                })
+            {
+                let i = (v.max(0.0) as usize).min(strips.len() - 1);
+                let s = strips[i];
+                let tip = pos2(s.rect.min.x + (v - i as f64) as f32 * s.rect.width(), s.rect.min.y + y as f32 * s.rect.height());
+                cursor(&ctx.layer_painter(s.layer).with_clip_rect(s.clip), tip, color, &o.name, shown, value_tag);
+            }
+            // Over the MIDI Editor's velocity lane when they edit its clip too: the stalks they drag, and their pointer.
+            if let Some(r) = roll
+                && let Some(vel) = r.vel
+                && o.state["midi"]["clip"].as_u64() == Some(r.clip)
+            {
+                let painter = ctx.layer_painter(r.layer).with_clip_rect(r.area);
+                let px = [f64::from(r.kx), f64::from((vel.height() - 4.0) / 127.0)];
+                let far = [f64::from(r.rect.width()) / 4.0, f64::INFINITY];
+                let stalks: Vec<_> =
+                    items(&o.state["midi"]["vel"]).filter_map(|s| Some([time(&s[0])?, s[1].as_u64().filter(|v| *v <= 127)? as f64])).collect();
+                for &[tick, v] in presence::ease_list(ctx, &o.id, "midi.vel", stalks.as_flattened(), &px, &far).unwrap_or_default().as_chunks().0 {
+                    // As the editor draws a stalk: 3 points wide from the lane's foot, a dot on top.
+                    let top = r.vel_pos(vel, [tick, v]) + vec2(1.0, 0.0);
+                    presence::ghost(
+                        &painter.with_clip_rect(vel),
+                        Rect::from_min_max(top - vec2(2.0, 0.0), pos2(top.x + 2.0, vel.max.y - 2.0)),
+                        color,
+                    );
+                    painter.with_clip_rect(vel).circle(top, 3.5, color.gamma_multiply(GHOST), Stroke::new(1.5, color.gamma_multiply(GHOST_EDGE)));
+                }
+                let to = (p["clip"].as_u64() == Some(r.clip))
+                    .then(|| Some([time(&p["tick"])?, p["vel"].as_f64().filter(|v| (-10.0..=140.0).contains(v))?]))
+                    .flatten();
+                if let Some([tick, v]) = to.and_then(|t| presence::ease(ctx, &o.id, "midi.vel.pointer", t, px, [far[0], f64::from(vel.height())])) {
+                    cursor(&painter, r.vel_pos(vel, [tick, v]), color, &o.name, value(o), None);
+                }
+            }
+            // Over a plug-in window this person has open too: how far across and down it.
+            let window = (p["plugin"][0].as_u64().zip(p["plugin"][1].as_u64()))
+                .and_then(|(t, slot)| Some((TrackId(t), usize::try_from(slot).ok()?)))
+                .filter(|w| app.ui.plugin_windows.contains(w))
+                .map(|(t, slot)| Id::new(("plugin", t.0, slot)))
+                .and_then(|id| Some((id, ctx.memory(|m| m.area_rect(id))?)));
+            if let Some((id, r)) = window {
+                let px = [f64::from(r.width()), f64::from(r.height())];
+                if let Some([x, y]) = x.zip(y).and_then(|(x, y)| presence::ease(ctx, &o.id, "plugin.pointer", [x, y], px, px.map(|p| p / 4.0))) {
+                    let tip = r.min + vec2(x as f32 * r.width(), y as f32 * r.height());
+                    cursor(&ctx.layer_painter(LayerId::new(Order::Middle, id)).with_clip_rect(r), tip, color, &o.name, shown, None);
+                }
+            }
+        }
+        held.retain(|_, h| now - h.2 < LINGER);
+    });
+    presence::end_frame(ctx);
+}
+
+/// Where `p` is, in the session's terms: over a plug-in window (`{plugin: [track, slot], x, y}`), a Mix-window strip
+/// (`{strip: track, x, y}`), the MIDI Editor's roll (`{clip, tick, pitch}`) or velocity lane (`{clip, tick, vel}`) or the
+/// Edit window's tracks ([`pointer_at`]).
+fn pointer(app: &SoundApp, ctx: &Context, p: Pos2) -> Option<Value> {
+    let across = |r: Rect| [fine((p.x - r.min.x) / r.width()), fine((p.y - r.min.y) / r.height())];
+    let layer = ctx.layer_id_at(p);
+    for &(t, slot) in &app.ui.plugin_windows {
+        let id = Id::new(("plugin", t.0, slot));
+        if layer == Some(LayerId::new(Order::Middle, id))
+            && let Some(r) = ctx.memory(|m| m.area_rect(id))
+        {
+            let [x, y] = across(r);
+            return Some(json!({"plugin": [t.0, slot], "x": x, "y": y}));
+        }
+    }
+    let strip = STRIPS.with_borrow(|(pass, strips)| {
+        let hit = |s: &&Strip| layer == Some(s.layer) && s.rect.contains(p) && s.clip.contains(p);
+        strips.iter().find(hit).filter(|_| fresh(ctx, *pass)).copied()
+    });
+    if let Some(s) = strip {
+        let [x, y] = across(s.rect);
+        return Some(json!({"strip": s.track, "x": x, "y": y}));
+    }
+    if let Some(r) = ROLL.get().filter(|r| fresh(ctx, r.pass) && r.kx > 0.0 && r.ky < 0.0) {
+        if r.rect.contains(p) {
+            let pitch = (f64::from((p.y - r.y0) / r.ky) * 100.0).round() / 100.0;
+            return Some(json!({"clip": r.clip, "tick": f64::from((p.x - r.x0) / r.kx).round() as i64, "pitch": pitch}));
+        }
+        if let Some(vel) = r.vel.filter(|v| v.contains(p)) {
+            let [tick, v] = r.vel_at(vel, p);
+            return Some(json!({"clip": r.clip, "tick": tick as i64, "vel": (v * 10.0).round() / 10.0}));
+        }
+    }
+    (app.ui.window == MainWindow::Edit || app.ui.mix_separate).then(|| pointer_at(app, p)).flatten()
+}
+
+/// The gesture under way in the Edit window, where it has things so far: `ghosts` ([track, start, end] of each clip
+/// moved or trimmed, as the Edit window previews them), `band` (a MIDI clip being drawn), `fade` (`{clip, in, fade}`),
+/// `stroke` (`{track, view, points: [[time, value]...]}`, the newest points of a Pencil stroke) or `selecting`.
+fn edit_gesture(app: &SoundApp, ctx: Option<&Context>, state: &mut Value) {
+    let s = app.engine.session();
+    let span = |track: TrackId, a: i64, b: i64| json!([track.0, a, b]);
+    match &app.gesture {
+        Some(Gesture::Select { .. }) => state["selecting"] = true.into(),
+        Some(Gesture::MoveClips { clips, delta, from_track, to_track, grab_at }) => {
+            let Some(ctx) = ctx else { return };
+            // As the Edit window's overlay draws the move.
+            let plan = drag_plan(ctx, s, app.engine.revision, clips, (*from_track, *to_track), *grab_at);
+            let Some(dest) = &plan.dest else { return };
+            let ghosts: Vec<_> = (plan.moving.iter().take(MAX_ITEMS))
+                .map(|&(t, start, len)| {
+                    let d = ops::lands(dest, t);
+                    let start = (plan.groups.iter().find(|g| g.0 == d))
+                        .map_or(start + delta, |(_, first, slots)| ops::nearest_slot(slots, first + delta) + (start - first));
+                    span(d, start, start + len)
+                })
+                .collect();
+            state["ghosts"] = ghosts.into();
+        }
+        Some(g @ (Gesture::TrimStart { clip, to, .. } | Gesture::TrimEnd { clip, to, .. })) => {
+            if let Some((t, c)) = s.find_clip(*clip) {
+                // Where trimming leaves the clip (as Spot::trim has it).
+                let (a, b) = match g {
+                    Gesture::TrimStart { .. } => ((*to).min(c.end().saturating_sub(1)), c.end()),
+                    _ => (c.start, (*to).max(c.start.saturating_add(1))),
+                };
+                state["ghosts"] = json!([span(t, a, b)]);
+            }
+        }
+        Some(Gesture::MidiClip { track, from, to }) => {
+            if let Some(r) = midi_clip_span(s, *track, *from, *to) {
+                state["band"] = span(*track, r.start, r.end);
+            }
+        }
+        Some(Gesture::Fade { clip, fade_in, .. } | Gesture::FadeCurve { clip, fade_in, .. }) => {
+            if let Some((_, c)) = s.find_clip(*clip) {
+                let (i, o) = clip_preview_fades(c, app.gesture.as_ref());
+                let fade = if *fade_in { i } else { o };
+                state["fade"] = json!({"clip": clip.0, "in": fade_in, "fade": fade});
+            }
+        }
+        Some(Gesture::Pencil { track, points }) if !points.is_empty() => {
+            let newest = &points[points.len().saturating_sub(MAX_STROKE)..];
+            let points: Vec<_> = newest.iter().map(|&(at, v)| json!([at, (f64::from(v) * 100.0).round() / 100.0])).collect();
+            state["stroke"] = json!({"track": track.0, "view": s.track(*track).map(|t| t.view.as_str()), "points": points});
+        }
+        _ => {}
+    }
+}
+
+/// The MIDI Editor's clip when it shows one: `{clip, notes, ghosts?, vel?}`, the selected notes and those being dragged,
+/// as [tick, pitch, length] (where the editor draws a drag: a move takes the selection along with the grabbed note), and
+/// the notes whose velocity the gesture under way set, as [tick, velocity].
+fn midi_marks(app: &SoundApp, ctx: &Context, state: &mut Value) {
+    let Some(r) = ROLL.get().filter(|r| fresh(ctx, r.pass)) else { return };
+    let Some((_, c)) = app.engine.session().find_clip(ClipId(r.clip)) else { return };
+    let ClipContent::Midi { sequence } = &c.content else { return };
+    let selected = &app.midi.selected;
+    let notes: Vec<_> = selected.iter().filter_map(|&i| sequence.notes.get(i)).take(MAX_ITEMS).map(|n| json!([n.start, n.pitch, n.length])).collect();
+    state["midi"] = json!({"clip": r.clip, "notes": notes});
+    if let Some(d) = &app.midi.drag {
+        let dragged = |i: &usize| *i == d.index || (!d.resize && selected.contains(i) && selected.contains(&d.index));
+        let ghosts: Vec<_> = (sequence.notes.iter().enumerate().filter(|(i, _)| dragged(i)).take(MAX_ITEMS))
+            .map(|(_, n)| match d.resize {
+                true => json!([n.start, n.pitch, (n.length + d.dx_ticks).max(1)]),
+                false => json!([(n.start + d.dx_ticks).max(0), (i64::from(n.pitch) + d.dy_semi).clamp(0, 127), n.length]),
+            })
+            .collect();
+        state["midi"]["ghosts"] = ghosts.into();
+    }
+    if ctx.input(|i| i.pointer.any_down()) {
+        let mut set = BTreeMap::new();
+        for (id, p) in app.engine.journal.iter().skip(PRESSED_AT.get()).map(|(id, p)| (id, p)) {
+            if id == "midi.note_edit"
+                && p["clip"].as_u64() == Some(r.clip)
+                && let (Some(i), Some(v)) = (p["index"].as_u64(), p["velocity"].as_u64())
+            {
+                set.insert(i, v);
+            }
+        }
+        let vel: Vec<_> =
+            set.into_iter().filter_map(|(i, v)| Some(json!([sequence.notes.get(usize::try_from(i).ok()?)?.start, v]))).take(MAX_ITEMS).collect();
+        if !vel.is_empty() {
+            state["midi"]["vel"] = vel.into();
+        }
+    }
+}
+
+/// What a command a gesture runs sets, as its tag shows it: a fader, pan, trim, send, plug-in parameter, clip gain or
+/// velocity. Other commands say nothing.
+fn value_text(s: &Session, (id, p): &(String, Value)) -> Option<String> {
+    let num = |k: &str| p[k].as_f64().filter(|v| v.is_finite()).map(|v| v as f32);
+    let track = || s.track(TrackId(p["track"].as_u64()?));
+    let send = || Some(char::from(b'A' + u8::try_from(p["slot"].as_u64()?).ok().filter(|s| *s < 26)?));
+    let param = |plugin: &str| crate::mix_window::plugin_info(plugin)?.param(p["param"].as_str()?);
+    Some(match id.as_str() {
+        "mix.volume" => format!("Volume {} dB", db_text(num("db")?)),
+        "mix.pan" => format!("Pan {}", pan_text(num("pan")?)),
+        "mix.trim" => format!("Trim {:+.1} dB", num("db")?),
+        "clip.gain" => format!("Clip gain {:+.1} dB", num("db")?),
+        "mix.send_level" => match num("db") {
+            Some(db) => format!("Send {} {} dB", send()?, db_text(db)),
+            None => format!("Send {} pan {}", send()?, pan_text(num("pan")?)),
+        },
+        "mix.insert_param" => {
+            let ins = track()?.mixer.inserts.get(usize::try_from(p["slot"].as_u64()?).ok()?)?.as_ref()?;
+            let info = param(&ins.plugin)?;
+            format!("{} {}", info.name, info.format(num("value")?))
+        }
+        "mix.instrument_param" => {
+            let ins = track()?.instrument.as_ref()?;
+            let info = param(&ins.plugin)?;
+            format!("{} {}", info.name, crate::sampler_window::format_param(&ins.plugin, info, num("value")?))
+        }
+        "midi.note_edit" => format!("Velocity {}", p["velocity"].as_u64()?),
+        _ => return None,
+    })
+}
+
+/// Halves the longest list a gesture grows until the state fits the shell's 4 KiB (a stroke keeps its newest points).
+fn fit(state: &mut Value) {
+    const LISTS: [&str; 7] = ["/stroke/points", "/ghosts", "/midi/ghosts", "/midi/notes", "/midi/vel", "/selection/clips", "/selection/tracks"];
+    while state.to_string().len() > 4000 {
+        let len = |p: &str| state.pointer(p).and_then(Value::as_array).map_or(0, Vec::len);
+        let Some(longest) = LISTS.into_iter().max_by_key(|p| len(p)).filter(|p| len(p) > 0) else { return };
+        let Some(list) = state.pointer_mut(longest).and_then(Value::as_array_mut) else { return };
+        match longest == LISTS[0] {
+            true => drop(list.drain(..list.len().div_ceil(2))),
+            false => list.truncate(list.len() / 2),
+        }
+    }
+}
