+impl Live for SoundApp {
+    const COUNTERS: &'static [&'static str] = &["next_id"];
+
+    fn live_document(&self) -> Value {
+        let mut s = self.engine.session().clone();
+        for t in &mut s.tracks {
+            keep_views(t, &fresh_track(t));
+        }
+        s.sources.iter_mut().for_each(|s| s.unsaved = false);
+        let mut doc = serde_json::to_value(&s).unwrap_or_default();
+        if let Some(doc) = doc.as_object_mut() {
+            doc.remove("edit");
+        }
+        // Playlists keyed by their name, so clips merge one by one (a track with two of one name merges them whole).
+        for t in doc["tracks"].as_array_mut().into_iter().flatten() {
+            for p in t["playlists"].as_array_mut().into_iter().flatten() {
+                p["id"] = p["name"].clone();
+            }
+        }
+        doc
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        // A playlist keeps its clips in (start, id) order: merge them as sets (id order on every side), then sort them.
+        let by_id = |doc: &Value| {
+            let mut doc = doc.clone();
+            clip_lists(&mut doc).for_each(|clips| clips.sort_by_key(|c| c["id"].as_u64()));
+            doc
+        };
+        let mut doc = playground_live::merge(&by_id(base), &by_id(current), &by_id(edited), Self::COUNTERS)?;
+        clip_lists(&mut doc).for_each(|clips| clips.sort_by_key(|c| (c["start"].as_i64(), c["id"].as_u64())));
+        // Only a session the app opens.
+        let edit = serde_json::to_value(EditState::default()).map_err(|e| e.to_string())?;
+        doc.as_object_mut().ok_or("Not a session")?.insert("edit".into(), edit);
+        Session::deserialize(&doc).map_err(|e| format!("Invalid session: {e}"))?;
+        doc.as_object_mut().map(|doc| doc.remove("edit"));
+        Ok(doc)
+    }
+
+    fn live_adopt(&mut self, mut document: Value) -> Result<(), String> {
+        let current = self.engine.session();
+        let edit = serde_json::to_value(&current.edit).map_err(|e| e.to_string())?;
+        document.as_object_mut().ok_or("Not a session")?.insert("edit".into(), edit);
+        let mut s: Session = serde_json::from_value(document).map_err(|e| format!("Invalid session: {e}"))?;
+        // Repairs what a merge can break (clip order, a removed active playlist); the id counter stays as shared.
+        let next_id = s.next_id;
+        s.sanitize();
+        s.next_id = next_id;
+        for t in &mut s.tracks {
+            let new = fresh_track(t);
+            keep_views(t, current.track(t.id).unwrap_or(&new));
+        }
+        for src in &mut s.sources {
+            src.unsaved = current.source(src.id).is_some_and(|c| c.unsaved);
+        }
+        s.pool = current.pool.clone();
+        // Source ids before the session were counted on each side: this browser's own audio under a shared source's id
+        // is not that source's (it then arrives as a session file).
+        for src in &s.sources {
+            if current.source(src.id).is_some_and(|c| !same_audio(c, src)) {
+                s.pool.remove(src.id);
+            }
+        }
+        s.folder = current.folder.clone();
+        *self.engine.session_mut() = s;
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        presence::quiet()
+            && self.gesture.is_none()
+            && self.dialogs.open.is_none()
+            && self.bounce.is_none()
+            && !self.engine.transport.recording
+            && self.touched.is_empty()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.engine.revision)
+    }
+
+    /// Forgets Undo and Redo: their steps hold other people's edits. A step pushed with no history kept clears both.
+    fn live_disconnected(&mut self) {
+        let limit = std::mem::replace(&mut self.engine.history_limit, 0);
+        self.engine.push_undo("", Arc::new(Session::default()));
+        self.engine.history_limit = limit;
+    }
+
+    /// `{ selection: { tracks, clips, range: [start, end] }, pointer?, playhead?, value?, control?, midi?, ...the Edit
+    /// window's gesture }` (see [`pointer`], [`edit_gesture`], [`midi_marks`], [`value_text`]; an empty range is the
+    /// insertion point; the playhead while playing or scrubbing; `control` the command setting a fader, pan or send).
+    fn live_presence(&self) -> Value {
+        let s = self.engine.session();
+        let ctx = self.docking_context.as_ref();
+        let selection = json!({
+            "tracks": s.edit.selected_tracks.iter().take(MAX_ITEMS).collect::<Vec<_>>(),
+            "clips": s.edit.selected_clips.iter().take(MAX_ITEMS).collect::<Vec<_>>(),
+            "range": [s.edit.selection.start, s.edit.selection.end],
+        });
+        let mut state = json!({"selection": selection});
+        if let Some(ctx) = ctx {
+            if let Some(pointer) = ctx.input(|i| i.pointer.hover_pos()).and_then(|p| pointer(self, ctx, p)) {
+                state["pointer"] = pointer;
+            }
+            midi_marks(self, ctx, &mut state);
+            let since = PRESSED_AT.get();
+            if ctx.input(|i| i.pointer.any_down())
+                && let Some((c, value)) = self.engine.journal.iter().skip(since).rev().find_map(|c| Some((c, value_text(s, c)?)))
+            {
+                state["value"] = value.into();
+                // A fader, pan knob or send level: the others show it on theirs (end_frame).
+                if matches!(c.0.as_str(), "mix.volume" | "mix.pan" | "mix.send_level") {
+                    state["control"] = json!([c.0, c.1]);
+                }
+            }
+        }
+        if self.is_playing() || matches!(self.gesture, Some(Gesture::Scrub { .. })) {
+            state["playhead"] = self.position().into();
+        }
+        edit_gesture(self, ctx, &mut state);
+        fit(&mut state);
+        state
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let (s, demo) = (self.engine.session(), soundcraft_engine::demo::cached_demo_session());
+        let built_in = |id| matches!((s.pool.get(id), demo.pool.get(id)), (Some(a), Some(b)) if Arc::ptr_eq(a, b));
+        s.sources
+            .iter()
+            .filter(|src| !built_in(src.id))
+            .map(|src| (src.id.0.to_string(), format!("{}.wav", src.name), s.pool.contains(src.id)))
+            .collect()
+    }
+
+    /// Every source id (the demo's too, which `live_assets` leaves out: nobody shares it).
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        document["sources"].as_array().into_iter().flatten().filter_map(|s| s["id"].as_u64()).map(|id| id.to_string()).collect()
+    }
+
+    /// The source's audio as a 32-bit float WAV, as a saved bundle carries it.
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        let audio = self.engine.session().pool.get(SourceId(id.parse().ok()?))?;
+        let wav = EncodeOptions { format: FileFormat::Wav, bit_depth: BitDepth::Float32, dither: false, bwf: None };
+        soundcraft_audio_io::encode(&audio.buffer, &wav).ok()
+    }
+
+    /// Into the pool, as opening a bundle decodes it, if it is the audio the source describes and none is here yet (a late
+    /// arrival never replaces it). Only what [`Self::live_read_asset`] sends is decoded: a 32-bit float WAV no bigger
+    /// than that audio, never a compressed file that could decode to far more.
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let s = self.engine.session();
+        let Some(src) = id.parse().ok().and_then(|id| s.source(SourceId(id))) else { return };
+        let most = src.frames.saturating_mul(u64::from(src.channels)).saturating_mul(4).saturating_add(65536);
+        let f32_wav = || {
+            soundcraft_audio_io::detect_format(&bytes, None) == FileFormat::Wav
+                && soundcraft_audio_io::probe(&bytes, None).is_ok_and(|i| (i.format, i.sample_format) == (FileFormat::Wav, SampleFormat::Float32))
+        };
+        if s.pool.contains(src.id) || bytes.len() as u64 > most || !f32_wav() {
+            return;
+        }
+        let Ok((_, buf)) = soundcraft_audio_io::decode(&bytes, Some("wav")) else { return };
+        if (buf.num_channels(), buf.frames() as u64, buf.sample_rate) == (usize::from(src.channels), src.frames, src.sample_rate) {
+            let id = src.id;
+            self.engine.session_mut().pool.insert(id, Arc::new(SourceAudio::new(buf)));
+        }
+    }
+}
