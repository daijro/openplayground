index 0000000..bc98228
--- /dev/null
+++ b/apps/suhina-web/src/audio.rs
@@ -0,0 +1,148 @@
+//! The browser's audio output: the engine renders inside the page's WebAudio callback (cpal's `webaudio` host), on
+//! the one thread a page has. The desktop output (crates/output) renders ahead on a real-time thread of its own,
+//! which a browser without shared memory cannot start.
+
+use std::sync::Arc;
+use std::sync::atomic::{AtomicBool, AtomicU64, AtomicUsize, Ordering};
+
+use cpal::traits::{DeviceTrait, HostTrait, StreamTrait};
+use suhina_engine::model::Project;
+use suhina_engine::{AudioPool, DeviceAssets, Plugins, RenderInputs, RenderOptions, Renderer};
+use suhina_session::{OutputHandle, Player};
+use suhina_session::audio::{AudioSystem, DeviceInfo, HostInfo, LiveOutput, Opened, OutputChoice, OutputInfo};
+
+/// Frames per WebAudio buffer: two are queued, so about 85 ms at 48 kHz. Shorter ones break up while the page draws.
+const BUFFER_FRAMES: u32 = 2048;
+const HOST: &str = "Web Audio";
+const DEVICE: &str = "This browser";
+
+thread_local! {
+    /// The streams playing, so the first click or key can start them (browsers keep audio off until then).
+    static STREAMS: std::cell::RefCell<Vec<std::sync::Weak<cpal::Stream>>> = const { std::cell::RefCell::new(Vec::new()) };
+}
+
+/// Starts the streams the page could not start before the person did anything.
+pub fn resume() {
+    STREAMS.with_borrow_mut(|streams| {
+        streams.retain(|s| s.strong_count() > 0);
+        for stream in streams.iter().filter_map(std::sync::Weak::upgrade) {
+            let _ = stream.play();
+        }
+    });
+}
+
+#[derive(Default)]
+struct Progress {
+    frames: AtomicU64,
+    callback_frames: AtomicUsize,
+    failed: AtomicBool,
+}
+
+struct Live {
+    progress: Arc<Progress>,
+    sample_rate: u32,
+}
+
+impl LiveOutput for Live {
+    fn info(&self) -> OutputInfo {
+        let buffer = self.progress.callback_frames.load(Ordering::Relaxed) as u32;
+        OutputInfo {
+            host: HOST.into(),
+            device: DEVICE.into(),
+            sample_rate: self.sample_rate,
+            buffer_frames: buffer,
+            engine_block: buffer,
+            latency_ms: f64::from(buffer * 2) * 1000.0 / f64::from(self.sample_rate.max(1)),
+            failed: self.progress.failed.load(Ordering::Relaxed),
+            channels: 2,
+            ..OutputInfo::default()
+        }
+    }
+}
+
+/// What keeps a player's stream playing: dropping it stops the stream.
+struct Keep(#[allow(dead_code)] Arc<cpal::Stream>);
+
+impl OutputHandle for Keep {
+    /// Closing drops the stream; no plug-ins run here to hand back.
+    fn close(self: Box<Self>) -> Option<(u32, Plugins)> {
+        None
+    }
+}
+
+#[derive(Default)]
+pub struct WebOutput;
+
+impl AudioSystem for WebOutput {
+    fn hosts(&self) -> Vec<HostInfo> {
+        vec![HostInfo {
+            name: HOST.into(),
+            default: true,
+            devices: vec![DeviceInfo {
+                name: DEVICE.into(),
+                default: true,
+                channels: 2,
+                sample_rates: vec![48_000],
+                default_sample_rate: Some(48_000),
+                buffer_sizes: vec![BUFFER_FRAMES],
+                ..DeviceInfo::default()
+            }],
+            inputs: Vec::new(),
+            error: None,
+        }]
+    }
+
+    fn open(
+        &self,
+        project: &Project,
+        audio: &AudioPool,
+        assets: &DeviceAssets,
+        _choice: &OutputChoice,
+        previous: Option<Player>,
+    ) -> Result<Opened, String> {
+        // One stream at a time: the old one stops before the new one starts.
+        drop(previous);
+        let host = cpal::default_host();
+        let device = host.default_output_device().ok_or("this browser has no audio output")?;
+        let sample_rate = device.default_output_config().map(|c| c.sample_rate()).unwrap_or(48_000);
+        let inputs = RenderInputs::from_audio(audio).with_assets(assets);
+        let mut renderer = Renderer::build(project, inputs, sample_rate, RenderOptions::STOPPED).map_err(|e| e.to_string())?;
+        // No stretch worker thread: the renderer stretches clips itself, as an offline render does.
+        let controller = renderer.controller();
+        let progress = Arc::new(Progress::default());
+        let config = cpal::StreamConfig {
+            channels: 2,
+            sample_rate,
+            buffer_size: cpal::BufferSize::Fixed(BUFFER_FRAMES),
+        };
+        let (watching, failing) = (Arc::clone(&progress), Arc::clone(&progress));
+        let mut cue = Vec::new();
+        let stream = device
+            .build_output_stream(
+                config,
+                move |out: &mut [f32], _: &cpal::OutputCallbackInfo| {
+                    cue.resize(out.len(), 0.0);
+                    renderer.set_live_clock(suhina_engine::live_now(), (out.len() / 2) as u32);
+                    renderer.process_with_cue(out, &mut cue);
+                    watching.callback_frames.store(out.len() / 2, Ordering::Relaxed);
+                    watching.frames.fetch_add((out.len() / 2) as u64, Ordering::Relaxed);
+                },
+                move |_| failing.failed.store(true, Ordering::Relaxed),
+                None,
+            )
+            .map_err(|e| format!("could not open the browser's audio: {e}"))?;
+        let stream = Arc::new(stream);
+        // Refused until the person clicks or types; resume() tries again then.
+        let _ = stream.play();
+        STREAMS.with_borrow_mut(|s| s.push(Arc::downgrade(&stream)));
+        let live = Live { progress, sample_rate };
+        let mut player = Player::with_output(controller, Some(Box::new(Keep(stream))), Arc::new(live));
+        // Takes are written on a thread of their own, which a page cannot start: no audio recording here.
+        drop(player.take_recorder());
+        Ok(Opened { player, notice: None, plugins_kept: false })
+    }
+
+    fn chosen_present(&self, _: &OutputChoice) -> Option<bool> {
+        Some(true)
+    }
+}
