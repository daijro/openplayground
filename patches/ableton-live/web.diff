@@ -0,0 +1,31 @@
+# Suhina in the browser, for Playground (patches/ableton-live.yaml in github.com/daijro/openplayground).
+# The window is crates/ui; crates/playground gives the crates their clock, files and threads on wasm.
+# Build with: trunk build --release   (from apps/suhina-web)
+[package]
+name = "suhina-web"
+description = "Suhina in the browser"
+version.workspace = true
+edition.workspace = true
+license.workspace = true
+rust-version.workspace = true
+publish = false
+
+[[bin]]
+name = "suhina-web"
+path = "src/main.rs"
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+suhina-engine.workspace = true
+suhina-session.workspace = true
+suhina-media.workspace = true
+suhina-ui.workspace = true
+suhina-playground = { path = "../../crates/playground" }
+serde_json.workspace = true
+cpal = { workspace = true, features = ["wasm-bindgen"] }
+eframe = { version = "0.36", default-features = false, features = ["glow", "persistence", "default_fonts"] }
+# accesskit's ids want the browser's random numbers on wasm.
+uuid = { version = "1", features = ["js"] }
+wasm-bindgen = "0.2"
+wasm-bindgen-futures = "0.4"
+js-sys = "0.3"
+web-sys = { version = "0.3", features = ["Window", "Document", "Element", "HtmlCanvasElement", "Location", "Storage", "console"] }
