--- /dev/null
+++ b/crates/playground/src/lib.rs
@@ -0,0 +1,624 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Suhina in the browser, for Playground (patches/ableton-live.yaml in github.com/daijro/openplayground).
+//!
+//! wasm32-unknown-unknown has no clock, no files and no threads: `Instant::now` and `SystemTime::now` panic there,
+//! every file call fails, and `thread::scope`'s spawn and `thread::sleep` panic. The modules that use them take `std`
+//! from here instead, through one `#[cfg(target_arch = "wasm32")] use suhina_playground::std;` line at each one's end
+//! (a local `std` shadows the standard library's name in that module; everything else in it still comes from the real
+//! std):
+//!   time    web-time's Instant and SystemTime;
+//!   fs      an in-memory file system (projects, samples, settings), each change noted for the page to mirror;
+//!   thread  `scope` runs what it spawns at once, on this thread, and `sleep` returns at once; `Builder::spawn` still
+//!           fails, which its callers handle (they do the work in place or go without).
+//! And [`interprocess`], the plug-in hosts' sockets, which always fail: a browser runs no plug-in hosts.
+#![cfg(target_arch = "wasm32")]
+
+/// crates/media's `locate` with the in-memory files: `file` (or `absolute`) inside `project_dir`, with no `..`, when
+/// it is a file there.
+pub fn locate(file: &str, absolute: Option<&str>, project_dir: &::std::path::Path) -> Option<::std::path::PathBuf> {
+    [Some(file), absolute].into_iter().flatten().find_map(|name| {
+        let path = ::std::path::Path::new(name);
+        if path.components().any(|c| matches!(c, ::std::path::Component::ParentDir)) {
+            return None;
+        }
+        let candidate = project_dir.join(path);
+        (candidate.starts_with(project_dir) && std::fs::metadata(&candidate).is_ok_and(|m| m.is_file())).then_some(candidate)
+    })
+}
+
+/// The page's time as std's `SystemTime`, for crates that take that one (chrono).
+pub fn std_time(t: web_time::SystemTime) -> ::std::time::SystemTime {
+    ::std::time::UNIX_EPOCH + t.duration_since(web_time::UNIX_EPOCH).unwrap_or_default()
+}
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+    }
+
+    pub mod process {
+        pub use ::std::process::*;
+
+        /// The page is one process (std's panics on wasm).
+        pub fn id() -> u32 {
+            1
+        }
+    }
+
+    pub mod thread {
+        pub use ::std::thread::*;
+        use ::std::marker::PhantomData;
+
+        /// Returns at once: one thread can only wait by returning to the page.
+        pub fn sleep(_: ::std::time::Duration) {}
+
+        /// [`::std::thread::scope`], where each spawn runs to its end before `spawn` returns.
+        pub fn scope<'env, F, T>(f: F) -> T
+        where
+            F: for<'scope> FnOnce(&'scope Scope<'scope, 'env>) -> T,
+        {
+            f(&Scope(PhantomData))
+        }
+
+        pub struct Scope<'scope, 'env: 'scope>(PhantomData<(&'scope mut &'scope (), &'env mut &'env ())>);
+
+        impl<'scope> Scope<'scope, '_> {
+            pub fn spawn<F, T>(&'scope self, f: F) -> ScopedJoinHandle<'scope, T>
+            where
+                F: FnOnce() -> T + Send + 'scope,
+                T: Send + 'scope,
+            {
+                ScopedJoinHandle(f(), PhantomData)
+            }
+        }
+
+        pub struct ScopedJoinHandle<'scope, T>(T, PhantomData<&'scope ()>);
+
+        impl<T> ScopedJoinHandle<'_, T> {
+            pub fn join(self) -> Result<T> {
+                Ok(self.0)
+            }
+            pub fn is_finished(&self) -> bool {
+                true
+            }
+        }
+    }
+
+    pub mod fs {
+        pub use ::std::fs::*;
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io::{self, Cursor, Read, Seek, SeekFrom, Write};
+        use ::std::path::{Component, Path, PathBuf};
+
+        enum Entry {
+            Dir,
+            File(Vec<u8>, web_time::SystemTime),
+        }
+
+        #[derive(Default)]
+        struct Tree {
+            entries: BTreeMap<PathBuf, Entry>,
+            /// Paths written, created or removed since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+            /// Goes up with every change.
+            generation: u64,
+        }
+
+        thread_local! {
+            static TREE: RefCell<Tree> = RefCell::default();
+        }
+
+        fn with<T>(f: impl FnOnce(&mut Tree) -> T) -> T {
+            TREE.with(|t| f(&mut t.borrow_mut()))
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        pub fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} does not exist", p.display()))
+        }
+
+        impl Tree {
+            fn mark(&mut self, p: PathBuf) {
+                self.generation += 1;
+                self.changed.insert(p);
+            }
+            fn parents(&mut self, p: &Path) {
+                for dir in p.ancestors().skip(1) {
+                    self.entries.entry(dir.to_path_buf()).or_insert(Entry::Dir);
+                }
+            }
+            fn put(&mut self, p: PathBuf, bytes: Vec<u8>) {
+                self.parents(&p);
+                self.entries.insert(p, Entry::File(bytes, web_time::SystemTime::now()));
+            }
+            /// `p` and everything below it.
+            fn below(&self, p: &Path) -> Vec<PathBuf> {
+                self.entries.range(p.to_path_buf()..).map(|(k, _)| k).take_while(|k| k.starts_with(p)).cloned().collect()
+            }
+        }
+
+        /// Stores a file without noting a change (files the page loads from its storage or a session).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            with(|t| t.put(key(p), bytes));
+        }
+
+        /// The paths changed since the last call: each now holds what the page's storage should hold, or is gone.
+        pub fn changes() -> Vec<PathBuf> {
+            with(|t| ::std::mem::take(&mut t.changed).into_iter().collect())
+        }
+
+        /// Goes up with every change, so a caller can tell nothing changed.
+        pub fn generation() -> u64 {
+            with(|t| t.generation)
+        }
+
+        pub fn exists<P: AsRef<Path>>(p: P) -> io::Result<bool> {
+            Ok(metadata(p).is_ok())
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.put(p.clone(), bytes.as_ref().to_vec());
+                t.mark(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, _)) => Ok(bytes.clone()),
+                _ => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                if !t.entries.contains_key(&p) {
+                    t.parents(&p);
+                    t.entries.insert(p.clone(), Entry::Dir);
+                    t.mark(p);
+                }
+            });
+            Ok(())
+        }
+
+        pub fn create_dir<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            if metadata(p.as_ref()).is_ok() {
+                return Err(io::Error::new(io::ErrorKind::AlreadyExists, format!("{} exists", p.as_ref().display())));
+            }
+            create_dir_all(p)
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| match t.entries.get(&p) {
+                Some(Entry::File(..)) => {
+                    t.entries.remove(&p);
+                    t.mark(p);
+                    Ok(())
+                }
+                _ => Err(missing(&p)),
+            })
+        }
+
+        /// Removes an empty folder.
+        pub fn remove_dir<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                if t.below(&p).len() != 1 || !matches!(t.entries.get(&p), Some(Entry::Dir)) {
+                    return Err(io::Error::other(format!("{} is not an empty folder", p.display())));
+                }
+                t.entries.remove(&p);
+                t.mark(p);
+                Ok(())
+            })
+        }
+
+        pub fn remove_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                let gone = t.below(&p);
+                if gone.is_empty() {
+                    return Err(missing(&p));
+                }
+                for g in gone {
+                    t.entries.remove(&g);
+                    t.mark(g);
+                }
+                Ok(())
+            })
+        }
+
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+            let (from, to) = (key(from.as_ref()), key(to.as_ref()));
+            let bytes = read(&from)?;
+            with(|t| {
+                t.entries.remove(&from);
+                t.mark(from);
+                t.put(to.clone(), bytes);
+                t.mark(to);
+            });
+            Ok(())
+        }
+
+        pub fn copy<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<u64> {
+            let bytes = read(from)?;
+            let n = bytes.len() as u64;
+            write(to, bytes)?;
+            Ok(n)
+        }
+
+        pub fn canonicalize<P: AsRef<Path>>(p: P) -> io::Result<PathBuf> {
+            let p = key(p.as_ref());
+            metadata(&p).map(|_| p)
+        }
+
+        /// There are no links here.
+        pub fn read_link<P: AsRef<Path>>(p: P) -> io::Result<PathBuf> {
+            Err(io::Error::new(io::ErrorKind::InvalidInput, format!("{} is not a link", p.as_ref().display())))
+        }
+
+        #[derive(Clone, Copy, Debug, PartialEq, Eq)]
+        pub struct FileType(bool);
+        impl FileType {
+            pub fn is_file(&self) -> bool {
+                self.0
+            }
+            pub fn is_dir(&self) -> bool {
+                !self.0
+            }
+            pub fn is_symlink(&self) -> bool {
+                false
+            }
+        }
+
+        #[derive(Clone, Debug)]
+        pub struct Metadata(Option<(u64, web_time::SystemTime)>);
+        impl Metadata {
+            pub fn len(&self) -> u64 {
+                self.0.map_or(0, |(n, _)| n)
+            }
+            pub fn is_file(&self) -> bool {
+                self.0.is_some()
+            }
+            pub fn is_dir(&self) -> bool {
+                self.0.is_none()
+            }
+            pub fn is_symlink(&self) -> bool {
+                false
+            }
+            pub fn file_type(&self) -> FileType {
+                FileType(self.is_file())
+            }
+            pub fn modified(&self) -> io::Result<web_time::SystemTime> {
+                Ok(self.0.map_or(web_time::SystemTime::UNIX_EPOCH, |(_, t)| t))
+            }
+        }
+
+        pub fn metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, at)) => Ok(Metadata(Some((bytes.len() as u64, *at)))),
+                Some(Entry::Dir) => Ok(Metadata(None)),
+                None => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn symlink_metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            metadata(p)
+        }
+
+        pub struct DirEntry(PathBuf);
+        impl DirEntry {
+            pub fn path(&self) -> PathBuf {
+                self.0.clone()
+            }
+            pub fn file_name(&self) -> ::std::ffi::OsString {
+                self.0.file_name().unwrap_or_default().to_os_string()
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                metadata(&self.0)
+            }
+            pub fn file_type(&self) -> io::Result<FileType> {
+                Ok(metadata(&self.0)?.file_type())
+            }
+        }
+
+        pub type ReadDir = ::std::vec::IntoIter<io::Result<DirEntry>>;
+
+        pub fn read_dir<P: AsRef<Path>>(p: P) -> io::Result<ReadDir> {
+            let dir = key(p.as_ref());
+            if !metadata(&dir)?.is_dir() {
+                return Err(io::Error::other(format!("{} is not a folder", dir.display())));
+            }
+            let entries = TREE.with(|t| {
+                t.borrow().below(&dir).into_iter().filter(|k| k.parent() == Some(&dir)).map(|k| Ok(DirEntry(k))).collect::<Vec<_>>()
+            });
+            Ok(entries.into_iter())
+        }
+
+        /// A file's bytes, read whole when it opens; one opened for writing is stored back when flushed or dropped.
+        pub struct File {
+            data: Cursor<Vec<u8>>,
+            /// Where written bytes go, for a file opened to write.
+            to: Option<PathBuf>,
+            dirty: bool,
+        }
+
+        impl File {
+            pub fn open<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                Ok(File { data: Cursor::new(read(p)?), to: None, dirty: false })
+            }
+            pub fn create<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                write(p.as_ref(), [])?;
+                Ok(File { data: Cursor::new(Vec::new()), to: Some(key(p.as_ref())), dirty: false })
+            }
+            pub fn options() -> OpenOptions {
+                OpenOptions::new()
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                Ok(Metadata(Some((self.data.get_ref().len() as u64, web_time::SystemTime::now()))))
+            }
+            pub fn sync_all(&self) -> io::Result<()> {
+                Ok(())
+            }
+            pub fn sync_data(&self) -> io::Result<()> {
+                Ok(())
+            }
+            /// Truncates or zero-extends the file (the sample cache drops a torn tail through this).
+            pub fn set_len(&self, size: u64) -> io::Result<()> {
+                if let Some(to) = &self.to {
+                    let mut bytes = self.data.get_ref().clone();
+                    bytes.resize(size as usize, 0);
+                    write(to, bytes)?;
+                }
+                Ok(())
+            }
+            fn store(&mut self) {
+                if let (true, Some(to)) = (self.dirty, &self.to) {
+                    let _ = write(to, self.data.get_ref());
+                    self.dirty = false;
+                }
+            }
+        }
+
+        impl Read for File {
+            fn read(&mut self, buf: &mut [u8]) -> io::Result<usize> {
+                self.data.read(buf)
+            }
+        }
+
+        impl Seek for File {
+            fn seek(&mut self, pos: SeekFrom) -> io::Result<u64> {
+                self.data.seek(pos)
+            }
+        }
+
+        impl Write for File {
+            fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+                if self.to.is_none() {
+                    return Err(io::Error::new(io::ErrorKind::PermissionDenied, "the file is open to read"));
+                }
+                self.dirty = true;
+                self.data.write(buf)
+            }
+            fn flush(&mut self) -> io::Result<()> {
+                self.store();
+                Ok(())
+            }
+        }
+
+        impl symphonia_core::io::MediaSource for File {
+            fn is_seekable(&self) -> bool {
+                true
+            }
+            fn byte_len(&self) -> Option<u64> {
+                Some(self.data.get_ref().len() as u64)
+            }
+        }
+
+        impl Drop for File {
+            fn drop(&mut self) {
+                self.store();
+            }
+        }
+
+        #[derive(Clone, Debug, Default)]
+        pub struct OpenOptions {
+            write: bool,
+            append: bool,
+            truncate: bool,
+            create: bool,
+            create_new: bool,
+        }
+
+        impl OpenOptions {
+            pub fn new() -> Self {
+                Self::default()
+            }
+            pub fn read(&mut self, _: bool) -> &mut Self {
+                self
+            }
+            pub fn write(&mut self, on: bool) -> &mut Self {
+                self.write = on;
+                self
+            }
+            pub fn append(&mut self, on: bool) -> &mut Self {
+                self.append = on;
+                self
+            }
+            pub fn truncate(&mut self, on: bool) -> &mut Self {
+                self.truncate = on;
+                self
+            }
+            pub fn create(&mut self, on: bool) -> &mut Self {
+                self.create = on;
+                self
+            }
+            pub fn create_new(&mut self, on: bool) -> &mut Self {
+                self.create_new = on;
+                self
+            }
+            pub fn open<P: AsRef<Path>>(&self, p: P) -> io::Result<File> {
+                let p = key(p.as_ref());
+                let had = read(&p).ok();
+                if self.create_new && had.is_some() {
+                    return Err(io::Error::new(io::ErrorKind::AlreadyExists, format!("{} exists", p.display())));
+                }
+                let bytes = match had {
+                    Some(_) if self.truncate => Vec::new(),
+                    Some(bytes) => bytes,
+                    None if self.create || self.create_new => {
+                        write(&p, [])?;
+                        Vec::new()
+                    }
+                    None => return Err(missing(&p)),
+                };
+                let mut data = Cursor::new(bytes);
+                if self.append {
+                    data.set_position(data.get_ref().len() as u64);
+                }
+                let writes = self.write || self.append;
+                Ok(File { data, to: writes.then_some(p), dirty: writes && self.truncate })
+            }
+        }
+    }
+}
+
+/// The plug-in hosts' sockets (the `interprocess` crate's local sockets, as crates/plugins uses them), which never
+/// connect: a browser runs no plug-in hosts, so starting one fails with a message and the project plays without it.
+pub mod interprocess {
+    use std::io;
+
+    fn unsupported() -> io::Error {
+        io::Error::new(io::ErrorKind::Unsupported, "plug-ins do not run in the browser")
+    }
+
+    pub trait TryClone: Sized {
+        fn try_clone(&self) -> io::Result<Self>;
+    }
+
+    pub mod local_socket {
+        use super::unsupported;
+        use std::io;
+        use std::marker::PhantomData;
+        use std::path::PathBuf;
+
+        pub mod traits {
+            pub trait Listener {}
+            pub trait Stream {}
+        }
+
+        pub struct Name<'a>(PhantomData<&'a ()>);
+
+        pub trait NameType {
+            fn is_supported() -> bool {
+                false
+            }
+        }
+        pub struct GenericNamespaced;
+        pub struct GenericFilePath;
+        impl NameType for GenericNamespaced {}
+        impl NameType for GenericFilePath {}
+
+        pub trait ToNsName {
+            fn to_ns_name<T: NameType>(self) -> io::Result<Name<'static>>;
+        }
+        impl ToNsName for String {
+            fn to_ns_name<T: NameType>(self) -> io::Result<Name<'static>> {
+                Ok(Name(PhantomData))
