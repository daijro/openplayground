+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Suhina in the browser, for Playground (patches/ableton-live.yaml in github.com/daijro/openplayground): the
+//! desktop window (crates/ui) on the page's canvas, playing through the browser's audio.
+
+#[cfg(target_arch = "wasm32")]
+mod audio;
+#[cfg(target_arch = "wasm32")]
+mod web;
+
+fn main() {
+    #[cfg(target_arch = "wasm32")]
+    web::start();
+}
diff --git a/apps/suhina-web/src/web.rs b/apps/suhina-web/src/web.rs
new file mode 100644
index 0000000..edb1009
--- /dev/null
+++ b/apps/suhina-web/src/web.rs
@@ -0,0 +1,343 @@
+//! The page side: the window (crates/ui) on the canvas, settings in localStorage, projects and samples through
+//! Playground's Files (`globalThis.playgroundFiles`), and the browser's audio (audio.rs).
+//!
+//! Files live in memory (crates/playground's `std::fs`). A project opened from Files comes in with the files beside
+//! it (its samples), at the same path: `browser:/Music/Song/Song.als` is `/Music/Song/Song.als` here. A sample or
+//! MIDI file opened in Suhina becomes a clip on a new track. Whatever Suhina writes (a save, a rendered file) goes
+//! back to Files at its path after the frame. Projects saved without a folder go to `/Suhina/Projects`, so
+//! `browser:/Suhina/Projects` in Files.
+
+use std::cell::RefCell;
+use std::path::{Path, PathBuf};
+
+use eframe::egui;
+use suhina_playground::std::fs;
+use suhina_session::Session;
+use suhina_ui::interaction::pick::PickField;
+use suhina_ui::settings::Settings;
+use suhina_ui::settings::keymap::Keymap;
+use suhina_ui::{App, NewProject, OpenAs, Status};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+const SETTINGS_KEY: &str = "suhina.settings";
+const KEYMAP_KEY: &str = "suhina.keymap";
+const PROJECTS: &str = "/Suhina/Projects";
+const TEMPLATES: &str = "/Suhina/Templates";
+/// Where dropped files are kept.
+const DROPS: &str = "/Suhina/Dropped";
+/// The project types Suhina opens.
+const TYPES: [&str; 2] = ["suhina", "als"];
+
+thread_local! {
+    static CTX: std::cell::OnceCell<egui::Context> = const { std::cell::OnceCell::new() };
+    /// Files that came in from Playground (Open, "Open in Suhina"), with how to open them, for the next frame.
+    static OPENED: RefCell<Vec<(PathBuf, OpenAs)>> = const { RefCell::new(Vec::new()) };
+    /// Dropped files whose bytes are in memory now, for the next frame.
+    static DROPPED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+}
+
+pub fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+fn api() -> Option<JsValue> {
+    Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = api()?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok()
+}
+
+fn storage() -> Option<web_sys::Storage> {
+    web_sys::window()?.local_storage().ok().flatten()
+}
+
+fn stored(key: &str) -> Option<String> {
+    storage()?.get_item(key).ok().flatten()
+}
+
+fn store(key: &str, text: &str) {
+    if let Some(s) = storage() {
+        let _ = s.set_item(key, text);
+    }
+}
+
+/// Whether `path` names a project Suhina opens.
+fn is_project(path: &Path) -> bool {
+    path.extension().is_some_and(|e| TYPES.iter().any(|t| e.eq_ignore_ascii_case(t)))
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory; a project with the files of its folder (its samples).
+/// Files without a path (From computer…) go to `/Suhina/Opened`. Returns its path here.
+async fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let bytes = js_sys::Uint8Array::new(&get(file, "bytes")).to_vec();
+    let path = match get(file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(str::to_owned)) {
+        Some(local) => {
+            let path = PathBuf::from(local);
+            if let Some(folder) = path.parent().filter(|f| f.parent().is_some() && is_project(&path)) {
+                let listed = wait(call("files", &[format!("browser:{}", folder.display()).into()])).await;
+                let paths: Vec<String> =
+                    listed.map(|l| js_sys::Array::from(&l).iter().filter_map(|p| p.as_string()).collect()).unwrap_or_default();
+                for p in paths {
+                    let Some(local) = p.strip_prefix("browser:") else { continue };
+                    if fs::metadata(local).is_ok() {
+                        continue;
+                    }
+                    if let Some(bytes) = wait(call("read", &[p.as_str().into()])).await {
+                        fs::put(Path::new(local), js_sys::Uint8Array::new(&bytes).to_vec());
+                    }
+                }
+            }
+            path
+        }
+        None => Path::new("/Suhina/Opened").join(&name),
+    };
+    fs::put(&path, bytes);
+    Some(path)
+}
+
+fn take_in(file: JsValue) {
+    wasm_bindgen_futures::spawn_local(async move {
+        if let Some(path) = bring_in(&file).await {
+            OPENED.with_borrow_mut(|o| o.push((path, OpenAs::NewTab)));
+            repaint();
+        }
+    });
+}
+
+/// File › Open…: Playground's Open dialog.
+fn pick_project() {
+    let types = js_sys::Array::new();
+    for t in TYPES {
+        types.push(&t.into());
+    }
+    let options = js_sys::Object::new();
+    let _ = js_sys::Reflect::set(&options, &"types".into(), &types);
+    let asked = call("open", &[options.into()]);
+    wasm_bindgen_futures::spawn_local(async move {
+        let Some(picked) = wait(asked).await.filter(|p| !p.is_null() && !p.is_undefined()) else { return };
+        if let Some(file) = js_sys::Array::from(&picked).iter().next()
+            && let Some(path) = bring_in(&file).await
+        {
+            OPENED.with_borrow_mut(|o| o.push((path, OpenAs::NewTab)));
+            repaint();
+        }
+    });
+}
+
+/// A dropped file, in memory.
+#[derive(Debug)]
+struct InMemory(PathBuf);
+
+impl egui::DroppedFile for InMemory {
+    fn path(&self) -> &Path {
+        &self.0
+    }
+    fn bytes_async(&self) -> std::pin::Pin<Box<dyn Future<Output = Result<Vec<u8>, String>> + '_>> {
+        let bytes = fs::read(&self.0).map_err(|e| e.to_string());
+        Box::pin(async move { bytes })
+    }
+}
+
+/// `session`'s project playing on the browser's audio, stopped.
+fn play(session: &Session) -> Result<suhina_session::audio::Opened, String> {
+    use suhina_session::audio::{AudioSystem as _, OutputChoice};
+    crate::audio::WebOutput.open(session.project(), session.audio(), session.device_assets(), &OutputChoice::default(), None)
+}
+
+pub struct Web {
+    pub app: App,
+    unsaved: Option<bool>,
+    started: bool,
+}
+
+impl Web {
+    fn new(cc: &eframe::CreationContext<'_>) -> Self {
+        CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+        suhina_ui::kit::theme::install(&cc.egui_ctx);
+        let mut app = App::new();
+        app.projects_mut().set_audio_system(std::sync::Arc::new(crate::audio::WebOutput));
+        let (settings, mut warnings) = stored(SETTINGS_KEY).map_or_else(|| (Settings::default(), Vec::new()), |t| Settings::from_text(&t));
+        let (keymap, keymap_warnings) = stored(KEYMAP_KEY).map_or_else(|| (Keymap::default(), Vec::new()), |t| Keymap::from_json(&t));
+        warnings.extend(keymap_warnings);
+        app.projects_mut().set_output_choice(settings.output_choice());
+        app.set_default_folders(PROJECTS.into(), TEMPLATES.into());
+        let _ = fs::create_dir_all(PROJECTS);
+        let _ = fs::create_dir_all(TEMPLATES);
+        app.set_settings(&cc.egui_ctx, settings);
+        app.set_keymap(keymap);
+        if let Some(warning) = warnings.first() {
+            app.set_status(Status::Hint(warning.clone()));
+        }
+        Self { app, unsaved: None, started: false }
+    }
+
+    /// The demo project, the first time a frame runs.
+    fn start(&mut self) {
+        let session = Session::new(suhina_ui::demo::demo_project());
+        self.show_session(session, Vec::new(), OpenAs::NewTab);
+    }
+
+    fn open(&mut self, path: &Path, how: OpenAs) {
+        match Session::open(path) {
+            Ok((session, warnings)) => self.show_session(session, warnings, how),
+            Err(e) => self.app.set_status(Status::Error(String::from(e))),
+        }
+    }
+
+    /// Decodes a session's audio, starts it playing (stopped) and shows it (the desktop app's `show_session`).
+    fn show_session(&mut self, mut session: Session, mut warnings: Vec<String>, how: OpenAs) {
+        let folder = session.audio_folder().map_or_else(|| PathBuf::from("/"), Path::to_path_buf);
+        let (audio, audio_warnings) = suhina_media::load_project_audio(session.project(), &folder);
+        warnings.extend(audio_warnings);
+        let waveforms = suhina_ui::kit::waveform::from_pool(&audio);
+        session.set_audio(audio);
+        self.app.projects_mut().close_preview_output();
+        match play(&session) {
+            Ok(opened) => session.attach_player(opened.player),
+            Err(e) => warnings.push(format!("no audio output: {e}")),
+        }
+        if self.app.open_project(session, &warnings, how).is_some() {
+            self.app.set_waveforms(waveforms);
+        }
+        let _closed = self.app.take_closed();
+    }
+
+    /// After the window's frame: what it asked of the app, and what it wrote, to Files.
+    fn after(&mut self) {
+        for (path, how) in OPENED.take() {
+            if is_project(&path) {
+                self.open(&path, how);
+            } else {
+                // A sample or MIDI file: a clip in the first scene, on a track of its own.
+                let paths = serde_json::json!({ "paths": [path.display().to_string()], "scene": 1 });
+                self.app.run(&suhina_ui::kit::widgets::Action::new("clip.addFiles", paths));
+            }
+        }
+        if let Some((path, how)) = self.app.take_open_request() {
+            self.open(&path, how);
+        }
+        if let Some(new) = self.app.take_new_request() {
+            let made = match new {
+                NewProject::Blank { returns } => Ok((Session::new(suhina_session::blank_project_with(returns)), Vec::new())),
+                NewProject::Template(path) => Session::from_template(&path),
+            };
+            match made {
+                Ok((session, warnings)) => self.show_session(session, warnings, OpenAs::NewTab),
+                Err(e) => self.app.set_status(Status::Error(String::from(e))),
+            }
+        }
+        let _ = self.app.take_recovery_request();
+        let _ = self.app.take_reveal_request();
+        let _ = self.app.take_saved_path();
+        let _ = self.app.take_forget_request();
+        if let Some(request) = self.app.take_pick_request()
+            && request.field == PickField::OpenProject
+        {
+            pick_project();
+        }
+        if self.app.take_lists_wanted().is_some() {
+            self.app.set_project_lists(Vec::new(), Vec::new());
+        }
+        let _closed = self.app.take_closed();
+        if let Some(id) = self.app.take_player_request() {
+            match self.app.projects().get(id).map(play) {
+                Some(Ok(opened)) => self.app.attach_player(id, opened.player),
+                Some(Err(e)) => self.app.set_status(Status::Error(format!("no audio output: {e}"))),
+                None => {}
+            }
+        }
+        if let Some(settings) = self.app.take_changed_settings() {
+            store(SETTINGS_KEY, &settings.to_text());
+        }
+        if let Some(keymap) = self.app.take_changed_keymap() {
+            store(KEYMAP_KEY, &keymap.to_json());
+        }
+        let _ = self.app.take_theme_actions();
+        for p in fs::changes() {
+            let target = JsValue::from(format!("browser:{}", p.display()));
+            match fs::metadata(&p) {
+                Ok(m) if m.is_file() => {
+                    let bytes = fs::read(&p).unwrap_or_default();
+                    call("write", &[target, js_sys::Uint8Array::from(bytes.as_slice()).into()]);
+                }
+                Ok(_) => {}
+                Err(_) => {
+                    call("remove", &[target]);
+                }
+            }
+        }
+        let projects = self.app.projects();
+        let unsaved = projects.ids().into_iter().any(|id| projects.get(id).is_some_and(Session::has_unsaved_changes));
+        if self.unsaved.replace(unsaved) != Some(unsaved) {
+            call("setUnsaved", &[unsaved.into()]);
+        }
+    }
+}
+
+impl eframe::App for Web {
+    fn raw_input_hook(&mut self, _: &egui::Context, raw_input: &mut egui::RawInput) {
+        // Browsers keep audio off until the person does something on the page.
+        if raw_input.events.iter().any(|e| matches!(e, egui::Event::PointerButton { pressed: true, .. } | egui::Event::Key { pressed: true, .. })) {
+            crate::audio::resume();
+        }
+        // A dropped file is only a name on the web: once its bytes are in memory at /Suhina/Dropped/<name>, a later
+        // frame drops that file instead, as the desktop window gets it.
+        raw_input.dropped_files.extend(DROPPED.take().into_iter().map(|p| std::sync::Arc::new(InMemory(p)) as _));
+        for f in std::mem::take(&mut raw_input.dropped_files).into_iter().filter(|f| f.path().parent() != Some(Path::new(DROPS))) {
+            wasm_bindgen_futures::spawn_local(async move {
+                if let Ok(bytes) = f.bytes_async().await
+                    && let Some(name) = f.path().file_name()
+                {
+                    let path = Path::new(DROPS).join(name);
+                    fs::put(&path, bytes);
+                    DROPPED.with_borrow_mut(|d| d.push(path));
+                    repaint();
+                }
+            });
+        }
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, _: &mut eframe::Frame) {
+        if !self.started {
+            self.started = true;
+            self.start();
+        }
+        self.app.ui(ui);
+        self.after();
+    }
+}
+
+pub fn start() {
+    let open = Closure::<dyn Fn(JsValue)>::new(take_in);
+    call("onOpen", &[open.into_js_value()]);
+    wasm_bindgen_futures::spawn_local(async {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let canvas = document
+            .get_element_by_id("suhina_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #suhina_canvas");
+        let started = eframe::WebRunner::new()
+            .start(canvas, eframe::WebOptions::default(), Box::new(|cc| Ok(Box::new(Web::new(cc)))))
+            .await;
+        if let Some(loading) = document.get_element_by_id("suhina_loading") {
+            match started {
+                Ok(()) => loading.remove(),
+                Err(e) => loading.set_text_content(Some(&format!("Suhina could not start: {e:?}"))),
+            }
+        }
+    });
+}
