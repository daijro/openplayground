+//! Live editing in a Playground session (patches/ableton-live.yaml in github.com/daijro/openplayground), the page's
+//! side: the web runner kept for the adapter, and the app eframe runs wrapped: the window's frame, the others' marks
+//! over the window (and the kit's end of frame), then the session's (remote changes in, this person's changes
+//! reported). The shared document and the merge are crates/session's `live`, the window's side crates/ui's `app::live`.
+
+use crate::web::Web;
+use eframe::egui;
+use suhina_session::live::{FORMAT, kit};
+
+thread_local! {
+    static RUNNER: std::cell::OnceCell<eframe::WebRunner> = const { std::cell::OnceCell::new() };
+}
+
+/// The page's web runner, kept for the adapter.
+pub fn runner() -> eframe::WebRunner {
+    RUNNER.with(|kept| kept.get_or_init(eframe::WebRunner::new).clone())
+}
+
+/// The app eframe runs, and the adapter offered to the shell.
+pub fn wrap(web: Web) -> Box<dyn eframe::App> {
+    let with_app = |f: &mut dyn FnMut(&mut suhina_ui::App)| runner().app_mut::<Shell>().map(|mut shell| f(&mut shell.0.app)).is_some();
+    if let Err(e) = kit::web::attach::<suhina_ui::App>(FORMAT, with_app, crate::web::repaint) {
+        web_sys::console::warn_1(&format!("Suhina: no live editing: {e:?}").into());
+    }
+    Box::new(Shell(web))
+}
+
+struct Shell(Web);
+
+impl eframe::App for Shell {
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        eframe::App::raw_input_hook(&mut self.0, ctx, raw_input);
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut eframe::Frame) {
+        eframe::App::ui(&mut self.0, ui, frame);
+        suhina_ui::app::live::overlay(ui, &self.0.app);
+        kit::frame(&mut self.0.app);
+    }
+
+    fn as_any_mut(&mut self) -> Option<&mut dyn std::any::Any> {
+        Some(self)
+    }
+}
