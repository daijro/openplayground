+++ b/crates/ui/src/app/live.rs
@@ -0,0 +1,148 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Live editing in a Playground session (patches/ableton-live.yaml in github.com/daijro/openplayground), the window's
+//! side: the window is the app the session's kit (crates/session `live`) runs on. The shared document is the project
+//! of the tab shown when the session connected; a remote change goes into it at the end of a frame with no pointer
+//! down and no text field focused, and is no step of its undo history. Audio files travel as the session's media, by
+//! the name the clips give them. Each person's pointer and the gesture under way go to the others (`peers`). Web only;
+//! a child of the app module, so it reads the window's state.
+
+mod peers;
+
+pub use peers::{clip_shown, column, drawn_notes, fader, lanes, moving_note, overlay, pan, param, piano};
+
+use super::App;
+use playground_live::presence;
+use serde_json::Value;
+use std::cell::Cell;
+use suhina_session::ProjectId;
+use suhina_session::live::{self as doc, kit::Live};
+
+thread_local! {
+    /// The project the session shares: the one shown when it connected.
+    static BOUND: Cell<Option<ProjectId>> = const { Cell::new(None) };
+}
+
+impl App {
+    /// The shared project's id (the one shown, the first time).
+    fn live_id(&self) -> Option<ProjectId> {
+        let id = BOUND.get().filter(|id| self.projects.get(*id).is_some()).or_else(|| self.projects.active());
+        BOUND.set(id);
+        id
+    }
+
+    fn live_session(&self) -> Option<&suhina_session::Session> {
+        self.projects.get(self.live_id()?)
+    }
+
+    fn live_session_mut(&mut self) -> Option<&mut suhina_session::Session> {
+        let id = self.live_id()?;
+        self.projects.get_mut(id)
+    }
+
+    /// The notes of the clip the clip editor shows, if it shows one.
+    fn live_shown_notes(&self) -> Option<Vec<suhina_engine::model::Note>> {
+        use crate::detail::detail_view::ClipRef;
+        let clip = match self.shown {
+            super::View::Session => self.view.selected_slot.map(|(t, s)| ClipRef::Slot(t, s)),
+            super::View::Arrangement => self.arrangement.selected_clip().map(|(t, i)| ClipRef::Arrangement(t, i)),
+        };
+        self.piano_clip(clip).map(|c| c.notes)
+    }
+
+    /// The waveforms of the shared project's audio, after audio came in.
+    fn live_waveforms(&mut self) {
+        if let Some(session) = self.live_session() {
+            let waveforms = crate::kit::waveform::from_pool(session.audio());
+            self.set_waveforms(waveforms);
+        }
+    }
+}
+
+impl Live for App {
+    fn live_document(&self) -> Value {
+        self.live_session().map_or_else(|| Value::Object(serde_json::Map::new()), suhina_session::Session::live_document)
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let shown = self.live_shown_notes();
+        let session = self.live_session_mut().ok_or("no project is open")?;
+        let decoded = session.audio().files.len();
+        session.live_adopt(&document)?;
+        let more = session.audio().files.len() != decoded;
+        self.note_outside_change();
+        // The clip editor's selection is by place in the list, which a remote change can reorder: the same notes stay
+        // selected.
+        if let (Some(old), Some(new)) = (shown, self.live_shown_notes()) {
+            let selected = std::mem::take(&mut self.piano_roll.selected);
+            self.piano_roll.selected = selected.iter().filter_map(|&i| old.get(i)).filter_map(|n| new.iter().position(|m| m == n)).collect();
+        }
+        if more {
+            self.live_waveforms();
+        }
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        presence::quiet() && self.live_session().is_some()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        let id = self.live_id()?;
+        Some((u64::from(id.0) << 40) ^ self.projects.get(id)?.live_generation())
+    }
+
+    fn live_disconnected(&mut self) {
+        if let Some(session) = self.live_session_mut() {
+            session.live_disconnected();
+        }
+        BOUND.set(None);
+    }
+
+    fn live_assets(&self) -> Vec<(String, String, bool)> {
+        let Some(session) = self.live_session() else { return Vec::new() };
+        doc::audio_files(session.project())
+            .into_iter()
+            .map(|id| {
+                let name = std::path::Path::new(&id).file_name().map_or_else(|| id.clone(), |n| n.to_string_lossy().into());
+                let have = session.live_has_audio(&id);
+                (id, name, have)
+            })
+            .collect()
+    }
+
+    fn live_assets_of(document: &Value) -> Vec<String> {
+        doc::project_of(document).map(|p| doc::audio_files(&p)).unwrap_or_default()
+    }
+
+    fn live_read_asset(&self, id: &str) -> Option<Vec<u8>> {
+        self.live_session()?.live_audio_bytes(id)
+    }
+
+    fn live_write_asset(&mut self, id: &str, _name: &str, bytes: Vec<u8>) {
+        let Some(session) = self.live_session_mut() else { return };
+        match session.live_add_audio(id, bytes) {
+            Ok(()) => {
+                // The missing-files bar looks again, and the clip shows its waveform.
+                self.note_outside_change();
+                self.live_waveforms();
+            }
+            Err(e) => self.set_status(crate::Status::Error(format!("could not use {id}: {e}"))),
+        }
+    }
+
+    fn live_presence(&self) -> Value {
+        peers::mine(self)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<doc::kit::Presence>) {
+        presence::show(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        doc::merge(base, current, edited)
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        doc::project_of(document).map(drop)
+    }
+}
diff --git a/crates/ui/src/app/live/peers.rs b/crates/ui/src/app/live/peers.rs
new file mode 100644
index 0000000..052f81d
--- /dev/null
+++ b/crates/ui/src/app/live/peers.rs
@@ -0,0 +1,467 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Presence in a Playground session: where each person is and the gesture under way, in the project's terms, so it
+//! shows in the same place for everyone whatever their zoom, scroll or window size.
+//!
+//! This person's state (`mine`, at most a few KiB of JSON):
+//!   `at`      the pointer: `{ "in": "slots", "track", "fx", "scene" }` (the Session view's clip grid: a track's
+//!             column, the fraction across it, and the scene row as a number, 0 at the top of the first),
+//!             `{ "in": "mixer", "track", "fx", "fy" }` (its mixer strip, fractions across and down),
+//!             `{ "in": "lanes", "track", "fy", "beat" }` (the Arrangement view), or `{ "in": "piano", "clip", "beat",
+//!             "key" }` (the clip editor: the clip's address, a beat of its content and a key as a number);
+//!   `notes`   with `clip`: the notes a drag in the clip editor is moving, resizing or drawing, as they are now,
+//!             `[time, length, key]` each;
+//!   `clips`   the arrangement clips a drag is moving or trimming, as they are now, `[track, start, end]`;
+//!   `fader`   a mixer value being dragged: `{ "track", "control": "volume" | "pan" | "send", "value" }`;
+//!   `param`   a device parameter being dragged: `{ "track", "device", "param", "value", "min", "max" }`.
+//! The views record where things are as they draw (the hooks [`column`], [`lanes`], [`clip_shown`], [`piano`],
+//! [`moving_note`], [`drawn_notes`]), so the pointer can be read in those terms and the others drawn back: their
+//! pointers with name tags, ghosts of what their drags are doing, in their colour, eased toward where they are; the
+//! mixer's and the device panels' controls ([`fader`], [`pan`], [`param`]) show the others turning them. The look and
+//! the easing are the playground-live crate's ([`presence`]); [`overlay`] ends the frame with its `end_frame`.
+
+use super::super::App;
+use crate::session::session_view::Control;
+use egui::{Color32, Id, LayerId, Order, Painter, Pos2, Rangef, Rect, Ui, pos2, vec2};
+use playground_live::presence;
+use serde_json::{Value, json};
+use std::cell::RefCell;
+use suhina_engine::model::{ClipId, Note, TrackId};
+
+/// The most notes or clips a presence carries.
+const MAX_ITEMS: usize = 50;
+/// A mark glides to wherever its person went in the same place (a column, a row, a clip), however far.
+const FAR: f64 = f64::INFINITY;
+
+/// Where things were drawn this frame.
+#[derive(Default)]
+struct Frame {
+    /// Session view columns: track, x span, the top of scene 0, a scene's height, the grid's and the mixer's areas.
+    columns: Vec<(TrackId, Rangef, f32, f32, Rect, Rect)>,
+    /// Arrangement rows: track, the row, the part of it shown; and x of beat 0 and points a beat.
+    rows: Vec<(TrackId, Rect, Rect)>,
+    beat: (f32, f32),
+    /// Arrangement clips as drawn (where a drag has them): id and rect.
+    clips: Vec<(ClipId, Rect)>,
+    /// Notes a clip-editor drag moves or draws, as shown.
+    notes: Vec<[f64; 3]>,
+    /// The others' marks on mixer and device controls, drawn over everything at the frame's end (a strip's own area
+    /// would cut their tags off).
+    marks: Vec<(Color32, String, Marks)>,
+}
+
+/// This person's state as of the last frame.
+#[derive(Default)]
+struct Mine {
+    at: Value,
+    piano: Option<(Value, Vec<[f64; 3]>)>,
+    clips: Vec<[f64; 3]>,
+    param: Value,
+}
+
+thread_local! {
+    static FRAME: RefCell<Frame> = RefCell::default();
+    static MINE: RefCell<Mine> = RefCell::default();
+}
+
+fn on() -> bool {
+    playground_live::connected()
+}
+
+fn num(v: &Value) -> Option<f64> {
+    v.as_f64().filter(|n| n.is_finite() && n.abs() < 1.0e7)
+}
+
+fn track_of(v: &Value) -> Option<TrackId> {
+    v.as_u64().and_then(|n| u32::try_from(n).ok()).map(TrackId)
+}
+
+// ---------------------------------------------------------------- the views' hooks
+
+/// The Session view drew `track`'s column at `span` (scene 0 at `top`, `pitch` a scene).
+pub fn column(track: TrackId, span: Rangef, top: f32, pitch: f32, body: Rect, mixer: Rect) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.columns.push((track, span, top, pitch, body, mixer)));
+    }
+}
+
+/// The Arrangement view's rows this frame (track, row, the part shown), beat 0 at `x0`, `beat_width` points a beat.
+pub fn lanes(rows: impl Iterator<Item = (TrackId, Rect, Rect)>, x0: f32, beat_width: f32) {
+    if on() {
+        FRAME.with_borrow_mut(|f| {
+            f.rows = rows.collect();
+            f.beat = (x0, beat_width);
+        });
+    }
+}
+
+/// An arrangement clip, drawn at `rect` (a drag's place for it, while one is under way).
+pub fn clip_shown(clip: ClipId, rect: Rect) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.clips.push((clip, rect)));
+    }
+}
+
+/// A note a clip-editor drag is moving or resizing, as it shows.
+pub fn moving_note(note: &Note) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.notes.push([note.time, note.duration, f64::from(note.key)]));
+    }
+}
+
+/// The notes a draw or paint drag is making.
+pub fn drawn_notes(notes: &[Note]) {
+    if on() {
+        FRAME.with_borrow_mut(|f| f.notes.extend(notes.iter().map(|n| [n.time, n.duration, f64::from(n.key)])));
+    }
+}
+
+/// The clip editor drew `address`'s notes over `grid`: this person's pointer and drag there, and the others' on the
+/// same clip, drawn now with the editor's own mapping.
+#[allow(clippy::too_many_arguments)]
+pub fn piano(
+    ui: &Ui,
+    address: &Value,
+    grid: Rect,
+    key_height: f32,
+    x_of: &dyn Fn(f64) -> f32,
+    beat_at: &dyn Fn(f32) -> f64,
+    y_of: &dyn Fn(u8) -> f32,
+    key_at: &dyn Fn(f32) -> Option<u8>,
+) {
+    if !on() {
+        return;
+    }
+    let notes: Vec<[f64; 3]> = FRAME.with_borrow_mut(|f| std::mem::take(&mut f.notes)).into_iter().take(MAX_ITEMS).collect();
+    let pointer = ui.ctx().pointer_latest_pos().filter(|p| grid.contains(*p));
+    MINE.with_borrow_mut(|m| {
+        m.piano = Some((address.clone(), notes));
+        if let Some(p) = pointer
+            && let Some(key) = key_at(p.y)
+        {
+            let top = y_of(key);
+            let key = f64::from(key) + 1.0 - f64::from(((p.y - top) / key_height.max(1.0)).clamp(0.0, 1.0));
+            m.at = json!({ "in": "piano", "clip": address, "beat": beat_at(p.x), "key": key });
+        } else if m.at["in"] == "piano" {
+            m.at = Value::Null;
+        }
+    });
+    let scope = format!("piano:{address}");
+    // A key as a number: its row's bottom at the whole number, its top a key higher.
+    let y = |key: f64| {
+        let k = key.floor().clamp(0.0, 127.0);
+        y_of(k as u8) + key_height * (1.0 - (key - k) as f32)
+    };
+    let note_rect = |n: &[f64; 3]| {
+        let k = n[2].round().clamp(0.0, 127.0) as u8;
+        let left = x_of(n[0]);
+        Rect::from_min_max(pos2(left, y_of(k) + 1.0), pos2(x_of(n[0] + n[1].max(0.0)).max(left + 2.0) - 1.0, y_of(k) + key_height))
+    };
+    // Points a beat and a key, for the easing.
+    let (beat, key) = (f64::from((x_of(1.0) - x_of(0.0)).abs()), f64::from(key_height));
+    let ctx = ui.ctx();
+    let mut all = Vec::new();
+    for peer in presence::others() {
+        let (at, notes, _) = targets(&peer.state);
+        let mut marks = Marks::default();
+        if peer.state["clip"] == *address {
+            let eased = presence::ease_list(ctx, &peer.id, "piano.notes", notes.as_flattened(), &[beat, beat, key], &[FAR]);
+            marks.ghosts = eased.unwrap_or_default().as_chunks().0.iter().map(note_rect).collect();
+        }
+        if let Some((s, to)) = at
+            && s == scope
+            && let Some([b, k]) = presence::ease(ctx, &peer.id, &s, to, [beat, key], [FAR; 2])
+        {
+            marks.tip = Some(pos2(x_of(b), y(k)));
+        }
+        all.push((presence::color(&peer), peer.name, marks));
+    }
+    paint(&ui.painter_at(grid), &all);
+}
+
+/// The mixer drew `track`'s volume fader at `fader`: the others' drags of it, as ghost caps with their value.
+pub fn fader(painter: &Painter, track: TrackId, fader: Rect) {
+    // Only the strip's part that shows.
+    if !fader.intersects(painter.clip_rect()) {
+        return;
+    }
+    if !on() {
+        return;
+    }
+    let mut all = Vec::new();
+    for peer in presence::others() {
+        let f = &peer.state["fader"];
+        if track_of(&f["track"]) != Some(track) || f["control"] != "volume" {
+            continue;
+        }
+        let Some(db) = num(&f["value"]) else { continue };
+        let travel = Rangef::new(fader.bottom() - 4.0, fader.top() + 4.0);
+        let y = travel.min + (travel.max - travel.min) * crate::kit::widgets::volume_position(db);
+        let cap = Rect::from_center_size(pos2(fader.center().x, y), vec2(fader.width().min(26.0), 8.0));
+        let cap = cap.intersect(painter.clip_rect());
+        let value = format!("{} dB", crate::kit::widgets::format_db(db));
+        let marks = Marks { ghosts: vec![cap], tag_at: Some(cap.right_top()), value: Some(value), ..Marks::default() };
+        all.push((presence::color(&peer), peer.name, marks));
+    }
+    FRAME.with_borrow_mut(|f| f.marks.extend(all));
+}
+
+/// The mixer drew `track`'s pan knob at `knob`: the others' drags of it, as rings with their value.
+pub fn pan(painter: &Painter, track: TrackId, knob: Rect) {
+    if !on() || !knob.intersects(painter.clip_rect()) {
+        return;
+    }
+    let mut all = Vec::new();
+    for peer in presence::others() {
+        let f = &peer.state["fader"];
+        if track_of(&f["track"]) != Some(track) || f["control"] != "pan" {
+            continue;
+        }
+        let Some(pan) = num(&f["value"]).filter(|v| v.abs() <= 1.0) else { continue };
+        let ring = knob.expand(2.0);
+        let marks = Marks { rings: vec![ring], tag_at: Some(ring.right_bottom()), value: Some(crate::kit::widgets::format_pan(pan)), ..Marks::default() };
+        all.push((presence::color(&peer), peer.name, marks));
+    }
+    FRAME.with_borrow_mut(|f| f.marks.extend(all));
+}
+
+/// A device panel drew a parameter's control at `rect`: this person's drag of it, and the others', as a ring with
+/// their value.
+#[allow(clippy::too_many_arguments)]
+pub fn param(painter: &Painter, track: TrackId, device: &Value, param: &str, rect: Rect, value: f64, min: f64, max: f64, dragging: bool) {
+    if !on() {
+        return;
+    }
+    let key = json!({ "track": track.0, "device": device, "param": param });
+    MINE.with_borrow_mut(|m| {
+        let same = m.param["track"] == key["track"] && m.param["device"] == key["device"] && m.param["param"] == key["param"];
+        if dragging {
+            m.param = json!({ "track": track.0, "device": device, "param": param, "value": value, "min": min, "max": max });
+        } else if same {
+            m.param = Value::Null;
+        }
+    });
+    let mut all = Vec::new();
+    for peer in presence::others() {
+        let p = &peer.state["param"];
+        if p["track"] != key["track"] || p["device"] != key["device"] || p["param"] != key["param"] {
+            continue;
+        }
+        let Some(v) = num(&p["value"]) else { continue };
+        let ring = rect.expand(2.0).intersect(painter.clip_rect());
+        let marks = Marks { rings: vec![ring], tag_at: Some(ring.right_bottom()), value: Some(format!("{v:.2}")), ..Marks::default() };
+        all.push((presence::color(&peer), peer.name, marks));
+    }
+    FRAME.with_borrow_mut(|f| f.marks.extend(all));
+}
+
+// ---------------------------------------------------------------- the frame's end
+
+/// After the window's frame: while connected, this person's pointer and drags read in the project's terms, the others'
+/// marks eased and drawn over the views (under menus and dialogs), and the recorded places cleared for the next frame;
+/// then the kit's end of frame (marks still easing ask for another, and whether a gesture is under way, for quiet).
+pub fn overlay(ui: &Ui, app: &App) {
+    if on() {
+        draw(ui, app);
+    }
+    presence::end_frame(ui.ctx());
+}
+
+fn draw(ui: &Ui, app: &App) {
+    let mut frame = FRAME.with_borrow_mut(std::mem::take);
+    let pointer = ui.ctx().pointer_latest_pos();
+    let down = ui.input(|i| i.pointer.any_down());
+    let in_slots = |p: Pos2| {
+        frame.columns.iter().find(|c| c.1.contains(p.x) && c.4.contains(p)).map(|&(track, span, top, pitch, ..)| {
+            json!({ "in": "slots", "track": track.0, "fx": (p.x - span.min) / span.span().max(1.0), "scene": (p.y - top) / pitch.max(1.0) })
+        })
+    };
+    let in_mixer = |p: Pos2| {
+        frame.columns.iter().find(|c| c.1.contains(p.x) && c.5.contains(p)).map(|&(track, span, .., mixer)| {
+            json!({ "in": "mixer", "track": track.0, "fx": (p.x - span.min) / span.span().max(1.0), "fy": (p.y - mixer.top()) / mixer.height().max(1.0) })
+        })
+    };
+    let (x0, bw) = frame.beat;
+    let beat_of = |x: f32| f64::from((x - x0) / bw.max(1.0e-3));
+    let in_lanes = |p: Pos2| {
+        frame.rows.iter().find(|r| r.2.contains(p)).map(|&(track, row, _)| {
+            json!({ "in": "lanes", "track": track.0, "fy": (p.y - row.top()) / row.height().max(1.0), "beat": beat_of(p.x) })
+        })
+    };
+    // The arrangement clips a drag has somewhere else than the project does.
+    let mut dragged = Vec::new();
+    if down && !frame.rows.is_empty() {
+        if let Some(project) = app.live_session().map(|s| s.project()) {
+            for lane in &project.arrangement.lanes {
+                for clip in &lane.clips {
+                    let Some((_, rect)) = frame.clips.iter().rev().find(|(id, _)| *id == clip.id) else { continue };
+                    // As drawn, to a point (a clip's right edge is drawn a point short of its end).
+                    let px = f64::from(bw.max(1.0e-3));
+                    let (start, end) = (beat_of(rect.left()), beat_of(rect.right()));
+                    let moved = ((start - clip.start) * px).abs() > 1.0;
+                    let resized = ((end - start - clip.length) * px).abs() > 2.0;
+                    let row = frame.rows.iter().find(|r| r.1.y_range().contains(rect.center().y)).map(|r| r.0);
+                    if (moved || resized || row != lane.track) && let Some(track) = row.or(lane.track) {
+                        let start = if moved { start } else { clip.start };
+                        let end = if resized { end } else { start + clip.length };
+                        dragged.push([f64::from(track.0), start, end]);
+                    }
+                }
+            }
+        }
+    }
+    dragged.truncate(MAX_ITEMS);
+    MINE.with_borrow_mut(|m| {
+        let over = pointer.and_then(|p| in_slots(p).or_else(|| in_mixer(p)).or_else(|| in_lanes(p)));
+        match over {
+            Some(at) => m.at = at,
+            None if m.at["in"] != "piano" || pointer.is_none() => m.at = Value::Null,
+            None => {}
+        }
+        m.clips = dragged;
+    });
+    // The others' marks: eased, then drawn.
+    let ctx = ui.ctx();
+    let x_of = |beat: f64| x0 + beat as f32 * bw;
+    let mut all = Vec::new();
+    let mut area = Rect::NOTHING;
+    for c in &frame.columns {
+        area = area.union(c.4).union(c.5);
+    }
+    for r in &frame.rows {
+        area = area.union(r.2);
+    }
+    for peer in presence::others() {
+        let (at, _, clips) = targets(&peer.state);
+        let mut marks = Marks::default();
+        // A clip ghost's track is no number to ease: `far` 0 takes the ghosts to another track at once, the track whole.
+        let eased = presence::ease_list(ctx, &peer.id, "clips", clips.as_flattened(), &[1.0, f64::from(bw), f64::from(bw)], &[0.0, FAR, FAR]);
+        for &[track, start, end] in eased.unwrap_or_default().as_chunks().0 {
+            let Some(row) = frame.rows.iter().find(|r| Some(r.0) == track_of(&json!(track as u64))) else { continue };
+            marks.ghosts.push(Rect::from_x_y_ranges(Rangef::new(x_of(start), x_of(end)), row.1.y_range()));
+        }
+        if let Some((scope, to)) = at {
+            let (kind, track) = scope.split_once(':').unwrap_or_default();
+            let track = track.parse::<u32>().ok().map(TrackId);
+            let column = frame.columns.iter().find(|c| Some(c.0) == track);
+            let row = frame.rows.iter().find(|r| Some(r.0) == track);
+            // Points per unit of the place's two numbers, for the easing (the clip editor's are eased in `piano`).
+            let px = match kind {
+                "slots" => column.map(|c| [c.1.span(), c.3]),
+                "mixer" => column.map(|c| [c.1.span(), c.5.height()]),
+                "lanes" => row.map(|r| [r.1.height(), bw]),
+                _ => None,
+            };
+            if let Some(px) = px
+                && let Some([a, b]) = presence::ease(ctx, &peer.id, &scope, to, px.map(f64::from), [FAR; 2])
+            {
+                marks.tip = match kind {
+                    "slots" => column.map(|&(_, span, top, pitch, ..)| pos2(span.min + span.span() * a as f32, top + pitch * b as f32)),
+                    "mixer" => column.map(|&(_, span, .., mixer)| pos2(span.min + span.span() * a as f32, mixer.top() + mixer.height() * b as f32)),
+                    _ => row.map(|r| pos2(x_of(b), r.1.top() + r.1.height() * a as f32)),
+                };
+            }
+        }
+        all.push((presence::color(&peer), peer.name, marks));
+    }
+    let layer = ctx.layer_painter(LayerId::new(Order::Middle, Id::new("suhina-live-presence")));
+    if area.is_positive() && all.iter().any(|(_, _, m)| m.tip.is_some() || !m.ghosts.is_empty()) {
+        paint(&layer.with_clip_rect(area), &all);
+    }
+    if !frame.marks.is_empty() {
+        paint(&layer.with_clip_rect(ui.max_rect()), &std::mem::take(&mut frame.marks));
+    }
+}
+
+/// This person's presence for the others.
+pub fn mine(app: &App) -> Value {
+    MINE.with_borrow(|m| {
+        let mut out = serde_json::Map::new();
+        out.insert("view".into(), json!(if app.shown == super::super::View::Arrangement { "arrangement" } else { "session" }));
+        if !m.at.is_null() {
+            out.insert("at".into(), m.at.clone());
+        }
+        if let Some((clip, notes)) = m.piano.as_ref().filter(|(_, n)| !n.is_empty()) {
+            out.insert("clip".into(), clip.clone());
+            out.insert("notes".into(), json!(notes));
+        }
+        if !m.clips.is_empty() {
+            out.insert("clips".into(), json!(m.clips));
+        }
+        if let Some((track, control, value)) = app.view.drag {
+            let control = match control {
+                Control::Volume => "volume",
+                Control::Pan => "pan",
+                Control::Send(_) => "send",
+            };
+            out.insert("fader".into(), json!({ "track": track.0, "control": control, "value": value }));
+        }
+        if !m.param.is_null() {
+            out.insert("param".into(), m.param.clone());
+        }
+        Value::Object(out)
+    })
+}
+
+/// Where a person's state puts their marks: their pointer's place (`slots:<track>`, `mixer:<track>`, `lanes:<track>`,
+/// `piano:<clip>`) and position in it, and the notes and clips their drag has.
+fn targets(state: &Value) -> (Option<(String, [f64; 2])>, Vec<[f64; 3]>, Vec<[f64; 3]>) {
+    let at = &state["at"];
+    let pointer = match at["in"].as_str() {
+        Some("slots") => track_of(&at["track"]).zip(num(&at["fx"]).zip(num(&at["scene"]))).map(|(t, (a, b))| (format!("slots:{}", t.0), [a, b])),
+        Some("mixer") => track_of(&at["track"]).zip(num(&at["fx"]).zip(num(&at["fy"]))).map(|(t, (a, b))| (format!("mixer:{}", t.0), [a, b])),
+        Some("lanes") => track_of(&at["track"]).zip(num(&at["fy"]).zip(num(&at["beat"]))).map(|(t, (a, b))| (format!("lanes:{}", t.0), [a, b])),
+        Some("piano") => num(&at["beat"]).zip(num(&at["key"])).map(|(b, k)| (format!("piano:{}", at["clip"]), [b, k])),
+        _ => None,
+    };
+    let triples = |v: &Value| -> Vec<[f64; 3]> {
+        v.as_array()
+            .into_iter()
+            .flatten()
+            .take(MAX_ITEMS)
+            .filter_map(|t| Some([num(&t[0])?, num(&t[1])?, num(&t[2])?]))
+            .collect()
+    };
+    (pointer, triples(&state["notes"]), triples(&state["clips"]))
+}
