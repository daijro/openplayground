+// SPDX-License-Identifier: GPL-3.0-or-later
+#![allow(clippy::unwrap_used)]
+
+use super::*;
+use serde_json::json;
+
+#[test]
+fn two_people_changing_different_notes_of_one_clip_both_keep_theirs() {
+    let mut session = Session::new(crate::blank_project());
+    let track = session.project().tracks[0].id.0;
+    session.execute("clip.create", &json!({ "track": track, "scene": 1 })).unwrap();
+    let notes = json!([{ "time": 0.0, "length": 1.0, "key": 60 }, { "time": 1.0, "length": 1.0, "key": 62 }]);
+    session.execute("note.add", &json!({ "track": track, "scene": 1, "notes": notes })).unwrap();
+    let base = session.live_document();
+    // The note ids are the notes themselves, so the document reads back to the same bytes.
+    assert_eq!(kit::canonical(&document_of(&project_of(&base).unwrap())), kit::canonical(&base));
+
+    session.execute("note.move", &json!({ "track": track, "scene": 1, "notes": [0], "semitones": 1 })).unwrap();
+    let moved = session.live_document();
+    session.live_adopt(&base).unwrap();
+    session.execute("note.setVelocity", &json!({ "track": track, "scene": 1, "notes": [1], "velocity": 100 })).unwrap();
+    let louder = session.live_document();
+
+    let merged = merge(&base, &moved, &louder).unwrap();
+    session.live_adopt(&merged).unwrap();
+    let mut keys: Vec<(u8, f32)> = session.project().contents.iter().flat_map(|c| &c.lanes).filter_map(|l| match &l.data {
+        LaneData::Notes(notes) => Some(notes.iter().map(|n| (n.key, n.velocity)).collect::<Vec<_>>()),
+        _ => None,
+    }).flatten().collect();
+    keys.sort_by_key(|k| k.0);
+    assert_eq!(keys.iter().map(|k| k.0).collect::<Vec<_>>(), [61, 62]);
+    assert!((keys[1].1 - 100.0 / 127.0).abs() < 0.01, "{keys:?}");
+    // The same note changed by both is a conflict, not a mix of the two.
+    session.live_adopt(&base).unwrap();
+    session.execute("note.move", &json!({ "track": track, "scene": 1, "notes": [0], "semitones": -1 })).unwrap();
+    assert!(merge(&base, &moved, &session.live_document()).is_err());
+}
+
+#[test]
+fn two_people_adding_clips_at_once_both_keep_theirs() {
+    let mut session = Session::new(crate::blank_project());
+    let track = session.project().tracks[0].id.0;
+    let base = session.live_document();
+    session.execute("clip.create", &json!({ "track": track, "scene": 1 })).unwrap();
+    let first = session.live_document();
+    session.live_adopt(&base).unwrap();
+    session.execute("clip.create", &json!({ "track": track, "scene": 2 })).unwrap();
+    let second = session.live_document();
+    // Both took the same content id and the same clip id; the second side's are renumbered.
+    let merged = merge(&base, &first, &second).unwrap();
+    let project = project_of(&merged).unwrap();
+    let column = project.launcher.columns.iter().find(|c| c.track.0 == track).unwrap();
+    let clips: Vec<_> = column.slots.iter().filter_map(|s| s.clip.as_ref()).collect();
+    assert_eq!(clips.len(), 2);
+    assert_ne!(clips[0].id, clips[1].id);
+    assert_ne!(clips[0].content, clips[1].content);
+}
