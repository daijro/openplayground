+// ---------------------------------------------------------------- the look
+
+/// What a person shows in a view, in screen terms.
+#[derive(Default)]
+struct Marks {
+    tip: Option<Pos2>,
+    ghosts: Vec<Rect>,
+    rings: Vec<Rect>,
+    /// Where the tag goes when there is no pointer to hang it from, and the value it shows under the name.
+    tag_at: Option<Pos2>,
+    value: Option<String>,
+}
+
+/// The others' marks over `painter`'s area in the kit's look: everyone's ghosts, then rings (outlines just outside the
+/// control), then pointers with their name tags, or a name tag with the value being set under it.
+fn paint(painter: &Painter, all: &[(Color32, String, Marks)]) {
+    let near = painter.clip_rect().expand(4.0);
+    for (color, _, marks) in all {
+        for ghost in &marks.ghosts {
+            let rect = ghost.intersect(near);
+            if rect.is_positive() {
+                presence::ghost(painter, rect, *color);
+            }
+        }
+    }
+    for (color, _, marks) in all {
+        for ring in &marks.rings {
+            presence::outline(painter, ring.expand(2.0), *color);
+        }
+    }
+    for (color, name, marks) in all {
+        if let Some(tip) = marks.tip.filter(|p| painter.clip_rect().contains(*p)) {
+            presence::cursor(painter, tip, *color, name);
+        } else if let Some(at) = marks.tag_at {
+            let tag = presence::tag(painter, at + vec2(4.0, -6.0), *color, name);
+            if let Some(value) = &marks.value {
+                presence::label(painter, pos2(tag.min.x, tag.max.y + 2.0), *color, value);
+            }
+        }
+    }
+}
