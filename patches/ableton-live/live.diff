+// SPDX-License-Identifier: GPL-3.0-or-later
+//! Live editing in a Playground session (patches/ableton-live.yaml in github.com/daijro/openplayground), the session's
+//! side: the shared document a project makes, putting one back into the session, and the merge. Playground's
+//! `shell/live.js` drives it through the adapter `kit::web::attach` offers (`kit` is the playground-live crate,
+//! patches/live/kit; the window, crates/ui `app::live`, is the app it runs on). Nothing here runs until a session
+//! connects. Web only, and its native tests.
+//!
+//! The shared document is the project as its `.suhina` file has it (`project` in the file), shaped so two people's
+//! edits merge: the kit merges objects by key and lists of objects by their `id`, and here every list of objects
+//! without ids gets one: a note's is the note itself (a note moved or changed is the old one gone and a new one added,
+//! so two people changing different notes of one clip both keep theirs), anything else's is its place in the list
+//! (two people turning different devices of one track both keep theirs; adding or removing one beside another's edit
+//! is a conflict, never a mix-up). These ids are strings beginning with `~`, which the file never has, and are taken
+//! off again before the project is read. Notes are kept in time order, so every peer has the same bytes.
+
+pub use ::playground_live as kit;
+
+use crate::Session;
+use serde_json::{Map, Value};
+use suhina_model::{LaneData, Project};
+
+/// The document's format: peers whose formats differ do not share a document.
+pub const FORMAT: &str = "suhina:1";
+/// The allocator the kit merges by maximum: the clip, lane and scene ids' counter.
+pub const COUNTERS: &[&str] = &["next_id"];
+
+const NOTE: &str = "~n:";
+const AT: &str = "~i:";
+
+fn note_order(note: &Value) -> (f64, i64) {
+    (note["time"].as_f64().unwrap_or(0.0), note["key"].as_i64().unwrap_or(0))
+}
+
+/// Notes in time order (then key, then id), the order every peer keeps them in.
+fn sort_notes(notes: &mut [Value]) {
+    notes.sort_by(|a, b| {
+        let (ta, ka) = note_order(a);
+        let (tb, kb) = note_order(b);
+        ta.total_cmp(&tb).then(ka.cmp(&kb)).then_with(|| a["id"].as_str().cmp(&b["id"].as_str()))
+    });
+}
+
+fn keyed(items: &[Value]) -> bool {
+    let mut seen = std::collections::HashSet::new();
+    items.iter().all(|i| match i.get("id") {
+        Some(Value::Number(n)) => seen.insert(n.to_string()),
+        Some(Value::String(s)) => seen.insert(s.clone()),
+        _ => false,
+    })
+}
+
+/// The file's project as the shared document (see the top).
+pub fn shape(value: &mut Value, key: &str) {
+    match value {
+        Value::Object(map) => {
+            for (k, v) in map.iter_mut() {
+                shape(v, k);
+            }
+        }
+        Value::Array(items) if !items.is_empty() && items.iter().all(Value::is_object) => {
+            if key == "notes" {
+                let mut seen = std::collections::HashMap::<String, usize>::new();
+                for note in items.iter_mut() {
+                    let text = String::from_utf8(kit::canonical(note)).unwrap_or_default();
+                    let n = seen.entry(text.clone()).or_default();
+                    *n += 1;
+                    note["id"] = Value::String(format!("{NOTE}{text}#{n}"));
+                }
+                sort_notes(items);
+                return;
+            }
+            if !keyed(items) && items.iter().all(|i| i.get("id").is_none()) {
+                for (n, item) in items.iter_mut().enumerate() {
+                    item["id"] = Value::String(format!("{AT}{n}"));
+                }
+            }
+            for item in items.iter_mut() {
+                shape(item, "");
+            }
+        }
+        _ => {}
+    }
+}
+
+/// The shared document back as the file's project: the ids [`shape`] gave taken off.
+fn unshape(value: &mut Value) {
+    match value {
+        Value::Object(map) => {
+            if map.get("id").and_then(Value::as_str).is_some_and(|id| id.starts_with('~')) {
+                map.remove("id");
+            }
+            map.values_mut().for_each(unshape);
+        }
+        Value::Array(items) => items.iter_mut().for_each(unshape),
+        _ => {}
+    }
+}
+
+/// Notes back in order after a merge, which keeps each side's additions next to their neighbours.
+fn order(value: &mut Value, key: &str) {
+    match value {
+        Value::Object(map) => map.iter_mut().for_each(|(k, v)| order(v, k)),
+        Value::Array(items) => {
+            if key == "notes" {
+                sort_notes(items);
+            }
+            items.iter_mut().for_each(|v| order(v, ""));
+        }
+        _ => {}
+    }
+}
+
+/// A project as the shared document.
+pub fn document_of(project: &Project) -> Value {
+    let file: Value = serde_json::from_str(&suhina_project_file::to_json(project)).unwrap_or_default();
+    let mut doc = file.get("project").cloned().unwrap_or_else(|| Value::Object(Map::new()));
+    shape(&mut doc, "");
+    doc
+}
+
+/// The project a shared document holds; it must read and validate as a file's does.
+pub fn project_of(document: &Value) -> Result<Project, String> {
+    let mut doc = document.clone();
+    if !doc.is_object() {
+        return Err("Conflict: not a project".into());
+    }
+    unshape(&mut doc);
+    let file = serde_json::json!({ "format": "suhina", "version": suhina_project_file::VERSION, "project": doc });
+    suhina_project_file::from_json(&file.to_string()).map_err(|e| format!("Conflict: {e}"))
+}
+
+/// The three-way merge: the kit's, then the notes back in order, then the result must read as a project. Objects both
+/// sides added under the same id (two people adding a clip, or making their first edit to clips whose notes another
+/// clip shares, which copies them, at once) are no conflict: `edited`'s get new ids first ([`renumber`]).
+pub fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+    let merge = |edited: &Value| -> Result<Value, String> {
+        let mut merged = kit::merge(base, current, edited, COUNTERS)?;
+        order(&mut merged, "");
+        project_of(&merged)?;
+        Ok(merged)
+    };
+    merge(edited).or_else(|e| renumber(base, current, edited).map_or(Err(e), |edited| merge(&edited)))
+}
+
+/// The kinds of ids, each with the lists its objects are in and the fields that name one (as JSON pointers with `*`
+/// for every item of a list). Clips, arrangement lanes and scenes share one counter, so one kind.
+const KINDS: [(&[&str], &[&str]); 4] = [
+    (&["/contents/*"], &["/arrangement/lanes/*/clips/*/content", "/launcher/columns/*/slots/*/clip/content"]),
+    (&["/arrangement/lanes/*", "/arrangement/lanes/*/clips/*", "/launcher/columns/*/slots/*/clip", "/launcher/scenes/*"], &[]),
+    (
+        &["/tracks/*"],
+        &["/tracks/*/parent", "/arrangement/lanes/*/track", "/launcher/columns/*/track", "/contents/*/lanes/*/target", "/launcher/mappings/*/track"],
+    ),
+    (&["/channels/*"], &["/tracks/*/channel", "/channels/*/output", "/channels/*/sends/*/target"]),
+];
+
+/// The values at `pointer` (with `*` for every item of a list).
+fn at_all<'a>(value: &'a mut Value, pointer: &[&str], out: &mut Vec<&'a mut Value>) {
+    match pointer.split_first() {
+        None => out.push(value),
+        Some((&"*", rest)) => {
+            if let Value::Array(items) = value {
+                items.iter_mut().for_each(|v| at_all(v, rest, out));
+            }
+        }
+        Some((key, rest)) => {
+            if let Some(v) = value.get_mut(*key) {
+                at_all(v, rest, out);
+            }
+        }
+    }
+}
+
+fn ids(doc: &Value, lists: &[&str]) -> Vec<u64> {
+    let mut doc = doc.clone();
+    let mut out = Vec::new();
+    for list in lists {
+        let parts: Vec<&str> = list.split('/').skip(1).collect();
+        let mut found = Vec::new();
+        at_all(&mut doc, &parts, &mut found);
+        out.extend(found.into_iter().filter_map(|v| v["id"].as_u64()));
+    }
+    out
+}
+
+/// `edited` with new ids for the objects it added under an id `current` also added, and every field naming them; `None`
+/// when there are none.
+fn renumber(base: &Value, current: &Value, edited: &Value) -> Option<Value> {
+    let mut edited = edited.clone();
+    let mut changed = false;
+    for (kind, (lists, refs)) in KINDS.iter().enumerate() {
+        let (b, c, e) = (ids(base, lists), ids(current, lists), ids(&edited, lists));
+        let clashes: Vec<u64> = e.iter().copied().filter(|id| !b.contains(id) && c.contains(id)).collect();
+        if clashes.is_empty() {
+            continue;
+        }
+        let counter = |d: &Value| if kind == 1 { d["next_id"].as_u64().unwrap_or(0) } else { 0 };
+        let mut next = c.iter().chain(&e).copied().max().unwrap_or(0).max(counter(current)).max(counter(&edited)) + 1;
+        let fresh: std::collections::HashMap<u64, u64> = clashes
+            .into_iter()
+            .map(|id| {
+                next += 1;
+                (id, next - 1)
+            })
+            .collect();
+        let swap = |v: &mut Value| {
+            if let Some(new) = v.as_u64().and_then(|id| fresh.get(&id)) {
+                *v = Value::from(*new);
+            }
+        };
+        for pointer in lists.iter().map(|l| format!("{l}/id")).chain(refs.iter().map(|r| (*r).to_owned())) {
+            let parts: Vec<&str> = pointer.split('/').skip(1).collect();
+            let mut found = Vec::new();
+            at_all(&mut edited, &parts, &mut found);
+            found.into_iter().for_each(|v| swap(v));
+        }
+        if kind == 1 {
+            edited["next_id"] = Value::from(next);
+        }
+        changed = true;
+    }
+    changed.then_some(edited)
+}
+
+/// The audio files a project plays, by the name its clips give them (the key its decoded audio is kept under).
+pub fn audio_files(project: &Project) -> Vec<String> {
+    let mut files: Vec<String> = project
+        .contents
+        .iter()
+        .flat_map(|c| &c.lanes)
+        .filter_map(|l| match &l.data {
+            LaneData::Audio(region) if !region.file.is_empty() => Some(region.file.clone()),
+            _ => None,
+        })
+        .chain(project.channels.iter().flat_map(|c| &c.devices).filter_map(|d| d.sample_file().map(str::to_owned)))
+        .collect();
+    files.sort();
+    files.dedup();
+    files
+}
+
+/// An audio file's name as a shared document gives it, where it is kept in this browser: inside the project's
+/// folder, never above it. `None` for a name that would leave it.
+pub fn file_at(folder: &std::path::Path, name: &str) -> Option<std::path::PathBuf> {
+    let path = std::path::Path::new(name);
+    if name.is_empty() || name.len() > 1024 || path.components().any(|c| matches!(c, std::path::Component::ParentDir)) {
+        return None;
+    }
+    Some(folder.join(path))
+}
+
+impl Session {
+    /// The shared document: this project (see the top).
+    pub fn live_document(&self) -> Value {
+        document_of(&self.project)
+    }
+
+    /// Changes whenever the project may have.
+    pub fn live_generation(&self) -> u64 {
+        self.history.changes
+    }
+
+    /// The folder the project's audio names start from here.
+    pub fn live_folder(&self) -> std::path::PathBuf {
+        self.audio.folder.clone().unwrap_or_else(|| std::path::PathBuf::from("/"))
+    }
+
+    /// Puts a shared document's project in: no step of the undo history, the playing engine follows, and audio files
+    /// already here are decoded for it (the others arrive as the session's media, [`Session::live_add_audio`]).
+    pub fn live_adopt(&mut self, document: &Value) -> Result<(), String> {
+        let project = project_of(document)?;
+        if project == self.project {
+            return Ok(());
+        }
+        let scenes = std::mem::replace(&mut self.project, project).launcher;
+        self.history.changes = self.history.changes.wrapping_add(1);
+        self.history.open_step = None;
+        self.history.param_gesture = None;
+        self.live_decode();
+        let shift = suhina_engine::SceneShift::between(&scenes, &self.project.launcher);
+        self.update_player(shift).map_err(|e| e.0)?;
+        self.send_armed();
+        Ok(())
+    }
+
+    /// Decodes the project's audio files that are here and not decoded yet. Whether any was.
+    fn live_decode(&mut self) -> bool {
+        let folder = self.live_folder();
+        let mut added = false;
+        for name in audio_files(&self.project) {
+            if self.audio.pool.files.contains_key(&name) {
+                continue;
+            }
+            let Some(path) = file_at(&folder, &name).filter(|p| std::fs::metadata(p).is_ok_and(|m| m.is_file())) else {
+                continue;
+            };
+            if let Ok(data) = suhina_media::decode_file(&path) {
+                self.audio.pool.files.insert(name, std::sync::Arc::new(data));
+                added = true;
+            }
+        }
+        self.audio.changed |= added;
+        added
+    }
+
+    /// An audio file someone else in the session shared: kept in memory where the project names it, decoded, and
+    /// heard from now on. `name` comes from another person: one that would leave the project's folder is refused.
+    pub fn live_add_audio(&mut self, name: &str, bytes: Vec<u8>) -> Result<(), String> {
+        let path = file_at(&self.live_folder(), name).ok_or("not a file name")?;
+        live_files_impl::put(&path, bytes);
+        if self.live_decode() {
+            self.update_player(None).map_err(|e| e.0)?;
+        }
+        Ok(())
+    }
+
+    /// Whether an audio file the project plays is here.
+    pub fn live_has_audio(&self, name: &str) -> bool {
+        file_at(&self.live_folder(), name).is_some_and(|p| std::fs::metadata(p).is_ok_and(|m| m.is_file()))
+    }
+
+    /// The bytes of an audio file the project plays, when it is here.
+    pub fn live_audio_bytes(&self, name: &str) -> Option<Vec<u8>> {
+        audio_files(&self.project).iter().any(|f| f == name).then_some(())?;
+        std::fs::read(file_at(&self.live_folder(), name)?).ok()
+    }
+
+    /// The session ended: Undo starts again from the project as it is.
+    pub fn live_disconnected(&mut self) {
+        self.history.undo.clear();
+        self.history.redo.clear();
+        self.history.open_step = None;
+    }
+}
+
+/// Storing a shared file without it counting as this browser's own change (which the page would copy into Files).
+mod live_files_impl {
+    #[cfg(target_arch = "wasm32")]
+    pub fn put(path: &std::path::Path, bytes: Vec<u8>) {
+        suhina_playground::std::fs::put(path, bytes);
+    }
+    #[cfg(not(target_arch = "wasm32"))]
+    pub fn put(path: &std::path::Path, bytes: Vec<u8>) {
+        if let Some(dir) = path.parent() {
+            let _ = std::fs::create_dir_all(dir);
+        }
+        let _ = std::fs::write(path, bytes);
+    }
+}
+
+// The clock and files, as the session's other modules have them on wasm (patches/ableton-live.yaml).
+#[cfg(target_arch = "wasm32")]
+use suhina_playground::std;
+
+#[cfg(test)]
+mod tests;
