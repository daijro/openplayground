+//! Where the canvas puts the pages on screen (patches/word.yaml): the one place the adapter reads the canvas's page
+//! view, which the release keeps in fields and newer commits behind methods.
+
+use egui::{Pos2, Rect};
+use wordcraft_engine::layout::DocLayout;
+use wordcraft_ui_egui::WordApp;
+
+/// The canvas body on screen, once a pass has shown it.
+pub fn canvas_rect(app: &WordApp) -> Option<Rect> {
+    app.canvas.canvas_rect()
+}
+
+/// Page `page` on screen in the last pass (`None` for a page that isn't).
+pub fn page_rect(app: &WordApp, page: usize) -> Option<Rect> {
+    app.canvas.page_rects().find(|(i, _)| *i == page).map(|(_, r)| r)
+}
+
+/// Screen pixels per page point at the canvas's zoom (the page's own scale is better where the page is on screen).
+pub fn scale(app: &WordApp) -> f32 {
+    app.canvas.zoom() as f32
+}
+
+/// Page index and page coordinates (points) under a screen point: the page it is over, else the nearest one.
+pub fn page_at(app: &WordApp, layout: &DocLayout, p: Pos2) -> Option<(usize, f32, f32)> {
+    let distance = |r: &Rect| (r.min.x - p.x).max(0.0).max(p.x - r.max.x).hypot((r.min.y - p.y).max(0.0).max(p.y - r.max.y));
+    let (page, r) = app.canvas.page_rects().min_by(|a, b| distance(&a.1).total_cmp(&distance(&b.1)))?;
+    let scale = match layout.pages.get(page) {
+        Some(pg) if pg.w > 0.0 => r.width() / pg.w,
+        _ => scale(app),
+    };
+    Some((page, (p.x - r.min.x) / scale, (p.y - r.min.y) / scale))
+}
