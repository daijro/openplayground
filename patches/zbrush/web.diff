+++ b/web/Trunk.toml
@@ -0,0 +1,6 @@
+# OxyBrush in the browser, for Playground (patches/zbrush.yaml in the openplayground repository).
+# Build with: scripts/build-web.sh <dist>   (from the repository's root)
+[build]
+target = "index.html"
