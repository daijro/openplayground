+#!/bin/sh
+# OxyBrush's browser build for Playground (patches/zbrush.yaml in the openplayground repository): the page in web/ is built with
+# trunk into the folder given. Run from the repository's root: scripts/build-web.sh <dist>
+set -e
+cd web
+trunk build --release --dist "$1" --public-url ./
