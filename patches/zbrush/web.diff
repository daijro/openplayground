+//! OxyBrush in the browser, for Playground (patches/zbrush.yaml in the openplayground repository): the desktop window on the
+//! page's canvas (winit's web backend), and its files in Playground's Files.
+//!
+//! Files live in memory (oxy_mesh::playground's `std::fs`): a file from Files comes in at its path (`browser:/Art/a.oxb` is
+//! `/Art/a.oxb` here), and whatever OxyBrush writes outside /tmp (a save, an export) goes to Files after the event. The desktop's
+//! file dialogs (`rfd`) are Playground's: `rfd` below answers them with a file in memory, as it does for a desktop path.
+//! "Open in OxyBrush" and a dropped file open as File > Open does. Native builds don't compile this.
+use super::*;
+use oxy_mesh::playground::std::{self, fs, path::Path};
+use std::cell::{Cell, RefCell};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+use winit::platform::web::{EventLoopExtWebSys as _, WindowAttributesExtWebSys as _};
+
+/// Memory only: files from the computer or a drop, and a save to download.
+const TMP: &str = "/tmp";
+const DOWNLOADS: &str = "/tmp/downloads";
+
+thread_local! {
+    /// The GPU state, once the browser has answered the adapter and device requests.
+    static READY: RefCell<Option<Result<Gfx, String>>> = const { RefCell::new(None) };
+    /// Files that came in (Open in, a drop), to open.
+    static OPENED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    static PROXY: RefCell<Option<EventLoopProxy<()>>> = const { RefCell::new(None) };
+    /// What Playground was last told (true at first, so the first answer is told).
+    static UNSAVED: Cell<bool> = const { Cell::new(true) };
+}
+
+/// Wakes the event loop (an answer arrived from the page).
+fn wake() {
+    PROXY.with_borrow(|p| p.as_ref().map(|p| p.send_event(())));
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(pairs: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in pairs {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory at its path (one from the computer goes to `/tmp`).
+fn bring_in(file: &JsValue) -> Option<PathBuf> {
+    let name = get(file, "name").as_string()?;
+    let path = match get(file, "path").as_string() {
+        Some(p) => PathBuf::from(p.strip_prefix("browser:")?),
+        None => Path::new(TMP).join(Path::new(&name).file_name()?),
+    };
+    fs::put(&path, js_sys::Uint8Array::new(&get(file, "bytes")).to_vec());
+    Some(path)
+}
+
+fn open(path: PathBuf) {
+    OPENED.with_borrow_mut(|o| o.push(path));
+    wake();
+}
+
+/// The loading text over the canvas: a message, or gone.
+fn loading(message: Option<&str>) {
+    let Some(el) = web_sys::window().and_then(|w| w.document()).and_then(|d| d.get_element_by_id("oxybrush_loading")) else {
+        return;
+    };
+    match message {
+        Some(m) => el.set_text_content(Some(m)),
+        None => el.remove(),
+    }
+}
+
+/// Playground's dialogs, in place of the desktop's `rfd`. The page asks (Open, or Save As in Files), the answer is a file in memory.
+pub mod rfd {
+    pub use ::rfd::*;
+    use super::*;
+
+    #[derive(Default)]
+    pub struct AsyncFileDialog {
+        name: String,
+        types: Vec<String>,
+    }
+
+    pub struct FileHandle(PathBuf);
+
+    impl FileHandle {
+        pub fn path(&self) -> &Path {
+            &self.0
+        }
+    }
+
+    impl AsyncFileDialog {
+        pub fn new() -> Self {
+            Self::default()
+        }
+
+        pub fn add_filter(mut self, _name: impl Into<String>, extensions: &[impl ToString]) -> Self {
+            for e in extensions {
+                let e = e.to_string().to_ascii_lowercase();
+                if !self.types.contains(&e) {
+                    self.types.push(e);
+                }
+            }
+            self
+        }
+
+        pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+            self.name = name.into();
+            self
+        }
+
+        pub fn set_parent<W>(self, _: &W) -> Self {
+            self
+        }
+
+        fn types(&self) -> JsValue {
+            self.types.iter().map(|t| JsValue::from(t.as_str())).collect::<js_sys::Array>().into()
+        }
+
+        pub async fn pick_file(self) -> Option<FileHandle> {
+            let answer = wait(call("open", &[options(&[("types", self.types())])])).await?;
+            js_sys::Array::from(&answer).iter().find_map(|f| bring_in(&f)).map(FileHandle)
+        }
+
+        pub async fn save_file(self) -> Option<FileHandle> {
+            let name = if self.name.is_empty() { "Untitled".to_string() } else { self.name.clone() };
+            let answer = wait(call("saveAs", &[options(&[("name", name.as_str().into()), ("types", self.types())])])).await?;
+            let path = match get(&answer, "path").as_string() {
+                Some(p) => PathBuf::from(p.strip_prefix("browser:")?),
+                // Download to device: written to memory, then handed to the browser (web_sync).
+                None => Path::new(DOWNLOADS).join(&name),
+            };
+            Some(FileHandle(path))
+        }
+    }
+}
+
+impl App {
+    /// The desktop's dialog thread can't wait for the page: the page's answer arrives as a future.
+    pub(super) fn spawn_dialog<F>(&mut self, future: F, map: impl FnOnce(Option<PathBuf>) -> DialogReply + 'static)
+    where
+        F: std::future::Future<Output = Option<rfd::FileHandle>> + 'static,
+    {
+        self.dialog_active = true;
+        let tx = self.dialog_tx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            let _ = tx.send(map(future.await.map(|h| h.path().to_path_buf())));
+            wake();
+        });
+    }
+
+    /// The window and surface now; the adapter and device are asked of the browser, which can't be waited for, and arrive in `READY`.
+    pub(super) fn init_gfx(&mut self, event_loop: &ActiveEventLoop) -> Result<(), String> {
+        // The shaders and the surface formats are WebGPU's (wgpu's WebGL2 has no surface view formats): without it, say so.
+        let webgpu = js_sys::Reflect::get(&js_sys::global(), &"navigator".into())
+            .and_then(|n| js_sys::Reflect::get(&n, &"gpu".into()))
+            .is_ok_and(|gpu| gpu.is_object());
+        if !webgpu {
+            loading(Some("OxyBrush needs WebGPU, which this browser doesn't have (or has turned off)."));
+            return Ok(());
+        }
+        let canvas = web_sys::window()
+            .and_then(|w| w.document())
+            .and_then(|d| d.get_element_by_id("oxybrush_canvas"))
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .ok_or("no #oxybrush_canvas")?;
+        let attrs = Window::default_attributes().with_title("OxyBrush").with_canvas(Some(canvas)).with_prevent_default(true);
+        let window = Arc::new(event_loop.create_window(attrs).map_err(|e| e.to_string())?);
+        let instance = wgpu::Instance::new(wgpu::InstanceDescriptor::new_with_display_handle_from_env(Box::new(
+            event_loop.owned_display_handle(),
+        )));
+        let surface = instance.create_surface(window.clone()).map_err(|e| e.to_string())?;
+        let ctx = self.egui_ctx.clone();
+        wasm_bindgen_futures::spawn_local(async move {
+            READY.set(Some(gfx(ctx, window, instance, surface).await));
+            wake();
+        });
+        Ok(())
+    }
+
+    /// After every batch of events: the GPU state when it has arrived, the files that came in, what OxyBrush wrote (to Files), and the
+    /// unsaved state.
+    pub(super) fn web_sync(&mut self) {
+        match READY.take() {
+            Some(Ok(g)) => {
+                loading(None);
+                g.window.request_redraw();
+                self.gfx = Some(g);
+            }
+            Some(Err(e)) => loading(Some(&format!("OxyBrush could not start: {e}"))),
+            None => {}
+        }
+        if let Some(g) = &self.gfx {
+            let opened = OPENED.take();
+            if !opened.is_empty() {
+                g.window.request_redraw();
+            }
+            for p in opened {
+                self.editor.open(&p);
+            }
+        }
+        for p in fs::changes() {
+            let (Ok(bytes), Some(name)) = (fs::read(&p), p.file_name()) else { continue };
+            let bytes = js_sys::Uint8Array::from(bytes.as_slice());
+            if p.starts_with(DOWNLOADS) {
+                call("download", &[name.to_string_lossy().as_ref().into(), bytes.into()]);
+                let _ = fs::remove_file(&p);
+            } else if !p.starts_with(TMP) {
+                call("write", &[format!("browser:{}", p.display()).into(), bytes.into()]);
+            }
+        }
+        // A file from the computer or a download has no place in Files: Save asks where.
+        if self.editor.path.as_deref().is_some_and(|p| p.starts_with(TMP)) {
+            self.editor.path = None;
+        }
+        let unsaved = self.editor.is_modified();
+        if UNSAVED.replace(unsaved) != unsaved {
+            call("setUnsaved", &[unsaved.into()]);
+        }
+    }
+}
+
+/// The rest of the desktop's `init_gfx`, once the browser has answered.
+async fn gfx(
+    ctx: egui::Context,
+    window: Arc<Window>,
+    instance: wgpu::Instance,
+    surface: wgpu::Surface<'static>,
+) -> Result<Gfx, String> {
+    let adapter = instance
+        .request_adapter(&wgpu::RequestAdapterOptions {
+            power_preference: wgpu::PowerPreference::HighPerformance,
+            compatible_surface: Some(&surface),
+            force_fallback_adapter: false,
+            apply_limit_buckets: false,
+        })
+        .await
+        .map_err(|e| format!("no compatible GPU adapter: {e}"))?;
+    let (device, queue) = adapter
+        .request_device(&wgpu::DeviceDescriptor {
+            label: Some("oxybrush"),
+            required_limits: adapter.limits(),
+            required_features: adapter.features() & oxy_render::optional_features(),
+            ..Default::default()
+        })
+        .await
+        .map_err(|e| e.to_string())?;
+    let size = window.inner_size();
+    let mut config =
+        surface.get_default_config(&adapter, size.width.max(1), size.height.max(1)).ok_or("surface not supported by adapter")?;
+    let view_format = config.format.add_srgb_suffix();
+    for f in [view_format, config.format.remove_srgb_suffix()] {
+        if f != config.format {
+            config.view_formats.push(f);
+        }
+    }
+    config.present_mode = wgpu::PresentMode::AutoVsync;
+    surface.configure(&device, &config);
+    let viewport = ViewportRenderer::new(&device, &queue, view_format);
+    let egui_renderer =
+        egui_wgpu::Renderer::new(&device, config.format.remove_srgb_suffix(), egui_wgpu::RendererOptions::default());
+    let egui_state = egui_winit::State::new(
+        ctx,
+        egui::ViewportId::ROOT,
+        &window,
+        Some(window.scale_factor() as f32),
+        None,
+        Some(device.limits().max_texture_dimension_2d as usize),
+    );
+    Ok(Gfx { window, surface, device, queue, config, view_format, viewport, egui_renderer, egui_state })
+}
+
+/// The page's `main`: the app on the canvas, and Files' "Open in" and drops.
+pub fn main() {
+    std::panic::set_hook(Box::new(|info| web_sys::console::error_1(&format!("OxyBrush: {info}").into())));
+    let event_loop = winit::event_loop::EventLoop::builder().build().expect("event loop");
+    let mut app = App::new(None, AutoRun::default(), None);
+    app.set_event_proxy(event_loop.create_proxy());
+    PROXY.set(Some(event_loop.create_proxy()));
+    call(
+        "onOpen",
+        &[Closure::<dyn Fn(JsValue)>::new(|file| {
+            if let Some(path) = bring_in(&file) {
+                open(path);
+            }
+        })
+        .into_js_value()],
+    );
+    if let Some(canvas) = web_sys::window().and_then(|w| w.document()).and_then(|d| d.get_element_by_id("oxybrush_canvas")) {
+        let over = Closure::<dyn Fn(web_sys::DragEvent)>::new(|e: web_sys::DragEvent| e.prevent_default());
+        let _ = canvas.add_event_listener_with_callback("dragover", over.into_js_value().unchecked_ref());
+        // A dropped file is only a name on the web: its bytes are read, then it opens as "Open in OxyBrush" does.
+        let drop = Closure::<dyn Fn(web_sys::DragEvent)>::new(|e: web_sys::DragEvent| {
+            e.prevent_default();
+            let files = e.data_transfer().and_then(|d| d.files());
+            for f in (0..files.as_ref().map_or(0, |f| f.length())).filter_map(|i| files.as_ref()?.get(i)) {
+                wasm_bindgen_futures::spawn_local(async move {
+                    if let Ok(bytes) = wasm_bindgen_futures::JsFuture::from(f.array_buffer()).await {
+                        let path = Path::new(TMP).join("dropped").join(f.name());
+                        fs::put(&path, js_sys::Uint8Array::new(&bytes).to_vec());
+                        open(path);
+                    }
+                });
+            }
+        });
+        let _ = canvas.add_event_listener_with_callback("drop", drop.into_js_value().unchecked_ref());
+    }
+    event_loop.spawn_app(app);
+}
