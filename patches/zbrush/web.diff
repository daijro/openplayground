+//! OxyBrush in the browser, for Playground (patches/zbrush.yaml in the openplayground repository).
+//!
+//! tobj opens an OBJ by its path on the real file system, which a page doesn't have: `tobj` here is tobj with `load_obj` reading
+//! the in-memory file system (oxy_mesh::playground) instead. lib.rs takes it through `use web::tobj;`. Native builds don't compile this.
+
+pub mod tobj {
+    pub use ::tobj::*;
+    use oxy_mesh::playground::std::fs;
+    use std::io::Cursor;
+    use std::path::Path;
+
+    /// `tobj::load_obj` for a file in memory; materials are not read (the importers drop them).
+    pub fn load_obj<P: AsRef<Path>>(path: P, opts: &LoadOptions) -> LoadResult {
+        let bytes = fs::read(path).map_err(|_| LoadError::OpenFileFailed)?;
+        load_obj_buf(&mut Cursor::new(bytes), opts, |_| Err(LoadError::OpenFileFailed))
+    }
+}
diff --git a/crates/oxy-mesh/src/playground.rs b/crates/oxy-mesh/src/playground.rs
new file mode 100644
index 0000000..1111111
--- /dev/null
+++ b/crates/oxy-mesh/src/playground.rs
@@ -0,0 +1,173 @@
+//! OxyBrush in the browser, for Playground (patches/zbrush.yaml in the openplayground repository).
+//!
+//! wasm32-unknown-unknown has no clock, no files and no threads: `Instant::now` and `process::id` panic there and every file
+//! call fails. The modules that use them take `std` from here instead, through one `#[cfg(target_arch = "wasm32")] use
+//! oxy_mesh::playground::std;` line at the end of each (a local `std` shadows the standard library's name in that module;
+//! everything else in it still comes from the real std):
+//!   time     web-time's Instant (SystemTime stays std's: the page asks the browser, see updates.rs);
+//!   fs       an in-memory file system for the calls OxyBrush makes (read, write, rename, create), each write noted for the
+//!            page to mirror to Playground's Files;
+//!   thread   a worker that runs where it is spawned (a page has one thread; the job's result waits in its channel);
+//!   process  a process id.
+//! Native builds don't compile this file.
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use ::std::time::*;
+        pub use web_time::Instant;
+    }
+
+    pub mod process {
+        pub use ::std::process::*;
+
+        pub fn id() -> u32 {
+            1
+        }
+    }
+
+    pub mod thread {
+        pub use ::std::thread::*;
+        use ::std::io;
+
+        pub struct JoinHandle<T>(T);
+
+        impl<T> JoinHandle<T> {
+            pub fn join(self) -> ::std::thread::Result<T> {
+                Ok(self.0)
+            }
+        }
+
+        pub struct Builder;
+
+        impl Builder {
+            pub fn new() -> Self {
+                Builder
+            }
+
+            pub fn name(self, _: String) -> Self {
+                self
+            }
+
+            // ponytail: runs the work at once on the page's thread, so the page stands still while it runs; a Web Worker if that matters.
+            pub fn spawn<F: FnOnce() -> T + Send + 'static, T: Send + 'static>(self, f: F) -> io::Result<JoinHandle<T>> {
+                Ok(JoinHandle(f()))
+            }
+        }
+    }
+
+    pub mod fs {
+        // What isn't here (read_dir, ...) is std's, which fails on a page.
+        pub use ::std::fs::*;
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io::{self, ErrorKind};
+        use ::std::path::{Component, Path, PathBuf};
+
+        #[derive(Default)]
+        struct Files {
+            bytes: BTreeMap<PathBuf, Vec<u8>>,
+            /// Paths written since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+        }
+
+        thread_local! {
+            static FILES: RefCell<Files> = RefCell::default();
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        /// Stores a file without noting a change (a file the page brings in from Files or a drop).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            FILES.with_borrow_mut(|f| f.bytes.insert(key(p), bytes));
+        }
+
+        /// The paths written since the last call.
+        pub fn changes() -> Vec<PathBuf> {
+            FILES.with_borrow_mut(|f| ::std::mem::take(&mut f.changed).into_iter().collect())
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            FILES.with_borrow_mut(|f| {
+                f.bytes.insert(p.clone(), bytes.as_ref().to_vec());
+                f.changed.insert(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            FILES
+                .with_borrow(|f| f.bytes.get(&key(p.as_ref())).cloned())
+                .ok_or_else(|| io::Error::new(ErrorKind::NotFound, format!("{} does not exist", p.as_ref().display())))
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(ErrorKind::InvalidData, e))
+        }
+
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+            let bytes = read(&from)?;
+            // The temporary file never was a change: only its new name is.
+            FILES.with_borrow_mut(|f| {
+                f.bytes.remove(&key(from.as_ref()));
+                f.changed.remove(&key(from.as_ref()));
+            });
+            write(to, bytes)
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            FILES
+                .with_borrow_mut(|f| f.bytes.remove(&key(p.as_ref())))
+                .map(|_| ())
+                .ok_or_else(|| io::Error::new(ErrorKind::NotFound, "no such file"))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(_: P) -> io::Result<()> {
+            Ok(())
+        }
+
+        /// A file being written (`File::create`): what is written is in the file system at once.
+        pub struct File(PathBuf);
+
+        impl File {
+            pub fn create<P: AsRef<Path>>(p: P) -> io::Result<File> {
+                let p = key(p.as_ref());
+                FILES.with_borrow_mut(|f| f.bytes.insert(p.clone(), Vec::new()));
+                Ok(File(p))
+            }
+
+            pub fn sync_all(&self) -> io::Result<()> {
+                Ok(())
+            }
+        }
+
+        impl io::Write for File {
+            fn write(&mut self, buf: &[u8]) -> io::Result<usize> {
+                FILES.with_borrow_mut(|f| {
+                    f.bytes.entry(self.0.clone()).or_default().extend_from_slice(buf);
+                    f.changed.insert(self.0.clone());
+                });
+                Ok(buf.len())
+            }
+
+            fn flush(&mut self) -> io::Result<()> {
+                Ok(())
+            }
+        }
+    }
+}
