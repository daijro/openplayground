+# Playground's browser build of HumanMotionCraft (patches/cascadeur.yaml in the Playground repository): what
+# wasm32-unknown-unknown lacks, as std, craft_atomic and craft_settings stand-ins. Native builds compile it empty.
+[package]
+name = "ac-playground"
+description = "HumanMotionCraft in the browser: the clock, files and settings std and craft-libs lack on wasm32-unknown-unknown"
+version.workspace = true
+edition.workspace = true
+rust-version.workspace = true
+license.workspace = true
+publish.workspace = true
+
+[target.'cfg(target_arch = "wasm32")'.dependencies]
+web-time = "1"
+
+[lints]
+workspace = true
diff --git a/crates/ac-playground/src/lib.rs b/crates/ac-playground/src/lib.rs
new file mode 100644
index 0000000..f732ce1
--- /dev/null
+++ b/crates/ac-playground/src/lib.rs
@@ -0,0 +1,305 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! HumanMotionCraft in the browser, for Playground (patches/cascadeur.yaml in the Playground repository).
+//!
+//! wasm32-unknown-unknown has no clock and no files: `Instant::now` panics and every file call fails. The modules that
+//! use them take `std` from here instead, through one `#[cfg(target_arch = "wasm32")] use ac_playground::std;` line at
+//! each one's end (a local `std` shadows the standard library's name in that module; everything else in it still
+//! comes from the real std):
+//!   time     web-time's Instant and SystemTime;
+//!   fs       an in-memory file system (the assets, the library, projects, exports), each change noted for the page
+//!            to mirror to Playground's Files; `exists`, `is_dir` and `is_file` stand in for the `Path` methods of
+//!            those names, which ask the real one.
+//! And three crates' stand-ins (stand_ins.rs), which Cargo.toml hands to the app under those crates' names (a dependency
+//! with `package = "ac-playground"`, so their `use` lines stay as they are): `atomic_write` into that file system
+//! (craft-atomic), the preferences kept for the page (craft-settings: the real store reads the clock and a folder on
+//! disk), and the file dialogs (rfd: a page can't wait for one, so a dialog notes what it asked for and answers
+//! nothing; see `take_ask`).
+#![cfg(target_arch = "wasm32")]
+
+mod stand_ins;
+pub use stand_ins::*;
+
+/// `exists`, `is_dir` and `is_file` on a `PathBuf` (or a reference to one, which is what `join` and a directory entry
+/// give), asking the in-memory file system: the real `Path` methods of those names ask the real one, which has no files
+/// here. Importing this trait next to [`std`] shadows them where the receiver is a `PathBuf`, as a method on `&PathBuf`
+/// is found before one on `&Path`; the call sites stay as they are.
+pub trait PathExt {
+    fn exists(self) -> bool;
+    fn is_dir(self) -> bool;
+    fn is_file(self) -> bool;
+}
+
+impl PathExt for &::std::path::PathBuf {
+    fn exists(self) -> bool {
+        std::fs::exists(self)
+    }
+    fn is_dir(self) -> bool {
+        std::fs::is_dir(self)
+    }
+    fn is_file(self) -> bool {
+        std::fs::is_file(self)
+    }
+}
+
+pub mod std {
+    pub use ::std::*;
+
+    pub mod time {
+        pub use web_time::*;
+    }
+
+    pub mod env {
+        pub use ::std::env::*;
+
+        /// std's panics on a page.
+        pub fn temp_dir() -> ::std::path::PathBuf {
+            "/tmp".into()
+        }
+    }
+
+    pub mod fs {
+        // What isn't here (OpenOptions, set_permissions, ...) is std's, which fails on a page.
+        pub use ::std::fs::*;
+        use ::std::cell::RefCell;
+        use ::std::collections::{BTreeMap, BTreeSet};
+        use ::std::io;
+        use ::std::path::{Component, Path, PathBuf};
+        use web_time::SystemTime;
+
+        enum Entry {
+            Dir(SystemTime),
+            File(Vec<u8>, SystemTime),
+        }
+
+        #[derive(Default)]
+        struct Tree {
+            entries: BTreeMap<PathBuf, Entry>,
+            /// Paths written, created or removed since the last [`changes`].
+            changed: BTreeSet<PathBuf>,
+        }
+
+        thread_local! {
+            static TREE: RefCell<Tree> = RefCell::default();
+        }
+
+        fn with<T>(f: impl FnOnce(&mut Tree) -> T) -> T {
+            TREE.with(|t| f(&mut t.borrow_mut()))
+        }
+
+        /// `/a/./b/../c` -> `/a/c`: one spelling per file (relative paths start at `/`).
+        pub fn key(p: &Path) -> PathBuf {
+            let mut out = PathBuf::from("/");
+            for c in p.components() {
+                match c {
+                    Component::ParentDir => {
+                        out.pop();
+                    }
+                    Component::Normal(n) => out.push(n),
+                    _ => {}
+                }
+            }
+            out
+        }
+
+        fn missing(p: &Path) -> io::Error {
+            io::Error::new(io::ErrorKind::NotFound, format!("{} does not exist", p.display()))
+        }
+
+        impl Tree {
+            fn parents(&mut self, p: &Path) {
+                for dir in p.ancestors().skip(1) {
+                    self.entries.entry(dir.to_path_buf()).or_insert_with(|| Entry::Dir(SystemTime::now()));
+                }
+            }
+            fn put(&mut self, p: PathBuf, bytes: Vec<u8>) {
+                self.parents(&p);
+                self.entries.insert(p, Entry::File(bytes, SystemTime::now()));
+            }
+            /// `p` and everything below it.
+            fn below(&self, p: &Path) -> Vec<PathBuf> {
+                self.entries.range(p.to_path_buf()..).map(|(k, _)| k).take_while(|k| k.starts_with(p)).cloned().collect()
+            }
+        }
+
+        /// Stores a file without noting a change (the assets, and files the page brings in from Files or a drop).
+        pub fn put(p: &Path, bytes: Vec<u8>) {
+            with(|t| t.put(key(p), bytes));
+        }
+
+        /// The paths changed since the last call: each now holds what the page's storage should hold, or is gone.
+        pub fn changes() -> Vec<PathBuf> {
+            with(|t| ::std::mem::take(&mut t.changed).into_iter().collect())
+        }
+
+        pub fn exists<P: AsRef<Path>>(p: P) -> bool {
+            TREE.with(|t| t.borrow().entries.contains_key(&key(p.as_ref())))
+        }
+
+        pub fn is_file<P: AsRef<Path>>(p: P) -> bool {
+            TREE.with(|t| matches!(t.borrow().entries.get(&key(p.as_ref())), Some(Entry::File(..))))
+        }
+
+        pub fn is_dir<P: AsRef<Path>>(p: P) -> bool {
+            TREE.with(|t| matches!(t.borrow().entries.get(&key(p.as_ref())), Some(Entry::Dir(_))))
+        }
+
+        pub fn write<P: AsRef<Path>, C: AsRef<[u8]>>(p: P, bytes: C) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.put(p.clone(), bytes.as_ref().to_vec());
+                t.changed.insert(p);
+            });
+            Ok(())
+        }
+
+        pub fn read<P: AsRef<Path>>(p: P) -> io::Result<Vec<u8>> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::File(bytes, _)) => Ok(bytes.clone()),
+                _ => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub fn read_to_string<P: AsRef<Path>>(p: P) -> io::Result<String> {
+            String::from_utf8(read(p)?).map_err(|e| io::Error::new(io::ErrorKind::InvalidData, e))
+        }
+
+        pub fn create_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                t.parents(&p);
+                t.entries.entry(p).or_insert_with(|| Entry::Dir(SystemTime::now()));
+            });
+            Ok(())
+        }
+
+        pub fn remove_file<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| match t.entries.remove(&p) {
+                Some(Entry::File(..)) => {
+                    t.changed.insert(p);
+                    Ok(())
+                }
+                _ => Err(missing(&p)),
+            })
+        }
+
+        pub fn remove_dir<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                if t.below(&p).len() > 1 {
+                    return Err(io::Error::other(format!("{} is not empty", p.display())));
+                }
+                t.entries.remove(&p).map(|_| ()).ok_or_else(|| missing(&p))
+            })
+        }
+
+        pub fn remove_dir_all<P: AsRef<Path>>(p: P) -> io::Result<()> {
+            let p = key(p.as_ref());
+            with(|t| {
+                for gone in t.below(&p) {
+                    t.entries.remove(&gone);
+                    t.changed.insert(gone);
+                }
+            });
+            Ok(())
+        }
+
+        /// A file, or a folder with everything in it, under a new name.
+        pub fn rename<P: AsRef<Path>, Q: AsRef<Path>>(from: P, to: Q) -> io::Result<()> {
+            let (from, to) = (key(from.as_ref()), key(to.as_ref()));
+            with(|t| {
+                let moved = t.below(&from);
+                if moved.is_empty() {
+                    return Err(missing(&from));
+                }
+                t.parents(&to);
+                for old in moved {
+                    if let Some(entry) = t.entries.remove(&old) {
+                        let new = to.join(old.strip_prefix(&from).unwrap_or(&old));
+                        t.entries.insert(new.clone(), entry);
+                        t.changed.insert(old);
+                        t.changed.insert(new);
+                    }
+                }
+                Ok(())
+            })
+        }
+
+        pub fn canonicalize<P: AsRef<Path>>(p: P) -> io::Result<PathBuf> {
+            Ok(key(p.as_ref()))
+        }
+
+        #[derive(Clone, Copy)]
+        pub struct FileType(bool);
+        impl FileType {
+            pub fn is_dir(&self) -> bool {
+                self.0
+            }
+            pub fn is_file(&self) -> bool {
+                !self.0
+            }
+            pub fn is_symlink(&self) -> bool {
+                false
+            }
+        }
+
+        #[derive(Clone)]
+        pub struct Metadata {
+            dir: bool,
+            len: u64,
+            modified: SystemTime,
+        }
+        impl Metadata {
+            pub fn len(&self) -> u64 {
+                self.len
+            }
+            pub fn is_dir(&self) -> bool {
+                self.dir
+            }
+            pub fn is_file(&self) -> bool {
+                !self.dir
+            }
+            pub fn file_type(&self) -> FileType {
+                FileType(self.dir)
+            }
+            pub fn modified(&self) -> io::Result<SystemTime> {
+                Ok(self.modified)
+            }
+        }
+
+        pub fn metadata<P: AsRef<Path>>(p: P) -> io::Result<Metadata> {
+            TREE.with(|t| match t.borrow().entries.get(&key(p.as_ref())) {
+                Some(Entry::Dir(modified)) => Ok(Metadata { dir: true, len: 0, modified: *modified }),
+                Some(Entry::File(bytes, modified)) => Ok(Metadata { dir: false, len: bytes.len() as u64, modified: *modified }),
+                None => Err(missing(p.as_ref())),
+            })
+        }
+
+        pub struct DirEntry(PathBuf);
+        impl DirEntry {
+            pub fn path(&self) -> PathBuf {
+                self.0.clone()
+            }
+            pub fn file_name(&self) -> ::std::ffi::OsString {
+                self.0.file_name().unwrap_or_default().to_owned()
+            }
+            pub fn metadata(&self) -> io::Result<Metadata> {
+                metadata(&self.0)
+            }
+            pub fn file_type(&self) -> io::Result<FileType> {
+                metadata(&self.0).map(|m| m.file_type())
+            }
+        }
+
+        pub fn read_dir<P: AsRef<Path>>(p: P) -> io::Result<::std::vec::IntoIter<io::Result<DirEntry>>> {
+            let dir = key(p.as_ref());
+            if !is_dir(&dir) {
+                return Err(missing(&dir));
+            }
+            let entries = TREE.with(|t| {
+                t.borrow().below(&dir).into_iter().filter(|k| k.parent() == Some(&dir)).map(|k| Ok(DirEntry(k))).collect::<Vec<_>>()
+            });
+            Ok(entries.into_iter())
+        }
+    }
+}
