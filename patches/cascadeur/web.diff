@@ -0,0 +1,276 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! HumanMotionCraft in the browser, for Playground (patches/cascadeur.yaml in the Playground repository): the desktop
+//! window on the page's canvas, and its files in Playground's Files.
+//!
+//! The page loads the `assets` folder (the rig, the mannequin, the in-betweener's weights, the built-in library) into
+//! ac-playground's in-memory file system, then starts the app as the desktop does, with its preferences kept in memory
+//! (`--prefs memory`). Open project, Save project as and Import file are Playground's dialogs: the app's `rfd` calls
+//! (ac-playground) note which one they wanted and the page asks it after the frame ([`Web::after`]). A file from Files
+//! ("Open in HumanMotionCraft"), from an answer to Open, or dropped on the page comes in as a file dropped on the
+//! window, as the desktop takes one. Whatever the app writes outside `/tmp` (a saved project, an exported `.glb`; Export
+//! starts in `/Documents`) goes to Files after the frame, and a project saved to download is handed to the browser.
+//! AI in-betweening and the physics solver run on the page's one thread, in the frame (the app's own fallback for an AI
+//! worker thread that can't start).
+use std::cell::{OnceCell, RefCell};
+use std::future::Future;
+use std::path::{Path, PathBuf};
+use std::pin::Pin;
+use std::sync::Arc;
+
+use ac_playground::std::{self, fs};
+use wasm_bindgen::{JsCast as _, JsValue, closure::Closure};
+
+use super::App;
+use crate::Args;
+
+/// Where the page puts the app's `assets` folder.
+const ASSETS: &str = "/assets";
+/// Where the Export dialog starts (`files::documents`): this folder goes to Files.
+const DOCUMENTS: &str = "/Documents";
+/// Memory only: files from the computer or a drop, and a project saved to download.
+const TMP: &str = "/tmp";
+const OPENED_FROM: &str = "/tmp/Opened";
+const DOWNLOADS: &str = "/tmp/Downloads";
+
+thread_local! {
+    static CTX: OnceCell<egui::Context> = const { OnceCell::new() };
+    /// Files that came in (an answer to Open, "Open in", a drop), for the next frame.
+    static OPENED: RefCell<Vec<PathBuf>> = const { RefCell::new(Vec::new()) };
+    /// Where Save project as… put the project (and whether it is a download), for the next frame.
+    static SAVED: RefCell<Vec<(PathBuf, bool)>> = const { RefCell::new(Vec::new()) };
+}
+
+fn repaint() {
+    CTX.with(|c| c.get().map(egui::Context::request_repaint));
+}
+
+fn get(o: &JsValue, k: &str) -> JsValue {
+    js_sys::Reflect::get(o, &k.into()).unwrap_or(JsValue::UNDEFINED)
+}
+
+/// `playgroundFiles[method](...args)`; None when the page has none or it threw.
+fn call(method: &str, args: &[JsValue]) -> Option<JsValue> {
+    let api = Some(get(&js_sys::global(), "playgroundFiles")).filter(JsValue::is_object)?;
+    let f = get(&api, method).dyn_into::<js_sys::Function>().ok()?;
+    f.apply(&api, &args.iter().collect::<js_sys::Array>()).ok()
+}
+
+async fn wait(v: Option<JsValue>) -> Option<JsValue> {
+    let promise = v?.dyn_into::<js_sys::Promise>().ok()?;
+    wasm_bindgen_futures::JsFuture::from(promise).await.ok().filter(|v| !v.is_null() && !v.is_undefined())
+}
+
+fn options(pairs: &[(&str, JsValue)]) -> JsValue {
+    let o = js_sys::Object::new();
+    for (k, v) in pairs {
+        let _ = js_sys::Reflect::set(&o, &(*k).into(), v);
+    }
+    o.into()
+}
+
+fn json_types() -> JsValue {
+    js_sys::Array::of1(&"json".into()).into()
+}
+
+/// A file from Files (`{ path, name, bytes }`) into memory at its path (one from the computer goes to `/tmp`).
+fn bring_in(file: JsValue) {
+    let (Some(name), bytes) = (get(&file, "name").as_string(), js_sys::Uint8Array::new(&get(&file, "bytes")).to_vec()) else {
+        return;
+    };
+    let from = get(&file, "path").as_string().and_then(|p| p.strip_prefix("browser:").map(PathBuf::from));
+    let Some(file_name) = Path::new(&name).file_name() else { return };
+    let path = from.unwrap_or_else(|| Path::new(OPENED_FROM).join(file_name));
+    fs::put(&path, bytes);
+    OPENED.with_borrow_mut(|o| o.push(path));
+    repaint();
+}
+
+/// A file the page put in memory, handed to the window as a dropped one.
+#[derive(Debug)]
+struct Injected(PathBuf);
+
+impl egui::DroppedFile for Injected {
+    fn path(&self) -> &Path {
+        &self.0
+    }
+    fn bytes_async(&self) -> Pin<Box<dyn Future<Output = Result<Vec<u8>, String>> + '_>> {
+        Box::pin(async move { fs::read(&self.0).map_err(|e| e.to_string()) })
+    }
+}
+
+/// What the page's Files should hold of what the app wrote: not the library, the preferences and the recovery files it
+/// keeps under `/tmp`.
+fn mirrored(p: &Path) -> bool {
+    !p.starts_with(TMP) && !p.starts_with(ASSETS)
+}
+
+/// The page's app: the window, then what it asked of the page.
+struct Web {
+    app: App,
+    unsaved: bool,
+}
+
+impl Web {
+    /// After the window's frame: the project to save, the dialog it asked for, and what it wrote.
+    fn after(&mut self) {
+        for (path, download) in SAVED.take() {
+            // "Download to device": written in memory first, then handed to the browser (below); the next Save asks again.
+            if self.app.save_project(Some(path)) && download {
+                self.app.session.document.project = None;
+            }
+        }
+        if let Some(ask) = ac_playground::take_ask() {
+            match (ask.title.as_str(), ask.save) {
+                ("Open project" | "Import animations and poses", false) => {
+                    let asked = call("open", &[options(&[("types", json_types())])]);
+                    wasm_bindgen_futures::spawn_local(async move {
+                        if let Some(file) = wait(asked).await.and_then(|p| js_sys::Array::from(&p).iter().next()) {
+                            bring_in(file);
+                        }
+                    });
+                }
+                ("Save project", true) => {
+                    let name = ask.name.unwrap_or_else(|| "untitled.project.json".into());
+                    let asked = call("saveAs", &[options(&[("name", name.as_str().into()), ("types", json_types())])]);
+                    wasm_bindgen_futures::spawn_local(async move {
+                        let Some(answer) = wait(asked).await else { return };
+                        let (path, download) = match get(&answer, "path").as_string() {
+                            Some(p) => (p.strip_prefix("browser:").map(PathBuf::from), false),
+                            None => (Some(Path::new(DOWNLOADS).join(&name)), true),
+                        };
+                        if let Some(mut path) = path {
+                            if !path.to_string_lossy().to_ascii_lowercase().ends_with(".json") {
+                                path = PathBuf::from(format!("{}{}", path.display(), ac_io::project::EXT));
+                            }
+                            SAVED.with_borrow_mut(|s| s.push((path, download)));
+                            repaint();
+                        }
+                    });
+                }
+                _ => self.app.status = format!("{}: not in the browser version", ask.title),
+            }
+        }
+        for p in fs::changes() {
+            if p.starts_with(DOWNLOADS) {
+                if let (Ok(bytes), Some(name)) = (fs::read(&p), p.file_name()) {
+                    call("download", &[name.to_string_lossy().as_ref().into(), js_sys::Uint8Array::from(bytes.as_slice()).into()]);
+                    let _ = fs::remove_file(&p);
+                    fs::changes();
+                }
+            } else if mirrored(&p) {
+                let target = JsValue::from(format!("browser:{}", p.display()));
+                if fs::is_file(&p) {
+                    call("write", &[target, js_sys::Uint8Array::from(fs::read(&p).unwrap_or_default().as_slice()).into()]);
+                } else if !fs::exists(&p) {
+                    call("remove", &[target]);
+                }
+            }
+        }
+        let unsaved = self.app.session.document.unsaved();
+        if self.unsaved != unsaved {
+            self.unsaved = unsaved;
+            call("setUnsaved", &[unsaved.into()]);
+        }
+    }
+}
+
+impl ::eframe::App for Web {
+    fn logic(&mut self, ctx: &egui::Context, frame: &mut ::eframe::Frame) {
+        ::eframe::App::logic(&mut self.app, ctx, frame);
+    }
+
+    fn raw_input_hook(&mut self, ctx: &egui::Context, raw_input: &mut egui::RawInput) {
+        ::eframe::App::raw_input_hook(&mut self.app, ctx, raw_input);
+        // A dropped file is only a name on the web: its bytes are read, and it is dropped again from memory.
+        for f in std::mem::take(&mut raw_input.dropped_files) {
+            wasm_bindgen_futures::spawn_local(async move {
+                if let (Ok(bytes), Some(name)) = (f.bytes_async().await, f.path().file_name()) {
+                    let path = Path::new(OPENED_FROM).join(name);
+                    fs::put(&path, bytes);
+                    OPENED.with_borrow_mut(|o| o.push(path));
+                    repaint();
+                }
+            });
+        }
+        raw_input.dropped_files.extend(OPENED.take().into_iter().map(|p| Arc::new(Injected(p)) as egui::DroppedFileHandle));
+    }
+
+    fn ui(&mut self, ui: &mut egui::Ui, frame: &mut ::eframe::Frame) {
+        ::eframe::App::ui(&mut self.app, ui, frame);
+        self.after();
+        // A link opens in a new tab, as the desktop opens the browser, rather than replacing the app.
+        ui.ctx().output_mut(|o| {
+            for command in &mut o.commands {
+                if let egui::OutputCommand::OpenUrl(url) = command {
+                    url.new_tab = true;
+                }
+            }
+        });
+    }
+}
+
+/// Every file of `assets.txt` (the build lists them, one per line, relative to the page), fetched at once.
+async fn load_assets() -> Result<(), JsValue> {
+    let window = web_sys::window().ok_or("no window")?;
+    let text = |r: JsValue| -> Result<web_sys::Response, JsValue> {
+        let r: web_sys::Response = r.dyn_into()?;
+        if r.ok() { Ok(r) } else { Err(format!("{} {}", r.status(), r.url()).into()) }
+    };
+    let list = text(wasm_bindgen_futures::JsFuture::from(window.fetch_with_str("assets.txt")).await?)?;
+    let list = wasm_bindgen_futures::JsFuture::from(list.text()?).await?.as_string().unwrap_or_default();
+    let names: Vec<&str> = list.lines().filter(|l| !l.is_empty()).collect();
+    let fetches = js_sys::Array::new();
+    for name in &names {
+        fetches.push(&window.fetch_with_str(name));
+    }
+    let responses = wasm_bindgen_futures::JsFuture::from(js_sys::Promise::all(&fetches)).await?;
+    let buffers = js_sys::Array::new();
+    for r in js_sys::Array::from(&responses).iter() {
+        buffers.push(&text(r)?.array_buffer()?.into());
+    }
+    let bodies = wasm_bindgen_futures::JsFuture::from(js_sys::Promise::all(&buffers)).await?;
+    for (name, body) in names.iter().zip(js_sys::Array::from(&bodies).iter()) {
+        fs::put(&Path::new("/").join(name), js_sys::Uint8Array::new(&body).to_vec());
+    }
+    Ok(())
+}
+
+/// The desktop's `main` on the page: load the assets, then start the app on the canvas.
+pub fn main() {
+    std::panic::set_hook(Box::new(|info| web_sys::console::error_1(&format!("HumanMotionCraft: {info}").into())));
+    wasm_bindgen_futures::spawn_local(async {
+        let document = web_sys::window().and_then(|w| w.document()).expect("no document");
+        let loading = document.get_element_by_id("hmc_loading");
+        let said = |text: &str| loading.as_ref().map(|l| l.set_text_content(Some(text)));
+        if let Err(e) = load_assets().await {
+            said(&format!("HumanMotionCraft could not load its assets: {e:?}"));
+            return;
+        }
+        let _ = fs::create_dir_all(DOCUMENTS);
+        let canvas = document
+            .get_element_by_id("hmc_canvas")
+            .and_then(|c| c.dyn_into::<web_sys::HtmlCanvasElement>().ok())
+            .expect("no #hmc_canvas");
+        call("onOpen", &[Closure::<dyn Fn(JsValue)>::new(bring_in).into_js_value()]);
+        let creator = move |cc: &::eframe::CreationContext<'_>| -> Result<Box<dyn ::eframe::App>, Box<dyn std::error::Error + Send + Sync>> {
+            CTX.with(|c| c.set(cc.egui_ctx.clone()).ok());
+            let args = Args { assets: Some(ASSETS.into()), prefs: Some("memory".into()), ..Default::default() };
+            Ok(Box::new(Web { app: App::new(cc, args)?, unsaved: false }))
+        };
+        let mut web_options = ::eframe::WebOptions::default();
+        // The mannequin's skinning reads storage buffers in the vertex stage, which WebGL2 has none of: WebGPU only.
+        if let ::eframe::egui_wgpu::WgpuSetup::CreateNew(c) = &mut web_options.wgpu_options.wgpu_setup {
+            c.instance_descriptor.backends = ::eframe::egui_wgpu::wgpu::Backends::BROWSER_WEBGPU;
+        }
+        let runner = ::eframe::WebRunner::new();
+        let started = runner.start(canvas, web_options, Box::new(creator)).await;
+        // The runner lives as long as the page.
+        std::mem::forget(runner);
+        match started {
+            Ok(()) => loading.iter().for_each(|l| l.remove()),
+            Err(e) => {
+                said(&format!("HumanMotionCraft could not start: {e:?}"));
+            }
+        }
+    });
+}
