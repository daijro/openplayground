+# HumanMotionCraft in the browser, for Playground (patches/cascadeur.yaml in the Playground repository).
+# Build with: trunk build --release   (from the repository's root)
+[build]
+target = "index.html"
+public_url = "./"
+filehash = true
+dist = "target/trunk-dist"
+
+# The list of the assets folder's files, which the page fetches at start (app/web.rs).
+[[hooks]]
+stage = "post_build"
+command = "sh"
+command_arguments = ["-c", "cd \"$TRUNK_STAGING_DIR\" && find assets -type f | sort > assets.txt"]
