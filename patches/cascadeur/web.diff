@@ -0,0 +1,137 @@
+// SPDX-License-Identifier: GPL-3.0-or-later
+//! The three crates' stand-ins (see lib.rs), each as the app uses it.
+use ::std::cell::RefCell;
+use ::std::path::{Path, PathBuf};
+use web_time::Instant;
+
+// craft-atomic
+
+/// A write is all-or-nothing in memory already.
+pub fn atomic_write(path: &Path, bytes: &[u8]) -> ::std::io::Result<()> {
+    crate::std::fs::write(path, bytes)
+}
+
+// craft-settings
+
+pub trait Settings: Default + Clone + PartialEq {
+    const APP_ID: &'static str;
+    const SCHEMA_VERSION: u32;
+}
+
+pub enum Location {
+    Auto,
+    Memory,
+    Dir(PathBuf),
+}
+
+#[derive(Debug)]
+pub enum SaveStatus {
+    Idle,
+    Failed(String),
+}
+
+pub struct TickResult {
+    pub status: SaveStatus,
+    pub next_deadline: Option<Instant>,
+}
+
+#[derive(Default)]
+pub struct OpenReport {
+    pub broken_moved_to: Option<PathBuf>,
+    pub section_errors: Vec<String>,
+    pub read_only: Option<String>,
+}
+
+pub struct SettingsStore<T>(T);
+
+impl<T: Settings> SettingsStore<T> {
+    pub fn open(_location: Location) -> (Self, OpenReport) {
+        (Self(T::default()), OpenReport::default())
+    }
+    pub fn get(&self) -> &T {
+        &self.0
+    }
+    pub fn update(&mut self, f: impl FnOnce(&mut T)) -> bool {
+        let mut next = self.0.clone();
+        f(&mut next);
+        let changed = next != self.0;
+        self.0 = next;
+        changed
+    }
+    pub fn path(&self) -> Option<PathBuf> {
+        None
+    }
+    pub fn tick(&mut self, _now: Instant) -> TickResult {
+        TickResult { status: SaveStatus::Idle, next_deadline: None }
+    }
+    pub fn flush(&mut self) -> Result<(), String> {
+        Ok(())
+    }
+}
+
+// rfd
+
+/// A dialog the app asked for: the page shows Playground's instead, after the frame.
+#[derive(Default)]
+pub struct Ask {
+    pub title: String,
+    /// Extensions, without dots.
+    pub extensions: Vec<String>,
+    /// Save dialogs: the name offered.
+    pub name: Option<String>,
+    pub save: bool,
+    pub folder: bool,
+    pub several: bool,
+}
+
+thread_local! {
+    static ASKED: RefCell<Option<Ask>> = const { RefCell::new(None) };
+}
+
+/// The dialog the app asked for since the last call.
+pub fn take_ask() -> Option<Ask> {
+    ASKED.take()
+}
+
+#[derive(Default)]
+pub struct FileDialog(Ask);
+
+impl FileDialog {
+    pub fn new() -> Self {
+        Self::default()
+    }
+    pub fn add_filter(mut self, _name: impl Into<String>, extensions: &[impl ToString]) -> Self {
+        self.0.extensions.extend(extensions.iter().map(ToString::to_string));
+        self
+    }
+    pub fn set_title(mut self, title: impl Into<String>) -> Self {
+        self.0.title = title.into();
+        self
+    }
+    pub fn set_file_name(mut self, name: impl Into<String>) -> Self {
+        self.0.name = Some(name.into());
+        self
+    }
+    pub fn set_directory(self, _dir: impl AsRef<Path>) -> Self {
+        self
+    }
+    fn ask(self, save: bool, folder: bool, several: bool) {
+        ASKED.set(Some(Ask { save, folder, several, ..self.0 }));
+    }
+    pub fn pick_file(self) -> Option<PathBuf> {
+        self.ask(false, false, false);
+        None
+    }
+    pub fn pick_files(self) -> Option<Vec<PathBuf>> {
+        self.ask(false, false, true);
+        None
+    }
+    pub fn pick_folder(self) -> Option<PathBuf> {
+        self.ask(false, true, false);
+        None
+    }
+    pub fn save_file(self) -> Option<PathBuf> {
+        self.ask(true, false, false);
+        None
+    }
+}
