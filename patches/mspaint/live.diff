+// SPDX-License-Identifier: MIT
+//! Live editing in a Playground session (patches/mspaint.yaml in github.com/daijro/openplayground): a document someone
+//! else's change was merged into, published as the current state with no step in the history. A child of the session
+//! module, so it reaches the published state.
+
+use super::*;
+
+impl Session {
+    /// Publishes `doc` (the shared picture as it now is) without recording it: while connected, Undo goes to the
+    /// session; when it ends, the app starts a new history from the picture as it is. The selection, this person's, stays.
+    pub fn install_remote(&mut self, doc: Document) -> Result<()> {
+        self.epoch = self.next_epoch()?;
+        self.doc = Arc::new(doc);
+        Ok(())
+    }
+}
