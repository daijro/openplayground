+// SPDX-License-Identifier: MIT
+//! Live editing in a Playground session (patches/mspaint.yaml in github.com/daijro/openplayground wires it in; the
+//! session and the presence look are the playground-live crate's, patches/live/kit). Web only; the document functions
+//! also run in native tests.
+//!
+//! The shared document is the picture: the canvas size and the layers bottom to top, each with its id, name, origin,
+//! visibility, opacity, size and default pixel, and its 256×256 tiles that differ from the default (`"tx,ty"`: the
+//! tile's pixels, straight RGBA cropped to the layer, LZ4-compressed, base64). A stroke changes only the tiles it
+//! touched, so two people's edits to different layers or tiles merge as JSON does (layers by id, tiles by key), and two
+//! edits to one tile merge pixel by pixel ([`merge_tiles`]): both stay, the later on top. A remote change goes in at the
+//! end of a frame with no gesture under way and is no step of the editor's history; while connected, Undo and Redo go
+//! to the session, which takes back only this person's edits. Each person's pointer, the stroke, shape, selection or
+//! text they are making and their selection go to the others (`peers`).
+
+// The page's hooks are web only; native tests use the document functions.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+mod peers;
+
+#[cfg(target_arch = "wasm32")]
+pub use peers::paint;
+
+use crate::app::WebApp;
+use crate::editor::MAX_PIXELS;
+use paintcraft_core::types::Rgba;
+use paintcraft_document::{Document, FilterStack, LAYER_COUNT_MAX, Layer};
+use paintcraft_raster::{Admission, RasterLayer, TILE_EDGE, TileVersion};
+use playground_live::{Live, Presence, presence};
+use serde_json::{Map, Value, json};
+use std::cell::{OnceCell, RefCell};
+use std::collections::{BTreeSet, HashMap};
+use uuid::Uuid;
+
+/// The document's format: peers whose formats differ do not share a document.
+pub const FORMAT: &str = "paintcraft:1";
+/// The largest layer, in pixels (layers keep what lies off the canvas, so they may be larger than it).
+const MAX_LAYER: u64 = 4 * MAX_PIXELS;
+
+fn invalid(e: impl std::fmt::Display) -> String {
+    format!("Invalid shared picture: {e}")
+}
+
+// ---------------------------------------------------------------- tiles
+
+const B64: &[u8; 64] = b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/";
+
+fn base64(bytes: &[u8]) -> String {
+    let mut out = String::with_capacity(bytes.len().div_ceil(3) * 4);
+    for chunk in bytes.chunks(3) {
+        let n = chunk.iter().enumerate().fold(0u32, |n, (i, b)| n | u32::from(*b) << (16 - 8 * i));
+        for i in 0..4 {
+            out.push(if i <= chunk.len() { B64[(n >> (18 - 6 * i) & 63) as usize] as char } else { '=' });
+        }
+    }
+    out
+}
+
+fn unbase64(text: &str) -> Result<Vec<u8>, String> {
+    let s = text.as_bytes();
+    if s.len() % 4 != 0 {
+        return Err(invalid("tile text"));
+    }
+    let mut out = Vec::with_capacity(s.len() / 4 * 3);
+    for (q, chunk) in s.chunks(4).enumerate() {
+        let pad = chunk.iter().rev().take_while(|&&c| c == b'=').count();
+        if pad > 2 || (pad > 0 && q + 1 != s.len() / 4) {
+            return Err(invalid("tile text"));
+        }
+        let mut n = 0u32;
+        for (i, &c) in chunk[..4 - pad].iter().enumerate() {
+            let v = match c {
+                b'A'..=b'Z' => c - b'A',
+                b'a'..=b'z' => c - b'a' + 26,
+                b'0'..=b'9' => c - b'0' + 52,
+                b'+' => 62,
+                b'/' => 63,
+                _ => return Err(invalid("tile text")),
+            };
+            n |= u32::from(v) << (18 - 6 * i);
+        }
+        out.extend_from_slice(&n.to_be_bytes()[1..4 - pad]);
+    }
+    Ok(out)
+}
+
+/// The size of tile (tx, ty) of a w×h layer: 256×256, cut at the layer's right and bottom edges.
+fn tile_size(w: u32, h: u32, (tx, ty): (u32, u32)) -> (u32, u32) {
+    ((w - tx * TILE_EDGE).min(TILE_EDGE), (h - ty * TILE_EDGE).min(TILE_EDGE))
+}
+
+fn encode(px: &[u8]) -> String {
+    let mut packed = vec![0; lz4_flex::block::get_maximum_output_size(px.len())];
+    let n = lz4_flex::block::compress_into(px, &mut packed).expect("room for the worst case");
+    base64(&packed[..n])
+}
+
+/// A tile's pixels, exactly `len` bytes (the size comes from the layer, never from the data someone sent).
+fn decode(text: &str, len: usize) -> Result<Vec<u8>, String> {
+    let mut px = vec![0; len];
+    let n = lz4_flex::block::decompress_into(&unbase64(text)?, &mut px).map_err(invalid)?;
+    if n == len { Ok(px) } else { Err(invalid("tile size")) }
+}
+
+/// A tile's text, or None when all its pixels are the default (tiles like that are left out).
+fn tile_text(px: &[u8], default: Rgba) -> Option<String> {
+    (!px.chunks_exact(4).all(|p| p == default.0)).then(|| encode(px))
+}
+
+/// The pixels of tile (tx, ty) of a layer.
+fn pixels(raster: &RasterLayer, (tx, ty): (u32, u32)) -> Vec<u8> {
+    let (tw, th) = tile_size(raster.width(), raster.height(), (tx, ty));
+    let mut px = vec![0; (tw * th * 4) as usize];
+    for (row, out) in px.chunks_exact_mut(tw as usize * 4).enumerate() {
+        raster.read_span(i64::from(ty * TILE_EDGE) + row as i64, i64::from(tx * TILE_EDGE), out);
+    }
+    px
+}
+
+fn key((tx, ty): (u32, u32)) -> String {
+    format!("{tx},{ty}")
+}
+
+// ---------------------------------------------------------------- the document
+
+/// A shared layer taken apart.
+struct SharedLayer<'a> {
+    id: Uuid,
+    name: &'a str,
+    origin: (i64, i64),
+    visible: bool,
+    opacity: u8,
+    size: (u32, u32),
+    default: Rgba,
+    tiles: Vec<((u32, u32), &'a str)>,
+}
+
+impl SharedLayer<'_> {
+    fn tile_len(&self, at: (u32, u32)) -> usize {
+        let (tw, th) = tile_size(self.size.0, self.size.1, at);
+        (tw * th * 4) as usize
+    }
+}
+
+/// A shared document taken apart, checked: sizes, ids, tile places. Tiles are decoded later ([`check`], [`install`]).
+fn parse(doc: &Value) -> Result<((u32, u32), Vec<SharedLayer<'_>>), String> {
+    let size = |v: &Value| -> Option<(u32, u32)> {
+        let side = |v: &Value| v.as_u64().filter(|s| (1..=u64::from(paintcraft_document::CANVAS_SIDE_MAX)).contains(s));
+        Some((side(&v[0])? as u32, side(&v[1])? as u32))
+    };
+    let canvas = size(&doc["canvas"]).filter(|(w, h)| u64::from(*w) * u64::from(*h) <= MAX_PIXELS).ok_or_else(|| invalid("canvas size"))?;
+    let items = doc["layers"].as_array().filter(|l| l.len() <= LAYER_COUNT_MAX).ok_or_else(|| invalid("layers"))?;
+    let mut ids = BTreeSet::new();
+    let mut layers = Vec::with_capacity(items.len());
+    for l in items {
+        let id = l["id"].as_str().and_then(|s| s.parse::<Uuid>().ok()).filter(|id| ids.insert(*id)).ok_or_else(|| invalid("layer id"))?;
+        let coord = |v: &Value| v.as_i64().filter(|c| c.abs() <= paintcraft_document::COORD_ABS_MAX);
+        let layer = SharedLayer {
+            id,
+            name: l["name"].as_str().ok_or_else(|| invalid("layer name"))?,
+            origin: (|| Some((coord(&l["origin"][0])?, coord(&l["origin"][1])?)))().ok_or_else(|| invalid("layer origin"))?,
+            visible: l["visible"].as_bool().ok_or_else(|| invalid("layer visibility"))?,
+            opacity: l["opacity"].as_u64().and_then(|o| u8::try_from(o).ok()).ok_or_else(|| invalid("layer opacity"))?,
+            size: size(&l["size"]).filter(|(w, h)| u64::from(*w) * u64::from(*h) <= MAX_LAYER).ok_or_else(|| invalid("layer size"))?,
+            default: l["default"].as_str().and_then(Rgba::parse).ok_or_else(|| invalid("layer default"))?,
+            tiles: Vec::new(),
+        };
+        let (w, h) = layer.size;
+        let mut tiles = Vec::new();
+        for (k, v) in l["tiles"].as_object().ok_or_else(|| invalid("tiles"))? {
+            let at = k.split_once(',').and_then(|(x, y)| Some((x.parse::<u32>().ok()?, y.parse::<u32>().ok()?)));
+            let at = at.filter(|&(x, y)| key((x, y)) == *k && x < w.div_ceil(TILE_EDGE) && y < h.div_ceil(TILE_EDGE)).ok_or_else(|| invalid(format!("tile {k}")))?;
+            tiles.push((at, v.as_str().ok_or_else(|| invalid(format!("tile {k}")))?));
+        }
+        layers.push(SharedLayer { tiles, ..layer });
+    }
+    Ok((canvas, layers))
+}
+
+/// A whole shared document: every tile decodes to its size.
+fn check(doc: &Value) -> Result<(), String> {
+    for layer in parse(doc)?.1 {
+        for &(at, text) in &layer.tiles {
+            decode(text, layer.tile_len(at))?;
+        }
+    }
+    Ok(())
+}
+
+thread_local! {
+    /// Each tile's text as last made or installed, by layer and place, with the tile it was made from: a tile that is
+    /// still the same buffer is not encoded again.
+    static TILES: RefCell<HashMap<(Uuid, u32, u32), (TileVersion, Option<String>)>> = RefCell::default();
+    static CTX: OnceCell<eframe::egui::Context> = const { OnceCell::new() };
+}
+
+/// The shared document of `doc` (see the top).
+fn shared(doc: &Document) -> Value {
+    TILES.with_borrow_mut(|cache| {
+        let mut kept = HashMap::new();
+        let layers: Vec<Value> = doc
+            .layers_in_order()
+            .map(|layer| {
+                let raster = &layer.raster;
+                let mut tiles = Map::new();
+                for (c, version) in raster.tile_versions(raster.bounds()).into_iter().flatten() {
+                    let at = (c.tx as u32, c.ty as u32);
+                    let text = match cache.remove(&(layer.id, at.0, at.1)) {
+                        Some((v, text)) if v == version => text,
+                        _ => tile_text(&pixels(raster, at), raster.default_pixel()),
+                    };
+                    if let Some(text) = &text {
+                        tiles.insert(key(at), text.as_str().into());
+                    }
+                    kept.insert((layer.id, at.0, at.1), (version, text));
+                }
+                json!({
+                    "id": layer.id.to_string(),
+                    "name": layer.name,
+                    "origin": [layer.origin.0, layer.origin.1],
+                    "visible": layer.visible,
+                    "opacity": layer.opacity,
+                    "size": [raster.width(), raster.height()],
+                    "default": raster.default_pixel().to_hex(),
+                    "tiles": tiles,
+                })
+            })
+            .collect();
+        *cache = kept;
+        json!({ "canvas": [doc.canvas.0, doc.canvas.1], "layers": layers })
+    })
+}
+
+/// `shared` as a document: each layer from `current`'s where its size and default are the same (the tiles that did not
+/// change stay the very buffers they were), decoding only the tiles whose text differs.
+fn document_of(shared: &Value, current: &Document) -> Result<Document, String> {
+    let (canvas, layers) = parse(shared)?;
+    TILES.with_borrow_mut(|cache| {
+        let mut roots = Vec::with_capacity(layers.len());
+        let mut out = HashMap::with_capacity(layers.len());
+        let mut adm = Admission::new(paintcraft_core::types::policy::STAGED_PIXELS_MAX);
+        for l in &layers {
+            let old = current.layers.get(&l.id).map(|o| &o.raster).filter(|r| (r.width(), r.height(), r.default_pixel()) == (l.size.0, l.size.1, l.default));
+            let mut raster = old.cloned().unwrap_or_else(|| RasterLayer::new(l.size.0, l.size.1, l.default));
+            // The kept layer's tiles: their text (None: all default) where it is known, else just their place.
+            let (mut known, mut unknown) = (HashMap::new(), BTreeSet::new());
+            for (c, version) in old.into_iter().flat_map(|old| old.tile_versions(old.bounds()).into_iter().flatten()) {
+                let at = (c.tx as u32, c.ty as u32);
+                match cache.get(&(l.id, at.0, at.1)).filter(|(v, _)| *v == version) {
+                    Some((_, text)) => {
+                        known.insert(at, text.as_deref());
+                    }
+                    None => {
+                        unknown.insert(at);
+                    }
+                }
+            }
+            let wanted: HashMap<(u32, u32), &str> = l.tiles.iter().copied().collect();
+            let places: BTreeSet<(u32, u32)> = wanted.keys().chain(known.keys()).chain(&unknown).copied().collect();
+            let mut set = Vec::new();
+            for at in places {
+                let want = wanted.get(&at).copied();
+                // A kept tile with this text already (or a default place of a kept layer, with none) stays.
+                if old.is_some() && !unknown.contains(&at) && known.get(&at).copied().flatten() == want {
+                    continue;
+                }
+                let px = match want {
+                    Some(text) => decode(text, l.tile_len(at))?,
+                    None => l.default.0.repeat(l.tile_len(at) / 4),
+                };
+                raster.set_block(at.0, at.1, &px, &mut adm).map_err(invalid)?;
+                set.push((at, want));
+            }
+            // The tiles just set are known by their text.
+            let versions: HashMap<(u32, u32), TileVersion> = raster.tile_versions(raster.bounds()).into_iter().flatten().map(|(c, v)| ((c.tx as u32, c.ty as u32), v)).collect();
+            for (at, want) in set {
+                if let Some(v) = versions.get(&at) {
+                    cache.insert((l.id, at.0, at.1), (v.clone(), want.map(str::to_owned)));
+                }
+            }
+            roots.push(l.id);
+            // Filters are not shared: a kept layer keeps its own, a new one has none.
+            let filters = current.layers.get(&l.id).map(|o| o.filters.clone()).map_or_else(|| FilterStack::new(Vec::new()).map_err(invalid), Ok)?;
+            out.insert(l.id, Layer { id: l.id, name: l.name.to_owned(), origin: l.origin, visible: l.visible, opacity: l.opacity, raster, filters });
+        }
+        Ok(Document {
+            document_id: current.document_id,
+            state_id: Uuid::new_v4(),
+            canvas,
+            roots,
+            layers: out,
+            title: current.title.clone(),
+            source_metadata: current.source_metadata.clone(),
+        })
+    })
+}
+
+/// Two people's changes to one tile, pixel by pixel: a pixel `current` (the side placed after `edited`) changed is
+/// its, the others `edited`'s.
+fn merge_tiles(base: &[u8], current: &[u8], edited: &[u8]) -> Vec<u8> {
+    let pixels = base.chunks_exact(4).zip(current.chunks_exact(4)).zip(edited.chunks_exact(4));
+    pixels.flat_map(|((b, c), e)| if c != b { c } else { e }).copied().collect()
+}
+
+/// The three-way merge: tiles both sides changed are merged pixel by pixel into `current`'s side (and `edited`'s set
+/// back to `base`'s), then the JSON merge does the rest: layers by id, fields and tiles by key.
+fn merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+    // Both sides read as documents first: tile places in range of their layers.
+    let ((_, base_layers), _, _) = (parse(base)?, parse(current)?, parse(edited)?);
+    let (mut current, mut edited) = (current.clone(), edited.clone());
+    for b in &base_layers {
+        let same = |doc: &Value| -> Option<usize> {
+            let layers = doc["layers"].as_array()?;
+            let i = layers.iter().position(|l| l["id"].as_str() == Some(b.id.to_string().as_str()))?;
+            let l = &layers[i];
+            (l["size"] == json!([b.size.0, b.size.1]) && l["default"].as_str().and_then(Rgba::parse) == Some(b.default)).then_some(i)
+        };
+        let (Some(ci), Some(ei)) = (same(&current), same(&edited)) else { continue };
+        let tiles = |doc: &Value, i: usize| doc["layers"][i]["tiles"].as_object().cloned().unwrap_or_default();
+        let (ct, et) = (tiles(&current, ci), tiles(&edited, ei));
+        let bt: HashMap<String, &str> = b.tiles.iter().map(|&(at, text)| (key(at), text)).collect();
+        let keys: BTreeSet<&String> = ct.keys().chain(et.keys()).chain(bt.keys()).collect();
+        for k in keys {
+            let (tb, tc, te) = (bt.get(k).copied(), ct.get(k).and_then(Value::as_str), et.get(k).and_then(Value::as_str));
+            if tb == tc || tb == te {
+                continue;
+            }
+            let at = k.split_once(',').and_then(|(x, y)| Some((x.parse().ok()?, y.parse().ok()?))).ok_or_else(|| invalid(format!("tile {k}")))?;
+            let len = b.tile_len(at);
+            let px = |t: Option<&str>| t.map_or_else(|| Ok(b.default.0.repeat(len / 4)), |t| decode(t, len));
+            let merged = tile_text(&merge_tiles(&px(tb)?, &px(tc)?, &px(te)?), b.default);
+            let put = |doc: &mut Value, i: usize, text: Option<String>| {
+                if let Some(tiles) = doc["layers"][i]["tiles"].as_object_mut() {
+                    match text {
+                        Some(text) => tiles.insert(k.clone(), text.into()),
+                        None => tiles.remove(k.as_str()),
+                    };
+                }
+            };
+            put(&mut current, ci, merged);
+            put(&mut edited, ei, tb.map(str::to_owned));
+        }
+    }
+    playground_live::merge(base, &current, &edited, &[])
+}
+
+// ---------------------------------------------------------------- the app's hooks
+
+impl Live for WebApp {
+    fn live_document(&self) -> Value {
+        shared(self.editor.session.document())
+    }
+
+    fn live_adopt(&mut self, document: Value) -> Result<(), String> {
+        let doc = document_of(&document, self.editor.session.document())?;
+        let resized = doc.canvas != self.editor.session.document().canvas;
+        self.editor.session.install_remote(doc).map_err(|e| e.to_string())?;
+        self.editor.retarget();
+        // A picture of another size is fitted to the view, as one opened is.
+        if resized {
+            self.canvas = crate::canvas::Canvas::default();
+        }
+        peers::landed();
+        Ok(())
+    }
+
+    fn live_quiet(&self) -> bool {
+        let tools = &self.editor.tools;
+        presence::quiet()
+            && !tools.gesture_in_progress()
+            && !tools.is_editing_text()
+            && !tools.is_constructing_shape()
+            && tools.floating_selection().is_none()
+            && !self.paste.busy()
+    }
+
+    fn live_generation(&self) -> Option<u64> {
+        Some(self.editor.session.document().state_id.as_u128() as u64)
+    }
+
+    /// The editor's own Undo starts again from the picture as it is (its history holds pictures from before the others'
+    /// changes); a new session, set up as Editor::from_document sets one up, still unsaved if it was.
+    fn live_disconnected(&mut self) {
+        let unsaved = self.editor.session.is_dirty();
+        let mut session = paintcraft_editor::session::Session::new((*self.editor.session.snapshot()).clone());
+        session.set_staged_pixel_budget(MAX_PIXELS * 4);
+        session.set_history_budget(64 * 1024 * 1024);
+        session.set_history_retention(paintcraft_editor::session::HistoryRetention::TrimOldest);
+        if unsaved {
+            session.mark_unsaved();
+        }
+        self.editor.session = session;
+        self.editor.retarget();
+    }
+
+    fn live_presence(&self) -> Value {
+        peers::mine(self)
+    }
+
+    fn live_show_presence(&mut self, others: Vec<Presence>) {
+        presence::show(others);
+    }
+
+    fn live_merge(base: &Value, current: &Value, edited: &Value) -> Result<Value, String> {
+        merge(base, current, edited)
+    }
+
+    fn live_check(document: &Value) -> Result<(), String> {
+        check(document)
+    }
+}
+
+/// The end of each frame (after the app drew the others): the presence look's, then the session's.
+pub fn frame(app: &mut WebApp, ctx: &eframe::egui::Context) {
+    CTX.with(|c| drop(c.set(ctx.clone())));
+    presence::end_frame(ctx);
+    playground_live::frame(app);
+}
+
+/// Offers the running app to a Playground session (a page without Playground never connects). It fails only when the
+/// page's global object refuses a property.
+#[cfg(target_arch = "wasm32")]
+pub fn attach(runner: &eframe::WebRunner) {
+    let runner = runner.clone();
+    let _ = playground_live::web::attach::<WebApp>(
+        FORMAT,
+        move |with| runner.app_mut::<WebApp>().map(|mut app| with(&mut app)).is_some(),
+        || {
+            CTX.with(|c| c.get().map(eframe::egui::Context::request_repaint));
+        },
+    );
+}
+
