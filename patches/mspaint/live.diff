@@ -0,0 +1,123 @@
+// SPDX-License-Identifier: MIT
+use super::*;
+use crate::editor::WHITE;
+use playground_live::canonical;
+
+const RED: Rgba = Rgba([255, 0, 0, 255]);
+const BLUE: Rgba = Rgba([0, 0, 255, 255]);
+
+fn app() -> WebApp {
+    let mut app = WebApp::new(&eframe::egui::Context::default());
+    app.install(crate::files::Loaded {
+        document: paintcraft_document::new_document(600, 300, Some(WHITE), 0, paintcraft_document::POLICY).unwrap(),
+        name: "test.pcnd".into(),
+        losses: Vec::new(),
+    });
+    app
+}
+
+/// `doc` with the pixels of `rect` in its layer `layer` (bottom first) painted `color`.
+fn painted(doc: &Document, layer: usize, rect: (i64, i64, i64, i64), color: Rgba) -> Document {
+    let mut doc = doc.clone();
+    let id = doc.roots[layer];
+    let area = paintcraft_core::types::Rect { x0: rect.0, y0: rect.1, x1: rect.2, y1: rect.3 };
+    let raster = &mut doc.layers.get_mut(&id).unwrap().raster;
+    raster.fill_rect(&area, color, paintcraft_raster::BlendMode::Replace, &mut Admission::new(u64::MAX)).unwrap();
+    doc
+}
+
+fn pixel(shared: &Value, layer: usize, (x, y): (i64, i64)) -> Rgba {
+    let doc = document_of(shared, &app().editor.session.snapshot()).unwrap();
+    doc.layers[&doc.roots[layer]].raster.get(x, y)
+}
+
+#[test]
+fn tiles_read_back_exactly_and_bad_ones_are_refused() {
+    for n in 0..8 {
+        let bytes: Vec<u8> = (0..n).map(|i| (i * 37) as u8).collect();
+        assert_eq!(unbase64(&base64(&bytes)).unwrap(), bytes);
+    }
+    let px: Vec<u8> = (0..256 * 10 * 4).map(|i| (i % 7) as u8).collect();
+    assert_eq!(decode(&encode(&px), px.len()).unwrap(), px);
+    assert!(decode(&encode(&px), px.len() - 4).is_err(), "a tile of another size");
+    assert!(decode("not base64!", 16).is_err());
+    assert!(decode(&base64(&[0xff; 8]), 16).is_err());
+}
+
+#[test]
+fn adopting_gives_the_same_picture_keeps_the_selection_and_is_no_undo_step() {
+    let (mut a, b) = (app(), app());
+    let doc = painted(&b.editor.session.snapshot(), 0, (10, 10, 40, 30), RED);
+    let shared = shared(&doc);
+    check(&shared).unwrap();
+    a.edit(paintcraft_tools::Action::Select { corners: Some(((1, 1), (5, 5))) });
+    let (undo, selection) = (a.editor.session.undo_depth(), a.editor.session.selection());
+    a.live_adopt(shared.clone()).unwrap();
+    assert_eq!(canonical(&a.live_document()), canonical(&shared));
+    assert_eq!(a.editor.session.document().layers[&doc.roots[0]].raster.get(20, 20), RED);
+    assert_eq!((a.editor.session.undo_depth(), a.editor.session.selection()), (undo, selection));
+    // Once the session ends, the editor's own Undo starts from the picture as it is.
+    a.live_disconnected();
+    assert_eq!(a.editor.session.undo_depth(), 0);
+    assert_eq!(canonical(&a.live_document()), canonical(&shared));
+}
+
+#[test]
+fn two_strokes_in_one_tile_both_stay_the_later_on_top_and_undo_takes_back_only_its_own() {
+    let base_doc = app().editor.session.snapshot();
+    let base = shared(&base_doc);
+    // Ann paints across row 20, Bob across row 22 and over one of Ann's pixels: the same tile.
+    let ann = shared(&painted(&base_doc, 0, (10, 20, 60, 21), RED));
+    let bob = shared(&painted(&painted(&base_doc, 0, (30, 22, 90, 23), BLUE), 0, (40, 20, 41, 21), BLUE));
+    // Ann's was accepted first; Bob's is placed after it.
+    let merged = WebApp::live_merge(&base, &bob, &ann).unwrap();
+    WebApp::live_check(&merged).unwrap();
+    assert_eq!([pixel(&merged, 0, (15, 20)), pixel(&merged, 0, (80, 22)), pixel(&merged, 0, (40, 20))], [RED, BLUE, BLUE]);
+    // Ann's Undo (the session's: merge(after hers, now, before hers)) takes back her pixels, not Bob's over them.
+    let undone = WebApp::live_merge(&ann, &merged, &base).unwrap();
+    assert_eq!([pixel(&undone, 0, (15, 20)), pixel(&undone, 0, (40, 20)), pixel(&undone, 0, (80, 22))], [WHITE, BLUE, BLUE]);
+    // Strokes in different tiles merge as JSON does.
+    let far = shared(&painted(&base_doc, 0, (500, 200, 520, 210), BLUE));
+    let both = WebApp::live_merge(&base, &far, &ann).unwrap();
+    assert_eq!([pixel(&both, 0, (15, 20)), pixel(&both, 0, (510, 205))], [RED, BLUE]);
+}
+
+#[test]
+fn a_new_layer_and_paint_on_another_both_stay() {
+    let mut app = app();
+    let base = app.live_document();
+    let painted = shared(&painted(&app.editor.session.snapshot(), 0, (10, 10, 20, 20), RED));
+    app.editor
+        .commit(vec![paintcraft_core::types::json::Value::object([
+            ("op", paintcraft_core::types::json::Value::str("layer.add")),
+            ("ref", paintcraft_core::types::json::Value::str("new")),
+            ("name", paintcraft_core::types::json::Value::str("Overlay")),
+            ("width", paintcraft_core::types::json::Value::Int(600)),
+            ("height", paintcraft_core::types::json::Value::Int(300)),
+            ("origin", paintcraft_core::types::json::Value::object([("x", paintcraft_core::types::json::Value::Int(0)), ("y", paintcraft_core::types::json::Value::Int(0))])),
+            ("default_pixel", paintcraft_core::types::json::Value::str("#00000000")),
+        ])])
+        .unwrap();
+    let layered = app.live_document();
+    let merged = WebApp::live_merge(&base, &painted, &layered).unwrap();
+    assert_eq!(merged["layers"].as_array().unwrap().len(), 2);
+    assert_eq!(pixel(&merged, 0, (15, 15)), RED);
+    app.live_adopt(merged.clone()).unwrap();
+    assert_eq!(canonical(&app.live_document()), canonical(&merged));
+}
+
+#[test]
+fn malformed_pictures_are_refused() {
+    let good = app().live_document();
+    let bad = |f: &dyn Fn(&mut Value)| {
+        let mut doc = good.clone();
+        f(&mut doc);
+        assert!(WebApp::live_check(&doc).is_err(), "{doc}");
+    };
+    bad(&|d| d["canvas"] = json!([100000, 100000]));
+    bad(&|d| d["layers"][0]["id"] = json!("not a uuid"));
+    bad(&|d| d["layers"][0]["tiles"] = json!({ "9,0": encode(&[0; 4]) }));
+    bad(&|d| d["layers"][0]["tiles"] = json!({ "0,0": encode(&[0; 4]) }));
+    bad(&|d| d["layers"][0]["tiles"] = json!({ "00,0": encode(&[0; 4]) }));
+    assert!(WebApp::live_check(&json!(null)).is_err());
+}
