+// SPDX-License-Identifier: MIT
+//! Presence in a live session. Each person shares, in picture pixels (so it lands on the same spot at anyone's zoom and
+//! scroll), their pointer over the picture and what they are making: the stroke being drawn (its points, evenly picked,
+//! and brush size), the shape, polygon, curve, marquee or lasso being dragged out, the text being typed, and their
+//! selection. Here, over the picture, for the others: their stroke in their colour, the rest dashed, their selection
+//! outlined (a ghost while they move it), then their pointer with their name, eased toward its latest place. A finished
+//! stroke stays until the picture with it arrives (at most a second). Everything in a state comes from another person:
+//! what doesn't read as numbers in range is skipped. Pointers, tags, outlines, ghosts, dashes and easing are the
+//! playground-live crate's presence look; strokes are drawn here, in the person's colour.
+// The painting is web only (its hook is); native tests use the state.
+#![cfg_attr(not(target_arch = "wasm32"), allow(dead_code))]
+
+use super::presence;
+use crate::app::WebApp;
+use eframe::egui::{self, Color32, Pos2, Rect, Shape, Stroke, vec2};
+use paintcraft_tools::{Preview, Tool};
+use serde_json::{Value, json};
+use std::cell::{Cell, RefCell};
+use std::collections::HashMap;
+
+/// The points of a stroke, polygon or lasso shared at most (presence stays under 4 KiB).
+const MAX_POINTS: usize = 150;
+const MAX_TEXT: usize = 64;
+/// How long a finished stroke stays while its picture is on the way, in seconds.
+const LINGER: f64 = 1.0;
+
+/// Someone's stroke as shown here: its points and brush size, when it last changed, and once it is finished, until
+/// when it stays.
+#[derive(Default)]
+struct Mark {
+    stroke: Option<(Vec<[f32; 2]>, f32)>,
+    changed: f64,
+    until: Option<f64>,
+}
+
+thread_local! {
+    /// This person's pointer over the picture, as of the last frame.
+    static POINTER: Cell<Option<[f32; 2]>> = const { Cell::new(None) };
+    static SHOWN: RefCell<HashMap<String, Mark>> = RefCell::default();
+    /// A remote change went into the picture since the last frame, and when one last did.
+    static LANDED: Cell<bool> = const { Cell::new(false) };
+    static LANDED_AT: Cell<f64> = const { Cell::new(f64::NEG_INFINITY) };
+}
+
+/// To a tenth of a pixel.
+fn r(v: f64) -> f64 {
+    (v * 10.0).round() / 10.0
+}
+
+/// At most [`MAX_POINTS`] of `points`, evenly picked, the last always in.
+fn sample(points: &[(i64, i64)], scale: f64) -> Value {
+    let step = (points.len() as f64 / MAX_POINTS as f64).max(1.0);
+    let mut picked: Vec<_> = (0..points.len().min(MAX_POINTS)).map(|i| points[(i as f64 * step) as usize]).collect();
+    if let (Some(last), Some(end)) = (picked.last_mut(), points.last()) {
+        *last = *end;
+    }
+    picked.iter().map(|p| json!([r(p.0 as f64 / scale), r(p.1 as f64 / scale)])).collect()
+}
+
+fn shape_kind(tool: Tool) -> &'static str {
+    match tool {
+        Tool::Line => "line",
+        Tool::Ellipse => "ellipse",
+        _ => "rect",
+    }
+}
+
+/// This person's presence (see the top).
+pub(super) fn mine(app: &WebApp) -> Value {
+    let mut s = json!({});
+    if let Some([x, y]) = POINTER.get() {
+        s["pointer"] = json!([r(x.into()), r(y.into())]);
+    }
+    let stroke = |stroke: &paintcraft_tools::Stroke| json!({ "points": sample(&stroke.points, f64::from(stroke.point_scale.max(1))), "size": stroke.size });
+    match app.editor.tools.preview() {
+        Some(Preview::Path(path)) => s["stroke"] = stroke(&path),
+        Some(Preview::Paths(paths)) => {
+            if let Some(path) = paths.last() {
+                s["stroke"] = stroke(path);
+            }
+        }
+        Some(Preview::Shape { tool, from, to, .. }) => s["shape"] = json!({ "kind": shape_kind(tool), "from": [from.0, from.1], "to": [to.0, to.1] }),
+        Some(Preview::Contour(c)) => s["path"] = json!({ "points": sample(&c.points, 1.0), "closed": c.closed }),
+        Some(Preview::SelectionPath { points }) => s["path"] = json!({ "points": sample(&points, 1.0), "closed": true }),
+        Some(Preview::Marquee { from, to }) => s["marquee"] = json!([from.0.min(to.0), from.1.min(to.1), from.0.max(to.0) + 1, from.1.max(to.1) + 1]),
+        Some(Preview::Text { at, text, .. }) => s["text"] = json!({ "at": [at.0, at.1], "text": text.chars().take(MAX_TEXT).collect::<String>() }),
+        Some(Preview::MoveSelection { .. }) => s["moving"] = true.into(),
+        _ => {}
+    }
+    if let Ok(Some(b)) = app.selected_bounds() {
+        s["selection"] = json!([b.x0, b.y0, b.x1, b.y1]);
+    }
+    s
+}
+
+/// A remote change went into the picture: finished strokes have arrived.
+pub(super) fn landed() {
+    LANDED.set(true);
+}
+
+/// A point someone gave, when it is two numbers of a sane size.
+fn point(v: &Value) -> Option<[f32; 2]> {
+    let c = |v: &Value| v.as_f64().filter(|c| c.abs() < 1e7).map(|c| c as f32);
+    Some([c(&v[0])?, c(&v[1])?])
+}
+
+fn points(v: &Value) -> Option<Vec<[f32; 2]>> {
+    let points: Vec<_> = v.as_array()?.iter().take(MAX_POINTS * 2).map(point).collect::<Option<_>>()?;
+    (!points.is_empty()).then_some(points)
+}
+
+fn stroke_of(v: &Value) -> Option<(Vec<[f32; 2]>, f32)> {
+    let size = v["size"].as_f64().filter(|s| (0.0..=1024.0).contains(s))? as f32;
+    Some((points(&v["points"])?, size))
+}
+
+/// A box someone gave: x0, y0, x1, y1.
+fn bounds(v: &Value) -> Option<[f32; 4]> {
+    let (a, b) = (point(&json!([v[0], v[1]]))?, point(&json!([v[2], v[3]]))?);
+    Some([a[0], a[1], b[0], b[1]])
+}
+
+/// `c` at 70% over white, opaque (overlapping dabs of a translucent colour would show darker spots).
+fn tint(c: Color32) -> Color32 {
+    let mix = |v: u8| (255.0 - 0.7 * (255.0 - f32::from(v))).round() as u8;
+    Color32::from_rgb(mix(c.r()), mix(c.g()), mix(c.b()))
+}
+
+fn corners(r: Rect) -> [Pos2; 4] {
+    [r.left_top(), r.right_top(), r.right_bottom(), r.left_bottom()]
+}
+
+/// In the canvas, after the picture (a line in canvas.rs): notes this person's pointer, and draws the others' strokes,
+/// shapes, selections and text, then their pointers. `sheet` is where the picture is, `zoom` points per pixel.
+pub fn paint(app: &WebApp, ui: &egui::Ui, painter: &egui::Painter, sheet: Rect) {
+    let zoom = app.zoom;
+    let clip = painter.clip_rect();
+    let hover = ui.input(|i| i.pointer.hover_pos()).filter(|p| clip.contains(*p) && ui.ctx().layer_id_at(*p) == Some(painter.layer_id()));
+    POINTER.set(hover.map(|p| [(p.x - sheet.min.x) / zoom, (p.y - sheet.min.y) / zoom]));
+    if !playground_live::connected() {
+        return;
+    }
+    let screen = |p: [f32; 2]| sheet.min + vec2(p[0], p[1]) * zoom;
+    let now = ui.input(|i| i.time);
+    // Pointers ease in picture pixels (`zoom` points each); a jump farther than a quarter of the view goes at once.
+    let far = f64::from(clip.width().max(clip.height()) / 4.0);
+    if LANDED.take() {
+        LANDED_AT.set(now);
+    }
+    let others = presence::others();
+    let mut pointers = Vec::new();
+    SHOWN.with_borrow_mut(|shown| {
+        shown.retain(|id, _| others.iter().any(|o| o.id == *id));
+        for o in &others {
+            let (state, color) = (&o.state, presence::color(o));
+            let mark = shown.entry(o.id.clone()).or_default();
+            match stroke_of(&state["stroke"]) {
+                Some(stroke) => {
+                    if mark.stroke.as_ref() != Some(&stroke) {
+                        mark.changed = now;
+                    }
+                    (mark.stroke, mark.until) = (Some(stroke), None);
+                }
+                // Finished: it stays until a change lands after its last point (the picture with it), at most a second.
+                None if mark.stroke.is_some() => {
+                    if LANDED_AT.get() > mark.changed || now > *mark.until.get_or_insert(now + LINGER) {
+                        (mark.stroke, mark.until) = (None, None);
+                    } else {
+                        presence::keep_moving();
+                    }
+                }
+                None => {}
+            }
+            if let Some((points, size)) = &mark.stroke {
+                let (line, width, ink) = (points.iter().map(|p| screen(*p)).collect::<Vec<_>>(), (size * zoom).max(2.0), tint(color));
+                painter.add(Shape::line(line.clone(), Stroke::new(width, ink)));
+                for p in line {
+                    painter.circle_filled(p, width / 2.0, ink);
+                }
+            }
+            if let Some(b) = bounds(&state["selection"]) {
+                let rect = Rect::from_two_pos(screen([b[0], b[1]]), screen([b[2], b[3]]));
+                if state["moving"].as_bool() == Some(true) {
+                    presence::ghost(painter, rect, color);
+                } else {
+                    presence::outline(painter, rect, color);
+                }
+            }
+            if let Some(b) = bounds(&state["marquee"]) {
+                presence::dashed(painter, &corners(Rect::from_two_pos(screen([b[0], b[1]]), screen([b[2], b[3]]))), true, color);
+            }
+            let shape = &state["shape"];
+            if let (Some(kind), Some(a), Some(b)) = (shape["kind"].as_str(), point(&shape["from"]), point(&shape["to"])) {
+                let (a, b) = (screen(a), screen(b));
+                let r = Rect::from_two_pos(a, b);
+                match kind {
+                    "line" => presence::dashed(painter, &[a, b], false, color),
+                    "ellipse" => {
+                        let ring: Vec<Pos2> = (0..64).map(|i| i as f32 * std::f32::consts::TAU / 64.0).map(|t| r.center() + vec2(t.cos() * r.width(), t.sin() * r.height()) / 2.0).collect();
+                        presence::dashed(painter, &ring, true, color);
+                    }
+                    _ => presence::dashed(painter, &corners(r), true, color),
+                }
+            }
+            if let Some(path) = points(&state["path"]["points"]) {
+                let path: Vec<Pos2> = path.into_iter().map(screen).collect();
+                presence::dashed(painter, &path, state["path"]["closed"].as_bool() == Some(true), color);
+            }
+            if let Some(at) = point(&state["text"]["at"]) {
+                let words: String = state["text"]["text"].as_str().unwrap_or_default().chars().take(MAX_TEXT).collect();
+                presence::label(painter, screen(at), color, if words.is_empty() { "…" } else { &words });
+            }
+            let eased = point(&state["pointer"]).and_then(|p| presence::ease(ui.ctx(), &o.id, "pointer", p.map(f64::from), [f64::from(zoom); 2], [far; 2]));
+            if let Some(p) = eased {
+                pointers.push((screen(p.map(|v| v as f32)), color, &o.name));
+            }
+        }
+    });
+    // Pointers over everything of theirs.
+    for (tip, color, name) in pointers {
+        presence::cursor(painter, tip, color, name);
+    }
+}
